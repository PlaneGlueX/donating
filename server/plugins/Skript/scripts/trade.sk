# trade.sk: trading between players, in person. Built 2026-09-26 (owner, 2026-09-26: cars and crate cosmetics,
# in person, no tax; the owner plans trading like CS:GO skins, where players pay each other outside the game.
# The server only ever moves the items, never money).
#
# /trade <player> standing next to them (trade::reach blocks) asks them; the same command back opens the trade
# for both: a 6-row window, your offer on the left, theirs on the right. Add your cars (in the garage, not out)
# and crate cosmetics (titles, bag skins, kill effects from crates; a rank's bag skins stay with the rank) with
# the buttons at the bottom, and click one of yours to take it back. Both press Ready; a countdown
# (trade::countdown seconds) runs and then the trade happens, unless anything changes first (both go back to
# not ready). A one-sided trade is a gift. Ready is refused for a moment after any change (so a click aimed at
# the old offer doesn't agree to a new one) and while the swap couldn't happen (with the reason). Everything is
# checked again at the end, in one call with no wait: each thing is still its giver's, the receiver doesn't
# have that cosmetic already and has room in the garage for the cars (car::garage-max, counting the ones they give).
# Cars are traded one by one (2026-09-28: several of a model, each its own plate): its wrap, mods, serial number
# and crate count go with it. A car above the receiver's level waits in their garage until they reach it
# (garage.sk carDriveBlock).
#
# The trade ends without a swap when either closes the window, walks away (trade::reach + 3 blocks), gets
# hurt or combat-tagged, dies, logs out or ends up in a heist.
#
# Memory only: {-trade::with::<u>} the partner (a player), {-trade::sid::<u>} the session number,
# {-trade::offer::<u>::*} "car:<plate>" / "cos:<id>", {-trade::ready::<u>}, {-trade::view::<u>} main | pick,
# {-trade::gui::<u>} / {-trade::pgui::<u>} the windows, {-trade::a::<sid>} / {-trade::b::<sid>} the two
# players, {-trade::ver::<sid>} (every change adds 1), {-trade::count::<sid>} the countdown shown,
# {-trade::req::<from u>::<to u>} when a request was sent.
# Log: plugins\Skript\logs\trade.log (every trade and cancel, for disputes).

function tradeLog(text: text):
	log {_text} to "trade"

# ---------- Who may trade ----------

# "" when these two may trade now (from p's side), else why not. loose: the looser check while a trade is open
# (a few blocks more).
function tradeBlock(p: player, o: player, loose: boolean) :: text:
	if {_p} is {_o}:
		return "You can't trade with yourself."
	if {_p} is not alive:
		return "Not right now."
	if {_o} is not alive:
		return "%name of {_o}% can't trade right now."
	set {_reach} to cfg("trade::reach")
	if {_loose} is true:
		add 3 to {_reach}
	if world of {_p} is not world of {_o}:
		return "Stand next to %name of {_o}% to trade (in person)."
	if distance between {_p} and {_o} > {_reach}:
		return "Stand next to %name of {_o}% to trade (in person)."
	if heistOf({_p}) is not "":
		return "Not inside a heist."
	if heistOf({_o}) is not "":
		return "Not while %name of {_o}% is in a heist."
	if isCombatTagged({_p}) is true:
		return "Not while in combat."
	if isCombatTagged({_o}) is true:
		return "Not while %name of {_o}% is in combat."
	return ""

# ---------- Requests ----------

command /trade [<text>]:
	description: Trade cars and crate cosmetics with a player next to you.
	executable by: players
	trigger:
		set {_u} to "%uuid of player%"
		if arg-1 is not set:
			msg(player, "&6Trading: &7stand next to someone and type &f/trade &7and their name. They do the same back, then you both add cars and crate cosmetics and press Ready. &f/trade cancel &7ends it.")
			stop
		if arg-1 is "cancel":
			if {-trade::sid::%{_u}%} is set:
				tradeEnd({-trade::sid::%{_u}%}, "%name of player% cancelled it")
			else:
				delete {-trade::req::%{_u}%::*}
				msg(player, "&7No trade open.")
			stop
		set {_o} to arg-1 parsed as player
		if {_o} is not set:
			msg(player, "&cNo player called %arg-1% is online.")
			stop
		if {-trade::sid::%{_u}%} is set:
			msg(player, "&cFinish your trade first (&f/trade cancel&c).")
			stop
		set {_ou} to "%uuid of {_o}%"
		if {-trade::sid::%{_ou}%} is set:
			msg(player, "&c%name of {_o}% is trading with someone else.")
			stop
		set {_why} to tradeBlock(player, {_o}, false)
		if {_why} is not "":
			msg(player, "&c%{_why}%")
			stop
		# They asked first (not too long ago): open it for both.
		set {_theirs} to {-trade::req::%{_ou}%::%{_u}%}
		if {_theirs} is set:
			if difference between {_theirs} and now < cfg("trade::request-time"):
				tradeStart({_o}, player)
				stop
		set {_mine} to {-trade::req::%{_u}%::%{_ou}%}
		if {_mine} is set:
			if difference between {_mine} and now < 5 seconds:
				msg(player, "&7You asked %name of {_o}% already.")
				stop
		set {-trade::req::%{_u}%::%{_ou}%} to now
		msg(player, "&6Trade: &7asked &f%name of {_o}%&7. They answer with &f/trade %name of player%&7.")
		msg({_o}, "&6Trade: &f%name of player% &7wants to trade with you. &f/trade %name of player% &7to open it.")
		play sound "block.note_block.pling" with volume 0.6 and pitch 1.4 to {_o}

on quit:
	set {_u} to "%uuid of player%"
	delete {-trade::req::%{_u}%::*}
	if {-trade::sid::%{_u}%} is set:
		tradeEnd({-trade::sid::%{_u}%}, "%name of player% left")

# ---------- A trade ----------

function tradeStart(a: player, b: player):
	set {_ua} to "%uuid of {_a}%"
	set {_ub} to "%uuid of {_b}%"
	delete {-trade::req::%{_ua}%::%{_ub}%}
	delete {-trade::req::%{_ub}%::%{_ua}%}
	closePhoneMap({_a})
	closePhoneMap({_b})
	add 1 to {-trade::next}
	set {_sid} to {-trade::next}
	set {-trade::a::%{_sid}%} to {_a}
	set {-trade::b::%{_sid}%} to {_b}
	set {-trade::ver::%{_sid}%} to 0
	loop {_ua} and {_ub}:
		delete {-trade::offer::%loop-value%::*}
		delete {-trade::gui::%loop-value%}
		delete {-trade::pgui::%loop-value%}
		set {-trade::ready::%loop-value%} to false
		set {-trade::sid::%loop-value%} to {_sid}
		set {-trade::view::%loop-value%} to "main"
	set {-trade::with::%{_ua}%} to {_b}
	set {-trade::with::%{_ub}%} to {_a}
	tradeLog("open sid=%{_sid}% %{_a}% %{_ua}% with %{_b}% %{_ub}%")
	tradeDraw({_a})
	tradeDraw({_b})
	play sound "block.chest.open" with volume 0.5 to {_a}
	play sound "block.chest.open" with volume 0.5 to {_b}

# Ends a trade with no swap (or after one: why = "done"), closing both windows.
function tradeEnd(sid: number, why: text):
	set {_a} to {-trade::a::%{_sid}%}
	set {_b} to {-trade::b::%{_sid}%}
	delete {-trade::a::%{_sid}%}
	delete {-trade::b::%{_sid}%}
	delete {-trade::ver::%{_sid}%}
	delete {-trade::count::%{_sid}%}
	delete {-trade::changedat::%{_sid}%}
	loop {_a} and {_b}:
		set {_p} to loop-value
		set {_u} to "%uuid of {_p}%"
		if {-trade::sid::%{_u}%} is {_sid}:
			set {_g} to {-trade::gui::%{_u}%}
			set {_pg} to {-trade::pgui::%{_u}%}
			delete {-trade::sid::%{_u}%}
			delete {-trade::with::%{_u}%}
			delete {-trade::offer::%{_u}%::*}
			delete {-trade::ready::%{_u}%}
			delete {-trade::view::%{_u}%}
			delete {-trade::gui::%{_u}%}
			delete {-trade::pgui::%{_u}%}
			delete {-trade::act::%{_u}%::*}
			delete {-trade::pact::%{_u}%::*}
			if {_p} is online:
				if {_g} is set:
					if {_p}'s current inventory is {_g}:
						close {_p}'s inventory
				if {_pg} is set:
					if {_p}'s current inventory is {_pg}:
						close {_p}'s inventory
				if {_why} is not "done":
					msg({_p}, "&7The trade was cancelled: %{_why}%.")
	if {_why} is not "done":
		tradeLog("cancel sid=%{_sid}% %{_a}% %{_b}% why=%{_why}%")

# Something changed: nobody is ready any more, and both windows show it.
function tradeChanged(sid: number):
	add 1 to {-trade::ver::%{_sid}%}
	set {-trade::changedat::%{_sid}%} to now
	delete {-trade::count::%{_sid}%}
	set {_a} to {-trade::a::%{_sid}%}
	set {_b} to {-trade::b::%{_sid}%}
	set {-trade::ready::%uuid of {_a}%} to false
	set {-trade::ready::%uuid of {_b}%} to false
	tradeDraw({_a})
	tradeDraw({_b})

# ---------- What can be offered ----------

# "" when p may put this in the trade now, else why not.
function tradeAddBlock(p: player, e: text) :: text:
	set {_u} to "%uuid of {_p}%"
	set {_o} to {-trade::with::%{_u}%}
	if {_o} is not set:
		return "No trade open."
	if {-trade::offer::%{_u}%::*} contains {_e}:
		return "It's in the trade already."
	if size of {-trade::offer::%{_u}%::*} >= 16:
		return "That's the most for one trade (16)."
	set {_a::*} to {_e} split at ":"
	set {_id} to {_a::2}
	if {_a::1} is "car":
		set {_plate} to {_id}
		if carOwns({_p}, {_plate}) is false:
			return "You don't have that car."
		if {car::out::%{_plate}%} is set:
			return "Send your %carTitle({_plate})% back to the garage first (/garage)."
		if {-car::driver::%{_plate}%} is set:
			return "Send your %carTitle({_plate})% back to the garage first (/garage)."
		return ""
	if {_a::1} is "cos":
		if cosExists({_id}) is false:
			return "No such cosmetic."
		# Only cosmetics from crates (saved per player), never a rank's.
		if {data::%{_p}%::cos::%{_id}%} is not true:
			return "You don't have that (a rank's looks stay with the rank)."
		if {-cfg::cos::%{_id}%::bound} is true:
			return "Earned titles can't be traded."
		if cosOwned({_o}, {_id}) is true:
			return "%name of {_o}% has %cosColored({_id})%&c already."
		return ""
	return "That can't be traded."

function tradeAdd(p: player, e: text):
	set {_why} to tradeAddBlock({_p}, {_e})
	if {_why} is not "":
		msg({_p}, "&c%{_why}%")
		play sound "entity.villager.no" with volume 0.5 to {_p}
		stop
	set {_u} to "%uuid of {_p}%"
	add {_e} to {-trade::offer::%{_u}%::*}
	play sound "entity.item.pickup" with volume 0.5 to {_p}
	tradeChanged({-trade::sid::%{_u}%})

# The icon of an offered (or offerable) thing; mine: the viewer's own offer (click to take it back).
function tradeIcon(owner: player, e: text, mine: boolean) :: item:
	set {_a::*} to {_e} split at ":"
	set {_id} to {_a::2}
	if {_a::1} is "car":
		set {_plate} to {_id}
		set {_i} to carIconOf({_plate})
		set {_name} to "&f%carTitle({_plate})%%carSerialText({_plate})%"
		add carLoreOf({_plate}) to {_l::*}
		set {_need} to carLevelOf(carModelOf({_plate}))
		if {_need} > 0:
			add "&7Drives from level %{_need}%" to {_l::*}
	else:
		set {_type} to {-cfg::cos::%{_id}%::type}
		if {_type} is "title":
			set {_i} to name tag
		else if {_type} is "killfx":
			set {_i} to blaze powder
		else:
			set {_i} to leather
			set string list tag "minecraft:custom_model_data;strings" of nbt of {_i} to "donating:bag_%{_id}%"
		set {_name} to cosColored({_id})
		set {_r} to {-cfg::cos::%{_id}%::rarity}
		set {_tn} to "Bag skin"
		if {_type} is "title":
			set {_tn} to "Title"
		else if {_type} is "killfx":
			set {_tn} to "Kill effect"
		add "&7%{_tn}% · %{-cfg::rarity::%{_r}%::color}%%{-cfg::rarity::%{_r}%::name}%" to {_l::*}
		set {_sl} to cosSerialLore({_owner}, {_id})
		if {_sl} is not "":
			add {_sl} to {_l::*}
	if {_mine} is true:
		add "&eClick: take it back." to {_l::*}
	set name of {_i} to colored {_name}
	set lore of {_i} to colored {_l::*}
	return {_i}

# ---------- The window ----------

function tradeButton(p: player, gui: inventory, slot: number, i: item, act: text):
	set slot {_slot} of {_gui} to {_i}
	set {-trade::act::%uuid of {_p}%::%{_slot}%} to {_act}

function tradeMySlot(n: number) :: number:
	set {_s::*} to 9, 10, 11, 12, 18, 19, 20, 21, 27, 28, 29, 30, 36, 37, 38 and 39
	return {_s::%{_n}%}

function tradeTheirSlot(n: number) :: number:
	set {_s::*} to 14, 15, 16, 17, 23, 24, 25, 26, 32, 33, 34, 35, 41, 42, 43 and 44
	return {_s::%{_n}%}

# Draws p's trade window (made once per trade and changed in place, so it doesn't flicker), and opens it
# when p isn't picking something to add.
function tradeDraw(p: player):
	set {_u} to "%uuid of {_p}%"
	set {_o} to {-trade::with::%{_u}%}
	{_o} is set
	set {_ou} to "%uuid of {_o}%"
	set {_sid} to {-trade::sid::%{_u}%}
	set {_gui} to {-trade::gui::%{_u}%}
	if {_gui} is not set:
		set {_gui} to chest inventory with 6 rows named "&8Trade · %name of {_o}%"
		set {-trade::gui::%{_u}%} to {_gui}
	delete {-trade::act::%{_u}%::*}
	set {_pane} to gray stained glass pane named "&r"
	set {_line} to black stained glass pane named "&r"
	loop 54 times:
		set slot (loop-number - 1) of {_gui} to {_pane}
	loop 4, 13, 22, 31, 40 and 49:
		set slot loop-value of {_gui} to {_line}
	set slot 1 of {_gui} to lime dye named "&aYou give" with lore "&7Click one of yours to take it back."
	set slot 7 of {_gui} to orange dye named "&6%name of {_o}% gives"
	set {_n} to 0
	loop {-trade::offer::%{_u}%::*}:
		add 1 to {_n}
		tradeButton({_p}, {_gui}, tradeMySlot({_n}), tradeIcon({_p}, loop-value, true), "take:%loop-index%")
	set {_n} to 0
	loop {-trade::offer::%{_ou}%::*}:
		add 1 to {_n}
		set slot tradeTheirSlot({_n}) of {_gui} to tradeIcon({_o}, loop-value, false)
	tradeButton({_p}, {_gui}, 45, minecart named "&eAdd a car" with lore "&7From your garage (not out)." and "&7They must be able to own it." , "add:car")
	tradeButton({_p}, {_gui}, 46, name tag named "&eAdd a cosmetic" with lore "&7Titles, bag skins, kill effects" and "&7from crates.", "add:cos")
	if {-trade::ready::%{_u}%} is true:
		tradeButton({_p}, {_gui}, 48, lime concrete named "&aYou're ready" with lore "&7Click to change your mind.", "ready")
	else:
		tradeButton({_p}, {_gui}, 48, red concrete named "&cNot ready" with lore "&7Click when you're happy with both sides." and "&7Any change makes you both not ready.", "ready")
	if {-trade::ready::%{_ou}%} is true:
		set slot 50 of {_gui} to lime concrete named "&a%name of {_o}% is ready"
	else:
		set slot 50 of {_gui} to red concrete named "&c%name of {_o}% isn't ready"
	set {_c} to {-trade::count::%{_sid}%}
	if {_c} is set:
		set slot 49 of {_gui} to clock named "&eTrading in %{_c}%..." with lore "&7Anything changing stops it."
	tradeButton({_p}, {_gui}, 53, barrier named "&cCancel the trade", "cancel")
	if {-trade::view::%{_u}%} is "main":
		if {_p}'s current inventory is not {_gui}:
			open {_gui} to {_p}

# The list of what p can add (cars or cosmetics), with why not for the rest.
function tradePick(p: player, kind: text):
	set {_u} to "%uuid of {_p}%"
	set {_o} to {-trade::with::%{_u}%}
	{_o} is set
	delete {-trade::pact::%{_u}%::*}
	if {_kind} is "car":
		set {_gui} to chest inventory with 6 rows named "&8Add a car"
	else:
		set {_gui} to chest inventory with 6 rows named "&8Add a cosmetic"
	set {-trade::pgui::%{_u}%} to {_gui}
	set {-trade::view::%{_u}%} to "pick"
	set {_slot} to 0
	if {_kind} is "car":
		loop carsOf({_p}):
			add "car:%loop-value%" to {_list::*}
	else:
		loop {-cfg::cosmetics::*}:
			if {data::%{_p}%::cos::%loop-value%} is true:
				if {-cfg::cos::%loop-value%::bound} is not true:
					add "cos:%loop-value%" to {_list::*}
	loop {_list::*}:
		{_slot} < 45
		if {-trade::offer::%{_u}%::*} does not contain loop-value:
			set {_i} to tradeIcon({_p}, loop-value, false)
			set {_why} to tradeAddBlock({_p}, loop-value)
			set {_l::*} to lore of {_i}
			if {_why} is "":
				add "&eClick: add it." to {_l::*}
				set lore of {_i} to colored {_l::*}
				set slot {_slot} of {_gui} to {_i}
				set {-trade::pact::%{_u}%::%{_slot}%} to "pick:%loop-value%"
			else:
				add "&c%{_why}%" to {_l::*}
				set lore of {_i} to colored {_l::*}
				set slot {_slot} of {_gui} to {_i}
			add 1 to {_slot}
			delete {_l::*}
	if {_slot} is 0:
		if {_kind} is "car":
			set slot 22 of {_gui} to paper named "&7No cars to trade" with lore "&7Buy one at the Car Dealer, or win" and "&7a crate car."
		else:
			set slot 22 of {_gui} to paper named "&7No crate cosmetics to trade" with lore "&7They come from crates: &f/crates"
	set {_pane} to gray stained glass pane named "&r"
	loop integers from 45 to 53:
		set slot loop-value of {_gui} to {_pane}
	# The standard Back button (phone.sk). Going back switches windows without ending the trade (the close
	# handler below lets a switch between the trade and this list through).
	set slot 45 of {_gui} to backItem("the trade")
	set {-trade::pact::%{_u}%::45} to "back"
	open {_gui} to {_p}

# ---------- Clicks ----------

on inventory click:
	set {_u} to "%uuid of player%"
	{-trade::sid::%{_u}%} is set
	set {_which} to ""
	if player's current inventory is {-trade::gui::%{_u}%}:
		set {_which} to "main"
	else if player's current inventory is {-trade::pgui::%{_u}%}:
		set {_which} to "pick"
	{_which} is not ""
	cancel event
	event-inventory is player's current inventory
	if {_which} is "main":
		set {_act} to {-trade::act::%{_u}%::%index of event-slot%}
	else:
		set {_act} to {-trade::pact::%{_u}%::%index of event-slot%}
	{_act} is set
	set {_ok} to false
	if click type is left mouse button:
		set {_ok} to true
	else if click type is right mouse button:
		set {_ok} to true
	{_ok} is true
	# One action per click, a tick later (as the shops).
	set {_gen} to {-trade::gen::%{_u}%}
	if {_gen} is not set:
		set {_gen} to 0
		set {-trade::gen::%{_u}%} to 0
	wait 1 tick
	player is online
	{-trade::gen::%{_u}%} is {_gen}
	add 1 to {-trade::gen::%{_u}%}
	{-trade::sid::%{_u}%} is set
	tradeAction(player, {_act})

on inventory drag:
	set {_u} to "%uuid of player%"
	{-trade::sid::%{_u}%} is set
	if player's current inventory is {-trade::gui::%{_u}%}:
		cancel event
	else if player's current inventory is {-trade::pgui::%{_u}%}:
		cancel event

# Closing the window ends the trade; switching between the trade and a list of things to add doesn't.
on inventory close:
	set {_u} to "%uuid of player%"
	set {_sid} to {-trade::sid::%{_u}%}
	{_sid} is set
	# The trade window itself was closed: no redraw may open it again before the check below (review fix).
	if event-inventory is {-trade::gui::%{_u}%}:
		if {-trade::view::%{_u}%} is "main":
			set {-trade::view::%{_u}%} to "closed"
	wait 1 tick
	player is online
	{-trade::sid::%{_u}%} is {_sid}
	if player's current inventory is {-trade::gui::%{_u}%}:
		stop
	if player's current inventory is {-trade::pgui::%{_u}%}:
		stop
	tradeEnd({_sid}, "%name of player% closed it")

function tradeAction(p: player, act: text):
	set {_u} to "%uuid of {_p}%"
	set {_sid} to {-trade::sid::%{_u}%}
	if {_act} is "cancel":
		tradeEnd({_sid}, "%name of {_p}% cancelled it")
	else if {_act} is "add:car":
		tradePick({_p}, "car")
	else if {_act} is "add:cos":
		tradePick({_p}, "cos")
	else if {_act} is "back":
		set {-trade::view::%{_u}%} to "main"
		tradeDraw({_p})
	else if {_act} starts with "pick:":
		set {-trade::view::%{_u}%} to "main"
		tradeAdd({_p}, subtext of {_act} from characters 6 to (length of {_act}))
		tradeDraw({_p})
	else if {_act} starts with "take:":
		set {_i} to subtext of {_act} from characters 6 to (length of {_act})
		if {-trade::offer::%{_u}%::%{_i}%} is set:
			delete {-trade::offer::%{_u}%::%{_i}%}
			tradeChanged({_sid})
	else if {_act} is "ready":
		tradeReady({_p})

function tradeReady(p: player):
	set {_u} to "%uuid of {_p}%"
	set {_sid} to {-trade::sid::%{_u}%}
	set {_o} to {-trade::with::%{_u}%}
	set {_ou} to "%uuid of {_o}%"
	if {-trade::ready::%{_u}%} is true:
		# Not ready any more: stops a countdown too.
		tradeChanged({_sid})
		stop
	if size of {-trade::offer::%{_u}%::*} is 0:
		if size of {-trade::offer::%{_ou}%::*} is 0:
			msg({_p}, "&7Add something first.")
			stop
	# A click aimed at the offer as it was a moment ago doesn't agree to a new one (review fix).
	set {_ch} to {-trade::changedat::%{_sid}%}
	if {_ch} is set:
		if difference between {_ch} and now < 1 second:
			msg({_p}, "&7The offer just changed: check it, then press Ready.")
			tradeDraw({_p})
			stop
	set {_why} to tradeCheck({_sid})
	if {_why} is not "":
		msg({_p}, "&cThis trade can't go through: %{_why}%.")
		play sound "entity.villager.no" with volume 0.5 to {_p}
		tradeDraw({_p})
		stop
	set {-trade::ready::%{_u}%} to true
	play sound "block.note_block.hat" with volume 0.6 to {_p}
	if {-trade::ready::%{_ou}%} is true:
		tradeCountdown({_sid}, {-trade::ver::%{_sid}%})
		stop
	tradeDraw({_p})
	tradeDraw({_o})

# True while the trade is still on exactly as both agreed to it.
function tradeStillOn(sid: number, ver: number) :: boolean:
	set {_a} to {-trade::a::%{_sid}%}
	set {_b} to {-trade::b::%{_sid}%}
	if {_a} is set:
		if {_b} is set:
			if {-trade::ver::%{_sid}%} is {_ver}:
				if {-trade::ready::%uuid of {_a}%} is true:
					if {-trade::ready::%uuid of {_b}%} is true:
						return true
	return false

function tradeCountdown(sid: number, ver: number):
	set {_n} to cfg("trade::countdown")
	loop {_n} times:
		if tradeStillOn({_sid}, {_ver}) is false:
			stop
		set {-trade::count::%{_sid}%} to {_n} - loop-number + 1
		tradeDraw({-trade::a::%{_sid}%})
		tradeDraw({-trade::b::%{_sid}%})
		play sound "block.note_block.hat" with volume 0.4 and pitch 1.6 to {-trade::a::%{_sid}%}
		play sound "block.note_block.hat" with volume 0.4 and pitch 1.6 to {-trade::b::%{_sid}%}
		wait 1 second
	if tradeStillOn({_sid}, {_ver}) is true:
		tradeDo({_sid})

# ---------- The swap (one call, no wait) ----------

# "" when g can still give e to r in this trade, else why not.
function tradeGiveBlock(g: player, r: player, e: text) :: text:
	set {_a::*} to {_e} split at ":"
	set {_id} to {_a::2}
	if {_a::1} is "car":
		set {_plate} to {_id}
		if carOwns({_g}, {_plate}) is false:
			return "%name of {_g}% doesn't have that car any more"
		if carAlive({_plate}) is false:
			return "%name of {_g}%'s %carTitle({_plate})% isn't ready (tell staff)"
		if {car::out::%{_plate}%} is set:
			return "%name of {_g}%'s %carTitle({_plate})% is out of the garage"
		if {-car::driver::%{_plate}%} is set:
			return "%name of {_g}%'s %carTitle({_plate})% is out of the garage"
		return ""
	if {_a::1} is "cos":
		if {-cfg::cos::%{_id}%::bound} is true:
			return "earned titles can't be traded"
		if {data::%{_g}%::cos::%{_id}%} is not true:
			return "%name of {_g}% doesn't have %cosColored({_id})% &7any more"
		if cosOwned({_r}, {_id}) is true:
			return "%name of {_r}% has %cosColored({_id})% &7already"
		return ""
	return "something can't be traded"

# "" when the trade as it stands could go through now, else why not.
function tradeCheck(sid: number) :: text:
	set {_a} to {-trade::a::%{_sid}%}
	set {_b} to {-trade::b::%{_sid}%}
	set {_why} to tradeBlock({_a}, {_b}, true)
	if {_why} is "":
		loop {-trade::offer::%uuid of {_a}%::*}:
			if {_why} is "":
				set {_why} to tradeGiveBlock({_a}, {_b}, loop-value)
		loop {-trade::offer::%uuid of {_b}%::*}:
			if {_why} is "":
				set {_why} to tradeGiveBlock({_b}, {_a}, loop-value)
	if {_why} is "":
		set {_why} to tradeRoomBlock({_a}, {_b})
	if {_why} is "":
		set {_why} to tradeRoomBlock({_b}, {_a})
	return {_why}

# "" when r's garage has room for the cars g gives (after the ones r gives away), else why not.
function tradeRoomBlock(r: player, g: player) :: text:
	set {_in} to 0
	loop {-trade::offer::%uuid of {_g}%::*}:
		if loop-value starts with "car:":
			add 1 to {_in}
	set {_out} to 0
	loop {-trade::offer::%uuid of {_r}%::*}:
		if loop-value starts with "car:":
			add 1 to {_out}
	# Only a garage that gains cars can overflow (one already over the most after a settings change can still trade).
	if {_in} <= {_out}:
		return ""
	set {_max} to cfg("car::garage-max")
	if carCount({_r}) - {_out} + {_in} > {_max}:
		return "%name of {_r}%'s garage would be over %{_max}% cars"
	return ""

function tradeDo(sid: number):
	set {_a} to {-trade::a::%{_sid}%}
	set {_b} to {-trade::b::%{_sid}%}
	set {_ua} to "%uuid of {_a}%"
	set {_ub} to "%uuid of {_b}%"
	# Cars MTVehicles lost are made again first (same model and color; the new plate is traded). A remake
	# that fails leaves a plate MTVehicles doesn't know, and the checks below refuse it (carAlive).
	loop {-trade::offer::%{_ua}%::*}:
		if loop-value starts with "car:":
			set {_old} to subtext of loop-value from characters 5 to (length of loop-value)
			set {_new} to carEnsure({_a}, {_old})
			if {_new} is not "":
				if {_new} is not {_old}:
					set {-trade::offer::%{_ua}%::%loop-index%} to "car:%{_new}%"
	loop {-trade::offer::%{_ub}%::*}:
		if loop-value starts with "car:":
			set {_old} to subtext of loop-value from characters 5 to (length of loop-value)
			set {_new} to carEnsure({_b}, {_old})
			if {_new} is not "":
				if {_new} is not {_old}:
					set {-trade::offer::%{_ub}%::%loop-index%} to "car:%{_new}%"
	# Still next to each other, out of combat and heists, and every entry still receivable.
	set {_why} to tradeCheck({_sid})
	if {_why} is not "":
		msg({_a}, "&cThe trade didn't go through: %{_why}%.")
		msg({_b}, "&cThe trade didn't go through: %{_why}%.")
		tradeLog("refused sid=%{_sid}% %{_a}% %{_b}% why=%{_why}%")
		tradeChanged({_sid})
		stop
	# Take everything from both givers first (a swap of the same car model), then give.
	loop {-trade::offer::%{_ua}%::*}:
		set {_e} to loop-value
		add "%{_ua}%|%{_ub}%|%{_e}%|%tradeTake({_a}, {_e})%" to {_moves::*}
	loop {-trade::offer::%{_ub}%::*}:
		set {_e} to loop-value
		add "%{_ub}%|%{_ua}%|%{_e}%|%tradeTake({_b}, {_e})%" to {_moves::*}
	loop {_moves::*}:
		set {_m::*} to loop-value split at "|"
		if {_m::1} is {_ua}:
			tradeGive({_b}, {_m::3}, {_m::4})
			add tradeEntryName({_m::3}, {_m::4}) to {_gotb::*}
		else:
			tradeGive({_a}, {_m::3}, {_m::4})
			add tradeEntryName({_m::3}, {_m::4}) to {_gota::*}
	set {_ga} to join {_gota::*} with "&7, "
	set {_gb} to join {_gotb::*} with "&7, "
	if {_ga} is "":
		set {_ga} to "&7nothing"
	if {_gb} is "":
		set {_gb} to "&7nothing"
	set {_la} to join {-trade::offer::%{_ua}%::*} with ","
	set {_lb} to join {-trade::offer::%{_ub}%::*} with ","
	set {_mv} to join {_moves::*} with " ; "
	tradeLog("trade sid=%{_sid}% %{_a}% %{_ua}% gave=[%{_la}%] %{_b}% %{_ub}% gave=[%{_lb}%] moves=%{_mv}%")
	tradeEnd({_sid}, "done")
	msg({_a}, "&aTrade done. &7You got: %{_ga}%&7.")
	msg({_b}, "&aTrade done. &7You got: %{_gb}%&7.")
	send title colored "&a&lTRADE DONE" with subtitle colored "&7with &f%name of {_b}%" to {_a} for 2 seconds
	send title colored "&a&lTRADE DONE" with subtitle colored "&7with &f%name of {_a}%" to {_b} for 2 seconds
	play sound "entity.player.levelup" with volume 0.6 to {_a}
	play sound "entity.player.levelup" with volume 0.6 to {_b}

# Takes an entry from its giver; returns what the receiver needs ("plate=model" for a car, the serial for a cosmetic).
function tradeTake(g: player, e: text) :: text:
	set {_a::*} to {_e} split at ":"
	set {_id} to {_a::2}
	if {_a::1} is "car":
		# Everything the car is (wrap, mods, serial number, crate count) stays with its plate (garage.sk).
		set {_plate} to {_id}
		set {_m} to carModelOf({_plate})
		delete {data::%{_g}%::cars::%{_plate}%}
		carLog("trade-out %{_g}% %uuid of {_g}% %{_m}% %{_plate}% %carTitle({_plate})% vin=%carVin({_plate})% grade=%carGrade({_plate})%")
		return "%{_plate}%=%{_m}%"
	# The copy's serial goes with it (cosmetics.sk; numbered now if it never was).
	set {_sn} to cosSerial({_g}, {_id})
	delete {data::%{_g}%::cos::%{_id}%}
	delete {data::%{_g}%::cosserial::%{_id}%}
	# Not worn any more (titles and kill effects by id; the bag's look follows what's owned).
	if getData({_g}, "title") is {_id}:
		deleteData({_g}, "title")
		set {-ph::title::%{_g}%} to titleText({_g})
	if getData({_g}, "killfx") is {_id}:
		deleteData({_g}, "killfx")
	if getData({_g}, "bag-skin") is {_id}:
		deleteData({_g}, "bag-skin")
	bagRefresh({_g})
	cosLog("trade-out %{_g}% %uuid of {_g}% %{_id}% serial=%{_sn}%")
	if {_sn} > 0:
		return "%{_sn}%"
	return ""

function tradeGive(r: player, e: text, what: text):
	set {_a::*} to {_e} split at ":"
	set {_id} to {_a::2}
	if {_a::1} is "car":
		set {_w::*} to {_what} split at "="
		set {_plate} to {_w::1}
		set {data::%{_r}%::cars::%{_plate}%} to {_w::2}
		set {car::owner::%{_plate}%} to "%uuid of {_r}%"
		set {car::lock::%{_plate}%} to true
		delete {-car::members::%{_plate}%::*}
		set {_car} to mtv vehicle with license plate {_plate}
		if {_car} is set:
			set vehicle owner of {_car} to {_r}
		carLog("trade-in %{_r}% %uuid of {_r}% %{_w::2}% %{_plate}% %carTitle({_plate})% vin=%carVin({_plate})%")
		stop
	set {data::%{_r}%::cos::%{_id}%} to true
	set {_sn} to {_what} parsed as integer
	if {_sn} is set:
		set {data::%{_r}%::cosserial::%{_id}%} to {_sn}
	cosLog("trade-in %{_r}% %uuid of {_r}% %{_id}% serial=%{_what}%")

function tradeEntryName(e: text, what: text) :: text:
	set {_a::*} to {_e} split at ":"
	set {_id} to {_a::2}
	if {_a::1} is "car":
		set {_w::*} to {_what} split at "="
		return "&f%carTitle({_w::1})%%carSerialText({_w::1})%"
	return cosColored({_id})

# ---------- Ending it ----------

every second:
	loop {-trade::a::*}:
		set {_sid} to loop-index parsed as number
		set {_a} to loop-value
		set {_b} to {-trade::b::%{_sid}%}
		if {_a} is not online:
			set {_end::%{_sid}%} to "%name of {_a}% left"
		else if {_b} is not online:
			set {_end::%{_sid}%} to "%name of {_b}% left"
		else if tradeBlock({_a}, {_b}, true) is not "":
			set {_end::%{_sid}%} to "you're not next to each other any more, or one of you is in combat or a heist"
	loop {_end::*}:
		tradeEnd(loop-index parsed as number, loop-value)

on damage of player with priority monitor:
	set {_u} to "%uuid of victim%"
	{-trade::sid::%{_u}%} is set
	tradeEnd({-trade::sid::%{_u}%}, "%name of victim% got hurt")

on death of player:
	isNpc(victim) is false
	set {_u} to "%uuid of victim%"
	{-trade::sid::%{_u}%} is set
	tradeEnd({-trade::sid::%{_u}%}, "%name of victim% died")
