# messages.sk: the phone's Messages app (2026-09-28; CLAUDE.md's ideas: "a phone Messages app"). Reworked 2026-10-19
# (owner: "redo the message system, theres alot of spam when the quest messages get put into the phone messages"): the
# phone keeps only what a contact would really text (story.sk's storyText / storySay / storyKeep call msgPost):
#   - "say": said in person (talking to an NPC, Mara's talk lines, a call, the inmates, the course): the whole line in
#     chat ("Mara: ..."), never kept.
#   - "text" (storyText): said in person while the player stands within messages::near (10) blocks of that contact's
#     quest giver (core.sk msgcontact::<key>::kind); else a text: kept, and chat gets one short notice
#     ("✉ Mara: <first words>… · /messages").
#   - "keep" (a mission's brief or "Skipping ahead", a hit contract's brief: one per start): like "text", but said in
#     person it's also kept, as read (unless an older text from that contact is still unread: then it's new too), so
#     every mission has its text on the phone.
#   - One contact's lines within messages::join-window (1 s) are ONE text (a mission's done line and the next brief;
#     a job's done line and the rep line), a line already in it is left out; the same text from the same contact within
#     messages::dedupe (30 min) isn't kept again (its notice still shows). So the unread count is per text, not per line.
#   - Old inboxes (every line was kept before) are tidied once at a join (msgCompact, data inbox-v 2).
#   - Saved per player: data inbox-n (the newest text's number), inbox::<n>::at (unix), ::from, ::text; only the newest
#     cfg messages::keep (60) are kept. data inbox-seen::<contact> = the newest number read from that contact (a
#     contact's key is its name in lower case without spaces: "mara", "boss").
#   - Messages (the phone's app in its dock, and /messages): one head per contact who texted (their NPC skin, skins.sk),
#     the newest conversation first, "(2 new)", how long ago and the last text. Click: the conversation. ◀ Phone.
#   - A conversation (/messages <contact>): 20 texts a page (page 1 the newest 20; Older / Newer), oldest first within a
#     page, each named by how long ago ("· new" while unread; the status bar is the contact). Opening it reads them.
#     ◀ Messages; "Find <contact>" pins them on
#     the GPS (quests.sk questFind, core.sk msgcontact::<key>::kind) when the map has one.
#   - Deleting (owner, 2026-10-21: "clear a whole conversation or a single message"): in a conversation, slot 3 "Clear
#     chat" (a red bin) and a click on a text arm a delete; a second click on the same button within 5 s deletes (the
#     button shows a red "Delete?" block meanwhile). A deleted text's data goes; its number stays used (the 60 kept
#     counts by number). Logged (messages.log `delete` / `clear`).
# Menu texts (owner, 2026-09-29: "most people can use context clues"): names and state, no lore explaining a click.
# Looking only: every click is cancelled; buttons run a tick later, once per drawn screen (like the other menus).

# ---------- The inbox ----------

function msgKeep() :: number:
	set {_k} to {-cfg::messages::keep}
	if {_k} is not set:
		return 60
	return {_k}

# A contact's key: its name in lower case, without spaces.
function msgKey(from: text) :: text:
	set {_k} to {_from} in lower case
	replace all " " with "" in {_k}
	return {_k}

function msgNewest(p: player) :: number:
	set {_n} to getData({_p}, "inbox-n")
	if {_n} is not set:
		return 0
	return {_n}

# The oldest number still kept.
function msgOldest(p: player) :: number:
	return max(1, msgNewest({_p}) - msgKeep() + 1)

# One text kept in the inbox (msgFlush; the oldest past messages::keep goes). Returns its number.
function msgSave(p: player, from: text, line: text) :: number:
	set {_n} to msgNewest({_p}) + 1
	setData({_p}, "inbox-n", {_n})
	setData({_p}, "inbox::%{_n}%::at", floor(unix timestamp of now))
	setData({_p}, "inbox::%{_n}%::from", {_from})
	setData({_p}, "inbox::%{_n}%::text", {_line})
	set {_old} to {_n} - msgKeep()
	if {_old} >= 1:
		deleteData({_p}, "inbox::%{_old}%::at")
		deleteData({_p}, "inbox::%{_old}%::from")
		deleteData({_p}, "inbox::%{_old}%::text")
	return {_n}

# ---------- Sending (story.sk's storyText, storySay, storyKeep) ----------

# Whether the player stands with the contact (within messages::near blocks of a quest giver of the contact's kind).
function msgInPerson(p: player, key: text) :: boolean:
	if {_p} is not online:
		return false
	set {_kind} to {-cfg::msgcontact::%{_key}%::kind}
	if {_kind} is not set:
		return false
	set {_r} to {-cfg::messages::near}
	if {_r} is not set:
		set {_r} to 10
	set {_w} to "%world of {_p}%"
	loop {quest::giver::*}:
		set {_a::*} to loop-value split at "|"
		if {_a::1} is {_kind}:
			if {_a::2} is {_w}:
				set {_l} to questLoc(loop-index)
				if {_l} is set:
					if distance between (location of {_p}) and {_l} <= {_r}:
						return true
	return false

# A line said in person: the whole line in chat, nothing kept. A recorded line (the inmates': voice.sk) plays instead
# of the ping.
function msgSpeak(p: player, from: text, line: text):
	send colored "&d%{_from}%&7: &f%{_line}%" to {_p}
	if voiceSay({_p}, {_from}, {_line}) is false:
		play sound "block.note_block.bit" with volume 0.7 and pitch 1.6 to {_p}

# A text's first words for its chat notice (messages::preview characters at most).
function msgPreview(t: text) :: text:
	set {_max} to {-cfg::messages::preview}
	if {_max} is not set:
		set {_max} to 60
	if length of {_t} <= {_max}:
		return {_t}
	set {_out} to ""
	set {_full} to false
	loop {_t} split at " ":
		if {_full} is false:
			set {_try} to loop-value
			if {_out} is not "":
				set {_try} to "%{_out}% %loop-value%"
			if length of {_try} > {_max} - 1:
				set {_full} to true
			else:
				set {_out} to {_try}
	if {_out} is "":
		set {_out} to first ({_max} - 1) characters of {_t}
	# A color code cut in half.
	if {_out} ends with "&":
		set {_out} to first (length of {_out} - 1) characters of {_out}
	return "%{_out}%…"

# The one chat line a kept text gets.
function msgNotice(p: player, from: text, t: text):
	send colored "&d✉ %{_from}%: &f%msgPreview({_t})% &7· /messages" to {_p}
	play sound "block.note_block.bit" with volume 0.7 and pitch 1.6 to {_p}

# Whether the contact sent this text within messages::dedupe seconds (it isn't kept again).
function msgRecent(p: player, key: text, t: text) :: boolean:
	set {_win} to {-cfg::messages::dedupe}
	if {_win} is not set:
		set {_win} to 1800
	set {_since} to floor(unix timestamp of now) - {_win}
	set {_last} to msgNewest({_p})
	if {_last} < 1:
		return false
	loop integers from msgOldest({_p}) to {_last}:
		if msgAt({_p}, loop-value) >= {_since}:
			if msgKey(msgFrom({_p}, loop-value)) is {_key}:
				if msgText({_p}, loop-value) is {_t}:
					return true
	return false

# A line from a contact: kind "say" (in person only), "text" (in person: said; else kept, with a notice) or "keep"
# (kept either way: as read when said in person). Kept lines wait messages::join-window so a burst is one text.
function msgPost(p: player, from: text, line: text, kind: text):
	{_line} is not ""
	set {_k} to msgKey({_from})
	if {_kind} is "say":
		msgSpeak({_p}, {_from}, {_line})
		stop
	set {_near} to msgInPerson({_p}, {_k})
	if {_near} is true:
		msgSpeak({_p}, {_from}, {_line})
		if {_kind} is not "keep":
			stop
	set {_u} to "%uuid of {_p}%"
	# A burst whose flush never came (a script reload drops its wait): kept now, this line starts a new one.
	set {_b} to {-msg::bufat::%{_u}%::%{_k}%}
	if {_b} is set:
		if difference between {_b} and now > 5 seconds:
			msgFlush({_p}, {_k})
	loop {-msg::buf::%{_u}%::%{_k}%::*}:
		if loop-value is {_line}:
			stop
	add {_line} to {-msg::buf::%{_u}%::%{_k}%::*}
	set {-msg::buffrom::%{_u}%::%{_k}%} to {_from}
	if {_near} is false:
		set {-msg::bufnew::%{_u}%::%{_k}%} to true
	{-msg::bufat::%{_u}%::%{_k}%} is not set
	set {-msg::bufat::%{_u}%::%{_k}%} to now
	msgFlushLater({_p}, {_k})

function msgFlushLater(p: player, key: text):
	set {_w} to {-cfg::messages::join-window}
	if {_w} is not set:
		set {_w} to 1 second
	wait {_w}
	msgFlush({_p}, {_key})

# The contact's pending lines as one text: kept (unless a repeat), a notice when any line came while away.
function msgFlush(p: player, key: text):
	set {_u} to "%uuid of {_p}%"
	{-msg::bufat::%{_u}%::%{_key}%} is set
	delete {-msg::bufat::%{_u}%::%{_key}%}
	set {_lines::*} to {-msg::buf::%{_u}%::%{_key}%::*}
	set {_from} to {-msg::buffrom::%{_u}%::%{_key}%}
	set {_new} to {-msg::bufnew::%{_u}%::%{_key}%}
	delete {-msg::buf::%{_u}%::%{_key}%::*}
	delete {-msg::buffrom::%{_u}%::%{_key}%}
	delete {-msg::bufnew::%{_u}%::%{_key}%}
	{_from} is set
	size of {_lines::*} > 0
	set {_t} to join {_lines::*} with " "
	if msgRecent({_p}, {_key}, {_t}) is true:
		if {_new} is true:
			msgNotice({_p}, {_from}, {_t})
		stop
	set {_n} to msgSave({_p}, {_from}, {_t})
	if {_new} is true:
		msgNotice({_p}, {_from}, {_t})
	else:
		# Said in person (a brief): kept, already read, but only when nothing older from that contact is unread
		# (inbox-seen is a high-water mark: moving it would mark those read too; then the brief shows new with them).
		if msgUnread({_p}, {_key}) is 1:
			setData({_p}, "inbox-seen::%{_key}%", {_n})

# Every pending text out now (quitting; tests).
function msgFlushAll(p: player):
	set {_u} to "%uuid of {_p}%"
	loop {-msg::bufat::%{_u}%::*}:
		add loop-index to {_keys::*}
	loop {_keys::*}:
		msgFlush({_p}, loop-value)

# ---------- Old inboxes (before 2026-10-19 every line was kept) ----------

# Once per player (data inbox-v 2): lines that were only ever said in person go (Mara's talk lines, "N for you. Check
# /jobs.", the inmates' own lines: Lefty keeps his missions' texts), one contact's texts within 5 s of each other become
# one text, and a text the same contact sent within messages::dedupe before is dropped. What was read stays read.
function msgCompact(p: player):
	set {_v} to getData({_p}, "inbox-v")
	if {_v} is set:
		if {_v} >= 2:
			stop
	setData({_p}, "inbox-v", 2)
	set {_last} to msgNewest({_p})
	if {_last} < 1:
		stop
	set {_win} to {-cfg::messages::dedupe}
	if {_win} is not set:
		set {_win} to 1800
	# What was said in person, and what a mission texts.
	loop {-cfg::story::chains::*}:
		loop storyList(loop-value):
			set {_id} to loop-value-2
			loop {-cfg::story::%{_id}%::talk::*}:
				set {_said::%loop-value-3%} to true
			loop "brief", "brief-escaped" and "done":
				set {_x} to {-cfg::story::%{_id}%::%loop-value-3%}
				if {_x} is set:
					set {_mission::%{_x}%} to true
	set {_m} to 0
	loop integers from msgOldest({_p}) to {_last}:
		set {_i} to loop-value
		set {_f} to msgFrom({_p}, {_i})
		set {_t} to msgText({_p}, {_i})
		set {_ok} to true
		if {_f} is "":
			set {_ok} to false
		else if {_t} is "":
			set {_ok} to false
		else if {_said::%{_t}%} is true:
			set {_ok} to false
		else if {_t} ends with "for you. Check /jobs.":
			set {_ok} to false
		set {_k} to msgKey({_f})
		if {_ok} is true:
			if {_k} is "lefty", "rusty", "tank" or "whisper":
				if {_mission::%{_t}%} is not true:
					set {_ok} to false
		if {_ok} is true:
			set {_at} to msgAt({_p}, {_i})
			set {_read} to false
			if {_i} <= msgSeen({_p}, {_k}):
				set {_read} to true
			set {_merged} to false
			if {_m} > 0:
				if {_ck::%{_m}%} is {_k}:
					if {_at} - {_cat::%{_m}%} <= 5:
						set {_merged} to true
						set {_prev} to {_ct::%{_m}%}
						if {_prev} does not contain {_t}:
							set {_ct::%{_m}%} to "%{_prev}% %{_t}%"
						set {_cat::%{_m}%} to {_at}
						if {_read} is false:
							set {_cread::%{_m}%} to false
			if {_merged} is false:
				set {_dup} to false
				loop {_m} times:
					set {_j} to loop-value-2
					if {_ck::%{_j}%} is {_k}:
						if {_ct::%{_j}%} is {_t}:
							if {_at} - {_cat::%{_j}%} <= {_win}:
								set {_dup} to true
				if {_dup} is false:
					add 1 to {_m}
					set {_ck::%{_m}%} to {_k}
					set {_cf::%{_m}%} to {_f}
					set {_ct::%{_m}%} to {_t}
					set {_cat::%{_m}%} to {_at}
					set {_cread::%{_m}%} to {_read}
	delete {data::%{_p}%::inbox::*}
	delete {data::%{_p}%::inbox-seen::*}
	setData({_p}, "inbox-n", {_m})
	loop {_m} times:
		set {_j} to loop-number
		setData({_p}, "inbox::%{_j}%::at", {_cat::%{_j}%})
		setData({_p}, "inbox::%{_j}%::from", {_cf::%{_j}%})
		setData({_p}, "inbox::%{_j}%::text", {_ct::%{_j}%})
		# A contact's texts are read up to the first unread one.
		set {_kk} to {_ck::%{_j}%}
		if {_unread::%{_kk}%} is not set:
			if {_cread::%{_j}%} is true:
				setData({_p}, "inbox-seen::%{_kk}%", {_j})
			else:
				set {_unread::%{_kk}%} to true
	msgLog("compact %{_p}% %uuid of {_p}% %{_last}% -> %{_m}%")

function msgLog(line: text):
	log {_line} to "messages"

# One text's parts (keys built in a local first: a quoted text with its own %...% can't sit inside %...%).
function msgAt(p: player, n: number) :: number:
	set {_k} to "inbox::%{_n}%::at"
	set {_v} to getData({_p}, {_k})
	if {_v} is not set:
		return 0
	return {_v}

function msgFrom(p: player, n: number) :: text:
	set {_k} to "inbox::%{_n}%::from"
	set {_v} to getData({_p}, {_k})
	if {_v} is not set:
		return ""
	return "%{_v}%"

function msgText(p: player, n: number) :: text:
	set {_k} to "inbox::%{_n}%::text"
	set {_v} to getData({_p}, {_k})
	if {_v} is not set:
		return ""
	return "%{_v}%"

function msgSeen(p: player, key: text) :: number:
	set {_s} to getData({_p}, "inbox-seen::%{_key}%")
	if {_s} is not set:
		return 0
	return {_s}

# Unread texts from one contact.
function msgUnread(p: player, key: text) :: number:
	set {_seen} to msgSeen({_p}, {_key})
	set {_c} to 0
	loop integers from msgOldest({_p}) to msgNewest({_p}):
		if loop-value > {_seen}:
			set {_f} to getData({_p}, "inbox::%loop-value%::from")
			if {_f} is set:
				if msgKey("%{_f}%") is {_key}:
					add 1 to {_c}
	return {_c}

function msgUnreadAll(p: player) :: number:
	set {_c} to 0
	loop msgContacts({_p}):
		add msgUnread({_p}, msgKey(loop-value)) to {_c}
	return {_c}

# The contacts who texted (their names as they sign), the newest conversation first.
function msgContacts(p: player) :: texts:
	set {_first} to msgOldest({_p})
	set {_last} to msgNewest({_p})
	{_last} >= 1
	loop integers from {_first} to {_last}:
		set {_f} to getData({_p}, "inbox::%loop-value%::from")
		if {_f} is set:
			set {_k} to msgKey("%{_f}%")
			set {_name::%{_k}%} to "%{_f}%"
			set {_at::%{_k}%} to loop-value
	loop {_at::*}:
		set {_v} to loop-value
		set {_pad} to "%100000000 - {_v}%"
		add "%{_pad}%|%loop-index%" to {_keys::*}
	loop sorted {_keys::*}:
		set {_a::*} to loop-value split at "|"
		add {_name::%{_a::2}%} to {_out::*}
	return {_out::*}

# The newest text's number from one contact (0 = none).
function msgLastOf(p: player, key: text) :: number:
	set {_i} to 0
	loop integers from msgOldest({_p}) to msgNewest({_p}):
		set {_f} to getData({_p}, "inbox::%loop-value%::from")
		if {_f} is set:
			if msgKey("%{_f}%") is {_key}:
				set {_i} to loop-value
	return {_i}

# "just now", "12m ago", "3h ago", "2d ago".
function msgAgo(at: number) :: text:
	set {_s} to floor(unix timestamp of now) - {_at}
	if {_s} < 60:
		return "just now"
	if {_s} < 3600:
		return "%floor({_s} / 60)%m ago"
	if {_s} < 86400:
		return "%floor({_s} / 3600)%h ago"
	return "%floor({_s} / 86400)%d ago"

# A text as lore lines of about w characters.
function msgWrap(t: text, w: number) :: texts:
	return msgWrapIn({_t}, {_w}, "&f")

# The same in another color (story.sk's mission cards: "&7").
function msgWrapIn(t: text, w: number, col: text) :: texts:
	set {_line} to ""
	loop {_t} split at " ":
		if {_line} is "":
			set {_line} to loop-value
		else:
			set {_try} to "%{_line}% %loop-value%"
			if length of {_try} > {_w}:
				add "%{_col}%%{_line}%" to {_out::*}
				set {_line} to loop-value
			else:
				set {_line} to {_try}
	if {_line} is not "":
		add "%{_col}%%{_line}%" to {_out::*}
	return {_out::*}

# A contact's icon: a head with their NPC skin (skins.sk), else a paper.
function msgIcon(key: text) :: item:
	set {_id} to {-cfg::msgcontact::%{_key}%::skin}
	if {_id} is set:
		set {_t} to skinTexture({_id})
		set {_s} to skinSignature({_id})
		if {_t} is not "":
			if {_s} is not "":
				return player head with nbt from "{""minecraft:profile"":{properties:[{name:""textures"",value:""%{_t}%"",signature:""%{_s}%""}]}}"
	return paper

# ---------- Menus ----------

function msgClear(p: player):
	delete {-msg::gui::%{_p}%}
	delete {-msg::act::%{_p}%::*}

# ---------- Deleting ----------

# One text gone (its number stays used).
function msgDelete(p: player, n: number):
	deleteData({_p}, "inbox::%{_n}%::at")
	deleteData({_p}, "inbox::%{_n}%::from")
	deleteData({_p}, "inbox::%{_n}%::text")

# Every text from one contact; returns how many went.
function msgDeleteAll(p: player, key: text) :: number:
	set {_c} to 0
	loop integers from msgOldest({_p}) to msgNewest({_p}):
		set {_f} to getData({_p}, "inbox::%loop-value%::from")
		if {_f} is set:
			if msgKey("%{_f}%") is {_key}:
				add loop-value to {_ids::*}
	loop {_ids::*}:
		msgDelete({_p}, loop-value)
		add 1 to {_c}
	deleteData({_p}, "inbox-seen::%{_key}%")
	return {_c}

# A delete waits for a second click on the same button within 5 s (the key: "del:<n>" or "clear:<contact>").
function msgArmed(p: player, key: text) :: boolean:
	if {-msg::arm::%{_p}%} is {_key}:
		if difference between {-msg::armat::%{_p}%} and now < 5 seconds:
			return true
	return false

function msgArm(p: player, key: text):
	set {-msg::arm::%{_p}%} to {_key}
	set {-msg::armat::%{_p}%} to now
	msgArmExpire({_p}, {_key}, "%{-msg::screen::%{_p}%}%")

# The armed button turns back after the window (a function of its own: Skript runs on past a called function's wait).
function msgArmExpire(p: player, key: text, screen: text):
	wait 5.1 seconds
	{_p} is online
	{-msg::arm::%{_p}%} is {_key}
	delete {-msg::arm::%{_p}%}
	{-msg::gui::%{_p}%} is set
	{-msg::screen::%{_p}%} is {_screen}
	msgRedraw({_p})

function msgRedraw(p: player):
	set {_s::*} to "%{-msg::screen::%{_p}%}%" split at ":"
	if {_s::1} is "thread":
		msgThreadPage({_p}, {_s::2}, ({_s::3} parsed as number))
	else:
		msgMenu({_p})

function msgDeleteIcon(what: text) :: item:
	return red concrete named "&c&lDelete?" with lore "&7%{_what}%" and "&eClick again to delete"

function msgButton(p: player, gui: inventory, slot: number, i: item, act: text):
	set slot {_slot} of {_gui} to {_i}
	set {-msg::act::%{_p}%::%{_slot}%} to {_act}

# Phone pages (ui.sk, 2026-09-29): the list is one head per contact on the screen (newest conversation first); a
# conversation shows 20 texts a page, page 1 the newest 20, oldest first within a page (Older / Newer at 5 and 6), so
# every kept text (messages::keep) can be read.
function msgMenu(p: player):
	set {_gui} to phonePage("Messages")
	msgClear({_p})
	set {-msg::gui::%{_p}%} to {_gui}
	set {-msg::screen::%{_p}%} to "list"
	msgButton({_p}, {_gui}, 2, phoneBackIcon("Phone"), "phone")
	set {_slots::*} to phoneSlots()
	set {_k2} to 0
	loop msgContacts({_p}):
		if {_k2} < 20:
			add 1 to {_k2}
			set {_from} to loop-value
			set {_k} to msgKey({_from})
			set {_new} to msgUnread({_p}, {_k})
			set {_i} to msgIcon({_k})
			set {_n} to msgLastOf({_p}, {_k})
			delete {_l::*}
			add "&7%msgAgo(msgAt({_p}, {_n}))%" to {_l::*}
			set {_w::*} to msgWrap(msgText({_p}, {_n}), 34)
			loop {_w::*}:
				if size of {_l::*} < 5:
					add loop-value-2 to {_l::*}
			if {_new} > 0:
				set {_i} to {_i} named "&d%{_from}% &a(%{_new}% new)" with lore {_l::*}
				set {_i} to glint({_i})
			else:
				set {_i} to {_i} named "&d%{_from}%" with lore {_l::*}
			msgButton({_p}, {_gui}, {_slots::%{_k2}%}, {_i}, "thread:%{_k}%")
	if {_k2} is 0:
		set slot 22 of {_gui} to phoneEmptyIcon("No messages yet")
	msgButton({_p}, {_gui}, 49, phoneHomeIcon(), "phone")
	open {_gui} to {_p}

function msgThread(p: player, key: text):
	msgThreadPage({_p}, {_key}, 1)

function msgThreadPage(p: player, key: text, page: number):
	set {_last} to msgLastOf({_p}, {_key})
	if {_last} is 0:
		msgMenu({_p})
		stop
	set {_from} to msgFrom({_p}, {_last})
	set {_seen} to msgSeen({_p}, {_key})
	# Its texts, oldest first.
	loop integers from msgOldest({_p}) to msgNewest({_p}):
		set {_f} to getData({_p}, "inbox::%loop-value%::from")
		if {_f} is set:
			if msgKey("%{_f}%") is {_key}:
				add loop-value to {_ids::*}
	set {_n} to size of {_ids::*}
	set {_pages} to max(1, ceil({_n} / 20))
	if {_page} > {_pages}:
		set {_page} to {_pages}
	if {_page} < 1:
		set {_page} to 1
	# Page k holds texts n - 20k + 1 .. n - 20(k - 1) of the list.
	set {_end} to {_n} - 20 * ({_page} - 1)
	set {_start} to max(1, {_end} - 19)
	set {_gui} to phonePage("%{_from}%")
	msgClear({_p})
	set {-msg::gui::%{_p}%} to {_gui}
	set {-msg::screen::%{_p}%} to "thread:%{_key}%:%{_page}%"
	msgButton({_p}, {_gui}, 2, phoneBackIcon("Messages"), "list")
	if msgArmed({_p}, "clear:%{_key}%") is true:
		msgButton({_p}, {_gui}, 3, msgDeleteIcon("All %{_n}% text(s) from %{_from}%"), "clear:%{_key}%")
	else:
		msgButton({_p}, {_gui}, 3, appIcon("trash", "&cClear chat"), "clear:%{_key}%")
	set {_kind} to {-cfg::msgcontact::%{_key}%::kind}
	if {_kind} is set:
		# Only when the map has one (a contact placed after launch: no dead-end button).
		if questNearest({_p}, {_kind}) is not "":
			msgButton({_p}, {_gui}, 4, compass named "&eFind %{_from}%", "find:%{_kind}%")
		else:
			set slot 4 of {_gui} to compass named "&7%{_from}% isn't in town yet"
	if {_page} < {_pages}:
		set {_i} to appIcon("prev", "&fOlder")
		set lore of {_i} to "&7Page %{_page} + 1%/%{_pages}%"
		msgButton({_p}, {_gui}, 5, {_i}, "page:%{_key}%:%{_page} + 1%")
	if {_page} > 1:
		set {_i} to appIcon("next", "&fNewer")
		set lore of {_i} to "&7Page %{_page} - 1%/%{_pages}%"
		msgButton({_p}, {_gui}, 6, {_i}, "page:%{_key}%:%{_page} - 1%")
	set {_slots::*} to phoneSlots()
	set {_s} to 0
	loop integers from {_start} to {_end}:
		add 1 to {_s}
		set {_n2} to {_ids::%loop-value%}
		delete {_l::*}
		add msgWrap(msgText({_p}, {_n2}), 34) to {_l::*}
		set {_ago} to msgAgo(msgAt({_p}, {_n2}))
		add "&7Click twice: delete" to {_l::*}
		if msgArmed({_p}, "del:%{_n2}%") is true:
			set {_i} to msgDeleteIcon("This text (%{_ago}%)")
		else if {_n2} > {_seen}:
			set {_i} to paper named "&7%{_ago}% &a· new" with lore {_l::*}
			set {_i} to glint({_i})
		else:
			set {_i} to paper named "&7%{_ago}%" with lore {_l::*}
		msgButton({_p}, {_gui}, {_slots::%{_s}%}, {_i}, "del:%{_n2}%:%{_key}%")
	msgButton({_p}, {_gui}, 49, phoneHomeIcon(), "phone")
	# Read now.
	setData({_p}, "inbox-seen::%{_key}%", {_last})
	open {_gui} to {_p}

function msgAction(p: player, act: text):
	if {_act} starts with "thread:":
		msgThread({_p}, subtext of {_act} from characters 8 to (length of {_act}))
	else if {_act} is "list":
		msgMenu({_p})
	else if {_act} starts with "page:":
		set {_a::*} to {_act} split at ":"
		msgThreadPage({_p}, {_a::2}, ({_a::3} parsed as number))
	else if {_act} is "phone":
		msgClear({_p})
		openPhone({_p})
	else if {_act} starts with "find:":
		close {_p}'s inventory
		questFind({_p}, subtext of {_act} from characters 6 to (length of {_act}))
	else if {_act} is "close":
		close {_p}'s inventory
	else if {_act} starts with "del:":
		set {_a::*} to {_act} split at ":"
		set {_n} to {_a::2} parsed as number
		if msgArmed({_p}, "del:%{_n}%") is false:
			msgArm({_p}, "del:%{_n}%")
			msgRedraw({_p})
			stop
		delete {-msg::arm::%{_p}%}
		if msgKey(msgFrom({_p}, {_n})) is {_a::3}:
			msgDelete({_p}, {_n})
			msgLog("delete %{_p}% %uuid of {_p}% %{_a::3}% #%{_n}%")
		if msgLastOf({_p}, {_a::3}) is 0:
			msgMenu({_p})
		else:
			msgRedraw({_p})
	else if {_act} starts with "clear:":
		set {_k} to subtext of {_act} from characters 7 to (length of {_act})
		if msgArmed({_p}, "clear:%{_k}%") is false:
			msgArm({_p}, "clear:%{_k}%")
			msgRedraw({_p})
			stop
		delete {-msg::arm::%{_p}%}
		set {_c} to msgDeleteAll({_p}, {_k})
		msgLog("clear %{_p}% %uuid of {_p}% %{_k}% n=%{_c}%")
		msgMenu({_p})

on inventory click:
	{-msg::gui::%player%} is set
	player's current inventory is {-msg::gui::%player%}
	cancel event
	event-inventory is {-msg::gui::%player%}
	set {_act} to {-msg::act::%player%::%index of event-slot%}
	{_act} is set
	# One action per drawn screen (a second click from the same tick finds it used), a tick later.
	if {-msg::gen::%player%} is not set:
		set {-msg::gen::%player%} to 0
	set {_gen} to {-msg::gen::%player%}
	wait 1 tick
	player is online
	{-msg::gui::%player%} is set
	{-msg::gen::%player%} is {_gen}
	add 1 to {-msg::gen::%player%}
	msgAction(player, {_act})

on inventory drag:
	{-msg::gui::%player%} is set
	player's current inventory is {-msg::gui::%player%}
	cancel event

on inventory close:
	{-msg::gui::%player%} is set
	event-inventory is {-msg::gui::%player%}
	msgClear(player)

on quit:
	msgFlushAll(player)
	msgClear(player)
	delete {-msg::gen::%player%}
	delete {-msg::arm::%player%}
	delete {-msg::armat::%player%}
	delete {-msg::screen::%player%}

# Old inboxes tidied once; a reminder at a join when texts wait.
on join:
	msgCompact(player)
	wait 6 seconds
	player is online
	set {_n} to msgUnreadAll(player)
	{_n} > 0
	msg(player, "&d✉ %{_n}% unread message(s) &7· &f/messages")

command /messages [<text>]:
	description: Your texts from Mara, the Boss, Vic and the Broker.
	aliases: /texts, /inbox
	executable by: players
	trigger:
		if arg-1 is not set:
			msgMenu(player)
			stop
		set {_k} to msgKey(arg-1)
		if msgLastOf(player, {_k}) is 0:
			msg(player, "&7No texts from %arg-1%. &f/messages")
			stop
		msgThread(player, {_k})
