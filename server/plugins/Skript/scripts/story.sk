# story.sk: the personal questlines, GTA-like. Built 2026-09-27 (owner, 2026-09-27: "a personal questline that
# helps the player do stuff instead of just spam robberies (like gta)"); chains 2026-09-27 (Vic the Fence's arc runs
# next to Mara's).
#
# Chains (core.sk story::chains, chain::<c>::giver|from|color|bar|barcolor|start|needs|missions): "story" is Mara's
# (a quest giver of the kind "story" at the Safehouse; her list is story::missions), "vic" is Vic the Fence's (kind
# "fence", from level 3). Each chain has one mission at a time, and they run side by side. A mission's settings are
# story::<id>::* (its chain: story::<id>::chain, unset = "story"). Missions only guide: they never unlock or lock
# anything (levels do that), give no season score, and a player can do anything in any order.
#
# Objectives (story::<id>::obj): talk|<quest kind> (open that giver in person; a chain's own giver plays the
# mission's lines 2 s apart first), ev|<event>|<n>[|<filter>] (progress.sk's events while the mission is active:
# rob, sell ($), crack, drill, getaway, contract, crate; filters pro+ / master (contract tiers), distinct (different
# heists), or a heist filter: d4, d<n>+, adv, safe, drill, finale, several with commas), state|level|<n>,
# state|gun, state|bagbest|<n>, state|vest, state|car (checked every second, so what a player already has counts at
# once), combo|<heist filter>[|<parts>] (parts crack,drill,getaway by default, all in one run of a fitting heist).
# A mission whose content the map doesn't have (needs: heist, heist3, safe, drill, adv, finale, d<n>+, contracts,
# crate, a quest kind) is skipped with one line, so a chain never blocks. A state mission already met when it
# starts is done at once, without its text or reward (veterans skip ahead; one summary line).
# The only place missions complete is the pass (every second, at most one per player every 3 s, shared with jobs.sk:
# {-quest::doneat}): the rewards (money, XP, tools through crates.sk's crateGrant, lockpicks, keys, a bound title,
# Vic's list), the contact's line, MISSION PASSED a second later (a level-up's title first), then the next text.
# Shown: the sidebar (%donating_mission%: the tracked quest first), the GPS (the quest slot, one owner for every
# chain and job: questGps; never over a car job or while carrying loot), the boss bar while the GPS shows it,
# /missions (the phone's Missions app, slot 6).
#
# Saved per player: data <key> (the mission id, "paying:<id>" or "done"), <key>-prog, <key>-seen::<heist>
# (distinct), <key>-combo::<heist>#<run>::<part>, where <key> is "story" for Mara and the chain's name otherwise;
# quest-track (the quest the player follows: a chain or "job:<c>:<k>"). Staff: /dstory info|set|reset|skip.
# Log: plugins\Skript\logs\story.log.

function storyLog(text: text):
	log {_text} to "story"

# ---------- Chains ----------

function storyChainOf(id: text) :: text:
	set {_c} to {-cfg::story::%{_id}%::chain}
	if {_c} is set:
		return {_c}
	return "story"

function storyList(c: text) :: texts:
	if {_c} is "story":
		return {-cfg::story::missions::*}
	return {-cfg::chain::%{_c}%::missions::*}

# The data key of a chain: "story" for Mara (her saved keys never changed), else the chain's name.
function storyKey(c: text) :: text:
	return {_c}

function storyIsChain(c: text) :: boolean:
	loop {-cfg::story::chains::*}:
		if loop-value is {_c}:
			return true
	return false

# Whether a quest kind is a chain's own giver (its talk missions complete after the lines, in storyTalk).
function storyIsChainGiver(k: text) :: boolean:
	loop {-cfg::story::chains::*}:
		if {-cfg::chain::%loop-value%::giver} is {_k}:
			return true
	return false

function storyIdOf(p: player, c: text) :: text:
	set {_s} to getData({_p}, storyKey({_c}))
	if {_s} is set:
		return "%{_s}%"
	return ""

function storyId(p: player) :: text:
	return storyIdOf({_p}, "story")

function storyExists(id: text) :: boolean:
	loop storyList(storyChainOf({_id})):
		if loop-value is {_id}:
			return true
	return false

# A mission that is running (not "", "done" or "paying:", and still in its chain).
function storyLive(id: text) :: boolean:
	if {_id} is "":
		return false
	if {_id} is "done":
		return false
	if {_id} starts with "paying:":
		return false
	return storyExists({_id})

# The mission after id in its chain ("" = the chain is over).
function storyNextId(id: text) :: text:
	set {_found} to false
	loop storyList(storyChainOf({_id})):
		if {_found} is true:
			return loop-value
		if loop-value is {_id}:
			set {_found} to true
	return ""

# Whether Mara's chain got to id (done, paying for it or a later one, or on a later mission).
function storyReached(p: player, id: text) :: boolean:
	set {_c} to storyChainOf({_id})
	set {_now} to storyIdOf({_p}, {_c})
	if {_now} is "done":
		return true
	if {_now} starts with "paying:":
		set {_now} to subtext of {_now} from characters 8 to (length of {_now})
		if {_now} is {_id}:
			return true
	set {_seen} to false
	loop storyList({_c}):
		if loop-value is {_id}:
			set {_seen} to true
		if loop-value is {_now}:
			if {_seen} is true:
				return true
			return false
	return false

function storyProgOf(p: player, c: text) :: number:
	set {_v} to getData({_p}, "%storyKey({_c})%-prog")
	if {_v} is set:
		return {_v}
	return 0

function storyProg(p: player) :: number:
	return storyProgOf({_p}, "story")

function storyFrom(id: text) :: text:
	set {_f} to {-cfg::story::%{_id}%::from}
	if {_f} is set:
		return {_f}
	set {_f} to {-cfg::chain::%storyChainOf({_id})%::from}
	if {_f} is set:
		return {_f}
	return "Mara"

# A text from the mission's contact, like a phone message.
function storyText(p: player, from: text, line: text):
	{_line} is not ""
	send colored "&d✉ %{_from}%: &f%{_line}%" to {_p}
	play sound "block.note_block.bit" with volume 0.7 and pitch 1.6 to {_p}

# ---------- What the map has (needs) ----------

# The heists a player could rob now or soon (enabled, their level allows, not a PvP heist for passive players).
function storyHeists(p: player) :: texts:
	loop {heists::*}:
		set {_h} to loop-index
		if heistState({_h}) is not "disabled":
			if heistLevelOk({_p}, {_h}) is true:
				set {_ok} to true
				if isPassive({_p}) is true:
					if heistIsPvp({_h}) is true:
						set {_ok} to false
				if {_ok} is true:
					add {_h} to {_out::*}
	return {_out::*}

function storyHasGate(h: text, kind: text) :: boolean:
	loop {loots::%{_h}%::*}:
		if loop-value is {_kind}:
			return true
	return false

# Whether a heist fits a filter: "" any, safe, drill, adv (advanced), d4, d<n>+ (difficulty n or harder), finale
# (advanced d4 with a safe and a vault); several with commas must all fit.
function storyHeistFits(h: text, f: text) :: boolean:
	if {_f} contains ",":
		loop {_f} split at ",":
			if storyHeistFits({_h}, loop-value) is false:
				return false
		return true
	if {_f} is "safe":
		return storyHasGate({_h}, "safe")
	if {_f} is "drill":
		return storyHasGate({_h}, "drill")
	if {_f} is "adv":
		return heistIsAdvanced({_h})
	if {_f} is "d4":
		if heistDifficulty({_h}) is 4:
			return true
		return false
	if {_f} is "finale":
		if heistDifficulty({_h}) is 4:
			if heistIsAdvanced({_h}) is true:
				if storyHasGate({_h}, "safe") is true:
					if storyHasGate({_h}, "drill") is true:
						return true
		return false
	if {_f} starts with "d":
		if {_f} ends with "+":
			set {_e} to (length of {_f}) - 1
			set {_d} to (subtext of {_f} from characters 2 to {_e}) parsed as number
			if {_d} is set:
				if heistDifficulty({_h}) >= {_d}:
					return true
				return false
	return true

function storyNeedsMet(p: player, need: text) :: boolean:
	if {_need} is "":
		return true
	if {_need} is "contracts":
		set {_g} to false
		loop {quest::giver::*}:
			if loop-value starts with "contracts|":
				set {_g} to true
		if {_g} is true:
			if size of {contract::spot::*} > 0:
				if size of {contract::chop::*} > 0:
					return true
		return false
	if questIsKind({_need}) is true:
		loop {quest::giver::*}:
			if loop-value starts with "%{_need}%|":
				return true
		return false
	if {_need} is "crate":
		if size of {crateblock::*} > 0:
			return true
		return false
	if {_need} is "heist3":
		if size of storyHeists({_p}) >= 3:
			return true
		return false
	set {_f} to {_need}
	if {_need} is "heist":
		set {_f} to ""
	loop storyHeists({_p}):
		if storyHeistFits(loop-value, {_f}) is true:
			return true
	return false

# ---------- Objectives ----------

function storyObj(id: text) :: text:
	set {_o} to {-cfg::story::%{_id}%::obj}
	if {_o} is set:
		return {_o}
	return ""

# The number an objective needs (1 for talk, state and combo).
function storyNeed(id: text) :: number:
	set {_a::*} to storyObj({_id}) split at "|"
	if {_a::1} is "ev":
		set {_n} to {_a::3} parsed as number
		if {_n} is set:
			return {_n}
	return 1

function storyOwnsGun(p: player) :: boolean:
	loop {-cfg::shop::weapons::*}:
		if loop-value is not "Combat_Knife":
			if getData({_p}, "wpn::%loop-value%") is true:
				return true
	return false

function storyOwnsCar(p: player) :: boolean:
	loop {-cfg::cars::*}:
		if carOwned({_p}, loop-value) is true:
			return true
	return false

# Whether a state objective holds now.
function storyState(p: player, o: text) :: boolean:
	set {_a::*} to {_o} split at "|"
	if {_a::2} is "level":
		return levelOk({_p}, {_a::3} parsed as number)
	if {_a::2} is "gun":
		return storyOwnsGun({_p})
	if {_a::2} is "bagbest":
		if bestBag({_p}) >= ({_a::3} parsed as number):
			return true
		return false
	if {_a::2} is "vest":
		if chestplate of {_p} is not air:
			return true
		return false
	if {_a::2} is "car":
		return storyOwnsCar({_p})
	return false

function storyMet(p: player, id: text) :: boolean:
	set {_o} to storyObj({_id})
	if {_o} starts with "state|":
		return storyState({_p}, {_o})
	if storyProgOf({_p}, storyChainOf({_id})) >= storyNeed({_id}):
		return true
	return false

# "0/1", "$4,000/$10,000", "done".
function storyProgText(p: player, id: text) :: text:
	set {_o} to storyObj({_id})
	set {_prog} to storyProgOf({_p}, storyChainOf({_id}))
	if {_o} starts with "state|":
		set {_a::*} to {_o} split at "|"
		if {_a::2} is "level":
			set {_need} to {_a::3} parsed as number
			return "&7%levelNum(levelXp({_p}))%/%levelNum(levelNeed({_need}))% XP"
		return "&70/1"
	set {_a::*} to {_o} split at "|"
	if {_a::1} is "ev":
		if {_a::2} is "sell":
			return "&7%formatMoney({_prog})%/%formatMoney(storyNeed({_id}))%"
	return "&7%{_prog}%/%storyNeed({_id})%"

# ---------- Counting (progress.sk calls this; nothing completes here) ----------

function storyEvent(p: player, ev: text, n: number, detail: text):
	loop {-cfg::story::chains::*}:
		storyEventOf({_p}, loop-value, {_ev}, {_n}, {_detail})

function storyEventOf(p: player, c: text, ev: text, n: number, detail: text):
	set {_id} to storyIdOf({_p}, {_c})
	storyLive({_id}) is true
	set {_key} to storyKey({_c})
	set {_o} to storyObj({_id})
	set {_a::*} to {_o} split at "|"
	if {_a::1} is "talk":
		# A chain's own givers (Mara, Vic) complete in storyTalk, after their lines; others (the Scrap Yard) by the event.
		if {_ev} is "talk":
			if {_detail} is {_a::2}:
				if storyIsChainGiver({_detail}) is false:
					setData({_p}, "%{_key}%-prog", 1)
		stop
	if {_a::1} is "combo":
		storyComboOf({_p}, {_c}, {_o}, {_ev}, {_detail})
		stop
	{_a::1} is "ev"
	{_a::2} is {_ev}
	set {_f} to ""
	if {_a::4} is set:
		set {_f} to {_a::4}
	set {_add} to 1
	if {_ev} is "sell":
		set {_add} to {_n}
	# The heist behind the event (sell and rob: "<h>#<run>").
	set {_h} to {_detail}
	if {_detail} contains "#":
		set {_hp::*} to {_detail} split at "#"
		set {_h} to {_hp::1}
	if {_f} is "pro+":
		if {_detail} is not "pro":
			if {_detail} is not "master":
				stop
	else if {_f} is "master":
		if {_detail} is not "master":
			stop
	else if {_f} is "distinct":
		if getData({_p}, "%{_key}%-seen::%{_h}%") is true:
			stop
		setData({_p}, "%{_key}%-seen::%{_h}%", true)
	else if {_f} is not "":
		if heistExists({_h}) is false:
			stop
		if storyHeistFits({_h}, {_f}) is false:
			stop
	# A getaway counts with that run's loot, after the cops came (as the season's).
	if {_ev} is "getaway":
		if heistWave({_h}) < 1:
			stop
		if bagRunLoot({_p}, {_h}) <= 0:
			stop
	setData({_p}, "%{_key}%-prog", storyProgOf({_p}, {_c}) + {_add})

# combo|<heist filter>[|<parts>]: every part (crack, drill, getaway with loot after a wave) in one run of a fitting heist.
function storyComboOf(p: player, c: text, obj: text, ev: text, detail: text):
	set {_a::*} to {_obj} split at "|"
	set {_f} to ""
	if {_a::2} is set:
		set {_f} to {_a::2}
	set {_parts} to "crack,drill,getaway"
	if {_a::3} is set:
		set {_parts} to {_a::3}
	set {_h} to {_detail}
	if {_detail} contains "#":
		set {_hp::*} to {_detail} split at "#"
		set {_h} to {_hp::1}
	heistExists({_h}) is true
	storyHeistFits({_h}, {_f}) is true
	set {_run} to heistRun({_h})
	set {_k} to "%storyKey({_c})%-combo::%{_h}%#%{_run}%"
	if {_ev} is "crack":
		setData({_p}, "%{_k}%::crack", true)
	else if {_ev} is "drill":
		setData({_p}, "%{_k}%::drill", true)
	else if {_ev} is "getaway":
		if heistWave({_h}) >= 1:
			if bagRunLoot({_p}, {_h}) > 0:
				setData({_p}, "%{_k}%::getaway", true)
	set {_all} to true
	loop {_parts} split at ",":
		if getData({_p}, "%{_k}%::%loop-value%") is not true:
			set {_all} to false
	if {_all} is true:
		setData({_p}, "%storyKey({_c})%-prog", 1)

# ---------- Starting and finishing missions ----------

function storyClearOf(p: player, c: text):
	set {_key} to storyKey({_c})
	delete {-story::needsgone::%{_p}%::%{_c}%}
	deleteData({_p}, "%{_key}%-prog")
	delete {data::%{_p}%::%{_key}%-seen::*}
	delete {data::%{_p}%::%{_key}%-combo::*}

function storyClear(p: player):
	storyClearOf({_p}, "story")

# Makes id the player's mission in its chain ("" = the chain is done). Retired missions are passed over, missions the
# map can't do are skipped with a line, a state already met is done at once (no text or reward): up to 12 in a row.
function storyActivateOf(p: player, c: text, id: text):
	set {_key} to storyKey({_c})
	set {_skipped} to 0
	loop 12 times:
		if {_id} is "":
			setData({_p}, {_key}, "done")
			storyClearOf({_p}, {_c})
			storyLog("done %{_p}% %uuid of {_p}% chain=%{_c}%")
			stop
		setData({_p}, {_key}, {_id})
		storyClearOf({_p}, {_c})
		set {_need} to {-cfg::story::%{_id}%::needs}
		if {_need} is not set:
			set {_need} to ""
		if {-cfg::story::%{_id}%::retired} is true:
			set {_id} to storyNextId({_id})
		else if storyNeedsMet({_p}, {_need}) is false:
			storyLog("skip-needs %{_p}% %uuid of {_p}% %{_id}% needs=%{_need}%")
			storyText({_p}, storyFrom({_id}), "That job fell through. On to the next one.")
			set {_id} to storyNextId({_id})
		else if storyObj({_id}) starts with "state|":
			if storyState({_p}, storyObj({_id})) is true:
				storyLog("skip-met %{_p}% %uuid of {_p}% %{_id}%")
				add 1 to {_skipped}
				set {_id} to storyNextId({_id})
			else:
				storyStartText({_p}, {_id}, {_skipped})
				stop
		else:
			storyStartText({_p}, {_id}, {_skipped})
			stop

function storyActivate(p: player, id: text):
	set {_c} to "story"
	if {_id} is not "":
		set {_c} to storyChainOf({_id})
	storyActivateOf({_p}, {_c}, {_id})

function storyStartText(p: player, id: text, skipped: number):
	set {_c} to storyChainOf({_id})
	set {_label} to {-cfg::story::%{_id}%::label}
	set {_from} to storyFrom({_id})
	if {_skipped} > 0:
		storyText({_p}, {-cfg::chain::%{_c}%::from}, "Heard you know your way around. Skipping ahead to: %{_label}%.")
	else:
		storyText({_p}, {_from}, {-cfg::story::%{_id}%::brief})
		# A talk mission whose giver isn't on the map: how to reach them.
		set {_k} to {-cfg::chain::%{_c}%::giver}
		if storyObj({_id}) is "talk|%{_k}%":
			if storyNeedsMet({_p}, {_k}) is false:
				set {_place} to {-cfg::quest::%{_k}%::place}
				set {_who} to {-cfg::chain::%{_c}%::from}
				msg({_p}, "&7(%{_who}% isn't at the %{_place}% right now: call from &f/missions&7.)")
	set {_col} to {-cfg::chain::%{_c}%::color}
	hudBar({_p}, "%{_col}%▶ New mission: &f%{_label}%", 1)
	# The newest objective is the one the player follows (sidebar, GPS).
	setData({_p}, "quest-track", {_c})
	storyLog("start %{_p}% %uuid of {_p}% %{_id}%")

# Pays a mission's rewards: "money|N", "xp|N", "tool|<t>|N", "con|<W>|N", "key|<crate>|N", "lockpick|<tier>|N",
# "cos|<id>", "fence|list" (Vic's first Wanted List). Returns what was given, for the chat line.
function storyRewards(p: player, id: text) :: text:
	loop {-cfg::story::%{_id}%::rewards::*}:
		set {_a::*} to loop-value split at "|"
		if {_a::1} is "money":
			set {_n} to {_a::2} parsed as number
			giveMoney({_p}, {_n})
			add "&a%formatMoney({_n})%" to {_got::*}
		else if {_a::1} is "xp":
			set {_n} to {_a::2} parsed as number
			levelAddXp({_p}, {_n}, "story")
			add "&b+%{_n}% XP" to {_got::*}
		else if {_a::1} is "tool":
			add crateGrant({_p}, "0|tool|%{_a::2}%|%{_a::3}%", "story") to {_got::*}
		else if {_a::1} is "con":
			add crateGrant({_p}, "0|con|%{_a::2}%|%{_a::3}%", "story") to {_got::*}
		else if {_a::1} is "key":
			set {_n} to {_a::3} parsed as number
			crateAddKeys({_p}, {_a::2}, {_n}, "story:%{_id}%")
			set {_cn} to crateColored({_a::2})
			add "&f%{_n}% %{_cn}% key(s)" to {_got::*}
		else if {_a::1} is "lockpick":
			set {_t} to {_a::2}
			set {_n} to {_a::3} parsed as number
			set {_have} to lockpickCount({_p}, {_t})
			set {_s} to lockpickSlot({_p}, {_t})
			if {_s} < 0:
				set {_s} to lockpickFreeSlot({_p})
			set {_fit} to 0
			if {_s} >= 0:
				set {_fit} to max(0, min({_n}, cfg("lockpick::max") - {_have}))
			if {_fit} > 0:
				set slot {_s} of {_p}'s inventory to lockpickItem({_t}, {_have} + {_fit})
				add "&f%{_fit}% %ctPickName({_t})%" to {_got::*}
			if {_fit} < {_n}:
				set {_cash} to floor(({_n} - {_fit}) * cfg("lockpick::%{_t}%::price") / 2)
				giveMoney({_p}, {_cash})
				add "&a%formatMoney({_cash})% &7(no room for a lockpick)" to {_got::*}
		else if {_a::1} is "cos":
			cosGive({_p}, {_a::2}, "story:%{_id}%")
			add "&7the title %cosColored({_a::2})%" to {_got::*}
		else if {_a::1} is "fence":
			fenceTakeList({_p})
			add "&6Vic's Wanted List" to {_got::*}
	# No rewards: an empty list joins to nothing (unset), and storyTitle wouldn't run with an unset argument.
	if size of {_got::*} is 0:
		return ""
	return join {_got::*} with "&7, "

function storyComplete(p: player, id: text):
	set {_c} to storyChainOf({_id})
	set {_next} to storyNextId({_id})
	# The mission moves on first (a second pass can't pay it again).
	setData({_p}, storyKey({_c}), "paying:%{_id}%")
	set {-quest::doneat::%{_p}%} to now
	set {_got} to storyRewards({_p}, {_id})
	storyLog("complete %{_p}% %uuid of {_p}% %{_id}% got=%{_got}%")
	set {_done} to {-cfg::story::%{_id}%::done}
	if {_done} is set:
		storyText({_p}, storyFrom({_id}), {_done})
	if {_got} is not "":
		msg({_p}, "&6Mission passed: &f%{-cfg::story::%{_id}%::label}% &7· %{_got}%")
	else:
		msg({_p}, "&6Mission passed: &f%{-cfg::story::%{_id}%::label}%")
	storyTitle({_p}, {_got})
	storyActivateOf({_p}, {_c}, {_next})

# MISSION PASSED a second later, so a level-up's title (the XP reward) shows first.
function storyTitle(p: player, got: text):
	wait 1 second
	{_p} is online
	send title colored "&6&lMISSION PASSED" with subtitle colored {_got} to {_p} for 3 seconds
	play sound "ui.toast.challenge_complete" with volume 0.8 to {_p}

# ---------- The pass: every second ----------

function storyPass(p: player):
	# Not in the first seconds online, and never two completions (missions, jobs) within 3 s.
	set {_j} to {-story::joined::%{_p}%}
	if {_j} is set:
		if difference between {_j} and now < 5 seconds:
			stop
	loop {-cfg::story::chains::*}:
		set {_d} to {-quest::doneat::%{_p}%}
		set {_gap} to false
		if {_d} is set:
			if difference between {_d} and now < 3 seconds:
				set {_gap} to true
		if {_gap} is false:
			storyPassOf({_p}, loop-value)

function storyPassOf(p: player, c: text):
	# Mara's chain starts after the tutorial (players from before it have no tutorial data).
	if {_c} is "story":
		if tutorialStep({_p}) is "bag":
			stop
	set {_id} to storyIdOf({_p}, {_c})
	set {_first} to first element out of storyList({_c})
	if {_id} is "":
		# Another chain starts when its start state holds and its giver is on the map.
		set {_start} to {-cfg::chain::%{_c}%::start}
		if {_start} is set:
			if storyState({_p}, {_start}) is false:
				stop
		set {_needs} to {-cfg::chain::%{_c}%::needs}
		if {_needs} is set:
			if storyNeedsMet({_p}, {_needs}) is false:
				stop
		storyActivateOf({_p}, {_c}, {_first})
		stop
	# A crash mid-payment: the mission was paid (the rewards come first after the mark), move on.
	if {_id} starts with "paying:":
		set {_was} to subtext of {_id} from characters 8 to (length of {_id})
		storyLog("resume %{_p}% %uuid of {_p}% after %{_was}%")
		storyActivateOf({_p}, {_c}, storyNextId({_was}))
		stop
	{_id} is not "done"
	if storyExists({_id}) is false:
		storyLog("gone %{_p}% %uuid of {_p}% %{_id}% (not in the missions any more)")
		storyActivateOf({_p}, {_c}, {_first})
		stop
	if {-cfg::story::%{_id}%::retired} is true:
		storyActivateOf({_p}, {_c}, storyNextId({_id}))
		stop
	# Content can disappear (a heist disabled for a rebuild): checked every story::needs-check seconds, and the mission
	# is only skipped once it has been missing for story::needs-grace seconds in a row (staff maintenance doesn't
	# cost anyone their mission).
	set {_at} to {-story::needsat::%{_p}%::%{_c}%}
	if {_at} is not set:
		set {_at} to now
		set {-story::needsat::%{_p}%::%{_c}%} to now
	if difference between {_at} and now >= 1 second * cfg("story::needs-check"):
		set {-story::needsat::%{_p}%::%{_c}%} to now
		set {_need} to {-cfg::story::%{_id}%::needs}
		if {_need} is set:
			if storyNeedsMet({_p}, {_need}) is true:
				delete {-story::needsgone::%{_p}%::%{_c}%}
			else if {-story::needsgone::%{_p}%::%{_c}%} is not set:
				set {-story::needsgone::%{_p}%::%{_c}%} to now
				storyLog("needs-gone %{_p}% %uuid of {_p}% %{_id}% needs=%{_need}% (waiting)")
			else if difference between {-story::needsgone::%{_p}%::%{_c}%} and now >= 1 second * cfg("story::needs-grace"):
				delete {-story::needsgone::%{_p}%::%{_c}%}
				storyLog("skip-needs %{_p}% %uuid of {_p}% %{_id}% needs=%{_need}% (gone)")
				storyText({_p}, storyFrom({_id}), "That job fell through. On to the next one.")
				storyActivateOf({_p}, {_c}, storyNextId({_id}))
				stop
		else:
			delete {-story::needsgone::%{_p}%::%{_c}%}
	if storyMet({_p}, {_id}) is true:
		storyComplete({_p}, {_id})

every second:
	loop all players:
		set {_p} to loop-player
		if {_p} is alive:
			storyPass({_p})
		questShow({_p})

on join:
	set {-story::joined::%player%} to now

on quit:
	delete {-story::joined::%player%}
	delete {-story::needsat::%player%::*}
	delete {-story::needsgone::%player%::*}
	delete {-story::talking::%player%}
	delete {-quest::doneat::%player%}
	delete {-gps::seenobj::%uuid of player%::*}
	delete {-qt::%uuid of player%::*}
	delete {-ph::mission::%player%}

# ---------- Showing it: the sidebar, the GPS, the boss bar ----------

# The GPS target spots of a mission ("x,y,z;x,y,z", "" = none) in the player's world.
function storyGpsSpots(p: player, id: text) :: text:
	set {_g} to {-cfg::story::%{_id}%::gps}
	if {_g} is not set:
		return ""
	set {_w} to "%world of {_p}%"
	set {_out} to ""
	if questIsKind({_g}) is true:
		loop {quest::giver::*}:
			set {_a::*} to loop-value split at "|"
			if {_a::1} is {_g}:
				if {_a::2} is {_w}:
					add "%{_a::3}%,%{_a::4}%,%{_a::5}%" to {_s::*}
	if {_g} is "crate":
		loop {crateblock::*}:
			set {_k::*} to loop-index split at ":"
			if {_k::1} is {_w}:
				set {_spot} to "%({_k::2} parsed as number) + 0.5%,%({_k::3} parsed as number) + 1%,%({_k::4} parsed as number) + 0.5%"
				add {_spot} to {_any::*}
				if crateKeys({_p}, loop-value) > 0:
					add {_spot} to {_s::*}
		if size of {_s::*} is 0:
			set {_s::*} to {_any::*}
	else if {_g} starts with "poi:shop:":
		set {_word} to subtext of {_g} from characters 10 to (length of {_g})
		loop {poi::*}:
			set {_a::*} to loop-value split at "|"
			if {_a::1} is "shop":
				if {_a::2} is {_w}:
					if {_a::6} contains {_word}:
						add "%{_a::3}%,%{_a::4}%,%{_a::5}%" to {_s::*}
	else if {_g} starts with "heist":
		set {_key} to storyKey(storyChainOf({_id}))
		set {_f} to ""
		if {_g} contains ":":
			set {_f} to subtext of {_g} from characters 7 to (length of {_g})
		loop storyHeists({_p}):
			set {_st} to heistState(loop-value)
			set {_open} to false
			if {_st} is "open":
				set {_open} to true
			else if {_st} is "active":
				set {_open} to true
			if {_open} is true:
				set {_fits} to true
				if {_f} is "new":
					if getData({_p}, "%{_key}%-seen::%loop-value%") is true:
						set {_fits} to false
				else if storyHeistFits(loop-value, {_f}) is false:
					set {_fits} to false
				if {_fits} is true:
					set {_l} to heistExit(loop-value)
					if "%world of {_l}%" is {_w}:
						add gpsSpot({_l}) to {_s::*}
	if size of {_s::*} > 0:
		set {_out} to join {_s::*} with ";"
	return {_out}

# The quests a player follows, in order: the tracked one (data quest-track) first, then each chain, then taken jobs.
function questOrder(p: player) :: texts:
	set {_t} to getData({_p}, "quest-track")
	if {_t} is set:
		add "%{_t}%" to {_o::*}
		set {_in::%{_t}%} to true
	loop {-cfg::story::chains::*}:
		if {_in::%loop-value%} is not set:
			set {_in::%loop-value%} to true
			add loop-value to {_o::*}
	loop jobsKeys({_p}):
		if {_in::%loop-value%} is not set:
			set {_in::%loop-value%} to true
			add loop-value to {_o::*}
	return {_o::*}

# Fills {-qt::<uuid>::world|spots|label|radius|by|obj} with a quest's GPS target; false when it has none.
function questTarget(p: player, key: text) :: boolean:
	set {_u} to "%uuid of {_p}%"
	delete {-qt::%{_u}%::*}
	if {_key} starts with "job:":
		return jobsTarget({_p}, {_key})
	if storyIsChain({_key}) is false:
		return false
	set {_id} to storyIdOf({_p}, {_key})
	if storyLive({_id}) is false:
		return false
	if storyMet({_p}, {_id}) is true:
		return false
	set {_spots} to storyGpsSpots({_p}, {_id})
	if {_spots} is "":
		return false
	set {-qt::%{_u}%::world} to "%world of {_p}%"
	set {-qt::%{_u}%::spots} to {_spots}
	set {-qt::%{_u}%::label} to {-cfg::story::%{_id}%::label}
	set {-qt::%{_u}%::radius} to 6
	set {-qt::%{_u}%::by} to {_key}
	set {-qt::%{_u}%::obj} to "%{_key}%:%{_id}%"
	return true

# Whether a GPS quest owner is one of the quests' (a chain or a job), not a car job's.
function questOwns(by: text) :: boolean:
	if {_by} is "job":
		return true
	return storyIsChain({_by})

# The GPS's quest slot: one owner for every chain and job. Never over a car job (contracts.sk owns the slot while
# one runs) or while carrying loot (the base route wins). An objective routed before doesn't take the slot back from
# a pin set meanwhile; a new one does (the newest objective wins, as in gps.sk).
function questGps(p: player):
	set {_u} to "%uuid of {_p}%"
	set {_by} to {-gps::questby::%{_u}%}
	if {_by} is not set:
		set {_by} to ""
	set {_ours} to true
	if {_by} is not "":
		set {_ours} to questOwns({_by})
	if {_ours} is false:
		stop
	set {_pick} to ""
	if {-ctjob::%{_u}%} is not set:
		if bagTotal({_p}) <= 0:
			loop questOrder({_p}):
				if {_pick} is "":
					if questTarget({_p}, loop-value) is true:
						set {_pick} to loop-value
	if {_pick} is "":
		if {_by} is not "":
			gpsQuestClear({_p}, {_by})
		stop
	set {_obj} to {-qt::%{_u}%::obj}
	if {-gps::seenobj::%{_u}%::%{_obj}%} is true:
		set {-gps::questobj::%{_u}%} to {_obj}
	set {-gps::seenobj::%{_u}%::%{_obj}%} to true
	gpsQuest({_p}, {-qt::%{_u}%::world}, {-qt::%{_u}%::spots}, {-qt::%{_u}%::label}, {-qt::%{_u}%::radius}, {-qt::%{_u}%::by}, {_obj})

# The sidebar line of a chain's mission ("" = none).
function storyLine(p: player, c: text) :: text:
	set {_id} to storyIdOf({_p}, {_c})
	if storyLive({_id}) is true:
		set {_col} to {-cfg::chain::%{_c}%::color}
		return "%{_col}%▶ &f%{-cfg::story::%{_id}%::label}% %storyProgText({_p}, {_id})%"
	return ""

function questShow(p: player):
	set {_line} to "&r"
	loop questOrder({_p}):
		if {_line} is "&r":
			set {_k} to loop-value
			if {_k} starts with "job:":
				set {_l} to jobsLine({_p}, {_k})
			else:
				set {_l} to storyLine({_p}, {_k})
			if {_l} is not "":
				set {_line} to {_l}
	set {-ph::mission::%{_p}%} to {_line}
	questGps({_p})

# The boss bar (hud.sk, after the GPS pin): only while the GPS shows a chain's mission.
function storyHud(p: player) :: boolean:
	set {_u} to "%uuid of {_p}%"
	if gpsActive({_p}) is "quest":
		set {_c} to {-gps::questby::%{_u}%}
		if {_c} is set:
			if storyIsChain({_c}) is true:
				set {_id} to storyIdOf({_p}, {_c})
				if storyLive({_id}) is true:
					set {_way} to gpsWay({_p})
					set {_bar} to {-cfg::chain::%{_c}%::bar}
					hudBossSet({_p}, "%{_bar}%&r &7· &f%{-cfg::story::%{_id}%::label}% %storyProgText({_p}, {_id})% %{_way}%", {-cfg::chain::%{_c}%::barcolor}, 1)
					return true
	return false

# ---------- Talking in person (quests.sk: a chain's giver) ----------

# Giver n (quests.sk), or Mara from the phone ("": Call Mara).
function storyTalk(p: player, n: text):
	set {_k} to "story"
	if {_n} is not "":
		set {_k} to questKind({_n})
	storyTalkKind({_p}, {_k})

function storyTalkKind(p: player, k: text):
	# A talk mission with this giver in any chain: its lines, 2 s apart, then it's done.
	set {_tc} to ""
	loop {-cfg::story::chains::*}:
		if {_tc} is "":
			set {_cid} to storyIdOf({_p}, loop-value)
			if storyObj({_cid}) is "talk|%{_k}%":
				set {_tc} to loop-value
				set {_id} to {_cid}
	if {_tc} is not "":
		if {-story::talking::%{_p}%} is set:
			stop
		set {-story::talking::%{_p}%} to true
		loop {-cfg::story::%{_id}%::talk::*}:
			storyText({_p}, storyFrom({_id}), loop-value)
			wait 2 seconds
			if {_p} is not online:
				delete {-story::talking::%{_p}%}
				stop
		delete {-story::talking::%{_p}%}
		# The same mission still (a staff change meanwhile doesn't complete another).
		if storyIdOf({_p}, {_tc}) is {_id}:
			setData({_p}, "%storyKey({_tc})%-prog", 1)
		stop
	# Nothing to talk about: the giver's own menu.
	if {_k} is "story":
		if storyIdOf({_p}, "story") is "done":
			jobsTalk({_p}, "mara", true)
			stop
		storyMenu({_p})
	else if {_k} is "fence":
		fenceTalk({_p})
	else:
		storyMenu({_p})

# ---------- /missions (the phone's Missions app) ----------

function storyButton(p: player, gui: inventory, slot: number, i: item, act: text):
	set slot {_slot} of {_gui} to {_i}
	set {-story::act::%{_p}%::%{_slot}%} to {_act}

# A chain's mission card (the GPS button while the GPS can show it).
function storyCard(p: player, id: text) :: item:
	set {_c} to storyChainOf({_id})
	set {_col} to {-cfg::chain::%{_c}%::color}
	set {_label} to {-cfg::story::%{_id}%::label}
	set {_hint} to {-cfg::story::%{_id}%::brief}
	set {_from} to storyFrom({_id})
	set {_prog} to storyProgText({_p}, {_id})
	set {_ch} to {-cfg::story::%{_id}%::chapter}
	set {_first} to "&7From: &f%{_from}%"
	if {_ch} is set:
		set {_chn} to {-cfg::story::chapter::%{_ch}%::name}
		set {_first} to "&7Chapter %{_ch}%: %{_chn}% &7· &f%{_from}%"
	set {_by} to {-gps::questby::%uuid of {_p}%}
	if {_by} is not set:
		set {_by} to ""
	if storyGpsSpots({_p}, {_id}) is "":
		return writable book named "%{_col}%%{_label}%" with lore {_first} and "&7Progress: %{_prog}%" and "&7""%{_hint}%"""
	if {-ctjob::%uuid of {_p}%} is set:
		return writable book named "%{_col}%%{_label}%" with lore {_first} and "&7Progress: %{_prog}%" and "&7""%{_hint}%""" and "&7The GPS shows your car job first."
	if bagTotal({_p}) > 0:
		return writable book named "%{_col}%%{_label}%" with lore {_first} and "&7Progress: %{_prog}%" and "&7""%{_hint}%""" and "&7The GPS shows the base first (you're carrying loot)."
	return writable book named "%{_col}%%{_label}%" with lore {_first} and "&7Progress: %{_prog}%" and "&7""%{_hint}%""" and "&eClick: the GPS shows the way."

function storyMenu(p: player):
	closePhoneMap({_p})
	set {_id} to storyId({_p})
	set {_gui} to chest inventory with 4 rows named "&8Missions"
	delete {-story::act::%{_p}%::*}
	set {_pane} to gray stained glass pane named "&r"
	loop 36 times:
		set slot (loop-number - 1) of {_gui} to {_pane}
	if {_id} is "done":
		set slot 13 of {_gui} to nether star named "&6The story is done" with lore "&7You finished Mara's jobs." and "&7The city is yours: heists, contracts," and "&7the season's leaderboards (/lb)."
		if {-cfg::jobs::contacts::*} is set:
			storyButton({_p}, {_gui}, 22, paper named "&dMara's jobs" with lore "&7Daily jobs from Mara and the Boss." and "&eClick: open your jobs.", "jobs")
	else if storyExists({_id}) is true:
		storyButton({_p}, {_gui}, 13, storyCard({_p}, {_id}), "gps:story")
		# No Mara on the map (yet): a talk mission can be done from here, so the chain never blocks.
		if storyObj({_id}) is "talk|story":
			if storyNeedsMet({_p}, "story") is false:
				storyButton({_p}, {_gui}, 22, paper named "&dCall Mara" with lore "&7She's not at the Safehouse right now." and "&eClick: talk on the phone.", "call:story")
	else:
		set slot 13 of {_gui} to paper named "&7Your first mission comes soon" with lore "&7After the tutorial."
	# The other chains (Vic's): a card while running, a call button when their giver isn't on the map.
	set {_slot} to 15
	loop {-cfg::story::chains::*}:
		set {_c} to loop-value
		if {_c} is not "story":
			set {_cid} to storyIdOf({_p}, {_c})
			if storyLive({_cid}) is true:
				storyButton({_p}, {_gui}, {_slot}, storyCard({_p}, {_cid}), "gps:%{_c}%")
				set {_k} to {-cfg::chain::%{_c}%::giver}
				if storyObj({_cid}) is "talk|%{_k}%":
					if storyNeedsMet({_p}, {_k}) is false:
						set {_who} to {-cfg::chain::%{_c}%::from}
						storyButton({_p}, {_gui}, {_slot} + 9, paper named "&6Call %{_who}%" with lore "&7Not in the shop right now." and "&eClick: talk on the phone.", "call:%{_c}%")
				add 1 to {_slot}
	# Mara's chapters: done, now, later.
	set {_slot} to 29
	set {_nowch} to 0
	if storyExists({_id}) is true:
		set {_nowch} to {-cfg::story::%{_id}%::chapter}
	loop {-cfg::story::chapters::*}:
		set {_c} to loop-value
		set {_cn} to {-cfg::story::chapter::%{_c}%::name}
		if {_id} is "done":
			set {_i} to lime dye named "&aChapter %{_c}%: %{_cn}%" with lore "&7Done."
		else if {_c} < {_nowch}:
			set {_i} to lime dye named "&aChapter %{_c}%: %{_cn}%" with lore "&7Done."
		else if {_c} is {_nowch}:
			set {_i} to orange dye named "&6Chapter %{_c}%: %{_cn}%" with lore "&7Now."
		else:
			set {_i} to gray dye named "&7Chapter %{_c}%: %{_cn}%" with lore "&7Later."
		set slot {_slot} of {_gui} to {_i}
		add 1 to {_slot}
	storyButton({_p}, {_gui}, 35, barrier named "&cClose", "close")
	set {-story::gui::%{_p}%} to {_gui}
	if {-story::gen::%{_p}%} is not set:
		set {-story::gen::%{_p}%} to 0
	open {_gui} to {_p}

# The GPS follows a chain's mission (the menu's card).
function storyTrack(p: player, c: text):
	setData({_p}, "quest-track", {_c})
	questGps({_p})
	set {_u} to "%uuid of {_p}%"
	if {-gps::questby::%{_u}%} is {_c}:
		set {-gps::active::%{_u}%} to "quest"
		gpsPush({_p})
		hudBar({_p}, "&dThe GPS shows your mission.", 1)
	else if {-ctjob::%{_u}%} is set:
		hudBar({_p}, "&7The GPS shows your car job first.", 1)
	else if bagTotal({_p}) > 0:
		hudBar({_p}, "&7The GPS shows the base first (you're carrying loot).", 1)
	else:
		hudBar({_p}, "&7Nothing to show on the GPS for it right now.", 1)

on inventory click:
	{-story::gui::%player%} is set
	player's current inventory is {-story::gui::%player%}
	cancel event
	event-inventory is {-story::gui::%player%}
	set {_act} to {-story::act::%player%::%index of event-slot%}
	{_act} is set
	set {_gen} to {-story::gen::%player%}
	wait 1 tick
	player is online
	{-story::gen::%player%} is {_gen}
	add 1 to {-story::gen::%player%}
	close player's inventory
	if {_act} starts with "gps:":
		set {_c} to subtext of {_act} from characters 5 to (length of {_act})
		storyTrack(player, {_c})
	else if {_act} starts with "call:":
		set {_c} to subtext of {_act} from characters 6 to (length of {_act})
		set {_k} to {-cfg::chain::%{_c}%::giver}
		set {_id} to storyIdOf(player, {_c})
		if storyObj({_id}) is "talk|%{_k}%":
			storyTalkKind(player, {_k})
	else if {_act} is "jobs":
		jobsMenu(player)

on inventory drag:
	{-story::gui::%player%} is set
	player's current inventory is {-story::gui::%player%}
	cancel event

on inventory close:
	{-story::gui::%player%} is set
	event-inventory is {-story::gui::%player%}
	delete {-story::gui::%player%}
	delete {-story::act::%player%::*}

command /missions:
	description: Your missions from Mara (and Vic).
	aliases: /mission
	executable by: players
	trigger:
		storyMenu(player)

command /story:
	description: Your missions from Mara (and Vic).
	executable by: players
	trigger:
		storyMenu(player)

# ---------- Staff ----------

command /dstory [<text>]:
	permission: donating.staff
	permission message: &cStaff only.
	trigger:
		set {_a::*} to arg-1 split at " "
		set {_sub} to {_a::1}
		set {_who} to {_a::2} parsed as player
		if {_who} is not set:
			send "STORY usage: /dstory info|reset|skip <online player> [chain] | set <online player> <mission id>" to sender
			stop
		set {_c} to "story"
		if {_a::3} is set:
			if storyIsChain({_a::3}) is true:
				set {_c} to {_a::3}
		if {_sub} is "info":
			set {_cid} to storyIdOf({_who}, {_c})
			send "STORY %{_who}% chain=%{_c}% id=%{_cid}% prog=%storyProgOf({_who}, {_c})% met=%storyMet({_who}, {_cid})% line=%{-ph::mission::%{_who}%}%" to sender
		else if {_sub} is "set":
			set {_id} to {_a::3}
			if storyExists({_id}) is false:
				send "STORY no mission %{_id}%" to sender
				stop
			storyLog("staff-set %{_who}% %uuid of {_who}% %{_id}% by=%sender%")
			storyActivate({_who}, {_id})
			send "STORY %{_who}% now on %storyIdOf({_who}, storyChainOf({_id}))%" to sender
		else if {_sub} is "reset":
			deleteData({_who}, storyKey({_c}))
			storyClearOf({_who}, {_c})
			storyLog("staff-reset %{_who}% %uuid of {_who}% chain=%{_c}% by=%sender%")
			send "STORY %{_who}% chain %{_c}% reset (it starts again in a second)" to sender
		else if {_sub} is "skip":
			set {_id} to storyIdOf({_who}, {_c})
			storyLog("staff-skip %{_who}% %uuid of {_who}% %{_id}% by=%sender%")
			storyActivateOf({_who}, {_c}, storyNextId({_id}))
			send "STORY %{_who}% now on %storyIdOf({_who}, {_c})%" to sender
		else:
			send "STORY usage: /dstory info|reset|skip <online player> [chain] | set <online player> <mission id>" to sender
