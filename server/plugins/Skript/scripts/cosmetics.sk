# cosmetics.sk: cosmetics from crates (crates.sk). Built 2026-09-26 (owner: crates with bag skins, titles
# and kill effects; car cosmetics, car upgrades and gun skins come later).
#
# A cosmetic is core.sk cos::<id>::type|name|rarity (optional ::retired, ::testing):
#   title    a tag after your name in chat and the tab list ("Name «Ghost»"): /title
#   bagskin  the bag's look, whatever tier you carry (the art is tools\make-item-art.js BAGS): /bagskin
#            (ranks.sk; a rank's own skins stay rank-only)
#   killfx   particles and a sound where your victim dies: /killeffect
# Owned: data cos::<id> = true (saved per player, never taken away except by a trade: trade.sk moves it to the
# other player and takes it off if worn). Chosen: data "title", "killfx"
# ("bag-skin" for bags, ranks.sk). Legends also own every retired and testing cosmetic (owner,
# 2026-09-26: "Receives all testing/retired cosmetics"; core.sk paidrank::<id>::retired-cosmetics),
# checked live, so it follows the rank. Crates never roll a retired or testing cosmetic.
# Looks only: no cosmetic changes what anything does. Log: plugins\Skript\logs\cosmetics.log.

function cosLog(text: text):
	log {_text} to "cosmetics"

function cosExists(id: text) :: boolean:
	if {-cfg::cos::%{_id}%::type} is set:
		return true
	return false

# "&9Cash Print" (the rarity's color and the name).
function cosColored(id: text) :: text:
	set {_r} to {-cfg::cos::%{_id}%::rarity}
	set {_c} to {-cfg::rarity::%{_r}%::color}
	if {_c} is not set:
		set {_c} to "&f"
	return "%{_c}%%{-cfg::cos::%{_id}%::name}%"

# "title" -> "title", "bagskin" -> "bag skin", "killfx" -> "kill effect".
function cosTypeName(type: text) :: text:
	if {_type} is "bagskin":
		return "bag skin"
	if {_type} is "killfx":
		return "kill effect"
	return {_type}

# Retired (no longer in crates) or testing (not released): crates skip it, Legends own it.
function cosHidden(id: text) :: boolean:
	if {-cfg::cos::%{_id}%::retired} is true:
		return true
	if {-cfg::cos::%{_id}%::testing} is true:
		return true
	return false

function cosOwned(p: offline player, id: text) :: boolean:
	if {data::%{_p}%::cos::%{_id}%} is true:
		return true
	# Earned titles (bound: seasons.sk) belong only to whoever earned them; never mark one retired or testing.
	if {-cfg::cos::%{_id}%::bound} is true:
		return false
	if cosHidden({_id}) is true:
		set {_r} to paidRank({_p})
		if {_r} is not "":
			if {-cfg::paidrank::%{_r}%::retired-cosmetics} is true:
				return true
	return false

# Gives a cosmetic: true if it's new, false if the player already had it. A tradeable one gets the next serial.
function cosGive(p: offline player, id: text, why: text) :: boolean:
	if {data::%{_p}%::cos::%{_id}%} is true:
		return false
	set {data::%{_p}%::cos::%{_id}%} to true
	set {_sn} to ""
	if cosSerialized({_id}) is true:
		set {data::%{_p}%::cosserial::%{_id}%} to serialMint("cos:%{_id}%")
		set {_sn} to " serial=%{data::%{_p}%::cosserial::%{_id}%}%"
	cosLog("give %{_p}% %uuid of {_p}% %{_id}% why=%{_why}%%{_sn}%")
	return true

# ---------- Serials ----------
# Owner, 2026-09-27: rare items are numbered so their value can be judged in trades: "#3/57" = the 3rd copy ever
# unlocked, of 57 so far (the count grows as more people unlock it from crates; a retired one's stops). Every
# tradeable copy has one: crate cosmetics here, crate cars in garage.sk ({carserial::<plate>}). A rank's or an
# earned (bound) cosmetic has none (never traded). Saved: {serial::<key>} = copies made ("cos:<id>", "car:<id>");
# data cosserial::<id> = the number of a player's copy; a trade moves it with the item.

function serialMint(key: text) :: number:
	if {serial::%{_key}%} is not set:
		set {serial::%{_key}%} to 0
	add 1 to {serial::%{_key}%}
	return {serial::%{_key}%}

function serialTotal(key: text) :: number:
	if {serial::%{_key}%} is set:
		return {serial::%{_key}%}
	return 0

# "#3/57" (the copy's number of the copies made so far).
function serialText(key: text, n: number) :: text:
	return "#%{_n}%/%serialTotal({_key})%"

# Tradeable, so numbered: every cosmetic but an earned (bound) one.
function cosSerialized(id: text) :: boolean:
	if cosExists({_id}) is false:
		return false
	if {-cfg::cos::%{_id}%::bound} is true:
		return false
	return true

# The number of the player's own copy (0 = none: not owned, or only through a rank). A copy from before serials
# existed is numbered the first time it's asked for.
function cosSerial(p: offline player, id: text) :: number:
	if {data::%{_p}%::cos::%{_id}%} is not true:
		return 0
	if cosSerialized({_id}) is false:
		return 0
	if {data::%{_p}%::cosserial::%{_id}%} is not set:
		set {data::%{_p}%::cosserial::%{_id}%} to serialMint("cos:%{_id}%")
		cosLog("serial %{_p}% %uuid of {_p}% %{_id}% serial=%{data::%{_p}%::cosserial::%{_id}%}% (numbered late)")
	return {data::%{_p}%::cosserial::%{_id}%}

# " &7#3/57" after a name, or "" when the player's copy has no serial.
function cosSerialText(p: offline player, id: text) :: text:
	set {_n} to cosSerial({_p}, {_id})
	if {_n} < 1:
		return ""
	set {_k} to "cos:%{_id}%"
	return " &7%serialText({_k}, {_n})%"

# The lore line for a numbered copy: "Serial #3 of 57" (+ "no more are made" once retired).
function cosSerialLore(p: offline player, id: text) :: text:
	set {_n} to cosSerial({_p}, {_id})
	if {_n} < 1:
		return ""
	set {_t} to serialTotal("cos:%{_id}%")
	if {-cfg::cos::%{_id}%::retired} is true:
		return "&7Serial &f#%{_n}% &7of %{_t}% &7(retired: no more are made)"
	return "&7Serial &f#%{_n}% &7of %{_t}% so far"

# Every cosmetic of a type the player owns, in core.sk's order.
function cosOwnedOf(p: offline player, type: text) :: texts:
	loop {-cfg::cosmetics::*}:
		if {-cfg::cos::%loop-value%::type} is {_type}:
			if cosOwned({_p}, loop-value) is true:
				add loop-value to {_out::*}
	return {_out::*}

# The id of a cosmetic of that type typed by a player: its id or its name, any case, spaces optional
# ("smooth operator", "SmoothOperator", "smooth"); "" when there's none.
function cosFind(type: text, typed: text) :: text:
	set {_t} to {_typed} in lower case
	replace all " " with "" in {_t}
	loop {-cfg::cosmetics::*}:
		if {-cfg::cos::%loop-value%::type} is {_type}:
			if loop-value is {_t}:
				return loop-value
			set {_n} to {-cfg::cos::%loop-value%::name} in lower case
			replace all " " with "" in {_n}
			if {_n} is {_t}:
				return loop-value
	return ""

# ---------- Titles ----------

# " &a«Ghost»" for the chosen title (if still owned), else "&r" (PlaceholderAPI would show the raw
# placeholder for an empty text).
function titleText(p: player) :: text:
	set {_id} to getData({_p}, "title")
	if {_id} is set:
		if cosExists({_id}) is true:
			if cosOwned({_p}, {_id}) is true:
				set {_r} to {-cfg::cos::%{_id}%::rarity}
				set {_c} to {-cfg::rarity::%{_r}%::color}
				return " %{_c}%«%{-cfg::cos::%{_id}%::name}%»&r"
	return "&r"

# LPC (chat) and TAB (tab list) read %donating_title% from another thread: a copy in memory.
every second:
	loop all players:
		set {-ph::title::%loop-player%} to titleText(loop-player)

on join:
	set {-ph::title::%player%} to titleText(player)

on quit:
	delete {-ph::title::%player%}

# ---------- Kill effects ----------

# The killer's chosen effect where the victim died. Players only: cops (Citizens NPCs, "NPC" metadata),
# traps, falls and combat logs have no effect.
on death of player:
	attacker is a player
	attacker does not have metadata "NPC"
	attacker is not victim
	# A hit target (hits.sk) is seen by its hunter only: no particles for everyone else. (Its NPC metadata is gone by
	# now: hits.sk flags it at the lowest priority.)
	{-hit::deadnpc::%uuid of victim%} is not set
	set {_id} to getData(attacker, "killfx")
	{_id} is set
	cosOwned(attacker, {_id}) is true
	killFx({_id}, location of victim)

function killFx(id: text, l: location):
	set {_c} to {_l} ~ vector(0, 1, 0)
	if {_id} is "poof":
		draw 30 poof particles with offset vector(0.3, 0.5, 0.3) at {_c}
		play sound "block.fire.extinguish" with volume 0.8 at {_c}
	else if {_id} is "smoke":
		draw 30 large smoke particles with offset vector(0.4, 0.6, 0.4) at {_c}
		play sound "entity.generic.extinguish_fire" with volume 0.8 at {_c}
	else if {_id} is "flames":
		draw 50 flame particles with offset vector(0.3, 0.8, 0.3) at {_c}
		play sound "item.firecharge.use" with volume 0.8 at {_c}
	else if {_id} is "sparks":
		draw 40 electric spark particles with offset vector(0.4, 0.8, 0.4) at {_c}
		draw 20 crit particles with offset vector(0.4, 0.8, 0.4) at {_c}
		play sound "entity.firework_rocket.twinkle" with volume 0.8 at {_c}
	else if {_id} is "cashburst":
		draw 30 happy villager particles with offset vector(0.5, 0.8, 0.5) at {_c}
		draw 20 wax on particles with offset vector(0.5, 0.8, 0.5) at {_c}
		play sound "entity.experience_orb.pickup" with volume 1 at {_c}
	else if {_id} is "souls":
		draw 25 soul particles with offset vector(0.4, 0.6, 0.4) at {_c}
		draw 20 soul fire flame particles with offset vector(0.3, 0.8, 0.3) at {_c}
		play sound "particle.soul_escape" with volume 1 at {_c}
	else if {_id} is "fireworks":
		draw 60 firework particles with offset vector(0.5, 0.8, 0.5) at {_c}
		play sound "entity.firework_rocket.blast" with volume 1 at {_c}
		play sound "entity.firework_rocket.twinkle" with volume 0.8 at {_c}
	else if {_id} is "stormcloud":
		draw 30 large smoke particles with offset vector(0.6, 0.2, 0.6) at {_c} ~ vector(0, 1.2, 0)
		draw 40 electric spark particles with offset vector(0.3, 1, 0.3) at {_c}
		play sound "entity.lightning_bolt.impact" with volume 0.7 at {_c}
	else if {_id} is "dragon":
		draw 60 dragon breath particles with offset vector(0.5, 0.8, 0.5) at {_c}
		draw 20 end rod particles with offset vector(0.4, 0.8, 0.4) at {_c}
		play sound "entity.ender_dragon.growl" with volume 0.4 at {_c}
	else if {_id} is "totem":
		draw 60 totem of undying particles with offset vector(0.4, 0.8, 0.4) at {_c}
		play sound "item.totem.use" with volume 0.6 at {_c}
	else if {_id} is "lvl_crown":
		# Level 150: a gold ring over the victim, like a crown.
		set {_top} to {_c} ~ vector(0, 1.2, 0)
		loop 16 times:
			set {_a} to loop-number * 22.5
			draw 1 wax on particle with offset vector(0, 0, 0) at {_top} ~ vector(cos({_a}) * 0.45, 0, sin({_a}) * 0.45)
			draw 1 end rod particle with offset vector(0, 0.05, 0) at {_top} ~ vector(cos({_a}) * 0.45, 0.15, sin({_a}) * 0.45)
		draw 20 totem of undying particles with offset vector(0.3, 0.6, 0.3) at {_c}
		play sound "entity.player.levelup" with volume 0.8 at {_c}
	else if {_id} is "lvl_moneyrain":
		# Level 200: cash raining down.
		draw 50 happy villager particles with offset vector(0.8, 0.2, 0.8) at {_c} ~ vector(0, 1.5, 0)
		draw 40 wax on particles with offset vector(0.8, 1, 0.8) at {_c}
		draw 20 end rod particles with offset vector(0.6, 0.3, 0.6) at {_c} ~ vector(0, 2, 0)
		play sound "block.chain.break" with volume 0.8 at {_c}
		play sound "entity.experience_orb.pickup" with volume 1 at {_c}
	else if {_id} is "glitch":
		draw 30 end rod particles with offset vector(0.3, 0.9, 0.3) at {_c}
		draw 30 sculk soul particles with offset vector(0.4, 0.8, 0.4) at {_c}
		draw 20 glow particles with offset vector(0.4, 0.8, 0.4) at {_c}
		play sound "block.beacon.deactivate" with volume 1 at {_c}

# ---------- Commands ----------

# /title and /killeffect: no argument lists yours, "none" takes it off, a name picks it.
function cosPick(p: player, type: text, key: text, cmd: text, typed: text):
	set {_label} to cosTypeName({_type})
	set {_owned::*} to cosOwnedOf({_p}, {_type})
	if {_typed} is "":
		if size of {_owned::*} is 0:
			msg({_p}, "&7You have no %{_label}%s yet. They come from crates: &f/crates")
			stop
		loop {_owned::*}:
			add cosColored(loop-value) to {_names::*}
		set {_list} to join {_names::*} with "&7, "
		set {_now} to getData({_p}, {_key})
		set {_nowText} to "none"
		if {_now} is set:
			if {_owned::*} contains {_now}:
				set {_nowText} to cosColored({_now})
		msg({_p}, "&6Your %{_label}%s: %{_list}% &7(now: %{_nowText}%&7). &f/%{_cmd}% <name> &7or &f/%{_cmd}% none")
		stop
	if {_typed} is "none":
		deleteData({_p}, {_key})
		msg({_p}, "&aNo %{_label}% now.")
		stop
	set {_id} to cosFind({_type}, {_typed})
	if {_id} is "":
		msg({_p}, "&cThere's no %{_label}% called %{_typed}%. &7/%{_cmd}% lists yours.")
		stop
	if cosOwned({_p}, {_id}) is false:
		msg({_p}, "&cYou don't have %cosColored({_id})%&c yet. &7Crates: &f/crates")
		stop
	setData({_p}, {_key}, {_id})
	if {_type} is "title":
		set {-ph::title::%{_p}%} to titleText({_p})
	msg({_p}, "&aYour %{_label}%: %cosColored({_id})%&a.")

command /title [<text>]:
	description: Pick the title after your name (from crates).
	executable by: players
	trigger:
		set {_t} to ""
		if arg-1 is set:
			set {_t} to arg-1
		cosPick(player, "title", "title", "title", {_t})

command /killeffect [<text>]:
	description: Pick what happens where you knock someone out (from crates).
	executable by: players
	trigger:
		set {_t} to ""
		if arg-1 is set:
			set {_t} to arg-1
		cosPick(player, "killfx", "killfx", "killeffect", {_t})

# ---------- The wardrobe (/cosmetics, the phone's Cosmetics app) ----------
# Owner, 2026-09-26: people can take a title off if they don't want it. /cosmetics shows the three kinds;
# each page lists what you own (click to wear it, the worn one glows) with a "Take it off" button.

command /cosmetics:
	description: Your cosmetics: wear them or take them off.
	aliases: /wardrobe
	executable by: players
	trigger:
		closePhoneMap(player)
		cosMenu(player)

# Owner, 2026-09-26: each kind's page of the wardrobe has its own command too.
command /titles:
	description: Your titles: wear one or take it off.
	executable by: players
	trigger:
		closePhoneMap(player)
		cosPage(player, "title")

command /bagskins:
	description: Your bag skins: pick your bag's look.
	executable by: players
	trigger:
		closePhoneMap(player)
		cosPage(player, "bagskin")

command /killeffects:
	description: Your kill effects: pick one or take it off.
	executable by: players
	trigger:
		closePhoneMap(player)
		cosPage(player, "killfx")

# The chat list (kept for the phone-less and for tests).
function cosList(p: player):
	msg({_p}, "&6Your cosmetics &7(from crates: /crates)")
	loop "title", "bagskin" and "killfx":
		set {_type} to loop-value
		delete {_names::*}
		loop cosOwnedOf({_p}, {_type}):
			add cosColored(loop-value-2) to {_names::*}
		set {_list} to join {_names::*} with "&7, "
		if {_list} is "":
			set {_list} to "&7none yet"
		if {_type} is "title":
			send colored "&7 » Titles &f/title&7: %{_list}%" to {_p}
		else if {_type} is "bagskin":
			send colored "&7 » Bag skins &f/bagskin&7: %{_list}%" to {_p}
		else:
			send colored "&7 » Kill effects &f/killeffect&7: %{_list}%" to {_p}

# What the player wears of a type ("" = nothing / the default look).
function cosWorn(p: player, type: text) :: text:
	if {_type} is "bagskin":
		return bagSkinOf({_p})
	set {_id} to getData({_p}, {_type})
	if {_id} is set:
		if cosOwned({_p}, "%{_id}%") is true:
			return "%{_id}%"
	return ""

# What the player owns of a type: bag skins include the rank's (ranks.sk).
function cosWardrobe(p: player, type: text) :: texts:
	if {_type} is "bagskin":
		return bagSkinsOwned({_p})
	return cosOwnedOf({_p}, {_type})

function cosWornName(p: player, type: text) :: text:
	set {_w} to cosWorn({_p}, {_type})
	if {_w} is "":
		return "&7none"
	if {_type} is "bagskin":
		if cosExists({_w}) is true:
			return cosColored({_w})
		return "&d%bagSkinName({_w})%"
	return cosColored({_w})

function cosClearGui(p: player):
	delete {-cos::gui::%{_p}%}
	delete {-cos::act::%{_p}%::*}

function cosButton(p: player, gui: inventory, slot: number, i: item, act: text):
	set slot {_slot} of {_gui} to {_i}
	set {-cos::act::%{_p}%::%{_slot}%} to {_act}

function cosMenu(p: player):
	set {_gui} to chest inventory with 3 rows named "&8Your cosmetics"
	set {_pane} to gray stained glass pane named "&r"
	loop 27 times:
		set slot (loop-number - 1) of {_gui} to {_pane}
	cosClearGui({_p})
	set {-cos::gui::%{_p}%} to {_gui}
	set {_n} to size of cosWardrobe({_p}, "title")
	set {_wt} to cosWornName({_p}, "title")
	cosButton({_p}, {_gui}, 11, name tag named "&6Titles" with lore "&7After your name in chat and the tab list." and "&7Wearing: %{_wt}%" and "&7You have %{_n}%." and "&eClick to pick or take it off.", "page:title")
	set {_n} to size of cosWardrobe({_p}, "bagskin")
	set {_wb} to cosWornName({_p}, "bagskin")
	cosButton({_p}, {_gui}, 13, leather named "&6Bag skins" with lore "&7How your bag looks." and "&7Wearing: %{_wb}%" and "&7You have %{_n}%." and "&eClick to pick one.", "page:bagskin")
	set {_n} to size of cosWardrobe({_p}, "killfx")
	set {_wk} to cosWornName({_p}, "killfx")
	cosButton({_p}, {_gui}, 15, blaze powder named "&6Kill effects" with lore "&7Where you knock someone out." and "&7Wearing: %{_wk}%" and "&7You have %{_n}%." and "&eClick to pick or take it off.", "page:killfx")
	# The Cosmetics app's main page: "◀ Phone" however it was opened (phone.sk's back buttons).
	cosButton({_p}, {_gui}, 18, phoneBackItem(), "phone")
	cosButton({_p}, {_gui}, 26, barrier named "&cClose", "close")
	open {_gui} to {_p}

function cosPage(p: player, type: text):
	set {_label} to cosTypeName({_type})
	set {_gui} to chest inventory with 6 rows named "&8Your %{_label}%s"
	cosClearGui({_p})
	set {-cos::gui::%{_p}%} to {_gui}
	set {_worn} to cosWorn({_p}, {_type})
	set {_slot} to 0
	loop cosWardrobe({_p}, {_type}):
		{_slot} < 45
		set {_id} to loop-value
		if {_type} is "title":
			set {_i} to name tag
		else if {_type} is "killfx":
			set {_i} to blaze powder
		else:
			set {_i} to leather
			set string list tag "minecraft:custom_model_data;strings" of nbt of {_i} to "donating:bag_%{_id}%"
		if cosExists({_id}) is true:
			set name of {_i} to colored cosColored({_id})
		else:
			set name of {_i} to colored "&d%bagSkinName({_id})% &7(rank)"
		set {_sl} to ""
		if cosExists({_id}) is true:
			set {_sl} to cosSerialLore({_p}, {_id})
		if {_id} is {_worn}:
			if {_sl} is "":
				set lore of {_i} to colored "&aWearing it."
			else:
				set lore of {_i} to colored {_sl} and colored "&aWearing it."
			set {_i} to glint({_i})
		else:
			if {_sl} is "":
				set lore of {_i} to colored "&eClick to wear it."
			else:
				set lore of {_i} to colored {_sl} and colored "&eClick to wear it."
		cosButton({_p}, {_gui}, {_slot}, {_i}, "wear:%{_type}%:%{_id}%")
		add 1 to {_slot}
	if {_slot} is 0:
		set slot 22 of {_gui} to paper named "&7No %{_label}%s yet" with lore "&7They come from crates: &f/crates"
	set {_pane} to gray stained glass pane named "&r"
	loop integers from 45 to 53:
		set slot loop-value of {_gui} to {_pane}
	# Back to /cosmetics, also when /titles, /bagskins or /killeffects opened this page directly.
	cosButton({_p}, {_gui}, 45, backItem("your cosmetics"), "menu")
	if {_type} is "bagskin":
		cosButton({_p}, {_gui}, 49, barrier named "&fDefault look" with lore "&7Your bag tier's own look.", "off:bagskin")
	else:
		cosButton({_p}, {_gui}, 49, barrier named "&fTake it off" with lore "&7Wear no %{_label}%.", "off:%{_type}%")
	cosButton({_p}, {_gui}, 53, barrier named "&cClose", "close")
	open {_gui} to {_p}

# Wear a cosmetic (or "" = take it off / the default bag look).
function cosWear(p: player, type: text, id: text):
	if {_type} is "bagskin":
		if {_id} is "":
			setData({_p}, "bag-skin", "default")
		else if bagSkinsOwned({_p}) contains {_id}:
			setData({_p}, "bag-skin", {_id})
		else:
			stop
		bagRefresh({_p})
	else:
		if {_id} is "":
			deleteData({_p}, {_type})
		else if cosOwned({_p}, {_id}) is true:
			setData({_p}, {_type}, {_id})
		else:
			stop
		if {_type} is "title":
			set {-ph::title::%{_p}%} to titleText({_p})
	play sound "item.armor.equip_leather" with volume 0.6 to {_p}
	cosPage({_p}, {_type})

on inventory click:
	{-cos::gui::%player%} is set
	player's current inventory is {-cos::gui::%player%}
	cancel event
	event-inventory is {-cos::gui::%player%}
	set {_act} to {-cos::act::%player%::%index of event-slot%}
	{_act} is set
	set {_ok} to false
	if click type is left mouse button:
		set {_ok} to true
	else if click type is right mouse button:
		set {_ok} to true
	{_ok} is true
	# One action per drawn screen, a tick later (as in crates.sk).
	if {-cos::gen::%player%} is not set:
		set {-cos::gen::%player%} to 0
	set {_gen} to {-cos::gen::%player%}
	wait 1 tick
	player is online
	{-cos::gui::%player%} is set
	{-cos::gen::%player%} is {_gen}
	add 1 to {-cos::gen::%player%}
	if {_act} starts with "page:":
		cosPage(player, subtext of {_act} from characters 6 to (length of {_act}))
	else if {_act} starts with "wear:":
		set {_a::*} to {_act} split at ":"
		cosWear(player, {_a::2}, {_a::3})
	else if {_act} starts with "off:":
		cosWear(player, subtext of {_act} from characters 5 to (length of {_act}), "")
	else if {_act} is "menu":
		cosMenu(player)
	else if {_act} is "phone":
		# Opening the phone closes this menu; the close handler only clears it.
		openPhone(player)
	else if {_act} is "close":
		close player's inventory

on inventory drag:
	{-cos::gui::%player%} is set
	player's current inventory is {-cos::gui::%player%}
	cancel event

on inventory close:
	{-cos::gui::%player%} is set
	event-inventory is {-cos::gui::%player%}
	cosClearGui(player)

on quit:
	cosClearGui(player)
