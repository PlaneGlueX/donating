# cosmetics.sk: titles, bag skins, kill effects and gun skins. Built 2026-09-26 (owner: crates with bag skins, titles
# and kill effects); gun skins 2026-10-06 (owner: "revamp the gun skin system to have different skin variants of specific
# guns"). They come from crates (crates.sk), and bound (untradeable) ones from levels, seasons, Mara's story, job rep and
# hits.
#
# A cosmetic is core.sk cos::<id>::type|name|rarity (optional ::retired, ::testing):
#   title    a tag after your name in chat and the tab list ("Name «Ghost»"): /title
#   bagskin  the bag's look, whatever tier you carry (the art is tools\make-item-art.js BAGS): /bagskin
#            (ranks.sk; a rank's own skins stay rank-only)
#   killfx   particles and a sound where your victim dies: /killeffect
#   gunskin  a look of one gun (cos::<id>::gun, the WeaponMechanics title; ::model, the pack's item definition):
#            /gunskin, /gunskins. Worn: data gunskin::<title> = the cos id (deleted = the gun's own look), one per gun.
#            DonatingPhone's GunFx puts the model on the player's guns (/dphone gunskin, every gun of gunskin::guns at
#            once, "default" for the rest): at join, on every change, and when a worn one stops being owned (a trade, a
#            Legend losing the rank's retired skins). Skript never sets, deletes or resets the item model of a real gun
#            (WeaponMechanics' pending pump, bolt and reload tasks write into the live stack); only menu icons get one.
# Owned: data cos::<id> = true (saved per player, never taken away except by a trade: trade.sk moves it to the
# other player and takes it off if worn). Chosen: data "title", "killfx"
# ("bag-skin" for bags, ranks.sk). Legends also own every retired and testing cosmetic (owner,
# 2026-09-26: "Receives all testing/retired cosmetics"; core.sk paidrank::<id>::retired-cosmetics),
# checked live, so it follows the rank. Crates never roll a retired or testing cosmetic.
# Looks only: no cosmetic changes what anything does. Log: plugins\Skript\logs\cosmetics.log.

function cosLog(text: text):
	log {_text} to "cosmetics"

function cosExists(id: text) :: boolean:
	if {-cfg::cos::%{_id}%::type} is set:
		return true
	return false

# "&9Cash Print" (the rarity's color and the name).
function cosColored(id: text) :: text:
	set {_r} to {-cfg::cos::%{_id}%::rarity}
	set {_c} to {-cfg::rarity::%{_r}%::color}
	if {_c} is not set:
		set {_c} to "&f"
	return "%{_c}%%{-cfg::cos::%{_id}%::name}%"

# "title" -> "title", "bagskin" -> "bag skin", "killfx" -> "kill effect", "gunskin" -> "gun skin".
function cosTypeName(type: text) :: text:
	if {_type} is "bagskin":
		return "bag skin"
	if {_type} is "killfx":
		return "kill effect"
	if {_type} is "gunskin":
		return "gun skin"
	return {_type}

# A cosmetic as a menu icon, unnamed (the wardrobe, crates.sk, trade.sk): a title a name tag, a kill effect blaze powder,
# a bag skin the bag in that look (a crate's or a rank's id), a gun skin the gun in that look.
function cosIcon(id: text) :: item:
	set {_type} to {-cfg::cos::%{_id}%::type}
	if {_type} is "gunskin":
		return gunSkinIcon("%{-cfg::cos::%{_id}%::gun}%", {_id})
	if {_type} is "title":
		set {_i} to name tag
	else if {_type} is "killfx":
		set {_i} to blaze powder
	else:
		set {_i} to leather
		set string list tag "minecraft:custom_model_data;strings" of nbt of {_i} to "donating:bag_%{_id}%"
	return {_i}

# Retired (no longer in crates) or testing (not released): crates skip it, Legends own it.
function cosHidden(id: text) :: boolean:
	if {-cfg::cos::%{_id}%::retired} is true:
		return true
	if {-cfg::cos::%{_id}%::testing} is true:
		return true
	return false

function cosOwned(p: offline player, id: text) :: boolean:
	if {data::%{_p}%::cos::%{_id}%} is true:
		return true
	# Earned titles (bound: seasons.sk) belong only to whoever earned them; never mark one retired or testing.
	if {-cfg::cos::%{_id}%::bound} is true:
		return false
	if cosHidden({_id}) is true:
		set {_r} to paidRank({_p})
		if {_r} is not "":
			if {-cfg::paidrank::%{_r}%::retired-cosmetics} is true:
				return true
	return false

# Gives a cosmetic: true if it's new, false if the player already had it. A tradeable one gets the next serial.
function cosGive(p: offline player, id: text, why: text) :: boolean:
	if {data::%{_p}%::cos::%{_id}%} is true:
		return false
	set {data::%{_p}%::cos::%{_id}%} to true
	set {_sn} to ""
	if cosSerialized({_id}) is true:
		set {data::%{_p}%::cosserial::%{_id}%} to serialMint("cos:%{_id}%")
		set {_sn} to " serial=%{data::%{_p}%::cosserial::%{_id}%}%"
	cosLog("give %{_p}% %uuid of {_p}% %{_id}% why=%{_why}%%{_sn}%")
	return true

# ---------- Serials ----------
# Owner, 2026-09-27: rare items are numbered so their value can be judged in trades: "#3/57" = the 3rd copy ever
# unlocked, of 57 so far (the count grows as more people unlock it from crates; a retired one's stops). Every
# tradeable copy has one: crate cosmetics here, crate cars in garage.sk ({carserial::<plate>}). A rank's or an
# earned (bound) cosmetic has none (never traded). Saved: {serial::<key>} = copies made ("cos:<id>", "car:<id>");
# data cosserial::<id> = the number of a player's copy; a trade moves it with the item.

function serialMint(key: text) :: number:
	if {serial::%{_key}%} is not set:
		set {serial::%{_key}%} to 0
	add 1 to {serial::%{_key}%}
	return {serial::%{_key}%}

function serialTotal(key: text) :: number:
	if {serial::%{_key}%} is set:
		return {serial::%{_key}%}
	return 0

# "#3/57" (the copy's number of the copies made so far).
function serialText(key: text, n: number) :: text:
	return "#%{_n}%/%serialTotal({_key})%"

# Tradeable, so numbered: every cosmetic but an earned (bound) one.
function cosSerialized(id: text) :: boolean:
	if cosExists({_id}) is false:
		return false
	if {-cfg::cos::%{_id}%::bound} is true:
		return false
	return true

# The number of the player's own copy (0 = none: not owned, or only through a rank). A copy from before serials
# existed is numbered the first time it's asked for.
function cosSerial(p: offline player, id: text) :: number:
	if {data::%{_p}%::cos::%{_id}%} is not true:
		return 0
	if cosSerialized({_id}) is false:
		return 0
	if {data::%{_p}%::cosserial::%{_id}%} is not set:
		set {data::%{_p}%::cosserial::%{_id}%} to serialMint("cos:%{_id}%")
		cosLog("serial %{_p}% %uuid of {_p}% %{_id}% serial=%{data::%{_p}%::cosserial::%{_id}%}% (numbered late)")
	return {data::%{_p}%::cosserial::%{_id}%}

# " &7#3/57" after a name, or "" when the player's copy has no serial.
function cosSerialText(p: offline player, id: text) :: text:
	set {_n} to cosSerial({_p}, {_id})
	if {_n} < 1:
		return ""
	set {_k} to "cos:%{_id}%"
	return " &7%serialText({_k}, {_n})%"

# The lore line for a numbered copy: "Serial #3 of 57" (+ "no more are made" once retired).
function cosSerialLore(p: offline player, id: text) :: text:
	set {_n} to cosSerial({_p}, {_id})
	if {_n} < 1:
		return ""
	set {_t} to serialTotal("cos:%{_id}%")
	if {-cfg::cos::%{_id}%::retired} is true:
		return "&7Serial &f#%{_n}% &7of %{_t}% &7(retired: no more are made)"
	return "&7Serial &f#%{_n}% &7of %{_t}% so far"

# Every cosmetic of a type the player owns, in core.sk's order.
function cosOwnedOf(p: offline player, type: text) :: texts:
	loop {-cfg::cosmetics::*}:
		if {-cfg::cos::%loop-value%::type} is {_type}:
			if cosOwned({_p}, loop-value) is true:
				add loop-value to {_out::*}
	return {_out::*}

# The id of a cosmetic of that type typed by a player: its id or its name, any case, spaces optional
# ("smooth operator", "SmoothOperator", "smooth"); "" when there's none.
function cosFind(type: text, typed: text) :: text:
	set {_t} to {_typed} in lower case
	replace all " " with "" in {_t}
	loop {-cfg::cosmetics::*}:
		if {-cfg::cos::%loop-value%::type} is {_type}:
			if loop-value is {_t}:
				return loop-value
			set {_n} to {-cfg::cos::%loop-value%::name} in lower case
			replace all " " with "" in {_n}
			if {_n} is {_t}:
				return loop-value
	return ""

# ---------- Titles ----------

# " &a«Ghost»" for the chosen title (if still owned), else "&r" (PlaceholderAPI would show the raw
# placeholder for an empty text).
function titleText(p: player) :: text:
	set {_id} to getData({_p}, "title")
	if {_id} is set:
		if cosExists({_id}) is true:
			if cosOwned({_p}, {_id}) is true:
				set {_r} to {-cfg::cos::%{_id}%::rarity}
				set {_c} to {-cfg::rarity::%{_r}%::color}
				return " %{_c}%«%{-cfg::cos::%{_id}%::name}%»&r"
	return "&r"

# LPC (chat) and TAB (tab list) read %donating_title% from another thread: a copy in memory.
every second:
	loop all players:
		set {-ph::title::%loop-player%} to titleText(loop-player)

on join:
	set {-ph::title::%player%} to titleText(player)

on quit:
	delete {-ph::title::%player%}

# ---------- Kill effects ----------

# The killer's chosen effect where the victim died. Players only: cops (Citizens NPCs, "NPC" metadata),
# traps, falls and combat logs have no effect.
on death of player:
	attacker is a player
	attacker does not have metadata "NPC"
	attacker is not victim
	# A hit target (hits.sk) is seen by its hunter only: no particles for everyone else. (Its NPC metadata is gone by
	# now: hits.sk flags it at the lowest priority.)
	{-hit::deadnpc::%uuid of victim%} is not set
	set {_id} to getData(attacker, "killfx")
	{_id} is set
	cosOwned(attacker, {_id}) is true
	killFx({_id}, location of victim)

function killFx(id: text, l: location):
	set {_c} to {_l} ~ vector(0, 1, 0)
	if {_id} is "poof":
		draw 30 poof particles with offset vector(0.3, 0.5, 0.3) at {_c}
		play sound "block.fire.extinguish" with volume 0.8 at {_c}
	else if {_id} is "smoke":
		draw 30 large smoke particles with offset vector(0.4, 0.6, 0.4) at {_c}
		play sound "entity.generic.extinguish_fire" with volume 0.8 at {_c}
	else if {_id} is "flames":
		draw 50 flame particles with offset vector(0.3, 0.8, 0.3) at {_c}
		play sound "item.firecharge.use" with volume 0.8 at {_c}
	else if {_id} is "sparks":
		draw 40 electric spark particles with offset vector(0.4, 0.8, 0.4) at {_c}
		draw 20 crit particles with offset vector(0.4, 0.8, 0.4) at {_c}
		play sound "entity.firework_rocket.twinkle" with volume 0.8 at {_c}
	else if {_id} is "cashburst":
		draw 30 happy villager particles with offset vector(0.5, 0.8, 0.5) at {_c}
		draw 20 wax on particles with offset vector(0.5, 0.8, 0.5) at {_c}
		play sound "entity.experience_orb.pickup" with volume 1 at {_c}
	else if {_id} is "souls":
		draw 25 soul particles with offset vector(0.4, 0.6, 0.4) at {_c}
		draw 20 soul fire flame particles with offset vector(0.3, 0.8, 0.3) at {_c}
		play sound "particle.soul_escape" with volume 1 at {_c}
	else if {_id} is "fireworks":
		draw 60 firework particles with offset vector(0.5, 0.8, 0.5) at {_c}
		play sound "entity.firework_rocket.blast" with volume 1 at {_c}
		play sound "entity.firework_rocket.twinkle" with volume 0.8 at {_c}
	else if {_id} is "stormcloud":
		draw 30 large smoke particles with offset vector(0.6, 0.2, 0.6) at {_c} ~ vector(0, 1.2, 0)
		draw 40 electric spark particles with offset vector(0.3, 1, 0.3) at {_c}
		play sound "entity.lightning_bolt.impact" with volume 0.7 at {_c}
	else if {_id} is "dragon":
		draw 60 dragon breath particles with offset vector(0.5, 0.8, 0.5) at {_c}
		draw 20 end rod particles with offset vector(0.4, 0.8, 0.4) at {_c}
		play sound "entity.ender_dragon.growl" with volume 0.4 at {_c}
	else if {_id} is "totem":
		draw 60 totem of undying particles with offset vector(0.4, 0.8, 0.4) at {_c}
		play sound "item.totem.use" with volume 0.6 at {_c}
	else if {_id} is "lvl_crown":
		# Level 150: a gold ring over the victim, like a crown.
		set {_top} to {_c} ~ vector(0, 1.2, 0)
		loop 16 times:
			set {_a} to loop-number * 22.5
			draw 1 wax on particle with offset vector(0, 0, 0) at {_top} ~ vector(cos({_a}) * 0.45, 0, sin({_a}) * 0.45)
			draw 1 end rod particle with offset vector(0, 0.05, 0) at {_top} ~ vector(cos({_a}) * 0.45, 0.15, sin({_a}) * 0.45)
		draw 20 totem of undying particles with offset vector(0.3, 0.6, 0.3) at {_c}
		play sound "entity.player.levelup" with volume 0.8 at {_c}
	else if {_id} is "lvl_moneyrain":
		# Level 200: cash raining down.
		draw 50 happy villager particles with offset vector(0.8, 0.2, 0.8) at {_c} ~ vector(0, 1.5, 0)
		draw 40 wax on particles with offset vector(0.8, 1, 0.8) at {_c}
		draw 20 end rod particles with offset vector(0.6, 0.3, 0.6) at {_c} ~ vector(0, 2, 0)
		play sound "block.chain.break" with volume 0.8 at {_c}
		play sound "entity.experience_orb.pickup" with volume 1 at {_c}
	else if {_id} is "glitch":
		draw 30 end rod particles with offset vector(0.3, 0.9, 0.3) at {_c}
		draw 30 sculk soul particles with offset vector(0.4, 0.8, 0.4) at {_c}
		draw 20 glow particles with offset vector(0.4, 0.8, 0.4) at {_c}
		play sound "block.beacon.deactivate" with volume 1 at {_c}

# ---------- Commands ----------

# /title and /killeffect: no argument lists yours, "none" takes it off, a name picks it.
function cosPick(p: player, type: text, key: text, cmd: text, typed: text):
	set {_label} to cosTypeName({_type})
	set {_owned::*} to cosOwnedOf({_p}, {_type})
	if {_typed} is "":
		if size of {_owned::*} is 0:
			msg({_p}, "&7You have no %{_label}%s yet.")
			stop
		loop {_owned::*}:
			add cosColored(loop-value) to {_names::*}
		set {_list} to join {_names::*} with "&7, "
		set {_now} to getData({_p}, {_key})
		set {_nowText} to "none"
		if {_now} is set:
			if {_owned::*} contains {_now}:
				set {_nowText} to cosColored({_now})
		msg({_p}, "&6Your %{_label}%s: %{_list}% &7(now: %{_nowText}%&7) &f/%{_cmd}% <name> &7or &fnone")
		stop
	if {_typed} is "none":
		deleteData({_p}, {_key})
		msg({_p}, "&aNo %{_label}% now.")
		stop
	set {_id} to cosFind({_type}, {_typed})
	if {_id} is "":
		msg({_p}, "&cThere's no %{_label}% called %{_typed}%. &7/%{_cmd}% lists yours.")
		stop
	if cosOwned({_p}, {_id}) is false:
		msg({_p}, "&cYou don't have %cosColored({_id})%&c.")
		stop
	setData({_p}, {_key}, {_id})
	if {_type} is "title":
		set {-ph::title::%{_p}%} to titleText({_p})
	msg({_p}, "&aYour %{_label}%: %cosColored({_id})%&a.")

command /title [<text>]:
	description: Pick the title after your name.
	executable by: players
	trigger:
		set {_t} to ""
		if arg-1 is set:
			set {_t} to arg-1
		cosPick(player, "title", "title", "title", {_t})

command /killeffect [<text>]:
	description: Pick your kill effect.
	executable by: players
	trigger:
		set {_t} to ""
		if arg-1 is set:
			set {_t} to arg-1
		cosPick(player, "killfx", "killfx", "killeffect", {_t})

# ---------- Gun skins ----------
# 2026-10-06 (the owner: "revamp the gun skin system to have different skin variants of specific guns"). core.sk lists the
# skins (cos::<id>::type "gunskin", ::gun, ::look, ::model) and the wardrobe's guns ({-cfg::gunskin::guns::*}, shop order).
# One worn per gun: data gunskin::<title> = the cos id; it counts only while the player owns it and it's that gun's
# (gunSkinWorn), else it's taken off at the next check (join, a trade, the rank changing). GunFx (DonatingPhone) keeps the
# looks in the player's PDC and puts them on the guns in place; gunSkinPush sends it every gun's look at once.

# The cos id of the skin the player wears on a gun ("" = the gun's own look).
function gunSkinWorn(p: offline player, w: text) :: text:
	set {_v} to getData({_p}, "gunskin::%{_w}%")
	if {_v} is set:
		set {_id} to "%{_v}%"
		if {-cfg::cos::%{_id}%::type} is "gunskin":
			if "%{-cfg::cos::%{_id}%::gun}%" is {_w}:
				if cosOwned({_p}, {_id}) is true:
					return {_id}
	return ""

# Every skin of a gun the player owns (core.sk's order).
function gunSkinsOwned(p: offline player, w: text) :: texts:
	loop cosOwnedOf({_p}, "gunskin"):
		if "%{-cfg::cos::%loop-value%::gun}%" is {_w}:
			add loop-value to {_out::*}
	return {_out::*}

# Every skin a gun has (owned or not, retired and testing included).
function gunSkinsOf(w: text) :: texts:
	loop {-cfg::cosmetics::*}:
		if {-cfg::cos::%loop-value%::type} is "gunskin":
			if "%{-cfg::cos::%loop-value%::gun}%" is {_w}:
				add loop-value to {_out::*}
	return {_out::*}

# The gun as a menu icon in a look ("" = its own): the shop's model number, plus the skin's item model. A fresh item,
# never a player's gun (only menu icons get an item model from Skript).
function gunSkinIcon(w: text, id: text) :: item:
	set {_i} to wpnIcon({_w})
	if {_id} is not "":
		set {_m} to {-cfg::cos::%{_id}%::model}
		# gunskin::icons false: menus draw every gun in its own look (with gunfx.skins.enabled false, for a pack without
		# the skins; else these icons would be the missing-model cube).
		if {_m} is set:
			if {-cfg::gunskin::icons} is not false:
				set item model of {_i} to "%{_m}%"
	return {_i}

# "&6Golden" (the look in its rarity's color), "&7default" for none.
function gunSkinLookText(id: text) :: text:
	if {_id} is "":
		return "&7default"
	set {_r} to {-cfg::cos::%{_id}%::rarity}
	set {_c} to {-cfg::rarity::%{_r}%::color}
	if {_c} is not set:
		set {_c} to "&f"
	return "%{_c}%%{-cfg::cos::%{_id}%::look}%"

# Tells GunFx every gun's look at once (/dphone gunskin <uuid> <title>=<model|default> ...): explicit "default" for a gun
# with no skin worn, so a look taken off (or traded away) comes off the gun too.
function gunSkinPush(p: player):
	loop {-cfg::gunskin::guns::*}:
		set {_id} to gunSkinWorn({_p}, loop-value)
		set {_m} to "default"
		if {_id} is not "":
			set {_m} to "%{-cfg::cos::%{_id}%::model}%"
		add "%loop-value%=%{_m}%" to {_parts::*}
	set {_line} to join {_parts::*} with " "
	execute console command "dphone gunskin %uuid of {_p}% %{_line}%"

# Takes off every worn skin the player doesn't own any more (or that isn't that gun's); true if one came off.
function gunSkinCheck(p: player) :: boolean:
	set {_changed} to false
	loop {-cfg::gunskin::guns::*}:
		set {_v} to getData({_p}, "gunskin::%loop-value%")
		if {_v} is set:
			if gunSkinWorn({_p}, loop-value) is "":
				deleteData({_p}, "gunskin::%loop-value%")
				cosLog("unworn-gunskin %{_p}% %uuid of {_p}% %loop-value% %{_v}% (not owned)")
				set {_changed} to true
	return {_changed}

# Wears a skin on a gun ("" = the gun's own look) and tells GunFx; false (nothing changes) for a skin that isn't owned or
# isn't that gun's.
function gunSkinWear(p: player, w: text, id: text) :: boolean:
	if {-cfg::gunskin::guns::*} does not contain {_w}:
		return false
	if {_id} is "":
		deleteData({_p}, "gunskin::%{_w}%")
	else:
		if {-cfg::cos::%{_id}%::type} is not "gunskin":
			return false
		if "%{-cfg::cos::%{_id}%::gun}%" is not {_w}:
			return false
		if cosOwned({_p}, {_id}) is false:
			return false
		setData({_p}, "gunskin::%{_w}%", {_id})
	set {_what} to {_id}
	if {_id} is "":
		set {_what} to "default"
	cosLog("wear-gunskin %{_p}% %uuid of {_p}% %{_w}% %{_what}%")
	gunSkinPush({_p})
	return true

# A typed text without spaces, "_" and "-", in lower case ("AK-48" -> "ak48", "50_GS" -> "50gs").
function gunSkinKey(t: text) :: text:
	set {_k} to {_t} in lower case
	replace all " " with "" in {_k}
	replace all "_" with "" in {_k}
	replace all "-" with "" in {_k}
	return {_k}

# The gun a player typed: its title or its name, any case, spaces optional ("" = none).
function gunSkinFindGun(typed: text) :: text:
	set {_t} to gunSkinKey({_typed})
	if {_t} is "":
		return ""
	loop {-cfg::gunskin::guns::*}:
		if gunSkinKey(loop-value) is {_t}:
			return loop-value
		if gunSkinKey("%{-cfg::wpn::%loop-value%::name}%") is {_t}:
			return loop-value
	return ""

# A skin a player typed: its id, look or full name, of that gun ("" = any gun); "" = none.
function gunSkinFind(w: text, typed: text) :: text:
	set {_t} to gunSkinKey({_typed})
	if {_t} is "":
		return ""
	loop {-cfg::cosmetics::*}:
		if {-cfg::cos::%loop-value%::type} is "gunskin":
			set {_ok} to true
			if {_w} is not "":
				if "%{-cfg::cos::%loop-value%::gun}%" is not {_w}:
					set {_ok} to false
			if {_ok} is true:
				if gunSkinKey(loop-value) is {_t}:
					return loop-value
				if gunSkinKey("%{-cfg::cos::%loop-value%::look}%") is {_t}:
					return loop-value
				if gunSkinKey("%{-cfg::cos::%loop-value%::name}%") is {_t}:
					return loop-value
	return ""

# /gunskin: nothing lists your skins per gun; a gun lists that gun's; a gun and a look (or "default") wears it; a skin's
# full name alone wears it too ("/gunskin golden ak-48").
function gunSkinCmd(p: player, typed: text):
	if {_typed} is "":
		set {_any} to false
		loop {-cfg::gunskin::guns::*}:
			set {_w} to loop-value
			set {_own::*} to gunSkinsOwned({_p}, {_w})
			if size of {_own::*} > 0:
				if {_any} is false:
					msg({_p}, "&6Your gun skins &7(/gunskin <gun> <look>, or &fdefault&7):")
					set {_any} to true
				delete {_names::*}
				loop {_own::*}:
					add gunSkinLookText(loop-value-2) to {_names::*}
				set {_list} to join {_names::*} with "&7, "
				set {_now} to gunSkinLookText(gunSkinWorn({_p}, {_w}))
				send colored "&7 » &f%{-cfg::wpn::%{_w}%::name}%&7: %{_list}% &7(now: %{_now}%&7)" to {_p}
		if {_any} is false:
			msg({_p}, "&7You have no gun skins yet.")
		stop
	# The gun is the longest run of first words that names one; the rest is the look.
	set {_words::*} to {_typed} split at " "
	set {_w} to ""
	set {_rest} to ""
	set {_acc} to ""
	set {_c} to 0
	set {_best} to 0
	loop {_words::*}:
		add 1 to {_c}
		set {_acc} to "%{_acc}% %loop-value%"
		set {_g} to gunSkinFindGun({_acc})
		if {_g} is not "":
			set {_w} to {_g}
			set {_best} to {_c}
	set {_c} to 0
	loop {_words::*}:
		add 1 to {_c}
		if {_c} > {_best}:
			add loop-value to {_tail::*}
	if {_tail::*} is set:
		set {_rest} to join {_tail::*} with " "
	if {_w} is "":
		# No gun named: a skin's full name (or its look, if only one gun has it).
		set {_id} to gunSkinFind("", {_typed})
		if {_id} is "":
			msg({_p}, "&cThere's no gun or gun skin called %{_typed}%. &7/gunskin lists yours.")
			stop
		set {_w} to "%{-cfg::cos::%{_id}%::gun}%"
		set {_rest} to {_id}
	set {_gun} to {-cfg::wpn::%{_w}%::name}
	if {_rest} is "":
		set {_own::*} to gunSkinsOwned({_p}, {_w})
		if size of {_own::*} is 0:
			msg({_p}, "&7You have no %{_gun}% skins yet.")
			stop
		loop {_own::*}:
			add gunSkinLookText(loop-value) to {_names::*}
		set {_list} to join {_names::*} with "&7, "
		set {_now} to gunSkinLookText(gunSkinWorn({_p}, {_w}))
		msg({_p}, "&6Your %{_gun}% skins: %{_list}% &7(now: %{_now}%&7)")
		stop
	set {_lr} to {_rest} in lower case
	if {_lr} is "default":
		set {_lr} to "none"
	if {_lr} is "none":
		gunSkinWear({_p}, {_w}, "")
		msg({_p}, "&aYour %{_gun}%: its own look.")
		stop
	set {_id} to gunSkinFind({_w}, {_rest})
	if {_id} is "":
		msg({_p}, "&cThere's no %{_gun}% skin called %{_rest}%. &7/gunskin %gunSkinKey({_gun})% lists yours.")
		stop
	if cosOwned({_p}, {_id}) is false:
		msg({_p}, "&cYou don't have %cosColored({_id})%&c.")
		stop
	gunSkinWear({_p}, {_w}, {_id})
	msg({_p}, "&aYour %{_gun}%: %cosColored({_id})%&a.")

command /gunskin [<text>]:
	description: Pick a gun's look: /gunskin <gun> <look|default>.
	executable by: players
	trigger:
		set {_t} to ""
		if arg-1 is set:
			set {_t} to arg-1
		gunSkinCmd(player, {_t})

command /gunskins:
	description: Your gun skins: pick each gun's look.
	executable by: players
	trigger:
		closePhoneMap(player)
		gunSkinMenu(player)

# The wardrobe's Gun skins page (status "Gun skins"): 2 ◀ Cosmetics, one gun a tile in its worn look (the guns in shop
# order on the screen's first slots), 49 home. A tile: the look, how many skins you have for it, and whether you have the
# gun yet (skins can be worn before it's bought: they're on it when it comes).
function gunSkinMenu(p: player):
	set {_gui} to phonePage("Gun skins")
	cosClearGui({_p})
	set {-cos::gui::%{_p}%} to {_gui}
	set {_slots::*} to phoneSlots()
	set {_k} to 0
	loop {-cfg::gunskin::guns::*}:
		add 1 to {_k}
		set {_w} to loop-value
		set {_worn} to gunSkinWorn({_p}, {_w})
		set {_i} to gunSkinIcon({_w}, {_worn})
		set name of {_i} to colored "&f%{-cfg::wpn::%{_w}%::name}%"
		delete {_l::*}
		add "&7Look: %gunSkinLookText({_worn})%" to {_l::*}
		set {_n} to size of gunSkinsOwned({_p}, {_w})
		add "&7Skins: &f%{_n}%" to {_l::*}
		if getData({_p}, "wpn::%{_w}%") is not true:
			add "&7Not bought" to {_l::*}
			set {_need} to wpnLevel({_w})
			if levelOk({_p}, {_need}) is false:
				add "&7Unlocks at level %{_need}%" to {_l::*}
		set lore of {_i} to colored {_l::*}
		if {_worn} is not "":
			set {_i} to glint({_i})
		cosButton({_p}, {_gui}, {_slots::%{_k}%}, {_i}, "gun:%{_w}%")
	cosButton({_p}, {_gui}, 2, phoneBackIcon("Cosmetics"), "menu")
	cosButton({_p}, {_gui}, 49, phoneHomeIcon(), "phone")
	open {_gui} to {_p}

# A gun's page (status: its name): 2 ◀ Gun skins, 4 its own look ("Default look"), 5/6 the page arrows, the skins you own
# for it on the screen (20 a page; the worn one glows and says so, each with its serial), 49 home. A click wears it.
function gunSkinPage(p: player, w: text):
	set {_name} to "%{-cfg::wpn::%{_w}%::name}%"
	set {_gui} to phonePage({_name})
	cosClearGui({_p})
	set {-cos::gui::%{_p}%} to {_gui}
	set {_worn} to gunSkinWorn({_p}, {_w})
	set {_all::*} to gunSkinsOwned({_p}, {_w})
	set {_count} to size of {_all::*}
	set {_pages} to max(1, ceil({_count} / 20))
	set {_page} to 1
	set {_pp::*} to "%{-cos::page::%{_p}%}%" split at "|"
	if {_pp::1} is "gun:%{_w}%":
		set {_page} to {_pp::2} parsed as integer
		if {_page} is not set:
			set {_page} to 1
	if {_page} > {_pages}:
		set {_page} to {_pages}
	if {_page} < 1:
		set {_page} to 1
	set {-cos::page::%{_p}%} to "gun:%{_w}%|%{_page}%"
	set {_slots::*} to phoneSlots()
	set {_first} to ({_page} - 1) * 20
	set {_k} to 0
	loop {_all::*}:
		add 1 to {_k}
		if {_k} > {_first}:
			if {_k} <= {_first} + 20:
				set {_id} to loop-value
				set {_i} to gunSkinIcon({_w}, {_id})
				set name of {_i} to colored cosColored({_id})
				delete {_l::*}
				set {_sl} to cosSerialLore({_p}, {_id})
				if {_sl} is not "":
					add {_sl} to {_l::*}
				if {_id} is {_worn}:
					add "&aWearing it" to {_l::*}
					set {_i} to glint({_i})
				if size of {_l::*} > 0:
					set lore of {_i} to colored {_l::*}
				set {_s} to {_k} - {_first}
				cosButton({_p}, {_gui}, {_slots::%{_s}%}, {_i}, "wear:gunskin:%{_id}%")
	if {_count} is 0:
		set slot 22 of {_gui} to phoneEmptyIcon("No %{_name}% skins yet")
	set {_d} to gunSkinIcon({_w}, "")
	set name of {_d} to colored "&fDefault look"
	if {_worn} is "":
		set lore of {_d} to colored "&aWearing it"
		set {_d} to glint({_d})
	cosButton({_p}, {_gui}, 4, {_d}, "off:gunskin:%{_w}%")
	cosButton({_p}, {_gui}, 2, phoneBackIcon("Gun skins"), "guns")
	if {_page} > 1:
		cosButton({_p}, {_gui}, 5, phonePrevIcon({_page}), "gpg:%{_w}%|%{_page} - 1%")
	if {_page} < {_pages}:
		cosButton({_p}, {_gui}, 6, phoneNextIcon({_page}), "gpg:%{_w}%|%{_page} + 1%")
	cosButton({_p}, {_gui}, 49, phoneHomeIcon(), "phone")
	open {_gui} to {_p}

# At join (a second in: LuckPerms' groups and DonatingPhone's join pass first): worn skins still owned, then every gun's
# look to GunFx (the choices are in the player file too, but what's owned may have changed while they were away).
on join:
	wait 1 second
	player is online
	gunSkinCheck(player)
	gunSkinPush(player)

# What a player owns can change while they wear it: a Legend owns every retired and testing skin only while Legend, and
# staff can take one away. Every 5 seconds a worn skin that isn't owned any more comes off (only players wearing one are
# looked at; a few variable reads each).
every 5 seconds:
	loop all players:
		if {data::%loop-player%::gunskin::*} is set:
			if gunSkinCheck(loop-player) is true:
				gunSkinPush(loop-player)

# ---------- The wardrobe (/cosmetics, the phone's Cosmetics app) ----------
# Owner, 2026-09-26: people can take a title off if they don't want it. /cosmetics shows the three kinds;
# each page lists what you own (click to wear it, the worn one glows) with a "Take it off" button. Owner,
# 2026-09-29 ("get rid of obvious explanations"): the buttons show only state (worn, owned, serials).

command /cosmetics:
	description: Your cosmetics: wear them or take them off.
	aliases: /wardrobe
	executable by: players
	trigger:
		closePhoneMap(player)
		cosMenu(player)

# Owner, 2026-09-26: each kind's page of the wardrobe has its own command too.
command /titles:
	description: Your titles: wear one or take it off.
	executable by: players
	trigger:
		closePhoneMap(player)
		cosPage(player, "title")

command /bagskins:
	description: Your bag skins: pick your bag's look.
	executable by: players
	trigger:
		closePhoneMap(player)
		cosPage(player, "bagskin")

command /killeffects:
	description: Your kill effects: pick one or take it off.
	executable by: players
	trigger:
		closePhoneMap(player)
		cosPage(player, "killfx")

# The chat list (kept for the phone-less and for tests).
function cosList(p: player):
	msg({_p}, "&6Your cosmetics")
	loop "title", "bagskin" and "killfx":
		set {_type} to loop-value
		delete {_names::*}
		loop cosOwnedOf({_p}, {_type}):
			add cosColored(loop-value-2) to {_names::*}
		set {_list} to join {_names::*} with "&7, "
		if {_list} is "":
			set {_list} to "&7none yet"
		if {_type} is "title":
			send colored "&7 » Titles &f/title&7: %{_list}%" to {_p}
		else if {_type} is "bagskin":
			send colored "&7 » Bag skins &f/bagskin&7: %{_list}%" to {_p}
		else:
			send colored "&7 » Kill effects &f/killeffect&7: %{_list}%" to {_p}
	delete {_names::*}
	loop cosOwnedOf({_p}, "gunskin"):
		add cosColored(loop-value) to {_names::*}
	set {_list} to join {_names::*} with "&7, "
	if {_list} is "":
		set {_list} to "&7none yet"
	send colored "&7 » Gun skins &f/gunskin&7: %{_list}%" to {_p}

# What the player wears of a type ("" = nothing / the default look).
function cosWorn(p: player, type: text) :: text:
	if {_type} is "bagskin":
		return bagSkinOf({_p})
	set {_id} to getData({_p}, {_type})
	if {_id} is set:
		if cosOwned({_p}, "%{_id}%") is true:
			return "%{_id}%"
	return ""

# What the player owns of a type: bag skins include the rank's (ranks.sk).
function cosWardrobe(p: player, type: text) :: texts:
	if {_type} is "bagskin":
		return bagSkinsOwned({_p})
	return cosOwnedOf({_p}, {_type})

function cosWornName(p: player, type: text) :: text:
	set {_w} to cosWorn({_p}, {_type})
	if {_w} is "":
		if {_type} is "bagskin":
			return "&7default"
		return "&7none"
	if {_type} is "bagskin":
		if cosExists({_w}) is true:
			return cosColored({_w})
		return "&d%bagSkinName({_w})%"
	return cosColored({_w})

function cosClearGui(p: player):
	delete {-cos::gui::%{_p}%}
	delete {-cos::act::%{_p}%::*}

function cosButton(p: player, gui: inventory, slot: number, i: item, act: text):
	set slot {_slot} of {_gui} to {_i}
	set {-cos::act::%{_p}%::%{_slot}%} to {_act}

# The wardrobe's pages are phone pages (ui.sk, owner 2026-09-29). /cosmetics: 2 ◀ Phone, the kinds at 11-13, 49 home.
function cosMenu(p: player):
	set {_gui} to phonePage("Cosmetics")
	cosClearGui({_p})
	set {-cos::gui::%{_p}%} to {_gui}
	set {_n} to size of cosWardrobe({_p}, "title")
	set {_wt} to cosWornName({_p}, "title")
	cosButton({_p}, {_gui}, 11, name tag named "&6Titles" with lore "&7Wearing: %{_wt}%" and "&7Owned: &f%{_n}%", "page:title")
	set {_n} to size of cosWardrobe({_p}, "bagskin")
	set {_wb} to cosWornName({_p}, "bagskin")
	cosButton({_p}, {_gui}, 12, leather named "&6Bag skins" with lore "&7Wearing: %{_wb}%" and "&7Owned: &f%{_n}%", "page:bagskin")
	set {_n} to size of cosWardrobe({_p}, "killfx")
	set {_wk} to cosWornName({_p}, "killfx")
	cosButton({_p}, {_gui}, 13, blaze powder named "&6Kill effects" with lore "&7Wearing: %{_wk}%" and "&7Owned: &f%{_n}%", "page:killfx")
	# Gun skins (2026-10-06): the AK-48 in the look you wear on it; a page of guns, then each gun's skins.
	set {_n} to size of cosOwnedOf({_p}, "gunskin")
	set {_gi} to gunSkinIcon("AK_47", gunSkinWorn({_p}, "AK_47"))
	set name of {_gi} to colored "&6Gun skins"
	set lore of {_gi} to colored "&7Owned: &f%{_n}%"
	cosButton({_p}, {_gui}, 14, {_gi}, "guns")
	# The Cosmetics app's main page: "◀ Phone" however it was opened (phone.sk's back buttons).
	cosButton({_p}, {_gui}, 2, phoneBackIcon("Phone"), "phone")
	cosButton({_p}, {_gui}, 49, phoneHomeIcon(), "phone")
	open {_gui} to {_p}

# A kind's page: status "Titles" / "Bag skins" / "Kill effects", 2 ◀ Cosmetics, 4 take it off (the default bag look),
# 5/6 the page arrows, what you own on the screen, 20 a page (titles pass 34 and grow every season). The page is kept
# while the same kind is redrawn (wearing one); a new kind or a closed menu starts at page 1.
function cosPage(p: player, type: text):
	set {_label} to cosTypeName({_type})
	set {_status} to "Titles"
	if {_type} is "bagskin":
		set {_status} to "Bag skins"
	else if {_type} is "killfx":
		set {_status} to "Kill effects"
	set {_gui} to phonePage({_status})
	cosClearGui({_p})
	set {-cos::gui::%{_p}%} to {_gui}
	set {_worn} to cosWorn({_p}, {_type})
	set {_all::*} to cosWardrobe({_p}, {_type})
	set {_count} to size of {_all::*}
	set {_pages} to max(1, ceil({_count} / 20))
	set {_page} to 1
	set {_pp::*} to "%{-cos::page::%{_p}%}%" split at "|"
	if {_pp::1} is {_type}:
		set {_page} to {_pp::2} parsed as integer
		if {_page} is not set:
			set {_page} to 1
	if {_page} > {_pages}:
		set {_page} to {_pages}
	if {_page} < 1:
		set {_page} to 1
	set {-cos::page::%{_p}%} to "%{_type}%|%{_page}%"
	set {_slots::*} to phoneSlots()
	set {_first} to ({_page} - 1) * 20
	set {_k} to 0
	loop {_all::*}:
		add 1 to {_k}
		if {_k} > {_first}:
			if {_k} <= {_first} + 20:
				set {_id} to loop-value
				set {_i} to cosIcon({_id})
				if cosExists({_id}) is true:
					set name of {_i} to colored cosColored({_id})
				else:
					set name of {_i} to colored "&d%bagSkinName({_id})% &7(rank)"
				set {_sl} to ""
				if cosExists({_id}) is true:
					set {_sl} to cosSerialLore({_p}, {_id})
				# The worn one glows and says so; the rest only show their serial (a click wears it).
				if {_id} is {_worn}:
					if {_sl} is "":
						set lore of {_i} to colored "&aWearing it"
					else:
						set lore of {_i} to colored {_sl} and colored "&aWearing it"
					set {_i} to glint({_i})
				else if {_sl} is not "":
					set lore of {_i} to colored {_sl}
				set {_s} to {_k} - {_first}
				cosButton({_p}, {_gui}, {_slots::%{_s}%}, {_i}, "wear:%{_type}%:%{_id}%")
	if {_count} is 0:
		set slot 22 of {_gui} to phoneEmptyIcon("No %{_label}%s yet")
	# Back to /cosmetics, also when /titles, /bagskins or /killeffects opened this page directly.
	cosButton({_p}, {_gui}, 2, phoneBackIcon("Cosmetics"), "menu")
	if {_type} is "bagskin":
		cosButton({_p}, {_gui}, 4, barrier named "&fDefault look", "off:bagskin")
	else:
		cosButton({_p}, {_gui}, 4, barrier named "&fTake it off", "off:%{_type}%")
	if {_page} > 1:
		cosButton({_p}, {_gui}, 5, phonePrevIcon({_page}), "pg:%{_type}%|%{_page} - 1%")
	if {_page} < {_pages}:
		cosButton({_p}, {_gui}, 6, phoneNextIcon({_page}), "pg:%{_type}%|%{_page} + 1%")
	cosButton({_p}, {_gui}, 49, phoneHomeIcon(), "phone")
	open {_gui} to {_p}

# Wear a cosmetic (or "" = take it off / the default bag look). A gun skin goes on its own gun (gunSkinWear; the
# default look of a gun is "off:gunskin:<title>" in the menu).
function cosWear(p: player, type: text, id: text):
	if {_type} is "gunskin":
		set {_w} to "%{-cfg::cos::%{_id}%::gun}%"
		if gunSkinWear({_p}, {_w}, {_id}) is true:
			play sound "item.armor.equip_chain" with volume 0.6 to {_p}
		gunSkinPage({_p}, {_w})
		stop
	if {_type} is "bagskin":
		if {_id} is "":
			setData({_p}, "bag-skin", "default")
		else if bagSkinsOwned({_p}) contains {_id}:
			setData({_p}, "bag-skin", {_id})
		else:
			stop
		bagRefresh({_p})
	else:
		if {_id} is "":
			deleteData({_p}, {_type})
		else if cosOwned({_p}, {_id}) is true:
			setData({_p}, {_type}, {_id})
		else:
			stop
		if {_type} is "title":
			set {-ph::title::%{_p}%} to titleText({_p})
	play sound "item.armor.equip_leather" with volume 0.6 to {_p}
	cosPage({_p}, {_type})

on inventory click:
	{-cos::gui::%player%} is set
	player's current inventory is {-cos::gui::%player%}
	cancel event
	event-inventory is {-cos::gui::%player%}
	set {_act} to {-cos::act::%player%::%index of event-slot%}
	{_act} is set
	set {_ok} to false
	if click type is left mouse button:
		set {_ok} to true
	else if click type is right mouse button:
		set {_ok} to true
	{_ok} is true
	# One action per drawn screen, a tick later (as in crates.sk).
	if {-cos::gen::%player%} is not set:
		set {-cos::gen::%player%} to 0
	set {_gen} to {-cos::gen::%player%}
	wait 1 tick
	player is online
	{-cos::gui::%player%} is set
	{-cos::gen::%player%} is {_gen}
	add 1 to {-cos::gen::%player%}
	if {_act} starts with "page:":
		delete {-cos::page::%player%}
		cosPage(player, subtext of {_act} from characters 6 to (length of {_act}))
	else if {_act} starts with "pg:":
		# A page arrow: "pg:<type>|<page>".
		set {-cos::page::%player%} to subtext of {_act} from characters 4 to (length of {_act})
		set {_pp::*} to {-cos::page::%player%} split at "|"
		cosPage(player, {_pp::1})
	else if {_act} starts with "wear:":
		set {_a::*} to {_act} split at ":"
		cosWear(player, {_a::2}, {_a::3})
	else if {_act} is "guns":
		delete {-cos::page::%player%}
		gunSkinMenu(player)
	else if {_act} starts with "gun:":
		delete {-cos::page::%player%}
		gunSkinPage(player, subtext of {_act} from characters 5 to (length of {_act}))
	else if {_act} starts with "gpg:":
		# A gun page's arrow: "gpg:<title>|<page>".
		set {_pp::*} to (subtext of {_act} from characters 5 to (length of {_act})) split at "|"
		set {-cos::page::%player%} to "gun:%{_pp::1}%|%{_pp::2}%"
		gunSkinPage(player, {_pp::1})
	else if {_act} starts with "off:gunskin:":
		set {_w} to subtext of {_act} from characters 13 to (length of {_act})
		if gunSkinWear(player, {_w}, "") is true:
			play sound "item.armor.equip_chain" with volume 0.6 to player
		gunSkinPage(player, {_w})
	else if {_act} starts with "off:":
		cosWear(player, subtext of {_act} from characters 5 to (length of {_act}), "")
	else if {_act} is "menu":
		cosMenu(player)
	else if {_act} is "phone":
		# Opening the phone closes this menu; the close handler only clears it.
		openPhone(player)
	else if {_act} is "close":
		close player's inventory

on inventory drag:
	{-cos::gui::%player%} is set
	player's current inventory is {-cos::gui::%player%}
	cancel event

on inventory close:
	{-cos::gui::%player%} is set
	event-inventory is {-cos::gui::%player%}
	cosClearGui(player)
	delete {-cos::page::%player%}

on quit:
	cosClearGui(player)
	delete {-cos::page::%player%}
