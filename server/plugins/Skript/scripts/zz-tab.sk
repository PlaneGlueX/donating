# zz-tab.sk: GENERATED by tools\make-zz-tab.js from the zz-*.sk helpers: do not edit, run the script again.
# The owner (owner.sk ownerIs, by UUID) runs every local test helper in game and gets their arguments completed; to
# everyone else they are "Unknown command", missing from the command list and never completed. LOCAL ONLY: never upload.

on command:
	player is set
	set {_c} to command
	if {_c} contains ":":
		set {_c} to last element of ({_c} split at ":")
	{_c} starts with "zz"
	ownerIs(player) is false
	cancel event
	send "Unknown command. Type ""/help"" for help." to player

on send command list:
	ownerIs(player) is false
	remove "zztestkit", "skript:zztestkit", "zzdump", "skript:zzdump", "zzperm", "skript:zzperm", "zzclear", "skript:zzclear", "zzforget", "skript:zzforget", "zzbal", "skript:zzbal", "zzcfg", "skript:zzcfg", "zzcfgset", "skript:zzcfgset", "zzafk", "skript:zzafk", "zzafkstate", "skript:zzafkstate", "zzdata", "skript:zzdata", "zzpassive", "skript:zzpassive", "zzphone", "skript:zzphone", "zzhide", "skript:zzhide", "zzshow", "skript:zzshow", "zztip", "skript:zztip", "zzcombat", "skript:zzcombat", "zzcombatend", "skript:zzcombatend", "zzregion", "skript:zzregion", "zzshield", "skript:zzshield", "zzshieldoff", "skript:zzshieldoff", "zzwm", "skript:zzwm", "zzshopact", "skript:zzshopact", "zzammo", "skript:zzammo", "zzshopreset", "skript:zzshopreset", "zzfill", "skript:zzfill", "zzshop", "skript:zzshop", "zztag", "skript:zztag", "zzbounty", "skript:zzbounty", "zzbountyreset", "skript:zzbountyreset", "zzbountyip", "skript:zzbountyip", "zzheist", "skript:zzheist", "zzinheist", "skript:zzinheist", "zzheisttp", "skript:zzheisttp", "zzconsole", "skript:zzconsole", "zzboosterleft", "skript:zzboosterleft", "zzheistleft", "skript:zzheistleft", "zzcfgtime", "skript:zzcfgtime", "zzcfgtext", "skript:zzcfgtext", "zzcfgreload", "skript:zzcfgreload", "zzpapi", "skript:zzpapi", "zzpassivewhy", "skript:zzpassivewhy", "zzheistforget", "skript:zzheistforget", "zzkick", "skript:zzkick", "zzspawn", "skript:zzspawn", "zzbagapply", "skript:zzbagapply", "zzpack", "skript:zzpack", "zzhp", "skript:zzhp", "zztrap", "skript:zztrap", "zztrapstate", "skript:zztrapstate", "zztrapprobe", "skript:zztrapprobe", "zztrapbench", "skript:zztrapbench", "zzloot", "skript:zzloot", "zzlootcode", "skript:zzlootcode", "zzbag", "skript:zzbag", "zzbagadd", "skript:zzbagadd", "zzgear", "skript:zzgear", "zztool", "skript:zztool", "zzduffels", "skript:zzduffels", "zzbagclear", "skript:zzbagclear", "zzoffhand", "skript:zzoffhand", "zzicon", "skript:zzicon", "zzdatatext", "skript:zzdatatext", "zzcleancalc", "skript:zzcleancalc", "zzcratereset", "skript:zzcratereset", "zzcratelines", "skript:zzcratelines", "zzcfgbool", "skript:zzcfgbool", "zzcrateroll", "skript:zzcrateroll", "zzcos", "skript:zzcos", "zzcosgive", "skript:zzcosgive", "zzgunskin", "skript:zzgunskin", "zzgunskinicon", "skript:zzgunskinicon", "zzheistvar", "skript:zzheistvar", "zznpcs", "skript:zznpcs", "zznpctool", "skript:zznpctool", "zzcops", "skript:zzcops", "zzcopforget", "skript:zzcopforget", "zzcarnew", "skript:zzcarnew", "zzcarspawn", "skript:zzcarspawn", "zzcarinfo", "skript:zzcarinfo", "zzcardelete", "skript:zzcardelete", "zzcarseat", "skript:zzcarseat", "zzseatonjoin", "skript:zzseatonjoin", "zzcarmount", "skript:zzcarmount", "zzcarspot", "skript:zzcarspot", "zzcartp", "skript:zzcartp", "zzcrategrant", "skript:zzcrategrant", "zzinrange", "skript:zzinrange", "zzhunt", "skript:zzhunt", "zzctdir", "skript:zzctdir", "zzctreset", "skript:zzctreset", "zzctoffer", "skript:zzctoffer", "zzctpark", "skript:zzctpark", "zzcttake", "skript:zzcttake", "zzctstate", "skript:zzctstate", "zzcttime", "skript:zzcttime", "zzpick", "skript:zzpick", "zzctmount", "skript:zzctmount", "zzctqte", "skript:zzctqte", "zzctpick", "skript:zzctpick", "zzcarflags", "skript:zzcarflags", "zzprog", "skript:zzprog", "zzseason", "skript:zzseason", "zzseasonmins", "skript:zzseasonmins", "zzseasonwipe", "skript:zzseasonwipe", "zzheistwave", "skript:zzheistwave", "zzrun", "skript:zzrun", "zzprune", "skript:zzprune", "zzweek", "skript:zzweek", "zzheat", "skript:zzheat", "zzrunset", "skript:zzrunset", "zzctdeliver", "skript:zzctdeliver", "zzfencepay", "skript:zzfencepay", "zzpv", "skript:zzpv", "zzpvleak", "skript:zzpvleak", "zzctofferget", "skript:zzctofferget", "zzhitwin", "skript:zzhitwin", "zzlvlrewards", "skript:zzlvlrewards", "zzcarpool", "skript:zzcarpool", "zzheistreopen", "skript:zzheistreopen", "zzcarclimb", "skript:zzcarclimb", "zztext", "skript:zztext", "zzmsg", "skript:zzmsg", "zzvoice", "skript:zzvoice", "zzinbox", "skript:zzinbox", "zzinboxraw", "skript:zzinboxraw", "zzinboxclear", "skript:zzinboxclear", "zzclose", "skript:zzclose", "zzdmglog", "skript:zzdmglog", "zzcarcall", "skript:zzcarcall", "zzjail", "skript:zzjail", "zzjailtp", "skript:zzjailtp", "zzjaildoor", "skript:zzjaildoor", "zzjailbreach", "skript:zzjailbreach", "zzjailcop", "skript:zzjailcop", "zzjailcops", "skript:zzjailcops", "zzjailsees", "skript:zzjailsees", "zzjailcopto", "skript:zzjailcopto", "zzjailroster", "skript:zzjailroster", "zzjailbusy", "skript:zzjailbusy", "zzctfake", "skript:zzctfake", "zzfuel", "skript:zzfuel", "zzbikelook", "skript:zzbikelook", "zzbike", "skript:zzbike", "zzclerkhit", "skript:zzclerkhit", "zzalarm", "skript:zzalarm", "zzclock" and "skript:zzclock" from command list

# One list per kind of argument.
function zzTab(p: player, kind: text) :: texts:
	if {_kind} is "p":
		return tabPlayerNames({_p})
	if {_kind} is "x", "y", "z", "cx", "cz" or "yaw":
		return tabPos({_p}, {_kind})
	if {_kind} is "heist":
		return tabHeists()
	if {_kind} is "trap" or "loot":
		return tabSpots({_kind})
	if {_kind} is "world":
		return tabWorlds()
	if {_kind} is "plate":
		loop {car::owner::*}:
			set {_u} to loop-index in upper case
			add {_u} to {_out::*}
		return {_out::*}
	if {_kind} is "run":
		loop {heists::*}:
			add "%loop-index%#%{heist::%loop-index%::run}%" to {_out::*}
		return {_out::*}
	if {_kind} is "crate":
		return {-cfg::crates::*}
	if {_kind} is "cos":
		return {-cfg::cosmetics::*}
	if {_kind} is "wpn":
		return {-cfg::shop::weapons::*} and {-cfg::shop::consumables::*}
	if {_kind} is "ammo":
		return {-cfg::shop::ammo::*}
	if {_kind} is "gear":
		return {-cfg::shop::gear::*}
	if {_kind} is "tool":
		return {-cfg::shop::tools::*}
	if {_kind} is "tier":
		return "starter" and {-cfg::contract::tiers::*}
	if {_kind} is "model":
		return {-cfg::cars::*}
	if {_kind} is "contact":
		return "Mara", "Boss", "Vic", "Broker", "Lefty", "Rusty", "Tank" and "Whisper"
	if {_kind} is "route":
		return "annex", "cafe", "cafer", "field", "fieldr", "gate", "gater", "halla", "hallar", "hallb", "hallbr", "lot", "lote", "lotr", "lotw", "plaza", "plazar", "poldesk", "poleast", "poloffice", "w5", "w5r", "w67", "w67r", "walk", "walkr", "yardn", "yardnr", "yards" and "yardsr"
	if {_kind} is "door":
		return "booth", "cell_n103", "cell_n110", "cell_n46", "cell_n53", "cell_n60", "cell_n67", "cell_n74", "cell_n89", "cell_n96", "cell_s103", "cell_s110", "cell_s117", "cell_s46", "cell_s53", "cell_s60", "cell_s67", "cell_s96", "gunshop", "poln", "pols", "rusty", "security", "sogate", "sohatch", "stairgate", "vent" and "ventlids"
	if {_kind} is "jailarg":
		return "course", "in", "out", "off", "none", "keycard", "c4", "putty", "wires", "timer", "donut", "scrap", "tape", "handle", "clear", "30", "c4lot", "card", "parkour" and "dig"
	if {_kind} starts with "L:":
		return (subtext of {_kind} from characters 3 to length of {_kind}) split at "|"

on tab complete of "/zztestkit" and "/skript:zztestkit":
	if ownerIs(player) is false:
		cancel event
		stop
	set {_l::*} to zzTab(player, "p")
	if {_l::*} is set:
		set tab completions for position 1 to {_l::*}
	delete {_l::*}

