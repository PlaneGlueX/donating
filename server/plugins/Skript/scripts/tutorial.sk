# tutorial.sk: the first-join welcome. Built 2026-09-26 (a spawn lock until the first bag); reworked 2026-09-27
# (owner: the bag costs money and is earned, "do your realistic tutorial job"). The texts are a PROPOSAL.
#
# No lock any more: a new robber starts with money::start ($1,000) and nothing else, their hands carry up to
# bag::hands::capacity of loot (bag.sk), and Mara's chapter 1 (story.sk) walks them through the start: her lockpick
# and a first car job at the Scrap Yard (contracts.sk's starter job: the money for a bag), the Gym Bag, a store or a
# heist, the sale, a knife (guns need level 5), a crate and level 5. The GPS leads the way at every step.
# This file only greets them once (data "tutorial": "welcomed", then "done" with their first bag) and keeps /tutorial.
#   /tutorial [confirm|stop]           the prison course: your step (confirm: back to it, or a replay after the course;
#                                      stop: ends a replay, back to how you were before it: jailcourse.sk jcStop)
#   /dtutorial <player> reset|done     staff (reset: the welcome again at the next join)

function tutorialLog(text: text):
	log {_text} to "tutorial"

function tutorialStep(p: player) :: text:
	set {_s} to getData({_p}, "tutorial")
	if {_s} is set:
		return "%{_s}%"
	return ""

# Always false now (nothing waits for the first bag); kept for the scripts that still ask (shop.sk, bounty.sk,
# hits.sk, tabcomplete.sk).
function tutorialNeedsBag(p: player) :: boolean:
	return false

# The whole game in four cards (owner, 2026-11-05: "make sure the player knows how to play"; kids don't read chat), the chat lines
# for whoever wants them.
function tutorialWelcome(p: player):
	tutorialSteps({_p})
	set {_t::*} to "&6&lROB", "&c&lGET OUT ALIVE", "&a&lSELL IT", "&6&lFIND MARA" and "&b&lLONG WALK?"
	# The way to Mara is 875 m on foot right after the escape, and the bikes stand 50 m from the gate (bikes.sk).
	set {_s::*} to "&7Stores and heists are full of loot", "&7Die and your loot drops for anyone to grab", "&7At the base: money, levels, better gear", "&7Follow the orange trail" and "&7Right-click a bike at the shop by the gate"
	set {_i} to 0
	loop {_t::*}:
		{_p} is online
		add 1 to {_i}
		send title colored loop-value with subtitle colored {_s::%{_i}%} to {_p} for 3 seconds with fade in 0 ticks and fade out 5 ticks
		play sound "block.note_block.pling" with volume 0.8 and pitch (0.8 + {_i} * 0.2) to {_p}
		play sound "block.note_block.bass" with volume 0.5 and pitch (0.8 + {_i} * 0.2) to {_p}
		wait 3 seconds

function tutorialSteps(p: player):
	set {_start} to formatMoney(cfg("money::start"))
	set {_hands} to formatMoney(cfg("bag::hands::capacity"))
	msg({_p}, "&7You've got %{_start}%. &eMeet Mara &7at the Safehouse: follow the orange trail.")
	send colored "&7 Your first job: &7steal a car for the Scrap Yard. It pays for a bag (your hands carry %{_hands}%)." to {_p}
	send colored "&7 Loot sells by itself at the base. Guns need level 5. &f/missions &7shows what's next, &f/help &7the rest." to {_p}
	# Street patrols (owner, 2026-11-10, DECISIONS B: "keep no floor, make sure to mention street patrol in the tutorial").
	send colored "&7 Carrying loot on the street? &cPolice patrols &7chase you if they see you: lose them or get it to the base." to {_p}

on join:
	getData(player, "tutorial") is not set
	setData(player, "tutorial", "welcomed")
	tutorialLog("start %player% %uuid of player%")
	# While the prison runs, the city's welcome waits for the first escape (prison.sk calls tutorialWelcome then).
	jailOn() is false
	# After the welcome title (join-quit.sk).
	wait 5 seconds
	player is online
	tutorialWelcome(player)

# The first bag ends it (checked every second; the story's own mission says so).
every second:
	loop all players:
		if tutorialStep(loop-player) is "welcomed":
			if bestBag(loop-player) >= 1:
				setData(loop-player, "tutorial", "done")
				tutorialLog("done %loop-player% %uuid of loop-player%")

command /tutorial [<text>]:
	description: Your tutorial step; /tutorial confirm takes you back to it (or replays it); /tutorial stop ends a replay.
	executable by: players
	trigger:
		# The prison course, also after it's done (owner, 2026-10-14: "/tutorial for people who want to go back to the
		# tutorial even after they complete it (but they still keep their stats)"): jailcourse.sk jcTutorial. Never the
		# city's welcome lines (tutorialSteps: the first join only). "stop" (owner, 2026-10-15: "have a /tutorial stop command
		# if you already completed it before") ends a replay: jcTutorial passes it to jcStop.
		if jailOn() is false:
			msg(player, "&7The prison tutorial is closed right now.")
			stop
		set {_a} to ""
		if arg-1 is set:
			set {_a} to arg-1
		jcTutorial(player, {_a})

command /dtutorial <offline player> <text>:
	permission: donating.staff
	permission message: &cStaff only.
	trigger:
		if arg-2 is "reset":
			delete {data::%arg-1%::tutorial}
			tutorialLog("reset %arg-1% by=%sender%")
			send "TUTORIAL %arg-1% reset (welcomed again at the next join)" to sender
		else if arg-2 is "done":
			set {data::%arg-1%::tutorial} to "done"
			tutorialLog("done-by-staff %arg-1% by=%sender%")
			send "TUTORIAL %arg-1% done" to sender
		else:
			send "TUTORIAL usage: /dtutorial <player> reset|done" to sender
