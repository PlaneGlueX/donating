# garage.sk: cars (MTVehicles 2.5.9). Built 2026-09-26 (Phase 2; owner, 2026-09-26: cars are a mid-game
# goal and the getaway: allowed while wanted, but the cops' chase radius doubles in a car, heists.sk).
# Reworked 2026-09-28 (owner: "expanding the car trading with the high rarity cars": extreme cars ($1M+), wraps and mods,
# serial numbers for rarity, car crates; "car value is like: base car < the car with a bad skin < car with bad skin and
# car mods / car with good skin < car with good skin and mods / car with super rare skin < car with super rare skin and
# mods"). A player may own several cars of a model now: each car is its own plate.
#
# Models (core.sk cars::*, car::<id>::name|price|level|crate|extreme|stats, carcolors::<id>::* = "Label=MTV uuid=damage",
# carcolorsx::<id>::* = colors only car crates give). Crate cars (car::<id>::crate) come only from crates and need no
# level; extreme cars ($1M+) are sold at the dealer but never tuned or wrapped there.
#
# A car is an MTVehicles vehicle: a license plate in its data, made with "a new mtv vehicle with uuid <variant uuid> and
# owner <player>" (the variant picks the look: a color, or a wrap from carwraps.sk). Players never hold the car item
# (the fixed inventory): the garage spawns it. Saved:
#   {data::<uuid>::cars::<plate>}    = the model id, one line per car the player owns (list indexes are lowercased by
#                                      Skript: plates read back from an index are uppercased first)
#   {car::owner::<plate>}            the owner's uuid (text); {car::model::<plate>} the model id
#   {car::color::<plate>}            its paint's label; {car::wrap::<plate>} its wrap (none = not set)
#   {car::mod::<plate>::<part>}      engine / turbo / handling stage 1-3; {car::neon::<plate>}, {car::trail::<plate>} looks
#   {car::vin::<plate>}              its serial number (every car ever made gets the next: {car::vins}); never changes
#   {car::origin::<plate>}           dealer, crate:<crate>, staff; {car::locked::<plate>} true = its build is locked (a
#                                    crate car: never repainted or tuned, that's what keeps its value)
#   {car::serial::<plate>}           a crate car's number of its kind ("#3/57": {serial::car:<model>[:<wrap>]})
#   {car::lock::<plate>}             true = locked (the default): nobody but the owner gets in
#   {car::out::<plate>}              where it is while spawned; {car::outof::<uuid>} the player's car out
#   {-car::driver::<plate>}          who's driving it; {-car::riding::<uuid>} the plate a player drives
#   {-car::members::<plate>::<uuid>} passengers let in while it was unlocked (MTVehicles "members")
#   {-car::used::<plate>}            when it was last driven or left (car-cleanup.sk: idle despawn)
# A new plate (a repaint, a car MTVehicles lost made again) takes every line with it (carRekey).
# MTVehicles saves its own data only every 10 minutes: after a crash a plate can be gone, so every use
# goes through carEnsure (it makes the car again, same model and look, and moves the data over).
#
# Grade (carGrade) = the wrap's tier (0 none, 1 common, 2 rare, 3 exotic) + 1 with any mod: Stock, Custom, Rare, Exotic,
# Mythic. Mods: hardware (engine = top speed, turbo = acceleration, handling = steering, stages 1-3) is set in MTVehicles
# each time the owner gets in (DonatingPhone's /dphone carstat); looks (neon, trail) are particles while it's driven.
# The tuning shop (a garage's menu) sells hardware for dealer cars below extreme; car crates roll whole cars (carRoll).
#
# Rules:
#   - Only the owner drives (MTVehicles checks too). Unlocked: others may sit as passengers.
#   - A car above the owner's level (a dealer model's level; a won or traded car too) stays in the garage until then.
#   - One car out per player; calling it spawns it next to you (not in heists, not while in combat, once
#     per car::call-cooldown); calling another car sends the first back.
#   - No cars in heists: no getting in inside one, and driving into one throws you out (MTVehicles' region
#     event: a car doesn't fire WorldGuard's walking events). No driving into a safe zone while in combat.
#   - While driving, slot 9 is the car key (right-click: lock / unlock); the phone comes back when you get
#     out. No locking in no-lock zones (regions whose id starts with car::nolock-prefix).
#   - Car stands can't be damaged (MTVehicles doesn't protect them; a broken one drops the car item).
#   - /vehicle and its aliases are staff only (MTVehicles' own commands hand out car items).
# car-cleanup.sk sends cars back to the garage (idle, owner gone, owner in another car) and sweeps stands.
#   /garage          your cars (also the phone's Garage app): call, send back, lock, repaint, tune
#   the Car Dealer   a shopkeeper (/dshopkeeper add cars; Citizens: dshop open <player> cars)
#   /dgarage give|take|info|store|build <player> [...]   staff
# Log: plugins\Skript\logs\garage.log.

function carLog(text: text):
	log {_text} to "garage"

function carExists(id: text) :: boolean:
	if {-cfg::car::%{_id}%::name} is set:
		return true
	return false

function carName(id: text) :: text:
	set {_n} to {-cfg::car::%{_id}%::name}
	if {_n} is set:
		return "%{_n}%"
	return {_id}

function carIsCrate(id: text) :: boolean:
	if {-cfg::car::%{_id}%::crate} is true:
		return true
	return false

function carIsExtreme(id: text) :: boolean:
	if {-cfg::car::%{_id}%::extreme} is true:
		return true
	return false

# The level a model needs to be driven (and bought): a dealer model's level, 0 for crate-only models.
function carLevelOf(id: text) :: number:
	if carIsCrate({_id}) is true:
		return 0
	set {_n} to {-cfg::car::%{_id}%::level}
	if {_n} is set:
		return {_n}
	return 0

# A part of a color entry "Label=uuid=damage" (dealer colors, then crate-only colors): 1 label, 2 uuid, 3 damage.
function carColorPart(id: text, label: text, n: number) :: text:
	loop {-cfg::carcolors::%{_id}%::*}:
		set {_a::*} to loop-value split at "="
		if {_a::1} is {_label}:
			return {_a::%{_n}%}
	loop {-cfg::carcolorsx::%{_id}%::*}:
		set {_a::*} to loop-value split at "="
		if {_a::1} is {_label}:
			return {_a::%{_n}%}
	return ""

function carFirstColor(id: text) :: text:
	loop {-cfg::carcolors::%{_id}%::*}:
		set {_a::*} to loop-value split at "="
		return {_a::1}
	return ""

# The dealer's colors of a model (crate-only colors aren't sold).
function carColorLabels(id: text) :: texts:
	loop {-cfg::carcolors::%{_id}%::*}:
		set {_a::*} to loop-value split at "="
		add {_a::1} to {_out::*}
	return {_out::*}

function carSpecialLabels(id: text) :: texts:
	loop {-cfg::carcolorsx::%{_id}%::*}:
		set {_a::*} to loop-value split at "="
		add {_a::1} to {_out::*}
	return {_out::*}

# ---------- Wraps and mods ----------

function carWrapExists(w: text) :: boolean:
	if {-cfg::carwrap::%{_w}%::name} is set:
		return true
	return false

function carWrapName(w: text) :: text:
	set {_n} to {-cfg::carwrap::%{_w}%::name}
	if {_n} is set:
		return "%{_n}%"
	return {_w}

function carWrapTier(w: text) :: number:
	set {_t} to {-cfg::carwrap::%{_w}%::tier}
	if {_t} is set:
		return {_t}
	return 0

# "&dH4CK3R" (the wrap's name in its tier's color).
function carWrapColored(w: text) :: text:
	set {_t} to carWrapTier({_w})
	set {_a::*} to "%{-cfg::carwrap::tier::%{_t}%}%" split at "|"
	return "%{_a::2}%%carWrapName({_w})%"

# The MTVehicles variant of a model with a wrap: "uuid=damage" (carwraps.sk, made by tools\make-car-wraps.js), or "".
function carWrapVariant(id: text, w: text) :: text:
	set {_v} to {-carwrap::%{_id}%::%{_w}%}
	if {_v} is set:
		return "%{_v}%"
	return ""

# The wraps a model can wear that can still be rolled (not retired), of a tier.
function carWrapsOfTier(id: text, tier: number) :: texts:
	loop {-cfg::carwraps::*}:
		if carWrapTier(loop-value) is {_tier}:
			if {-cfg::carwrap::%loop-value%::retired} is not true:
				if carWrapVariant({_id}, loop-value) is not "":
					add loop-value to {_out::*}
	return {_out::*}

function carModName(part: text) :: text:
	set {_n} to {-cfg::carmod::%{_part}%::name}
	if {_n} is set:
		return "%{_n}%"
	return {_part}

function carRoman(n: number) :: text:
	if {_n} is 1:
		return "I"
	if {_n} is 2:
		return "II"
	if {_n} is 3:
		return "III"
	return "%{_n}%"

# ---------- One car (by plate) ----------

function carOwnerOf(plate: text) :: text:
	set {_o} to {car::owner::%{_plate}%}
	if {_o} is set:
		return "%{_o}%"
	return ""

function carModelOf(plate: text) :: text:
	set {_m} to {car::model::%{_plate}%}
	if {_m} is set:
		return "%{_m}%"
	return ""

function carLocked(plate: text) :: boolean:
	if {car::lock::%{_plate}%} is false:
		return false
	return true

function carColor(plate: text) :: text:
	set {_c} to {car::color::%{_plate}%}
	if {_c} is set:
		return "%{_c}%"
	return carFirstColor(carModelOf({_plate}))

# The car's wrap id, "" for none.
function carWrap(plate: text) :: text:
	set {_w} to {car::wrap::%{_plate}%}
	if {_w} is set:
		return "%{_w}%"
	return ""

function carMod(plate: text, part: text) :: number:
	set {_n} to {car::mod::%{_plate}%::%{_part}%}
	if {_n} is set:
		return {_n}
	return 0

function carNeon(plate: text) :: text:
	set {_n} to {car::neon::%{_plate}%}
	if {_n} is set:
		return "%{_n}%"
	return ""

function carTrail(plate: text) :: text:
	set {_n} to {car::trail::%{_plate}%}
	if {_n} is set:
		return "%{_n}%"
	return ""

function carHasMods(plate: text) :: boolean:
	loop {-cfg::carmod::parts::*}:
		if carMod({_plate}, loop-value) > 0:
			return true
	if carNeon({_plate}) is not "":
		return true
	if carTrail({_plate}) is not "":
		return true
	return false

# 0 Stock ... 4 Mythic: the wrap's tier + 1 with any mod (the owner's value ladder).
function carGrade(plate: text) :: number:
	set {_g} to 0
	set {_w} to carWrap({_plate})
	if {_w} is not "":
		set {_g} to carWrapTier({_w})
	if carHasMods({_plate}) is true:
		add 1 to {_g}
	return min(4, {_g})

# "&dExotic".
function carGradeName(g: number) :: text:
	set {_k} to {_g} + 1
	set {_a::*} to "%{-cfg::car::grades::%{_k}%}%" split at "|"
	return "%{_a::2}%%{_a::1}%"

function carVin(plate: text) :: number:
	set {_v} to {car::vin::%{_plate}%}
	if {_v} is set:
		return {_v}
	# A car from before serial numbers gets the next one the first time it's asked for.
	if carOwnerOf({_plate}) is "":
		return 0
	set {car::vin::%{_plate}%} to carVinMint()
	return {car::vin::%{_plate}%}

function carVinMint() :: number:
	if {car::vins} is not set:
		set {car::vins} to 0
	add 1 to {car::vins}
	return {car::vins}

# "No. 000042".
function carVinText(plate: text) :: text:
	set {_t} to "%carVin({_plate})%"
	loop 6 times:
		if length of {_t} < 6:
			set {_t} to "0%{_t}%"
	return "No. %{_t}%"

function carLockedBuild(plate: text) :: boolean:
	if {car::locked::%{_plate}%} is true:
		return true
	return false

# "" when the tuning shop may change this car's hardware, else why not.
function carTuneBlock(plate: text) :: text:
	set {_m} to carModelOf({_plate})
	if carLockedBuild({_plate}) is true:
		return "Crate cars stay as they came"
	if carIsExtreme({_m}) is true:
		return "Extreme cars can't be tuned"
	if carIsCrate({_m}) is true:
		return "Crate cars stay as they came"
	if {-cfg::car::%{_m}%::price} is not set:
		return "This car can't be tuned"
	return ""

# "H4CK3R Apex" or "Red Sedan".
function carTitle(plate: text) :: text:
	set {_w} to carWrap({_plate})
	if {_w} is not "":
		return "%carWrapName({_w})% %carName(carModelOf({_plate}))%"
	return "%carColor({_plate})% %carName(carModelOf({_plate}))%"

# A crate car's count of its kind: its model, and its wrap if it has one.
function carSerialKey(plate: text) :: text:
	set {_w} to carWrap({_plate})
	if {_w} is not "":
		return "car:%carModelOf({_plate})%:%{_w}%"
	return "car:%carModelOf({_plate})%"

# " &7#3/57" for a crate car, else "".
function carSerialText(plate: text) :: text:
	set {_n} to {car::serial::%{_plate}%}
	if {_n} is not set:
		return ""
	return " &7%serialText(carSerialKey({_plate}), {_n})%"

# A model's name in the plural ("Sedans", "Apexes").
function carPlural(m: text) :: text:
	set {_n} to carName({_m})
	if {_n} ends with "x":
		return "%{_n}%es"
	if {_n} ends with "s":
		return "%{_n}%es"
	return "%{_n}%s"

function carSerialLore(plate: text) :: text:
	set {_n} to {car::serial::%{_plate}%}
	if {_n} is not set:
		return ""
	set {_k} to carSerialKey({_plate})
	set {_t} to serialTotal({_k})
	set {_pl} to carPlural(carModelOf({_plate}))
	set {_w} to carWrap({_plate})
	if {_w} is not "":
		if {-cfg::carwrap::%{_w}%::retired} is true:
			return "&7#%{_n}% of %{_t}% %{_pl}% with this wrap (retired)"
		return "&7#%{_n}% of %{_t}% %{_pl}% with this wrap"
	return "&7#%{_n}% of %{_t}% %{_pl}% from crates"

# The car's hardware mods as short texts ("Engine II", "Turbo I").
function carModTexts(plate: text) :: texts:
	loop {-cfg::carmod::parts::*}:
		set {_s} to carMod({_plate}, loop-value)
		if {_s} > 0:
			add "%carModName(loop-value)% %carRoman({_s})%" to {_out::*}
	return {_out::*}

# The car's looks beyond its paint ("Neon: Cyan", "Trail: Sparks").
function carLookTexts(plate: text) :: texts:
	set {_n} to carNeon({_plate})
	if {_n} is not "":
		add "Neon: %{-cfg::carneon::%{_n}%::name}%" to {_out::*}
	set {_t} to carTrail({_plate})
	if {_t} is not "":
		add "Trail: %{-cfg::cartrail::%{_t}%::name}%" to {_out::*}
	return {_out::*}

# The lore lines that describe a car (menus, trades, bays).
function carLoreOf(plate: text) :: texts:
	set {_m} to carModelOf({_plate})
	add "&7Grade: %carGradeName(carGrade({_plate}))%" to {_l::*}
	set {_w} to carWrap({_plate})
	if {_w} is not "":
		set {_wt} to carWrapTier({_w})
		set {_ta::*} to "%{-cfg::carwrap::tier::%{_wt}%}%" split at "|"
		add "&7Wrap: %carWrapColored({_w})% &7(%{_ta::1}%)" to {_l::*}
	else:
		add "&7Color: &f%carColor({_plate})%" to {_l::*}
	set {_mods::*} to carModTexts({_plate})
	if size of {_mods::*} > 0:
		add "&7Mods: &b%join {_mods::*} with ", "%" to {_l::*}
	set {_looks::*} to carLookTexts({_plate})
	if size of {_looks::*} > 0:
		add "&7Extras: &d%join {_looks::*} with ", "%" to {_l::*}
	if carIsExtreme({_m}) is true:
		add "&cExtreme car" to {_l::*}
	set {_sl} to carSerialLore({_plate})
	if {_sl} is not "":
		add {_sl} to {_l::*}
	add "&7Serial: &f%carVinText({_plate})%  &7Plate: &f%{_plate}%" to {_l::*}
	if carLockedBuild({_plate}) is true:
		add "&7Crate build: no repaint or tuning" to {_l::*}
	return {_l::*}

# ---------- Icons ----------

# The car as a menu icon: a diamond hoe with the model's damage, unbreakable (the pack draws the car).
# Only ever in menus: players never hold diamond hoes.
function carIconDamage(d: number) :: item:
	# Unbreakable: the pack only draws the car on an undamaged-looking hoe. No hoe stats in the tooltip
	# ("1 Attack Damage"): hiding them wasn't enough for a 26.3 client through ViaVersion (2026-09-26), so the
	# icon has no attributes at all.
	set {_i} to diamond hoe with nbt from "{""minecraft:attribute_modifiers"":[],""minecraft:unbreakable"":{},""minecraft:tooltip_display"":{hidden_components:[""minecraft:unbreakable"",""minecraft:attribute_modifiers""]}}"
	if {_d} > 0:
		set damage of {_i} to {_d}
	return {_i}

# A model in a color (the dealer).
function carIcon(id: text, label: text) :: item:
	set {_d} to carColorPart({_id}, {_label}, 3) parsed as number
	if {_d} is not set:
		set {_d} to 0
	return carIconDamage({_d})

# The car's own look (its wrap, else its color).
function carIconOf(plate: text) :: item:
	set {_m} to carModelOf({_plate})
	set {_w} to carWrap({_plate})
	if {_w} is not "":
		set {_v::*} to carWrapVariant({_m}, {_w}) split at "="
		set {_d} to {_v::2} parsed as number
		if {_d} is set:
			return carIconDamage({_d})
	return carIcon({_m}, carColor({_plate}))

# ---------- A player's cars ----------

# Moves a player's cars from the old one-per-model data (before 2026-09-28) to one line per plate. Once per player.
function carMigrate(p: offline player):
	loop {data::%{_p}%::car::*}:
		set {_id} to loop-index
		set {_plate} to "%loop-value%" in upper case
		set {data::%{_p}%::cars::%{_plate}%} to {_id}
		if {car::model::%{_plate}%} is not set:
			set {car::model::%{_plate}%} to {_id}
		if {car::owner::%{_plate}%} is not set:
			set {car::owner::%{_plate}%} to "%uuid of {_p}%"
		if {car::color::%{_plate}%} is not set:
			set {_c} to {data::%{_p}%::carcolor::%{_id}%}
			if {_c} is set:
				set {car::color::%{_plate}%} to "%{_c}%"
		if {car::vin::%{_plate}%} is not set:
			set {car::vin::%{_plate}%} to carVinMint()
		if carIsCrate({_id}) is true:
			set {car::origin::%{_plate}%} to "crate"
			set {car::locked::%{_plate}%} to true
			set {_sn} to {data::%{_p}%::carserial::%{_id}%}
			if {_sn} is set:
				set {car::serial::%{_plate}%} to {_sn}
		else:
			set {car::origin::%{_plate}%} to "dealer"
		carLog("migrate %{_p}% %uuid of {_p}% %{_id}% %{_plate}% vin=%{car::vin::%{_plate}%}%")
	delete {data::%{_p}%::car::*}
	delete {data::%{_p}%::carcolor::*}
	delete {data::%{_p}%::carserial::*}
	# A plate whose car records are gone (forgotten) is no car: it leaves the garage list.
	loop {data::%{_p}%::cars::*}:
		set {_plate} to loop-index in upper case
		if {car::model::%{_plate}%} is not set:
			add {_plate} to {_orphans::*}
	loop {_orphans::*}:
		carLog("orphan %{_p}% %uuid of {_p}% %loop-value% (no car records): removed from the garage list")
		delete {data::%{_p}%::cars::%loop-value%}

on join:
	carMigrate(player)

# The player's cars (plates), best first: grade, then the models' order, then serial number.
function carsOf(p: offline player) :: texts:
	set {_n} to 0
	loop {-cfg::cars::*}:
		add 1 to {_n}
		set {_mi::%loop-value%} to {_n}
	loop {data::%{_p}%::cars::*}:
		set {_plate} to loop-index in upper case
		set {_g} to 9 - carGrade({_plate})
		set {_i} to {_mi::%loop-value%}
		if {_i} is not set:
			set {_i} to 99
		set {_it} to "%{_i}%"
		if length of {_it} < 2:
			set {_it} to "0%{_it}%"
		set {_v} to "%carVin({_plate})%"
		loop 8 times:
			if length of {_v} < 8:
				set {_v} to "0%{_v}%"
		add "%{_g}%-%{_it}%-%{_v}%|%{_plate}%" to {_keys::*}
	loop sorted {_keys::*}:
		set {_a::*} to loop-value split at "|"
		add {_a::2} to {_out::*}
	return {_out::*}

function carCount(p: offline player) :: number:
	set {_n} to 0
	loop {data::%{_p}%::cars::*}:
		add 1 to {_n}
	return {_n}

function carOwns(p: offline player, plate: text) :: boolean:
	if {data::%{_p}%::cars::%{_plate}%} is set:
		return true
	return false

# How many cars of a model the player owns.
function carModelCount(p: offline player, id: text) :: number:
	set {_n} to 0
	loop {data::%{_p}%::cars::*}:
		if loop-value is {_id}:
			add 1 to {_n}
	return {_n}

# "" when the garage has room for one more car, else why not.
function carRoomBlock(p: offline player) :: text:
	set {_max} to cfg("car::garage-max")
	if carCount({_p}) >= {_max}:
		return "Your garage is full (%{_max}% cars). Trade some away first."
	return ""

# Whether MTVehicles still has this plate.
function carAlive(plate: text) :: boolean:
	set {_ok} to false
	set {_car} to mtv vehicle with license plate {_plate}
	if {_car} is set:
		if vehicle {_car} exists:
			set {_ok} to true
	return {_ok}

# The MTVehicles variant uuid for a model and look (a wrap, else the color), "" if there's none.
function carVariantUuid(id: text, label: text, wrap: text) :: text:
	if {_wrap} is not "":
		set {_v::*} to carWrapVariant({_id}, {_wrap}) split at "="
		if {_v::1} is set:
			return "%{_v::1}%"
		return ""
	return carColorPart({_id}, {_label}, 2)

# Makes a new MTVehicles car for a player (a model, a paint color, maybe a wrap) and records it; returns its plate ("" if
# it failed). origin: dealer, crate:<crate>, staff. The serial number is the next one.
function carCreate(p: offline player, id: text, label: text, wrap: text, origin: text) :: text:
	set {_uuid} to carVariantUuid({_id}, {_label}, {_wrap})
	if {_uuid} is "":
		carLog("create-failed %{_p}% %{_id}% %{_label}% wrap=%{_wrap}% (no such look)")
		return ""
	set {_car} to a new mtv vehicle with uuid {_uuid} and owner {_p}
	if {_car} is not set:
		carLog("create-failed %{_p}% %{_id}% %{_label}% wrap=%{_wrap}% (MTVehicles refused %{_uuid}%)")
		return ""
	set {_plate} to (vehicle license plate of {_car}) in upper case
	set {data::%{_p}%::cars::%{_plate}%} to {_id}
	set {car::owner::%{_plate}%} to "%uuid of {_p}%"
	set {car::model::%{_plate}%} to {_id}
	set {car::color::%{_plate}%} to {_label}
	if {_wrap} is not "":
		set {car::wrap::%{_plate}%} to {_wrap}
	set {car::lock::%{_plate}%} to true
	set {car::origin::%{_plate}%} to {_origin}
	set {car::vin::%{_plate}%} to carVinMint()
	return {_plate}

# Moves everything a car is from an old plate to its new one (a repaint, a car MTVehicles lost made again).
function carRekey(old: text, new: text):
	set {_o} to carOwnerOf({_old})
	loop "owner", "model", "color", "wrap", "neon", "trail", "vin", "origin", "locked", "serial" and "lock":
		set {_v} to {car::%loop-value%::%{_old}%}
		if {_v} is set:
			set {car::%loop-value%::%{_new}%} to {_v}
	loop {-cfg::carmod::parts::*}:
		set {_s} to {car::mod::%{_old}%::%loop-value%}
		if {_s} is set:
			set {car::mod::%{_new}%::%loop-value%} to {_s}
	if {_o} is not "":
		set {data::%{_o}%::cars::%{_new}%} to {data::%{_o}%::cars::%{_old}%}
		delete {data::%{_o}%::cars::%{_old}%}
	carForget({_old})
	carLog("rekey %{_old}% -> %{_new}% owner=%{_o}%")

# Forgets a plate everywhere (the car is gone, or its data moved to a new plate).
function carForget(plate: text):
	loop "owner", "model", "color", "wrap", "neon", "trail", "vin", "origin", "locked", "serial", "lock" and "out":
		delete {car::%loop-value%::%{_plate}%}
	delete {car::mod::%{_plate}%::*}
	delete {-car::driver::%{_plate}%}
	delete {-car::used::%{_plate}%}
	delete {-car::members::%{_plate}%::*}

# The player's car, made again if MTVehicles lost it (same model and look, same serial number). "" if it isn't theirs.
function carEnsure(p: offline player, plate: text) :: text:
	if carOwns({_p}, {_plate}) is false:
		return ""
	if carAlive({_plate}) is true:
		return {_plate}
	set {_m} to carModelOf({_plate})
	set {_uuid} to carVariantUuid({_m}, carColor({_plate}), carWrap({_plate}))
	set {_car} to a new mtv vehicle with uuid {_uuid} and owner {_p}
	if {_car} is not set:
		carLog("recreate-failed %{_p}% %uuid of {_p}% %{_m}% %{_plate}%")
		return {_plate}
	set {_new} to (vehicle license plate of {_car}) in upper case
	set {_wasout} to false
	if {car::out::%{_plate}%} is set:
		set {_wasout} to true
	if {car::outof::%uuid of {_p}%} is {_plate}:
		delete {car::outof::%uuid of {_p}%}
	carRekey({_plate}, {_new})
	carLog("recreated %{_p}% %uuid of {_p}% %{_m}% old=%{_plate}% new=%{_new}% wasout=%{_wasout}%")
	return {_new}

# ---------- Calling and storing ----------

# "" when a player may call a car now, else why not.
function carCallBlock(p: player) :: text:
	if {_p} is not alive:
		return "You can't call a car right now."
	if heistOf({_p}) is not "":
		return "No cars in heists."
	if isCombatTagged({_p}) is true:
		return "You can't call a car while in combat."
	if {-car::riding::%uuid of {_p}%} is set:
		return "You're driving already."
	# At a garage (citygarage.sk) the next car can come out sooner than a Valet call.
	set {_cd} to cfg("car::call-cooldown")
	if garageAt({_p}) is not "":
		set {_cd} to cfg("garage::takeout-cooldown")
	set {_at} to {-car::callat::%uuid of {_p}%}
	if {_at} is set:
		if difference between {_at} and now < {_cd}:
			return "Your mechanic needs a moment. Try again soon."
	return ""

# "" when this car may come out for the player (their level), else why not.
function carDriveBlock(p: player, plate: text) :: text:
	set {_m} to carModelOf({_plate})
	set {_need} to carLevelOf({_m})
	if levelOk({_p}, {_need}) is false:
		return "Your %carName({_m})% needs level %{_need}% (%levelName({_need})%) to drive."
	return ""

# A clear spot for a car near the player: ahead, right, left or behind (solid ground, room around it,
# not in a heist); none = not set.
function carSpawnSpot(p: player) :: location:
	set {_base} to location of {_p}
	set {_yaw} to yaw of {_p}
	# Coordinates in locals first: "x-coordinate of {_base} + {_dx}" parses as the x of (location + number).
	set {_bx} to x-coordinate of {_base}
	set {_by} to y-coordinate of {_base}
	set {_bz} to z-coordinate of {_base}
	loop 0, 90, -90 and 180:
		set {_a} to {_yaw} + loop-value
		set {_dx} to 0 - sin({_a}) * 3.5
		set {_dz} to cos({_a}) * 3.5
		set {_l} to location(floor({_bx} + {_dx}) + 0.5, floor({_by}), floor({_bz} + {_dz}) + 0.5, world of {_base})
		if carSpotClear({_l}) is true:
			if garageSiteOf({_l}) is "":
				if garageInLane({_l}) is false:
					# Never into a members-only area the owner may not enter (levels.sk).
					if levelZoneBlockAt({_p}, {_l}) is "":
						set yaw of {_l} to {_yaw}
						return {_l}
	return {_nothing}

function carSpotClear(l: location) :: boolean:
	if heistAt({_l}) is not "":
		return false
	set {_under} to block at ({_l} ~ vector(0, -1, 0))
	if {_under} is passable:
		return false
	loop -1, 0 and 1:
		loop -1, 0 and 1:
			loop 0 and 1:
				set {_b} to block at ({_l} ~ vector(loop-value-1, loop-value-3, loop-value-2))
				if {_b} is not passable:
					return false
				if "%type of {_b}%" is "water":
					return false
				if "%type of {_b}%" is "lava":
					return false
	return true

# Loaded MAIN stands of a plate (a spawned car has one).
function carStands(plate: text) :: number:
	set {_n} to 0
	set {_name} to "MTVEHICLES_MAIN_%{_plate}%"
	loop all armor stands:
		if "%name of loop-entity%" is {_name}:
			add 1 to {_n}
	return {_n}

# Brings a player's car next to them (sends another car of theirs back first).
function carCall(p: player, plate: text):
	set {_why} to carCallBlock({_p})
	if {_why} is not "":
		carFail({_p}, {_why})
		stop
	# Cars come out at garages, or anywhere with Valet (citygarage.sk).
	set {_gw} to garageAccessBlock({_p})
	if {_gw} is not "":
		carFail({_p}, {_gw})
		stop
	if carOwns({_p}, {_plate}) is false:
		carFail({_p}, "That's not your car.")
		stop
	set {_dw} to carDriveBlock({_p}, {_plate})
	if {_dw} is not "":
		carFail({_p}, {_dw})
		stop
	set {_plate} to carEnsure({_p}, {_plate})
	if carAlive({_plate}) is false:
		carFail({_p}, "Something went wrong with your car. Tell staff.")
		stop
	set {_m} to carModelOf({_plate})
	if {-car::driver::%{_plate}%} is set:
		carFail({_p}, "Someone is in your %carName({_m})%.")
		stop
	set {_site} to garageAt({_p})
	if {_site} is not "":
		set {_spot} to garageSpot({_p})
		if {_spot} is not set:
			carFail({_p}, "The exit lane is full. Give it a moment.")
			stop
	else:
		set {_spot} to carSpawnSpot({_p})
		if {_spot} is not set:
			carFail({_p}, "No room for a car here. Try an open street.")
			stop
	set {_other} to {car::outof::%uuid of {_p}%}
	if {_other} is set:
		carStore("%{_other}%", "swap")
	if {car::out::%{_plate}%} is set:
		carStore({_plate}, "recall")
	spawn mtv vehicle with license plate {_plate} at {_spot}
	if carStands({_plate}) < 1:
		carLog("call-failed %{_p}% %uuid of {_p}% %{_plate}% at %{_spot}%")
		carFail({_p}, "Your car couldn't get here. Try another spot.")
		stop
	set {car::out::%{_plate}%} to {_spot}
	set {car::outof::%uuid of {_p}%} to {_plate}
	set {-car::used::%{_plate}%} to now
	set {-car::callat::%uuid of {_p}%} to now
	carLog("call %{_p}% %uuid of {_p}% %{_m}% %{_plate}% at %{_spot}% site=%{_site}%")
	if {_site} is not "":
		garageTookOut({_p}, {_plate})
		hudBar({_p}, "&aYour %carTitle({_plate})% is waiting in the exit lane.", 1)
	else:
		msg({_p}, "&aYour %carTitle({_plate})% is here. &7Right-click it to get in.")
	play sound "block.note_block.bell" with volume 0.6 to {_p}

# Sends a car back to the garage (despawns it; the data stays). why: store, swap, recall, idle, quit...
function carStore(plate: text, why: text):
	# Load the car's chunk first so the despawn reaches it (the sweep removes what's still left later).
	set {_at} to {car::out::%{_plate}%}
	if {_at} is set:
		set {_chunk} to chunk at {_at}
	set {_car} to mtv vehicle with license plate {_plate}
	if {_car} is set:
		despawn mtv vehicle {_car}
		loop {-car::members::%{_plate}%::*}:
			remove loop-value as member of mtv vehicle {_car}
	delete {-car::members::%{_plate}%::*}
	delete {car::out::%{_plate}%}
	delete {-car::driver::%{_plate}%}
	delete {-car::used::%{_plate}%}
	delete {-car::fresh::%{_plate}%}
	delete {-car::lanesince::%{_plate}%}
	delete {-car::fxlast::%{_plate}%}
	set {_o} to carOwnerOf({_plate})
	if {_o} is not "":
		if {car::outof::%{_o}%} is {_plate}:
			delete {car::outof::%{_o}%}
	carLog("store %{_plate}% owner=%{_o}% why=%{_why}%")

function carFail(p: player, text: text):
	msg({_p}, "&c%{_text}%")
	play sound "entity.villager.no" with volume 0.6 to {_p}

# ---------- Getting in and out ----------

# MTVehicles fires this before its own checks (drivers and passengers). A click on a car that has a
# driver is a passenger seat; on an empty car it's the driver's.
on mtv vehicle enter:
	set {_plate} to event-text in upper case
	set {_o} to carOwnerOf({_plate})
	# Not one of ours (NPC cars later: npc-cars.sk): MTVehicles' own rules.
	{_o} is not ""
	if heistOf(player) is not "":
		cancel event
		hudBar(player, "&cNo cars in heists.", 2)
		stop
	# A copy that shouldn't be here (left behind in an unloaded chunk): not usable, the sweep removes it.
	set {_track} to {car::out::%{_plate}%}
	if {-car::driver::%{_plate}%} is set:
		set {_track} to location of {-car::driver::%{_plate}%}
	set {_stray} to false
	if {_track} is not set:
		set {_stray} to true
	else if world of {_track} is not world of event-location:
		set {_stray} to true
	else if distance between {_track} and event-location > 8:
		set {_stray} to true
	if {_stray} is true:
		cancel event
		hudBar(player, "&7This car was towed. &f/garage", 2)
		stop
	# No car rides into a safe zone for someone in combat: not even getting into one parked inside.
	if isCombatTagged(player) is true:
		if isSafeZone(event-location) is true:
			cancel event
			hudBar(player, "&cYou can't get into a car in a safe zone while in combat.", 3)
			stop
	set {_mine} to false
	if "%uuid of player%" is {_o}:
		set {_mine} to true
	if {-car::driver::%{_plate}%} is set:
		# A passenger seat (the owner always may).
		if {_mine} is false:
			if carLocked({_plate}) is true:
				cancel event
				hudBar(player, "&cThe car is locked.", 2)
				play sound "block.iron_door.close" with volume 0.5 to player
				stop
			set {_car} to mtv vehicle with license plate {_plate}
			set {_who} to player
			if {_car} is set:
				add {_who} as a member of the mtv vehicle {_car}
				set {-car::members::%{_plate}%::%uuid of player%} to {_who}
		stop
	# The driver's seat: only the owner.
	if {_mine} is false:
		cancel event
		if carLocked({_plate}) is true:
			hudBar(player, "&cThe car is locked.", 2)
		else:
			hudBar(player, "&cOnly the owner drives this car.", 2)
		stop
	# MTVehicles saves its owners only every 10 minutes: after a crash a traded car could still be the old
	# owner's there. This event comes before its own check, so the owner is set again first (trade.sk review).
	set {_car} to mtv vehicle with license plate {_plate}
	if {_car} is set:
		set vehicle owner of {_car} to player
	wait 2 ticks
	player is online
	carSeatCheck(player, {_plate})

# The seat a player is on right now ("" if none): the plate of the car and whether it's the driver's.
function carSeatOf(p: player) :: text:
	set {_v} to vehicle of {_p}
	if {_v} is not set:
		return ""
	set {_n} to "%name of {_v}%"
	if {_n} starts with "MTVEHICLES_MAINSEAT_":
		return "driver:%subtext of {_n} from characters 21 to (length of {_n})%"
	if {_n} starts with "MTVEHICLES_SEAT":
		set {_a::*} to {_n} split at "_"
		return "passenger:%{_a::3}%"
	return ""

# After an entry: really in the driver's seat -> the key replaces the phone, and the mods go into MTVehicles.
function carSeatCheck(p: player, plate: text):
	if carSeatOf({_p}) is not "driver:%{_plate}%":
		stop
	set {-car::driver::%{_plate}%} to {_p}
	set {-car::riding::%uuid of {_p}%} to {_plate}
	set {-car::used::%{_plate}%} to now
	# Picked up from the exit lane (citygarage.sk's pickup-idle no longer applies).
	delete {-car::fresh::%{_plate}%}
	closePhoneMap({_p})
	set slot 8 of {_p}'s inventory to carKey({_p}, {_plate})
	carApplyMods({_plate})
	carLog("drive %{_p}% %uuid of {_p}% %{_plate}%")

# The hardware mods: MTVehicles loads a car's stats from its data each time someone gets in, so this runs right after
# (DonatingPhone's /dphone carstat sets top speed, acceleration and steering for that plate until the next entry).
function carApplyMods(plate: text):
	set {_e} to carMod({_plate}, "engine")
	set {_t} to carMod({_plate}, "turbo")
	set {_h} to carMod({_plate}, "handling")
	if {_e} + {_t} + {_h} <= 0:
		stop
	set {_m} to carModelOf({_plate})
	set {_st::*} to "%{-cfg::car::%{_m}%::stats}%" split at "|"
	set {_max} to {_st::1} parsed as number
	set {_acc} to {_st::2} parsed as number
	set {_rot} to {_st::3} parsed as number
	if {_rot} is not set:
		carLog("mods-skipped %{_plate}% (no stats for %carModelOf({_plate})%)")
		stop
	if {_e} > 0:
		set {_max} to {_max} * (1 + {-cfg::carmod::engine::%{_e}%})
	if {_t} > 0:
		set {_acc} to {_acc} * (1 + {-cfg::carmod::turbo::%{_t}%})
	if {_h} > 0:
		set {_rot} to {_rot} + {-cfg::carmod::handling::%{_h}%}
	execute console command "dphone carstat %{_plate}% %carNum({_max})% %carNum({_acc})% %round({_rot})%"

# A number with 6 decimals ("0.013800"): Skript itself prints only 2, which would round a car's acceleration to 0.01.
function carNum(x: number) :: text:
	set {_i} to floor({_x})
	set {_f} to "%round(({_x} - {_i}) * 1000000)%"
	if {_f} is "1000000":
		add 1 to {_i}
		set {_f} to "0"
	loop 6 times:
		if length of {_f} < 6:
			set {_f} to "0%{_f}%"
	return "%{_i}%.%{_f}%"

# The key is the phone's map underneath (the player's phone map id), so holding it while driving still shows
# the GPS view; the pack draws it as a key in the inventory (custom model data donating:carkey).
function carKey(p: player, plate: text) :: item:
	set {_state} to "&aunlocked"
	if carLocked({_plate}) is true:
		set {_state} to "&clocked"
	set {_i} to filled map named "&6Car key &7· &f%carTitle({_plate})%" with lore "&7Right-click: lock/unlock" and "&7Doors: %{_state}%"
	set {_id} to metadata value "donating_phone_map" of {_p}
	if {_id} is set:
		set int tag "minecraft:map_id" of nbt of {_i} to {_id}
	set string list tag "minecraft:custom_model_data;strings" of nbt of {_i} to "donating:carkey"
	return tagItem({_i}, "carkey:%{_plate}%")

# Out of the driver's seat (MTVehicles' leave event is the driver's only; the every-second check catches
# everything else: a teleport, a death, a quit).
on mtv vehicle leave:
	carStopDriving(player, event-text in upper case)
	carTowLeft(player, event-text in upper case)

function carStopDriving(p: player, plate: text):
	delete {-car::riding::%uuid of {_p}%}
	delete {-car::outside::%uuid of {_p}%}
	delete {-car::outsideat::%uuid of {_p}%}
	if {-car::driver::%{_plate}%} is {_p}:
		delete {-car::driver::%{_plate}%}
	set {-car::used::%{_plate}%} to now
	if {car::out::%{_plate}%} is set:
		set {_l} to vehicle location of license plate {_plate}
		if {_l} is set:
			set {car::out::%{_plate}%} to {_l}
	carPhoneBack({_p})

function carPhoneBack(p: player):
	if itemId(slot 8 of {_p}'s inventory) starts with "carkey:":
		set slot 8 of {_p}'s inventory to phoneItem({_p})

every second:
	loop all players:
		set {_seat} to carSeatOf(loop-player)
		set {_plate} to {-car::riding::%uuid of loop-player%}
		if {_plate} is set:
			if {_seat} is not "driver:%{_plate}%":
				carStopDriving(loop-player, "%{_plate}%")
				carTowLeft(loop-player, "%{_plate}%")
			else if heistAt(location of loop-player) is not "":
				# A backstop for MTVehicles' region event (it only runs on driving input): out, and towed.
				carTow(loop-player, "%{_plate}%")
		else if itemId(slot 8 of loop-player's inventory) starts with "carkey:":
			carPhoneBack(loop-player)
		# Anyone in a car: combat-tagged inside a safe zone (a car that got in anyway) -> out, and back
		# to where they last were outside one.
		if {_seat} is not "":
			if isSafeZone(location of loop-player) is false:
				set {-car::outside::%uuid of loop-player%} to location of loop-player
				set {-car::outsideat::%uuid of loop-player%} to now
			else if isCombatTagged(loop-player) is true:
				carKickOut(loop-player, {_seat})

# Out of the car, and back outside the safe zone. Only a spot seen in the last 3 s and within 12 blocks (review
# 2026-09-28: a stale spot from an earlier ride teleported a wanted player away from the cops); else the car's
# own centre, which a tagged driver's car never gets into a safe zone with; else just out.
function carKickOut(p: player, seat: text):
	make {_p} dismount
	set {_back} to {-car::outside::%uuid of {_p}%}
	set {_at} to {-car::outsideat::%uuid of {_p}%}
	set {_ok} to false
	if {_back} is set:
		if {_at} is set:
			if difference between {_at} and now < 3 seconds:
				if world of {_back} is world of {_p}:
					if distance between {_back} and (location of {_p}) < 12:
						set {_ok} to true
	if {_ok} is false:
		set {_parts::*} to {_seat} split at ":"
		set {_back} to vehicle location of license plate {_parts::2}
		if {_back} is set:
			if isSafeZone({_back}) is false:
				set {_ok} to true
	if {_ok} is true:
		teleport {_p} to {_back}
	delete {-car::outside::%uuid of {_p}%}
	delete {-car::outsideat::%uuid of {_p}%}
	hudBar({_p}, "&cYou can't be in a safe zone while in combat.", 3)

# Throws a driver out of a car that ended up in a heist and sends the car back to the garage.
function carTow(p: player, plate: text):
	make {_p} dismount
	carStopDriving({_p}, {_plate})
	# The dismount's leave event may have towed it already (carTowLeft).
	if {car::out::%{_plate}%} is set:
		carStore({_plate}, "heist")
		hudBar({_p}, "&cNo cars in heists: &7yours was towed to the garage.", 3)

# A car its driver just left: towed if it stands inside a heist. heists.sk moves a rider out of a heist (no riding in,
# 2026-09-28) before the every-second backstop sees them in it, so the car they leave standing inside is towed here.
function carTowLeft(p: player, plate: text):
	{car::out::%{_plate}%} is set
	set {_l} to vehicle location of license plate {_plate}
	{_l} is set
	heistAt({_l}) is not ""
	carStore({_plate}, "heist")
	hudBar({_p}, "&cNo cars in heists: &7yours was towed to the garage.", 3)

on quit:
	set {_plate} to {-car::riding::%uuid of player%}
	{_plate} is set
	delete {-car::riding::%uuid of player%}
	if {-car::driver::%{_plate}%} is player:
		delete {-car::driver::%{_plate}%}

# ---------- Out of the water (owner, 2026-09-28: "make cars able to climb land 1 block tall") ----------
# MTVehicles 2.5.9 (VehicleMovement.move, javap-checked): a car whose centre (its MAIN stand) is in a water block only
# gets pushed forward and down (-0.8), and its drive-up check never runs, so it can't climb out onto the shore. On land
# driveUp 'both' already climbs a block. Here: a driver holding forward in water, facing a wall whose top is at most one
# block above the water's surface (the car sits on the bottom, so a shore a block above the water is 2+ blocks up from
# it), gets the car lifted onto it, a bit forward. Every car (garage cars, contract cars): only the seat decides.
every 2 ticks:
	loop all players:
		set {_seat} to carSeatOf(loop-player)
		if {_seat} starts with "driver:":
			if loop-player is pressing forward key:
				set {_plate} to subtext of {_seat} from characters 8 to (length of {_seat})
				set {_main} to "MTVEHICLES_MAIN_%{_plate}%"
				delete {_m}
				loop all armor stands in radius 4 around loop-player:
					if name of loop-entity-2 is {_main}:
						set {_m} to loop-entity-2
				if {_m} is set:
					carClimbOut({_m})

function carClimbOut(m: entity):
	set {_l} to location of {_m}
	"%type of block at {_l}%" contains "water"
	set {_yaw} to yaw of {_m}
	set {_dx} to 0 - sin({_yaw})
	set {_dz} to cos({_yaw})
	set {_x} to x-coordinate of {_l}
	set {_z} to z-coordinate of {_l}
	set {_w} to world of {_l}
	set {_by} to floor(y-coordinate of {_l})
	# The water above the car (it sinks to the bottom): {_sy} = the top water block, its surface is at sy + 1.
	set {_sy} to {_by}
	set {_more} to true
	loop 8 times:
		if {_more} is true:
			set {_up} to {_sy} + 1
			if "%type of block at location({_x}, {_up}, {_z}, {_w})%" contains "water":
				set {_sy} to {_up}
			else:
				set {_more} to false
	# Ahead: the first solid column at the car's height within 1.3 blocks (review 2026-09-28: looking 1.3 blocks ahead
	# past a thin wall let the car climb through it), not a barrier, with a spot to stand on no higher than one block above
	# the water's surface (land a block above the water, the owner's "1 block tall") and room for the car there.
	set {_found} to false
	loop 6 times:
		if {_found} is false:
			set {_step} to loop-value * 0.25
			set {_ax} to {_x} + {_dx} * {_step}
			set {_az} to {_z} + {_dz} * {_step}
			if block at location({_ax}, {_by}, {_az}, {_w}) is not passable:
				set {_found} to true
	{_found} is true
	type of block at location({_ax}, {_by}, {_az}, {_w}) is not barrier
	set {_ty} to -1000
	set {_top} to {_sy} + 2
	loop integers from ({_by} + 1) to {_top}:
		if {_ty} is -1000:
			set {_c} to location({_ax}, loop-value, {_az}, {_w})
			if block at {_c} is passable:
				if "%type of block at {_c}%" does not contain "water":
					if block at ({_c} ~ vector(0, 1, 0)) is passable:
						if block at ({_c} ~ vector(0, -1, 0)) is not passable:
							set {_ty} to loop-value
	{_ty} > -1000
	# Onto that column (MTVehicles moves the seats and the skin after it next tick).
	set {_dest} to location({_ax}, {_ty}, {_az}, {_w}, {_yaw}, 0)
	block at {_dest} is passable
	block at ({_dest} ~ vector(0, 1, 0)) is passable
	teleport {_m} to {_dest}
	carLog("climb %name of {_m}% from %floor({_x})%,%{_by}%,%floor({_z})% up to %{_ty}% (water top %{_sy}%)")

# ---------- Looks: neon and trails (particles while a car is driven) ----------

every 5 ticks:
	loop all players:
		set {_plate} to {-car::riding::%uuid of loop-player%}
		# The driver only: passengers would draw the same glow again.
		if {_plate} is set:
			set {_plate} to "%{_plate}%"
		if {-car::driver::%{_plate}%} is loop-player:
			set {_n} to carNeon({_plate})
			set {_t} to carTrail({_plate})
			if "%{_n}%%{_t}%" is not "":
				# The car's base is its MAIN stand: the driver sits lower (under the road on some models).
				set {_now} to location of loop-player
				set {_main} to "MTVEHICLES_MAIN_%{_plate}%"
				loop all armor stands in radius 4 around loop-player:
					if name of loop-entity-2 is {_main}:
						set {_now} to location of loop-entity-2
			if {_n} is not "":
				carNeonFx({_n}, {_now})
			if {_t} is not "":
				# Behind the car: opposite the way it moved since the last pass (nothing while it stands).
				set {_last} to {-car::fxlast::%{_plate}%}
				set {-car::fxlast::%{_plate}%} to {_now}
				if {_last} is set:
					if world of {_last} is world of {_now}:
						if distance between {_last} and {_now} > 0.3:
							set {_back} to {_last} ~ vector(0, 0.3, 0)
							carTrailFx({_t}, {_back})

# Particles don't take a variable type in Skript: one line per look.
function carNeonFx(n: text, l: location):
	# A steady glow on the ground under the car: colored dust doesn't drift (dragon breath and sparks flew off).
	set {_c} to {_l} ~ vector(0, 0.12, 0)
	if {_n} is "cyan":
		draw 8 rgb(0, 230, 255) dust particles of size 1.6 with offset vector(0.9, 0.02, 0.9) at {_c}
	else if {_n} is "blue":
		draw 8 rgb(40, 90, 255) dust particles of size 1.6 with offset vector(0.9, 0.02, 0.9) at {_c}
	else if {_n} is "green":
		draw 8 rgb(60, 255, 90) dust particles of size 1.6 with offset vector(0.9, 0.02, 0.9) at {_c}
	else if {_n} is "purple":
		draw 8 rgb(190, 60, 255) dust particles of size 1.6 with offset vector(0.9, 0.02, 0.9) at {_c}
	else if {_n} is "orange":
		draw 8 rgb(255, 140, 20) dust particles of size 1.6 with offset vector(0.9, 0.02, 0.9) at {_c}
	else if {_n} is "white":
		draw 8 rgb(255, 255, 255) dust particles of size 1.6 with offset vector(0.9, 0.02, 0.9) at {_c}

function carTrailFx(t: text, l: location):
	# No extra speed: the trail stays where the car was instead of flying around.
	if {_t} is "smoke":
		draw 4 large smoke particles with offset vector(0.2, 0.1, 0.2) with an extra value of 0.01 at {_l}
	else if {_t} is "flame":
		draw 5 flame particles with offset vector(0.2, 0.1, 0.2) with an extra value of 0.01 at {_l}
	else if {_t} is "blueflame":
		draw 5 soul fire flame particles with offset vector(0.2, 0.1, 0.2) with an extra value of 0.01 at {_l}
	else if {_t} is "sparks":
		draw 6 electric spark particles with offset vector(0.3, 0.1, 0.3) with an extra value of 0 at {_l}

# ---------- The key: lock and unlock ----------

on right click with priority lowest:
	itemId(player's tool) starts with "carkey:"
	cancel event
	if {-car::keyat::%player%} is set:
		difference between {-car::keyat::%player%} and now < 0.3 seconds
		stop
	set {-car::keyat::%player%} to now
	set {_id} to itemId(player's tool)
	carToggleLock(player, subtext of {_id} from characters 8 to (length of {_id}))

function carToggleLock(p: player, plate: text):
	if carOwnerOf({_plate}) is not "%uuid of {_p}%":
		carFail({_p}, "That's not your car.")
		stop
	if carLocked({_plate}) is false:
		# Where the car really is (it may be driving); a car in the garage can always be locked.
		if {car::out::%{_plate}%} is set:
			set {_where} to {car::out::%{_plate}%}
			if {-car::driver::%{_plate}%} is set:
				set {_where} to location of {-car::driver::%{_plate}%}
			if carNoLockAt({_where}) is true:
				carFail({_p}, "You can't lock cars here.")
				stop
		set {car::lock::%{_plate}%} to true
		set {_car} to mtv vehicle with license plate {_plate}
		if {_car} is set:
			loop {-car::members::%{_plate}%::*}:
				remove loop-value as member of mtv vehicle {_car}
		delete {-car::members::%{_plate}%::*}
		hudBar({_p}, "&cLocked", 1)
		play sound "block.iron_door.close" with volume 0.6 to {_p}
	else:
		set {car::lock::%{_plate}%} to false
		hudBar({_p}, "&aUnlocked &7· others can ride along", 1)
		play sound "block.iron_door.open" with volume 0.6 to {_p}
	carLog("lock %{_p}% %{_plate}% locked=%carLocked({_plate})%")
	if itemId(slot 8 of {_p}'s inventory) is "carkey:%{_plate}%":
		set slot 8 of {_p}'s inventory to carKey({_p}, {_plate})

function carNoLockAt(l: location) :: boolean:
	set {_prefix} to cfg("car::nolock-prefix")
	# Garages (citygarage.sk) are car spawn areas too.
	set {_gp} to cfg("garage::region-prefix")
	loop regions at {_l}:
		if name of loop-value starts with {_prefix}:
			return true
		if name of loop-value starts with {_gp}:
			return true
	return false

# ---------- Where cars may go ----------

# MTVehicles checks the car's regions every tick; cancelling throws the driver out.
on mtv vehicle region enter:
	set {_r} to event-text
	if {_r} starts with cfg("heist::region-prefix"):
		cancel event
		hudBar(player, "&cNo cars in heists. &7Go in on foot.", 2)
		stop
	if {_r} starts with cfg("pvp::safe-prefix"):
		# The driver, or anyone riding along (passengers fire no region events of their own).
		set {_tagged} to isCombatTagged(player)
		set {_plate} to {-car::riding::%uuid of player%}
		if {_plate} is set:
			loop all players:
				if carSeatOf(loop-player) is "passenger:%{_plate}%":
					if isCombatTagged(loop-player) is true:
						set {_tagged} to true
		if {_tagged} is true:
			cancel event
			hudBar(player, "&cNo driving into a safe zone with someone in combat.", 3)

# MTVehicles never protects its stands: two hits (or a cop's arrow) would break a car and drop its item.
on damage:
	victim is an armor stand
	"%name of victim%" starts with "MTVEHICLES"
	cancel event

# MTVehicles' own commands hand out car items and change owners: staff only.
on command:
	player is set
	set {_c} to command in lower case
	set {_mtv} to false
	if {_c} starts with "mtvehicles:":
		set {_mtv} to true
	else if {_c} is "minetopiavehicles":
		set {_mtv} to true
	else if {_c} is "mtv":
		set {_mtv} to true
	else if {_c} is "minetopiav":
		set {_mtv} to true
	else if {_c} is "mtvehicles":
		set {_mtv} to true
	else if {_c} is "mtvehicle":
		set {_mtv} to true
	else if {_c} is "vehicle":
		set {_mtv} to true
	{_mtv} is true
	player does not have permission "donating.staff"
	cancel event
	msg(player, "&7Your cars: &f/garage")

# ---------- Menus ----------
# Back buttons (phone.sk's convention, owner 2026-09-28): the garage is a phone app, so its main page has "◀ Phone"
# (openPhone, also when an attendant or /garage opened it); a car's options go back to the garage, its repaint and
# tuning pages to its options, the dealer's colors to the dealer's cars. The dealer's model list is a shop's main page
# (an NPC's, not a phone app): no button there, like the other shops. Always the bottom row's first slot.

function carClearGui(p: player):
	delete {-car::gui::%{_p}%}
	delete {-car::act::%{_p}%::*}
	delete {-car::screen::%{_p}%}

function carButton(p: player, gui: inventory, slot: number, i: item, act: text):
	set slot {_slot} of {_gui} to {_i}
	set {-car::act::%{_p}%::%{_slot}%} to {_act}

function carOpen(p: player, gui: inventory):
	set {-car::gui::%{_p}%} to {_gui}
	if {-car::gen::%{_p}%} is not set:
		set {-car::gen::%{_p}%} to 0
	open {_gui} to {_p}

function carPane(gui: inventory, rows: number):
	set {_pane} to gray stained glass pane named "&r"
	loop {_rows} * 9 times:
		set slot (loop-number - 1) of {_gui} to {_pane}

# A price's color: green when the player has the money, red when not.
function carPriceColor(p: player, price: number) :: text:
	if balance of {_p} < {_price}:
		return "&c"
	return "&a"

# "&aLevel 2 (Burglar)" in green when the player has it, red when not.
function carLevelText(p: player, need: number) :: text:
	set {_c} to "&c"
	if levelOk({_p}, {_need}) is true:
		set {_c} to "&a"
	return "%{_c}%Level %{_need}% (%levelName({_need})%)"

# The Car Dealer: every model sold (not crate cars), extreme ones last, then a model's colors.
function garageDealer(p: player):
	closePhoneMap({_p})
	set {_title} to "&8%{-cfg::shop::title::cars}%"
	set {_gui} to chest inventory with 3 rows named {_title}
	carClearGui({_p})
	carPane({_gui}, 3)
	set {_slot} to 10
	loop {-cfg::cars::*}:
		set {_id} to loop-value
		if carIsCrate({_id}) is false:
			set {_pr} to {-cfg::car::%{_id}%::price}
			set {_price} to formatMoney({_pr})
			set {_need} to carLevelOf({_id})
			set {_n} to size of carColorLabels({_id})
			delete {_l::*}
			if carIsExtreme({_id}) is true:
				add "&c&lEXTREME &r&7(%{-cfg::car::%{_id}%::kind}%)" to {_l::*}
			add "&7Price: %carPriceColor({_p}, {_pr})%%{_price}%" to {_l::*}
			add "&7Needs: %carLevelText({_p}, {_need})%" to {_l::*}
			add "&7Colors: &f%{_n}%" to {_l::*}
			if carIsExtreme({_id}) is true:
				add "&7Tuning and wraps: crate cars only" to {_l::*}
			set {_own} to carModelCount({_p}, {_id})
			if {_own} > 0:
				add "&aOwned: %{_own}%" to {_l::*}
			set {_i} to carIcon({_id}, carFirstColor({_id})) named "&6%carName({_id})%" with lore {_l::*}
			carButton({_p}, {_gui}, {_slot}, {_i}, "dealer:%{_id}%")
			add 1 to {_slot}
			if {_slot} is 17:
				set {_slot} to 19
	carButton({_p}, {_gui}, 26, barrier named "&cClose", "close")
	carOpen({_p}, {_gui})

# A model's colors at the dealer.
function garageColors(p: player, id: text):
	set {_title} to "&8%carName({_id})%: pick a color"
	set {_gui} to chest inventory with 3 rows named {_title}
	carClearGui({_p})
	set {-car::screen::%{_p}%} to "dealer:%{_id}%"
	carPane({_gui}, 3)
	set {_slot} to 10
	set {_pr} to {-cfg::car::%{_id}%::price}
	set {_price} to formatMoney({_pr})
	set {_need} to carLevelOf({_id})
	loop carColorLabels({_id}):
		set {_label} to loop-value
		if carArmed({_p}, carBuyKey({_id}, {_label})) is true:
			set {_i} to carArmedIcon("%{_label}% %carName({_id})%", {_pr})
		else if levelOk({_p}, {_need}) is false:
			set {_i} to carIcon({_id}, {_label}) named "&f%{_label}% &6%carName({_id})%" with lore "&7Price: %carPriceColor({_p}, {_pr})%%{_price}%" and "&cNeeds level %{_need}%"
		else:
			set {_i} to carIcon({_id}, {_label}) named "&f%{_label}% &6%carName({_id})%" with lore "&7Price: %carPriceColor({_p}, {_pr})%%{_price}%"
		carButton({_p}, {_gui}, {_slot}, {_i}, "buy:%{_id}%:%{_label}%")
		add 1 to {_slot}
		# 18 is "◀ Back": a model with more than 8 colors goes on in the bottom row.
		if {_slot} is 18:
			set {_slot} to 19
	carButton({_p}, {_gui}, 18, backItem("all cars"), "dealer")
	carButton({_p}, {_gui}, 26, barrier named "&cClose", "close")
	carOpen({_p}, {_gui})

# A car's other colors (the paint shop).
function garagePaintColors(p: player, plate: text):
	set {_id} to carModelOf({_plate})
	set {_title} to "&8%carName({_id})%: repaint"
	set {_gui} to chest inventory with 3 rows named {_title}
	carClearGui({_p})
	set {-car::screen::%{_p}%} to "paint:%{_plate}%"
	carPane({_gui}, 3)
	set {_slot} to 10
	set {_now} to carColor({_plate})
	set {_pr} to cfg("car::paint-price")
	set {_price} to formatMoney({_pr})
	loop carColorLabels({_id}):
		set {_label} to loop-value
		if {_label} is {_now}:
			set {_i} to carIcon({_id}, {_label}) named "&f%{_label}% &6%carName({_id})%" with lore "&aCurrent color"
			set slot {_slot} of {_gui} to {_i}
		else:
			if carArmed({_p}, carPaintKey({_plate}, {_label})) is true:
				set {_i} to carArmedIcon("Repaint %{_label}%", {_pr})
			else:
				set {_i} to carIcon({_id}, {_label}) named "&f%{_label}% &6%carName({_id})%" with lore "&7Repaint: %carPriceColor({_p}, {_pr})%%{_price}%"
			carButton({_p}, {_gui}, {_slot}, {_i}, "paint:%{_plate}%:%{_label}%")
		add 1 to {_slot}
		# 18 is "◀ Back": a model with more than 8 colors goes on in the bottom row.
		if {_slot} is 18:
			set {_slot} to 19
	carButton({_p}, {_gui}, 18, backItem("your %carTitle({_plate})%"), "options:%{_plate}%")
	carButton({_p}, {_gui}, 26, barrier named "&cClose", "close")
	carOpen({_p}, {_gui})

# The garage: every car the player owns, 36 a page, best first.
function garageMenu(p: player):
	garageMenuPage({_p}, 1)

function garageMenuPage(p: player, page: number):
	closePhoneMap({_p})
	set {_cars::*} to carsOf({_p})
	set {_total} to size of {_cars::*}
	set {_pages} to max(1, ceil({_total} / 36))
	set {_page} to max(1, min({_page}, {_pages}))
	set {_gui} to chest inventory with 6 rows named "&8Your garage (%{_total}%/%cfg("car::garage-max")%)"
	carClearGui({_p})
	carPane({_gui}, 6)
	# Where the cars come out (citygarage.sk): at this garage, Valet anywhere, or find a garage.
	set {_site} to garageAt({_p})
	set {_access} to false
	if garageAccessBlock({_p}) is "":
		set {_access} to true
	if garagesExist() is true:
		if {_site} is not "":
			set slot 4 of {_gui} to minecart named "&aGarage" with lore "&7Park: drive into a return lane"
		else if {_access} is true:
			set slot 4 of {_gui} to compass named "&6Valet" with lore "&7Cars come to you anywhere" and "&7Not in heists or combat"
		else:
			set {_gn} to garageNearest({_p})
			set {_where} to "&7No garage on the map yet"
			if {_gn} is not "":
				set {_gd} to round(distance between (location of {_p}) and poiLocation({poi::%{_gn}%}))
				set {_where} to "&7Nearest: &f%garagePoiName({_gn})% (%{_gd}%m)"
			carButton({_p}, {_gui}, 4, compass named "&6Find a garage" with lore {_where} and "&7Valet: &6[Elite] &d[Legend]", "find")
	set {_slot} to 9
	set {_from} to ({_page} - 1) * 36 + 1
	set {_to} to {_page} * 36
	set {_k} to 0
	loop {_cars::*}:
		add 1 to {_k}
		if {_k} >= {_from}:
			if {_k} <= {_to}:
				set {_plate} to loop-value
				set {_l::*} to carLoreOf({_plate})
				set {_dw} to carDriveBlock({_p}, {_plate})
				if {-car::driver::%{_plate}%} is set:
					add "&eBeing driven" to {_l::*}
				else if {car::out::%{_plate}%} is set:
					set {_at} to {car::out::%{_plate}%}
					add "&eOut at %floor(x-coordinate of {_at})%, %floor(z-coordinate of {_at})%" to {_l::*}
					if {_access} is true:
						add "&eLeft-click: bring it here" to {_l::*}
					else:
						add "&eLeft-click: find it" to {_l::*}
				else if {_dw} is not "":
					add "&cNeeds level %carLevelOf(carModelOf({_plate}))% to drive" to {_l::*}
				else:
					add "&aIn the garage" to {_l::*}
					if {_site} is not "":
						add "&eLeft-click: take it out" to {_l::*}
					else if {_access} is true:
						add "&eLeft-click: call it here" to {_l::*}
					else:
						add "&eLeft-click: find a garage" to {_l::*}
				if carLocked({_plate}) is true:
					add "&7Doors: &clocked" to {_l::*}
				else:
					add "&7Doors: &aunlocked" to {_l::*}
				add "&eRight-click: options" to {_l::*}
				set {_i} to carIconOf({_plate}) named "&6%carTitle({_plate})%%carSerialText({_plate})%" with lore {_l::*}
				if carGrade({_plate}) >= 3:
					set {_i} to glint({_i})
				carButton({_p}, {_gui}, {_slot}, {_i}, "car:%{_plate}%")
				add 1 to {_slot}
	if {_total} is 0:
		# The cheapest level a dealer car needs (crate cars need none).
		set {_low} to 1000
		loop {-cfg::cars::*}:
			if {-cfg::car::%loop-value%::crate} is not true:
				if {-cfg::car::%loop-value%::level} is set:
					set {_low} to min({_low}, {-cfg::car::%loop-value%::level})
		set slot 22 of {_gui} to paper named "&7No cars yet" with lore "&7Car Dealer: from level %{_low}%"
	# "◀ Phone" keeps the bottom-left slot on every page (where every menu's back button is); the page arrows sit
	# together on the right.
	carButton({_p}, {_gui}, 45, phoneBackItem(), "phone")
	if {_page} > 1:
		carButton({_p}, {_gui}, 52, arrow named "&fPage %{_page} - 1%", "page:%{_page} - 1%")
	if {_page} < {_pages}:
		carButton({_p}, {_gui}, 53, arrow named "&fPage %{_page} + 1%", "page:%{_page} + 1%")
	carButton({_p}, {_gui}, 49, barrier named "&cClose", "close")
	set {-car::page::%{_p}%} to {_page}
	carOpen({_p}, {_gui})

# One car's options: lock, repaint, tune, send back.
function garageOptions(p: player, plate: text):
	carOwns({_p}, {_plate}) is true
	set {_id} to carModelOf({_plate})
	set {_gui} to chest inventory with 3 rows named "&8%carTitle({_plate})%"
	carClearGui({_p})
	carPane({_gui}, 3)
	set {_i} to carIconOf({_plate}) named "&6%carTitle({_plate})%%carSerialText({_plate})%" with lore carLoreOf({_plate})
	set slot 4 of {_gui} to {_i}
	if carLocked({_plate}) is true:
		carButton({_p}, {_gui}, 10, iron door named "&cLocked" with lore "&7Unlock: others can ride along", "lock:%{_plate}%")
	else:
		carButton({_p}, {_gui}, 10, oak door named "&aUnlocked" with lore "&7Others can ride along", "lock:%{_plate}%")
	# Why a repaint or tuning can't happen right now (the car is out, or away from a garage), else "".
	set {_now} to ""
	if {car::out::%{_plate}%} is set:
		set {_now} to "&cSend it back first"
	else if garagesExist() is true:
		if garageAt({_p}) is "":
			set {_now} to "&cOnly at a garage"
	set {_n} to size of carColorLabels({_id})
	if carLockedBuild({_plate}) is true:
		set slot 12 of {_gui} to gray dye named "&7Repaint" with lore "&7Crate cars keep their paint and wrap"
	else if carWrap({_plate}) is not "":
		set slot 12 of {_gui} to gray dye named "&7Repaint" with lore "&7A wrapped car keeps its wrap"
	else if {_n} > 1:
		set {_price} to formatMoney(cfg("car::paint-price"))
		if {_now} is "":
			carButton({_p}, {_gui}, 12, red dye named "&dRepaint" with lore "&a%{_price}%", "paint:%{_plate}%")
		else:
			carButton({_p}, {_gui}, 12, red dye named "&dRepaint" with lore "&a%{_price}%" and {_now}, "paint:%{_plate}%")
	set {_tb} to carTuneBlock({_plate})
	if {_tb} is not "":
		set slot 14 of {_gui} to gray dye named "&7Tune" with lore "&7%{_tb}%"
	else if {_now} is "":
		carButton({_p}, {_gui}, 14, piston named "&bTune", "tune:%{_plate}%")
	else:
		carButton({_p}, {_gui}, 14, piston named "&bTune" with lore {_now}, "tune:%{_plate}%")
	if {car::out::%{_plate}%} is set:
		carButton({_p}, {_gui}, 16, chest named "&eSend it back", "store:%{_plate}%")
	carButton({_p}, {_gui}, 18, backItem("your garage"), "garage")
	carButton({_p}, {_gui}, 26, barrier named "&cClose", "close")
	carOpen({_p}, {_gui})

# The price of a part's next stage n for a model: max(min, floor(the model's price × share)).
function carModPrice(id: text, n: number) :: number:
	set {_price} to {-cfg::car::%{_id}%::price}
	if {_price} is not set:
		return 0
	return max({-cfg::carmod::min::%{_n}%}, floor({_price} * {-cfg::carmod::share::%{_n}%}))

# The tuning shop: each part's stage, what the next one does and costs.
function garageTune(p: player, plate: text):
	carOwns({_p}, {_plate}) is true
	set {_id} to carModelOf({_plate})
	set {_gui} to chest inventory with 3 rows named "&8Tune: %carTitle({_plate})%"
	carClearGui({_p})
	set {-car::screen::%{_p}%} to "tune:%{_plate}%"
	carPane({_gui}, 3)
	set slot 4 of {_gui} to carIconOf({_plate}) named "&6%carTitle({_plate})%" with lore carLoreOf({_plate})
	set {_slot} to 11
	loop {-cfg::carmod::parts::*}:
		set {_part} to loop-value
		set {_s} to carMod({_plate}, {_part})
		delete {_l::*}
		set {_what} to {-cfg::carmod::%{_part}%::what}
		if {_s} >= 3:
			set {_i} to lime concrete named "&b%carModName({_part})% III" with lore "&aMaxed out"
			set slot {_slot} of {_gui} to {_i}
		else:
			if {_s} > 0:
				add "&7Now: &bstage %carRoman({_s})%" to {_l::*}
			else:
				add "&7Now: &fstock" to {_l::*}
			set {_n} to {_s} + 1
			set {_v} to {-cfg::carmod::%{_part}%::%{_n}%}
			if {_part} is "handling":
				add "&7Stage %carRoman({_n})%: &f+%{_v}% %{_what}%" to {_l::*}
			else:
				add "&7Stage %carRoman({_n})%: &f+%round({_v} * 100)%%% %{_what}%" to {_l::*}
			set {_pr} to carModPrice({_id}, {_n})
			add "&7Price: %carPriceColor({_p}, {_pr})%%formatMoney({_pr})%" to {_l::*}
			if carArmed({_p}, carTuneKey({_plate}, {_part})) is true:
				set {_i} to carArmedIcon("%carModName({_part})% %carRoman({_n})%", {_pr})
			else:
				set {_i} to piston named "&b%carModName({_part})% %carRoman({_n})%" with lore {_l::*}
			carButton({_p}, {_gui}, {_slot}, {_i}, "tunebuy:%{_plate}%:%{_part}%")
		add 2 to {_slot}
	carButton({_p}, {_gui}, 18, backItem("your %carTitle({_plate})%"), "options:%{_plate}%")
	carButton({_p}, {_gui}, 26, barrier named "&cClose", "close")
	carOpen({_p}, {_gui})

on inventory click:
	{-car::gui::%player%} is set
	player's current inventory is {-car::gui::%player%}
	cancel event
	event-inventory is {-car::gui::%player%}
	set {_act} to {-car::act::%player%::%index of event-slot%}
	{_act} is set
	set {_right} to false
	set {_ok} to false
	if click type is left mouse button:
		set {_ok} to true
	else if click type is right mouse button:
		set {_ok} to true
		set {_right} to true
	{_ok} is true
	# One action per drawn screen, a tick later (as in crates.sk and shop.sk).
	set {_gen} to {-car::gen::%player%}
	wait 1 tick
	player is online
	{-car::gui::%player%} is set
	{-car::gen::%player%} is {_gen}
	add 1 to {-car::gen::%player%}
	carAction(player, {_act}, {_right})

on inventory drag:
	{-car::gui::%player%} is set
	player's current inventory is {-car::gui::%player%}
	cancel event

on inventory close:
	{-car::gui::%player%} is set
	event-inventory is {-car::gui::%player%}
	carClearGui(player)

function carAction(p: player, act: text, right: boolean):
	set {_a::*} to {_act} split at ":"
	set {_k} to {_a::1}
	if {_k} is "close":
		close {_p}'s inventory
	else if {_k} is "phone":
		# Opening the phone closes this menu: the close handler only forgets the screen, and an armed buy, repaint
		# or tune confirm just runs out (it needs a second click on its own button).
		openPhone({_p})
	else if {_k} is "dealer":
		if {_a::2} is set:
			garageColors({_p}, {_a::2})
		else:
			garageDealer({_p})
	else if {_k} is "garage":
		set {_pg} to {-car::page::%{_p}%}
		if {_pg} is not set:
			set {_pg} to 1
		garageMenuPage({_p}, {_pg})
	else if {_k} is "page":
		garageMenuPage({_p}, {_a::2} parsed as integer)
	else if {_k} is "car":
		if {_right} is true:
			garageOptions({_p}, {_a::2})
		else:
			close {_p}'s inventory
			# Away from a garage without Valet: the GPS leads to the car (out) or to a garage (in).
			if garageAccessBlock({_p}) is not "":
				garageFindCar({_p}, {_a::2})
			else:
				carCall({_p}, {_a::2})
	else if {_k} is "find":
		close {_p}'s inventory
		garageFind({_p})
	else if {_k} is "options":
		garageOptions({_p}, {_a::2})
	else if {_k} is "lock":
		if carOwns({_p}, {_a::2}) is true:
			carToggleLock({_p}, {_a::2})
		garageOptions({_p}, {_a::2})
	else if {_k} is "store":
		if carOwns({_p}, {_a::2}) is true:
			if {-car::driver::%{_a::2}%} is set:
				carFail({_p}, "Someone is in it.")
			else:
				carStore({_a::2}, "store")
				msg({_p}, "&aYour %carTitle({_a::2})% went back to the garage.")
		garageMenu({_p})
	else if {_k} is "paint":
		if {_a::3} is set:
			carPaint({_p}, {_a::2}, {_a::3})
		else:
			garagePaintColors({_p}, {_a::2})
	else if {_k} is "tune":
		garageTune({_p}, {_a::2})
	else if {_k} is "tunebuy":
		carTune({_p}, {_a::2}, {_a::3})
	else if {_k} is "buy":
		carBuy({_p}, {_a::2}, {_a::3})

# A second click within 5 s confirms (the key is the action and the price). The first click redraws the page with that
# button as a green "Confirm purchase?" block (chat is hidden behind a menu), and the page turns back after the window.
function carConfirm(p: player, key: text) :: boolean:
	if {-car::confirm::%{_p}%} is {_key}:
		if difference between {-car::confirmat::%{_p}%} and now < 5 seconds:
			delete {-car::confirm::%{_p}%}
			return true
	set {-car::confirm::%{_p}%} to {_key}
	set {-car::confirmat::%{_p}%} to now
	play sound "block.note_block.pling" with volume 0.6 to {_p}
	set {_screen} to {-car::screen::%{_p}%}
	if {_screen} is set:
		carRedraw({_p})
		carConfirmExpire({_p}, {_key}, {_screen})
	return false

function carArmed(p: player, key: text) :: boolean:
	if {-car::confirm::%{_p}%} is {_key}:
		if difference between {-car::confirmat::%{_p}%} and now < 5 seconds:
			return true
	return false

function carConfirmExpire(p: player, key: text, screen: text):
	wait 5.1 seconds
	{_p} is online
	{-car::confirm::%{_p}%} is {_key}
	delete {-car::confirm::%{_p}%}
	{-car::gui::%{_p}%} is set
	{-car::screen::%{_p}%} is {_screen}
	carRedraw({_p})

# Draws the page that has confirm buttons (the dealer's colors, repaint, tuning) again.
function carRedraw(p: player):
	set {_s::*} to "%{-car::screen::%{_p}%}%" split at ":"
	if {_s::1} is "dealer":
		garageColors({_p}, {_s::2})
	else if {_s::1} is "paint":
		garagePaintColors({_p}, {_s::2})
	else if {_s::1} is "tune":
		garageTune({_p}, {_s::2})

# The armed button: what the second click pays for.
function carArmedIcon(what: text, price: number) :: item:
	return lime concrete named "&a&lConfirm purchase?" with lore "&7%{_what}%: &a%formatMoney({_price})%" and "&eClick again to pay"

# The confirm keys (the action and the price, so a changed price asks again); the pages draw with the same keys.
function carBuyKey(id: text, label: text) :: text:
	set {_pr} to {-cfg::car::%{_id}%::price}
	return "buy:%{_id}%:%{_label}%@%{_pr}%"

function carPaintKey(plate: text, label: text) :: text:
	set {_pr} to cfg("car::paint-price")
	return "paint:%{_plate}%:%{_label}%@%{_pr}%"

function carTuneKey(plate: text, part: text) :: text:
	set {_n} to carMod({_plate}, {_part}) + 1
	set {_pr} to carModPrice(carModelOf({_plate}), {_n})
	return "tune:%{_plate}%:%{_part}%:%{_n}%@%{_pr}%"

# ---------- Buying, repainting and tuning ----------

function carBuyBlock(p: player, id: text) :: text:
	if {_p} is not alive:
		return "You can't buy a car right now."
	if isCombatTagged({_p}) is true:
		return "You can't buy a car while in combat."
	if carExists({_id}) is false:
		return "That car isn't for sale."
	if carIsCrate({_id}) is true:
		return "That car only comes from crates."
	set {_need} to carLevelOf({_id})
	if levelOk({_p}, {_need}) is false:
		return "The %carName({_id})% needs level %{_need}% (%levelName({_need})%)."
	return carRoomBlock({_p})

function carBuy(p: player, id: text, label: text):
	set {_why} to carBuyBlock({_p}, {_id})
	if {_why} is not "":
		carFail({_p}, {_why})
		stop
	if carColorPart({_id}, {_label}, 2) is "":
		stop
	# Only the dealer's colors are for sale (crate-only paint never is).
	carColorLabels({_id}) contains {_label}
	set {_price} to {-cfg::car::%{_id}%::price}
	if balance of {_p} < {_price}:
		carFail({_p}, "The %carName({_id})% costs %formatMoney({_price})%.")
		stop
	if carConfirm({_p}, carBuyKey({_id}, {_label})) is false:
		stop
	if chargeMoney({_p}, {_price}) is not true:
		carFail({_p}, "The %carName({_id})% costs %formatMoney({_price})%.")
		stop
	set {_plate} to carCreate({_p}, {_id}, {_label}, "", "dealer")
	if {_plate} is "":
		giveMoney({_p}, {_price})
		carFail({_p}, "The dealer couldn't register your car (refunded). Tell staff.")
		carLog("buy-failed %{_p}% %uuid of {_p}% %{_id}% %{_label}% refunded=%{_price}%")
		stop
	carLog("buy %{_p}% %uuid of {_p}% %{_id}% %{_label}% %{_plate}% price=%{_price}% vin=%carVin({_plate})%")
	close {_p}'s inventory
	send title colored "&6&lNEW CAR" with subtitle colored "&f%{_label}% %carName({_id})%" to {_p} for 3 seconds
	play sound "ui.toast.challenge_complete" with volume 0.7 to {_p}
	if garagesExist() is true:
		msg({_p}, "&aYou bought a %{_label}% %carName({_id})% &7(%carVinText({_plate})%)&a! &7Take it out at a garage: &f/gps")
	else:
		msg({_p}, "&aYou bought a %{_label}% %carName({_id})% &7(%carVinText({_plate})%)&a! &7Call it: &f/garage")

# "" when the paint or tuning shop may work on this car for the player now, else why not.
function carShopBlock(p: player, plate: text) :: text:
	if carOwns({_p}, {_plate}) is false:
		return "That's not your car."
	if {car::out::%{_plate}%} is set:
		return "Send it back to the garage first."
	if isCombatTagged({_p}) is true:
		return "Not while in combat."
	# The shops are at the garage (citygarage.sk; Valet doesn't cover them).
	if garagesExist() is true:
		if garageAt({_p}) is "":
			return "Repaints and tuning happen at a garage."
	return ""

function carPaint(p: player, plate: text, label: text):
	set {_id} to carModelOf({_plate})
	if carColorLabels({_id}) does not contain {_label}:
		stop
	if carLockedBuild({_plate}) is true:
		carFail({_p}, "Crate cars keep their paint and wrap.")
		stop
	if carWrap({_plate}) is not "":
		carFail({_p}, "A wrapped car keeps its wrap.")
		stop
	if carColor({_plate}) is {_label}:
		carFail({_p}, "It's %{_label}% already.")
		stop
	set {_why} to carShopBlock({_p}, {_plate})
	if {_why} is not "":
		carFail({_p}, {_why})
		if {_why} starts with "Repaints and tuning":
			garageFind({_p})
		stop
	set {_price} to cfg("car::paint-price")
	if balance of {_p} < {_price}:
		carFail({_p}, "A repaint costs %formatMoney({_price})%.")
		stop
	if carConfirm({_p}, carPaintKey({_plate}, {_label})) is false:
		# At a garage its bay shows the new color for a moment (citygarage.sk).
		garageBayPreview({_p}, {_plate}, {_label})
		stop
	if chargeMoney({_p}, {_price}) is not true:
		carFail({_p}, "A repaint costs %formatMoney({_price})%.")
		stop
	# A new plate in the new color (MTVehicles finds a car's model by its look); everything else moves to it and the
	# old car is deleted.
	set {_uuid} to carColorPart({_id}, {_label}, 2)
	set {_car} to a new mtv vehicle with uuid {_uuid} and owner {_p}
	if {_car} is not set:
		giveMoney({_p}, {_price})
		carFail({_p}, "The paint shop failed (refunded). Tell staff.")
		carLog("paint-failed %{_p}% %uuid of {_p}% %{_id}% %{_label}% refunded=%{_price}%")
		stop
	set {_new} to (vehicle license plate of {_car}) in upper case
	set {_old} to mtv vehicle with license plate {_plate}
	if {_old} is set:
		delete mtv vehicle {_old}
	carRekey({_plate}, {_new})
	set {car::color::%{_new}%} to {_label}
	carLog("paint %{_p}% %uuid of {_p}% %{_id}% %{_label}% old=%{_plate}% new=%{_new}% price=%{_price}%")
	msg({_p}, "&aYour %carName({_id})% is %{_label}% now. &7New plate: &f%{_new}%")
	play sound "entity.villager.work_cartographer" with volume 0.7 to {_p}
	garageOptions({_p}, {_new})

function carTune(p: player, plate: text, part: text):
	{-cfg::carmod::parts::*} contains {_part}
	set {_tb} to carTuneBlock({_plate})
	if {_tb} is not "":
		carFail({_p}, {_tb})
		stop
	set {_why} to carShopBlock({_p}, {_plate})
	if {_why} is not "":
		carFail({_p}, {_why})
		if {_why} starts with "Repaints and tuning":
			garageFind({_p})
		stop
	set {_s} to carMod({_plate}, {_part})
	if {_s} >= 3:
		carFail({_p}, "That's maxed out.")
		stop
	set {_n} to {_s} + 1
	set {_id} to carModelOf({_plate})
	set {_price} to carModPrice({_id}, {_n})
	if balance of {_p} < {_price}:
		carFail({_p}, "%carModName({_part})% %carRoman({_n})% costs %formatMoney({_price})%.")
		stop
	if carConfirm({_p}, carTuneKey({_plate}, {_part})) is false:
		stop
	if chargeMoney({_p}, {_price}) is not true:
		carFail({_p}, "%carModName({_part})% %carRoman({_n})% costs %formatMoney({_price})%.")
		stop
	set {car::mod::%{_plate}%::%{_part}%} to {_n}
	carLog("tune %{_p}% %uuid of {_p}% %{_id}% %{_plate}% %{_part}%=%{_n}% price=%{_price}%")
	msg({_p}, "&aFitted %carModName({_part})% %carRoman({_n})% on your %carTitle({_plate})%.")
	play sound "block.anvil.use" with volume 0.6 to {_p}
	garageTune({_p}, {_plate})

# ---------- Crate cars (crates.sk) ----------

# Gives a stock crate car (a Legendary or Hacked crate's "car|<id>|<Name>" line): its text for chat and crates.log, or ""
# when it can't be given (the garage is full, an unknown car: crates.sk then pays the crate's dupe value).
function garageGrantCar(p: player, id: text, why: text) :: text:
	if carExists({_id}) is false:
		carLog("grant-unknown %{_p}% %uuid of {_p}% %{_id}% why=%{_why}%")
		return ""
	return garageGrantBuild({_p}, "%{_id}%|%carFirstColor({_id})%|-|0|0|0|-|-", {_why})

# A whole car rolled by a car crate: "model|color|wrap|engine|turbo|handling|neon|trail" ("-" = none). The model is
# picked by weight, a crate-only color at special-color, the wrap's tier by weight (then any non-retired wrap of it the
# model can wear), each part's stage by weight, neon and trail by chance.
function carRoll(pool: text) :: text:
	set {_id} to carWeighted({-cfg::carroll::%{_pool}%::cars::*})
	if carExists({_id}) is false:
		return ""
	set {_label} to carFirstColor({_id})
	set {_x::*} to carSpecialLabels({_id})
	set {_c::*} to carColorLabels({_id})
	set {_r} to random number between 0 and 1
	if size of {_x::*} > 0:
		if {_r} < {-cfg::carroll::%{_pool}%::special-color}:
			set {_label} to random element out of {_x::*}
		else if size of {_c::*} > 0:
			set {_label} to random element out of {_c::*}
	else if size of {_c::*} > 0:
		set {_label} to random element out of {_c::*}
	set {_wrap} to "-"
	set {_tier} to carWeighted({-cfg::carroll::%{_pool}%::wraps::*}) parsed as integer
	if {_tier} is set:
		if {_tier} > 0:
			set {_w::*} to carWrapsOfTier({_id}, {_tier})
			if size of {_w::*} > 0:
				set {_wrap} to random element out of {_w::*}
	loop {-cfg::carmod::parts::*}:
		set {_st} to carWeighted({-cfg::carroll::%{_pool}%::stages::*}) parsed as integer
		if {_st} is not set:
			set {_st} to 0
		set {_s::%loop-value%} to min(3, max(0, {_st}))
	set {_neon} to "-"
	set {_r} to random number between 0 and 1
	if {_r} < {-cfg::carroll::%{_pool}%::neon}:
		set {_neon} to random element out of {-cfg::carneons::*}
	set {_trail} to "-"
	set {_r} to random number between 0 and 1
	if {_r} < {-cfg::carroll::%{_pool}%::trail}:
		set {_trail} to random element out of {-cfg::cartrails::*}
	return "%{_id}%|%{_label}%|%{_wrap}%|%{_s::engine}%|%{_s::turbo}%|%{_s::handling}%|%{_neon}%|%{_trail}%"

# A "weight|value" list picked by weight: the value ("" if the list is empty).
function carWeighted(lines: texts) :: text:
	set {_total} to 0
	loop {_lines::*}:
		set {_a::*} to loop-value split at "|"
		add ({_a::1} parsed as number) to {_total}
	if {_total} <= 0:
		return ""
	set {_r} to random number between 0 and {_total}
	set {_acc} to 0
	set {_last} to ""
	loop {_lines::*}:
		set {_a::*} to loop-value split at "|"
		add ({_a::1} parsed as number) to {_acc}
		set {_last} to {_a::2}
		if {_r} < {_acc}:
			return {_a::2}
	return {_last}

# The grade a build will have (before the car exists: the crate's spin and announcement).
function carBuildGrade(build: text) :: number:
	set {_b::*} to {_build} split at "|"
	set {_g} to 0
	if {_b::3} is not "-":
		set {_g} to carWrapTier({_b::3})
	set {_mods} to false
	loop 4, 5 and 6:
		if ({_b::%loop-value%} parsed as integer) > 0:
			set {_mods} to true
	if {_b::7} is not "-":
		set {_mods} to true
	if {_b::8} is not "-":
		set {_mods} to true
	if {_mods} is true:
		add 1 to {_g}
	return min(4, {_g})

# "&dExotic &fH4CK3R Apex &7(Engine II, Neon: Cyan)".
function carBuildText(build: text) :: text:
	set {_b::*} to {_build} split at "|"
	set {_name} to "%{_b::2}% %carName({_b::1})%"
	if {_b::3} is not "-":
		set {_name} to "%carWrapName({_b::3})% %carName({_b::1})%"
	set {_n} to 0
	loop {-cfg::carmod::parts::*}:
		add 1 to {_n}
		set {_s} to {_b::%{_n} + 3%} parsed as integer
		if {_s} > 0:
			add "%carModName(loop-value)% %carRoman({_s})%" to {_m::*}
	if {_b::7} is not "-":
		add "Neon: %{-cfg::carneon::%{_b::7}%::name}%" to {_m::*}
	if {_b::8} is not "-":
		add "Trail: %{-cfg::cartrail::%{_b::8}%::name}%" to {_m::*}
	set {_t} to "%carGradeName(carBuildGrade({_build}))% &f%{_name}%"
	if size of {_m::*} > 0:
		set {_t} to "%{_t}% &7(%join {_m::*} with ", "%)"
	return {_t}

# The build's model as a menu icon (its wrap or its color).
function carBuildIcon(build: text) :: item:
	set {_b::*} to {_build} split at "|"
	if {_b::3} is not "-":
		set {_v::*} to carWrapVariant({_b::1}, {_b::3}) split at "="
		set {_d} to {_v::2} parsed as number
		if {_d} is set:
			return carIconDamage({_d})
	return carIcon({_b::1}, {_b::2})

# Makes a crate build for the player: locked as it rolled, numbered of its kind. Its text for chat, or "" when it can't
# (a full garage, an unknown car or look: crates.sk pays the crate's dupe value then).
function garageGrantBuild(p: player, build: text, why: text) :: text:
	set {_b::*} to {_build} split at "|"
	set {_id} to {_b::1}
	if carExists({_id}) is false:
		carLog("grant-unknown %{_p}% %uuid of {_p}% %{_build}% why=%{_why}%")
		return ""
	if carRoomBlock({_p}) is not "":
		carLog("grant-full %{_p}% %uuid of {_p}% %{_build}% why=%{_why}%")
		return ""
	set {_wrap} to {_b::3}
	if {_wrap} is "-":
		set {_wrap} to ""
	set {_plate} to carCreate({_p}, {_id}, {_b::2}, {_wrap}, {_why})
	if {_plate} is "":
		return ""
	set {_n} to 0
	loop {-cfg::carmod::parts::*}:
		add 1 to {_n}
		set {_s} to {_b::%{_n} + 3%} parsed as integer
		if {_s} > 0:
			set {car::mod::%{_plate}%::%loop-value%} to {_s}
	if {_b::7} is not "-":
		set {car::neon::%{_plate}%} to {_b::7}
	if {_b::8} is not "-":
		set {car::trail::%{_plate}%} to {_b::8}
	set {car::locked::%{_plate}%} to true
	set {car::serial::%{_plate}%} to serialMint(carSerialKey({_plate}))
	carLog("grant %{_p}% %uuid of {_p}% %{_build}% %{_plate}% why=%{_why}% vin=%carVin({_plate})% serial=%{car::serial::%{_plate}%}% grade=%carGrade({_plate})%")
	set {_where} to "in your garage: &f/garage&7"
	set {_lv} to carLevelOf({_id})
	if levelOk({_p}, {_lv}) is false:
		set {_where} to "%{_where}%; drive it from level %{_lv}%"
	return "%carGradeName(carGrade({_plate}))% &6%carTitle({_plate})%%carSerialText({_plate})% &7(%{_where}%)"

# ---------- Commands ----------

command /garage:
	description: Your cars: call them, send them back, lock, repaint, tune.
	aliases: /cars
	executable by: players
	trigger:
		garageMenu(player)

command /dgarage <text> [<offline player>] [<text>] [<text>]:
	permission: donating.staff
	permission message: &cStaff only.
	trigger:
		if arg-1 is "give":
			if arg-3 is not set:
				send "GARAGE give <player> <car> [color]" to sender
				stop
			if carExists(arg-3) is false:
				send "GARAGE no car %arg-3%" to sender
				stop
			set {_label} to carFirstColor(arg-3)
			if arg-4 is set:
				set {_label} to arg-4
			set {_plate} to carCreate(arg-2, arg-3, {_label}, "", "staff")
			carLog("staff-give %arg-2% %uuid of arg-2% %arg-3% %{_label}% %{_plate}% by=%sender%")
			send "GARAGE gave %arg-2% a %{_label}% %arg-3%: %{_plate}% vin=%carVin({_plate})%" to sender
		else if arg-1 is "build":
			# build <player> <model|color|wrap|engine|turbo|handling|neon|trail> (a crate car, for tests and staff).
			if arg-3 is not set:
				send "GARAGE build <player> <model|color|wrap|e|t|h|neon|trail>" to sender
				stop
			set {_pl} to "%arg-2%" parsed as player
			if {_pl} is not set:
				send "GARAGE %arg-2% isn't online" to sender
				stop
			set {_got} to garageGrantBuild({_pl}, arg-3, "staff")
			carLog("staff-build %arg-2% %uuid of arg-2% %arg-3% by=%sender% got=%{_got}%")
			send "GARAGE build %arg-2%: %{_got}%" to sender
		else if arg-1 is "take":
			set {_plate} to arg-3 in upper case
			if carOwns(arg-2, {_plate}) is false:
				send "GARAGE %arg-2% has no car with plate %arg-3%" to sender
				stop
			carStore({_plate}, "staff-take")
			set {_car} to mtv vehicle with license plate {_plate}
			if {_car} is set:
				delete mtv vehicle {_car}
			delete {data::%arg-2%::cars::%{_plate}%}
			carLog("staff-take %arg-2% %uuid of arg-2% %{_plate}% %carModelOf({_plate})% vin=%carVin({_plate})% by=%sender%")
			carForget({_plate})
			send "GARAGE took %arg-2%'s %{_plate}%" to sender
		else if arg-1 is "info":
			carMigrate(arg-2)
			loop carsOf(arg-2):
				set {_plate} to loop-value
				set {_st} to "garage"
				if {car::out::%{_plate}%} is set:
					set {_st} to "out"
				if {-car::driver::%{_plate}%} is set:
					set {_st} to "driven"
				set {_mods} to "%carMod({_plate}, "engine")%%carMod({_plate}, "turbo")%%carMod({_plate}, "handling")%"
				add "%{_plate}%=%carModelOf({_plate})%(%carColor({_plate})%,wrap=%carWrap({_plate})%,mods=%{_mods}%,neon=%carNeon({_plate})%,trail=%carTrail({_plate})%,grade=%carGrade({_plate})%,vin=%carVin({_plate})%,serial=%{car::serial::%{_plate}%}%,built=%carLockedBuild({_plate})%,%{_st}%,locked=%carLocked({_plate})%,alive=%carAlive({_plate})%)" to {_o::*}
			set {_all} to join {_o::*} with " "
			send "GARAGE %arg-2% %{_all}% outof=%{car::outof::%uuid of arg-2%}%" to sender
		else if arg-1 is "store":
			set {_plate} to {car::outof::%uuid of arg-2%}
			if {_plate} is not set:
				send "GARAGE %arg-2% has no car out" to sender
				stop
			carStore("%{_plate}%", "staff")
			send "GARAGE stored %{_plate}%" to sender
		else if arg-1 is "roll":
			# roll <pool> [n]: test rolls, nothing given (the crate odds at a glance).
			set {_pool} to "%arg-2%"
			if arg-3 is set:
				set {_pool} to arg-3
			send "GARAGE roll %{_pool}%: %carRoll({_pool})%" to sender
		else:
			send "GARAGE usage: /dgarage give|build|take|info|store <player> [car|build|plate] [color]" to sender
