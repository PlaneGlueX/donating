# crates.sk: crates, keys and /daily. Built 2026-09-26 (owner: crates daily, common, uncommon, rare, epic,
# legendary, hacked; /daily gives everyone a daily key and each rank its extra keys; keys for common to
# legendary are sold on Tebex; hacked keys only at special events, never sold).
#
# Keys are virtual: data keys::<crate> = how many (never an item: the inventory is fixed). A crate's
# rewards are core.sk crate::<id>::rewards ("weight|kind|what|amount"); the chance of each line is its
# weight / the crate's total, shown in the menu. Every cosmetic belongs to one crate only (owner,
# 2026-09-26). Ammo, consumables and tools that don't fit pay cfg crate::overflow-rate (50%) of their
# shop price in cash instead; a cosmetic you own pays its rarity's dupe value (cosmetics.sk).
#
# Crates open only at crate stands, special places on the map (owner, 2026-09-26), and only in a safe
# zone, never inside a heist, in combat or dead. Opening takes the key and rolls at once, and the roll
# is saved as a pending reward ({cratepending::<uuid>::*}); the strip spins and the reward is given when
# it stops (owner: "give the reward after the animation"). Closing the menu ends the spin early and
# gives it at once; a logout or a crash mid-spin gives it at the next join, death at the respawn.
#   /crates           keys, what's inside each crate (the odds) and where to buy keys; no opening
#   /daily            once every cfg daily::hours (20): a daily key + the rank's daily-keys
#   crate stands      /dcrate place <crate> turns the block you look at into that crate (a hologram
#                     above it); clicking it shows the crate with an Open button. /dcrate remove, list.
#   /dcrate give <player> <crate> [count]   Tebex: dcrate give {username} rare {purchaseQuantity}
#   /dcrate take <player> <crate> [count]   Tebex refund/chargeback: takes back unused keys
#   /dcrate info <player>
# /dcrate is the owner's and the console's only (permission donating.store): keys are paid items.
# The Hacked crate's name is animated (owner, 2026-09-26): obfuscated text that reveals HACKED in a wave,
# holds, and hides again (in /crates and on its stands' holograms, %donating_hacked_crate%).
# Log: plugins\Skript\logs\crates.log (every key given, taken and used, every roll and what it paid).

function crateLog(text: text):
	log {_text} to "crates"

function crateExists(t: text) :: boolean:
	if {-cfg::crates::*} contains {_t}:
		return true
	return false

# "Rare Crate" / "&9Rare Crate".
function crateName(t: text) :: text:
	return "%{-cfg::rarity::%{_t}%::name}% Crate"

function crateColored(t: text) :: text:
	return "%{-cfg::rarity::%{_t}%::color}%%crateName({_t})%"

function crateKeys(p: offline player, t: text) :: number:
	set {_n} to {data::%{_p}%::keys::%{_t}%}
	if {_n} is set:
		return {_n}
	return 0

function crateAddKeys(p: offline player, t: text, n: number, why: text):
	set {data::%{_p}%::keys::%{_t}%} to crateKeys({_p}, {_t}) + {_n}
	crateLog("keys+ %{_p}% %uuid of {_p}% %{_t}% +%{_n}% now=%crateKeys({_p}, {_t})% why=%{_why}%")

# ---------- The animated Hacked name ----------

# One frame of the 44-frame loop (a frame every 2 ticks = 4.4 s): all obfuscated for 1 s, HACKED
# revealed a letter at a time left to right, shown for 1 s, then hidden again left to right.
function hackedName(f: number) :: text:
	set {_word} to "HACKED"
	set {_out} to ""
	loop 6 times:
		set {_i} to loop-number
		set {_show} to false
		if {_f} >= 10:
			if {_f} < 22:
				if {_i} <= floor(({_f} - 10) / 2) + 1:
					set {_show} to true
			else if {_f} < 32:
				set {_show} to true
			else if {_i} > floor(({_f} - 32) / 2) + 1:
				set {_show} to true
		set {_c} to subtext of {_word} from characters {_i} to {_i}
		if {_show} is true:
			set {_out} to "%{_out}%&a&l%{_c}%"
		else:
			set {_out} to "%{_out}%&2&l&k%{_c}%"
	return {_out}

# The crate's name in a menu or a hologram: animated for Hacked, else crateColored.
function crateLiveName(t: text) :: text:
	if {_t} is "hacked":
		if {-ph::hackedcrate} is set:
			return {-ph::hackedcrate}
	return crateColored({_t})

every 2 ticks:
	add 1 to {-crate::hackframe}
	if {-crate::hackframe} >= 44:
		set {-crate::hackframe} to 0
	set {-ph::hackedcrate} to "%hackedName({-crate::hackframe})%&r&2 Crate"
	loop {-crate::hackview::*}:
		set {_p} to loop-value
		if {_p} is online:
			set {_s} to {-crate::hackslot::%{_p}%}
			set {_gui} to {-crate::gui::%{_p}%}
			if {_s} is set:
				if {_gui} is set:
					set {_i} to {-crate::hackitem::%{_p}%} named colored {-ph::hackedcrate}
					set slot {_s} of {_gui} to {_i}
		else:
			delete {-crate::hackview::%loop-index%}

# ---------- Rewards ----------

function crateWeight(line: text) :: number:
	set {_a::*} to {_line} split at "|"
	set {_w} to {_a::1} parsed as number
	if {_w} is set:
		return {_w}
	return 0

# The cosmetic ids of a "cos" line ("cos|hacker,matrix" is a set of two).
function crateCosIds(line: text) :: texts:
	set {_a::*} to {_line} split at "|"
	return {_a::3} split at ","

# Whether a line can roll now: a cosmetic that's unknown, retired or testing is left out, and so is a
# car until cars exist (cfg crate::cars, set by garage.sk).
function crateLineLive(line: text) :: boolean:
	if crateWeight({_line}) <= 0:
		return false
	set {_a::*} to {_line} split at "|"
	if {_a::2} is "cos":
		loop crateCosIds({_line}):
			if cosExists(loop-value) is false:
				return false
			if cosHidden(loop-value) is true:
				return false
	if {_a::2} is "car":
		if {-cfg::crate::cars} is not true:
			return false
		if carExists({_a::3}) is false:
			return false
	return true

function crateLines(t: text) :: texts:
	loop {-cfg::crate::%{_t}%::rewards::*}:
		if crateLineLive(loop-value) is true:
			add loop-value to {_out::*}
	return {_out::*}

function crateTotal(t: text) :: number:
	set {_sum} to 0
	loop crateLines({_t}):
		add crateWeight(loop-value) to {_sum}
	return {_sum}

# A line picked by weight ("" if the crate has none).
function crateRoll(t: text) :: text:
	set {_total} to crateTotal({_t})
	if {_total} <= 0:
		return ""
	set {_r} to random number between 0 and {_total}
	set {_acc} to 0
	set {_last} to ""
	loop crateLines({_t}):
		add crateWeight(loop-value) to {_acc}
		set {_last} to loop-value
		if {_r} < {_acc}:
			return loop-value
	return {_last}

# The rarity a line counts as: a cosmetic's own (the first of a set), anything else the crate's.
function crateLineRarity(line: text, t: text) :: text:
	set {_a::*} to {_line} split at "|"
	if {_a::2} is "cos":
		set {_ids::*} to crateCosIds({_line})
		set {_r} to {-cfg::cos::%{_ids::1}%::rarity}
		if {_r} is set:
			return {_r}
	return {_t}

# "&9Cash Print &7bag skin" (a set: joined with " + ").
function crateCosText(line: text) :: text:
	loop crateCosIds({_line}):
		set {_id} to loop-value
		set {_type} to {-cfg::cos::%{_id}%::type}
		set {_tn} to cosTypeName({_type})
		add "%cosColored({_id})% &7%{_tn}%" to {_parts::*}
	return join {_parts::*} with " &7+ "

# "&a$1,000", "&e64 Light Rounds", "&f2 Stims", "&f1 Drill", "&9Cash Print &7bag skin", "&6Vandal &7car".
function crateLineText(line: text) :: text:
	set {_a::*} to {_line} split at "|"
	set {_k} to {_a::2}
	if {_k} is "money":
		return "&a%formatMoney({_a::3} parsed as number)%"
	if {_k} is "ammo":
		return "&e%{_a::4}% %{-cfg::ammo::%{_a::3}%::name}%"
	if {_k} is "con":
		set {_n} to {_a::4} parsed as number
		if {_n} is 1:
			return "&f1 %{-cfg::con::%{_a::3}%::name}%"
		return "&f%{_n}% %{-cfg::con::%{_a::3}%::name}%s"
	if {_k} is "tool":
		set {_n} to {_a::4} parsed as number
		if {_n} is 1:
			return "&f1 %{-cfg::tool::%{_a::3}%::name}%"
		return "&f%{_n}% %{-cfg::tool::%{_a::3}%::name}%s"
	if {_k} is "cos":
		return crateCosText({_line})
	if {_k} is "car":
		return "&6%{_a::4}% &7car"
	return "&f%{_line}%"

# The line as a menu icon (the pack's art where there is some). Never tagged: it's only a picture.
function crateLineIcon(line: text) :: item:
	set {_a::*} to {_line} split at "|"
	set {_k} to {_a::2}
	if {_k} is "money":
		set {_i} to paper
		set string list tag "minecraft:custom_model_data;strings" of nbt of {_i} to "donating:loot_cash"
	else if {_k} is "ammo":
		set {_i} to ammoIcon({_a::3})
	else if {_k} is "con":
		set {_i} to wpnIcon({_a::3})
	else if {_k} is "tool":
		set {_i} to 1 of {-cfg::tool::%{_a::3}%::item}
		set string list tag "minecraft:custom_model_data;strings" of nbt of {_i} to "donating:tool_%{_a::3}%"
	else if {_k} is "cos":
		# A set shows its most visible part (a bag skin, else a kill effect, else the title), so a spin
		# over sets doesn't look frozen (found in the client, 2026-09-26: both Hacked sets were name tags).
		set {_ids::*} to crateCosIds({_line})
		set {_show} to {_ids::1}
		loop {_ids::*}:
			if {-cfg::cos::%loop-value%::type} is "killfx":
				if {-cfg::cos::%{_show}%::type} is "title":
					set {_show} to loop-value
		loop {_ids::*}:
			if {-cfg::cos::%loop-value%::type} is "bagskin":
				set {_show} to loop-value
		set {_type} to {-cfg::cos::%{_show}%::type}
		if {_type} is "bagskin":
			set {_i} to leather
			set string list tag "minecraft:custom_model_data;strings" of nbt of {_i} to "donating:bag_%{_show}%"
		else if {_type} is "killfx":
			set {_i} to blaze powder
		else:
			set {_i} to name tag
	else if {_k} is "car":
		set {_i} to carIcon({_a::3}, carFirstColor({_a::3}))
	else:
		set {_i} to barrier
	set name of {_i} to colored crateLineText({_line})
	return {_i}

# Pay for what didn't fit: cfg crate::overflow-rate (0.5) of the shop price, rounded down.
function crateOverflowCash(n: number, price: number) :: number:
	return floor({_n} * {_price} * cfg("crate::overflow-rate"))

# Gives the reward of a line to an online, living player; returns what they got (for chat and the log).
function crateGrant(p: player, line: text, t: text) :: text:
	set {_a::*} to {_line} split at "|"
	set {_k} to {_a::2}
	if {_k} is "money":
		set {_n} to {_a::3} parsed as number
		giveMoney({_p}, {_n})
		return "&a%formatMoney({_n})%"
	if {_k} is "ammo":
		set {_type} to {_a::3}
		set {_n} to {_a::4} parsed as number
		set {_name} to {-cfg::ammo::%{_type}%::name}
		set {_got} to addAmmo({_p}, {_type}, min({_n}, ammoRoom({_p}, {_type})))
		set {_cash} to crateOverflowCash({_n} - {_got}, {-cfg::ammo::%{_type}%::price})
		giveMoney({_p}, {_cash})
		if {_got} >= {_n}:
			return "&e%{_n}% %{_name}%"
		if {_got} > 0:
			return "&e%{_got}% %{_name}% &7+ &a%formatMoney({_cash})% &7(no room for %{_n} - {_got}% more)"
		return "&a%formatMoney({_cash})% &7(no room for %{_n}% %{_name}%: cash instead)"
	if {_k} is "con":
		set {_w} to {_a::3}
		set {_n} to {_a::4} parsed as number
		set {_name} to {-cfg::con::%{_w}%::name}
		set {_max} to {-cfg::con::%{_w}%::max}
		set {_fit} to 0
		set {_have} to 0
		set {_slot} to loadoutSlotOf({_p}, "con:%{_w}%")
		if {_slot} >= 0:
			set {_have} to item amount of slot {_slot} of {_p}'s inventory
		else:
			set {_slot} to freeLoadoutSlot({_p})
		if {_slot} >= 0:
			set {_fit} to max(0, min({_n}, {_max} - {_have}))
		if {_fit} > 0:
			execute console command "wm give %name of {_p}% %{_w}% %{_have} + {_fit}% {slot:%{_slot}%}"
			if wmTitle(slot {_slot} of {_p}'s inventory) is not {_w}:
				set {_fit} to 0
			else if item amount of slot {_slot} of {_p}'s inventory is not {_have} + {_fit}:
				set {_fit} to 0
				send "[Donating] crates: wm give %{_w}% to %name of {_p}% gave the wrong amount" to console
		set {_cash} to crateOverflowCash({_n} - {_fit}, {-cfg::con::%{_w}%::price})
		giveMoney({_p}, {_cash})
		if {_fit} >= {_n}:
			return crateLineText({_line})
		if {_fit} > 0:
			return "&f%{_fit}% %{_name}% &7+ &a%formatMoney({_cash})% &7(you carry %{_max}% at most)"
		return "&a%formatMoney({_cash})% &7(no room for %{_name}%s: cash instead)"
	if {_k} is "tool":
		set {_tool} to {_a::3}
		set {_n} to {_a::4} parsed as number
		set {_name} to {-cfg::tool::%{_tool}%::name}
		set {_fit} to 0
		set {_why} to "no room"
		if levelOk({_p}, toolLevel({_tool})) is false:
			set {_why} to "needs level %toolLevel({_tool})%"
		else:
			set {_have} to 0
			set {_slot} to toolSlot({_p}, {_tool})
			if {_slot} >= 0:
				set {_have} to item amount of slot {_slot} of {_p}'s inventory
			else:
				set {_slot} to freeLoadoutSlot({_p})
			if {_slot} >= 0:
				set {_fit} to max(0, min({_n}, {-cfg::tool::%{_tool}%::max} - {_have}))
			if {_fit} > 0:
				set slot {_slot} of {_p}'s inventory to toolItem({_tool}, {_have} + {_fit})
				if toolCount({_p}, {_tool}) is not {_have} + {_fit}:
					set {_fit} to 0
		set {_cash} to crateOverflowCash({_n} - {_fit}, {-cfg::tool::%{_tool}%::price})
		giveMoney({_p}, {_cash})
		if {_fit} >= {_n}:
			return crateLineText({_line})
		if {_fit} > 0:
			set {_tmax} to {-cfg::tool::%{_tool}%::max}
			return "&f%{_fit}% %{_name}% &7+ &a%formatMoney({_cash})% &7(you carry %{_tmax}% at most)"
		return "&a%formatMoney({_cash})% &7(%{_name}%: %{_why}%, cash instead)"
	if {_k} is "cos":
		# A set gives every part the player doesn't have; only a set they own completely pays the dupe.
		loop crateCosIds({_line}):
			set {_id} to loop-value
			if cosGive({_p}, {_id}, "crate:%{_t}%") is true:
				set {_type} to {-cfg::cos::%{_id}%::type}
				set {_tn} to cosTypeName({_type})
				add "%cosColored({_id})% &7%{_tn}%" to {_new::*}
		if size of {_new::*} > 0:
			return join {_new::*} with " &7+ "
		set {_rar} to crateLineRarity({_line}, {_t})
		set {_dupe} to {-cfg::rarity::%{_rar}%::dupe}
		if {_dupe} is not set:
			set {_dupe} to 0
		giveMoney({_p}, {_dupe})
		return "%crateCosText({_line})% &7(you have it: &a%formatMoney({_dupe})% &7instead)"
	if {_k} is "car":
		# garage.sk makes the car (in the player's garage); one they have already pays the dupe value.
		set {_got} to garageGrantCar({_p}, {_a::3}, "crate:%{_t}%")
		if {_got} is not "":
			return {_got}
		set {_dupe} to {-cfg::rarity::%{_t}%::dupe}
		giveMoney({_p}, {_dupe})
		return "&6%{_a::4}% &7car (you have it: &a%formatMoney({_dupe})% &7instead)"
	send "[Donating] crates: unknown reward %{_line}% in %{_t}%" to console
	return "&cnothing (unknown reward, tell staff)"

# ---------- Opening (at crate stands only) ----------

# "" when the player may open crate t at their stand now, else why not. The stand must still exist and
# still be that crate (staff may remove or change it while a menu is open).
function crateBlockReason(p: player, t: text) :: text:
	if {_p} is not alive:
		return "You can't open crates right now."
	if {-crate::spinning::%{_p}%} is set:
		return "One crate at a time."
	if {cratepending::%uuid of {_p}%::line} is set:
		return "One crate at a time."
	set {_stand} to {-crate::stand::%{_p}%}
	if {_stand} is not set:
		return "Crates open at crate stands."
	if world of {_stand} is not world of {_p}:
		return "Crates open at crate stands."
	if distance between {_stand} and location of {_p} > cfg("crate::stand-reach"):
		return "Stand next to the crate to open it."
	set {_key} to {-crate::standkey::%{_p}%}
	if {_key} is not set:
		return "Crates open at crate stands."
	if {crateblock::%{_key}%} is not {_t}:
		return "That crate stand is gone."
	if heistOf({_p}) is not "":
		return "Open crates outside heists."
	if isCombatTagged({_p}) is true:
		return "You can't open crates while in combat."
	if isSafeZone(location of {_p}) is false:
		return "Crates open only in safe zones."
	return ""

# Takes a key and rolls in one call (no wait), saves the roll as the pending reward, logs it, then
# spins the strip. The reward is given when the spin ends (crateFinish).
function crateOpen(p: player, t: text):
	set {_why} to crateBlockReason({_p}, {_t})
	if {_why} is not "":
		msg({_p}, "&c%{_why}%")
		play sound "entity.villager.no" with volume 0.6 to {_p}
		stop
	if crateKeys({_p}, {_t}) < 1:
		if {-cfg::crate::%{_t}%::sold} is true:
			msg({_p}, "&cYou have no %crateColored({_t})% &ckeys. &7Get some: &f/store")
		else if {_t} is "daily":
			msg({_p}, "&cYou have no %crateColored({_t})% &ckeys. &7Claim one every day: &f/daily")
		else:
			msg({_p}, "&cYou have no %crateColored({_t})% &ckeys.")
		play sound "entity.villager.no" with volume 0.6 to {_p}
		stop
	set {_line} to crateRoll({_t})
	if {_line} is "":
		msg({_p}, "&cThat crate is empty right now. &7Your key is safe.")
		stop
	set {data::%{_p}%::keys::%{_t}%} to crateKeys({_p}, {_t}) - 1
	set {_u} to uuid of {_p}
	set {cratepending::%{_u}%::crate} to {_t}
	set {cratepending::%{_u}%::line} to {_line}
	crateLog("open %{_p}% %{_u}% %{_t}% keys-left=%crateKeys({_p}, {_t})% line=%{_line}%")
	crateSpin({_p}, {_t}, {_line})

# Gives the pending reward (if any): at the end of the spin, when the spin menu closes, at the next join
# after a logout or crash, at the respawn after a death. Deleted before it's given, so it's given once.
function crateFinish(p: player):
	set {_u} to uuid of {_p}
	set {_line} to {cratepending::%{_u}%::line}
	if {_line} is not set:
		stop
	if {_p} is not online:
		stop
	if {_p} is not alive:
		stop
	set {_t} to {cratepending::%{_u}%::crate}
	delete {cratepending::%{_u}%::*}
	set {_got} to crateGrant({_p}, {_line}, {_t})
	crateLog("grant %{_p}% %{_u}% %{_t}% line=%{_line}% got=%{_got}%")
	msg({_p}, "%crateColored({_t})%&7: you got %{_got}%&7!")
	set {_r} to crateLineRarity({_line}, {_t})
	if {_r} is "epic":
		play sound "ui.toast.challenge_complete" with volume 0.7 to {_p}
	else if {_r} is "legendary":
		play sound "ui.toast.challenge_complete" with volume 1 to {_p}
	else if {_r} is "hacked":
		play sound "ui.toast.challenge_complete" with volume 1 to {_p}
	else:
		play sound "entity.player.levelup" with volume 0.6 to {_p}
	# Big pulls are the one crate message everyone sees (owner, 2026-09-26: only Legendary and Hacked).
	set {_a::*} to {_line} split at "|"
	set {_big} to false
	if {_a::2} is "cos":
		set {_big} to true
	else if {_a::2} is "car":
		set {_big} to true
	if {_big} is true:
		if {-cfg::crate::announce::*} contains {_r}:
			broadcastMsg("&f%name of {_p}% &7unboxed %crateLineText({_line})% &7from a %crateColored({_t})%&7!")

# The strip: steps of random rewards sliding left, slowing down, ending with the reward in the middle
# (slot 13). The reward is given when it stops, or at once if the menu is closed first.
function crateSpin(p: player, t: text, line: text):
	set {_steps} to cfg("crate::spin-steps")
	loop {_steps} + 9 times:
		add crateLineIcon(crateRoll({_t})) to {_strip::*}
	set {_win} to crateLineIcon({_line})
	set {_strip::%{_steps} + 5%} to {_win}
	set {_gui} to chest inventory with 3 rows named "&8%crateName({_t})%"
	set {_pane} to gray stained glass pane named "&r"
	set {_mark} to lime stained glass pane named "&r"
	loop 27 times:
		set slot (loop-number - 1) of {_gui} to {_pane}
	set slot 4 of {_gui} to {_mark}
	set slot 22 of {_gui} to {_mark}
	crateClearGui({_p})
	set {-crate::spinning::%{_p}%} to true
	set {-crate::gui::%{_p}%} to {_gui}
	set {-crate::view::%{_p}%} to "spin"
	open {_gui} to {_p}
	set {_stopped} to false
	loop {_steps} + 1 times:
		set {_k} to loop-number - 1
		if {_stopped} is false:
			if {_p} is not online:
				set {_stopped} to true
			else if {_p}'s current inventory is not {_gui}:
				set {_stopped} to true
			else:
				loop 9 times:
					set slot (8 + loop-number-2) of {_gui} to {_strip::%{_k} + loop-number-2%}
				set {_pitch} to 1 + {_k} / {_steps}
				play sound "block.note_block.hat" with volume 0.4 and pitch {_pitch} to {_p}
				set {_wait} to 1
				if {_k} >= 12:
					set {_wait} to 2
				if {_k} >= 20:
					set {_wait} to 3
				if {_k} >= 25:
					set {_wait} to 5
				if {_k} >= 28:
					set {_wait} to 8
				if {_k} < {_steps}:
					wait 1 tick * {_wait}
	delete {-crate::spinning::%{_p}%}
	{_p} is online
	if {_p}'s current inventory is {_gui}:
		set slot 13 of {_gui} to glint({_win})
		set {_done} to lime stained glass pane named "&r"
		loop 27 times:
			if loop-number is not 14:
				set slot (loop-number - 1) of {_gui} to {_done}
	crateFinish({_p})
	# Back to this crate after a moment, if the result is still showing.
	wait 30 ticks
	{_p} is online
	{_p}'s current inventory is {_gui}
	cratePreview({_p}, {_t}, true)

# ---------- Menus ----------

function crateClearGui(p: player):
	delete {-crate::gui::%{_p}%}
	delete {-crate::view::%{_p}%}
	delete {-crate::act::%{_p}%::*}
	delete {-crate::hackslot::%{_p}%}
	delete {-crate::hackitem::%{_p}%}
	delete {-crate::hackview::%uuid of {_p}%}

function crateButton(p: player, gui: inventory, slot: number, i: item, act: text):
	set slot {_slot} of {_gui} to {_i}
	set {-crate::act::%{_p}%::%{_slot}%} to {_act}

# The Hacked crate's button redraws its name every 2 ticks while this menu is open.
function crateHackButton(p: player, slot: number, i: item):
	set {-crate::hackslot::%{_p}%} to {_slot}
	set {-crate::hackitem::%{_p}%} to {_i}
	set {-crate::hackview::%uuid of {_p}%} to {_p}

# "ready" or "in 5h 12m".
function dailyText(p: player) :: text:
	set {_left} to dailyLeft({_p})
	if {_left} <= 0:
		return "ready"
	set {_h} to floor({_left} / 3600)
	set {_m} to floor(mod({_left}, 3600) / 60)
	return "in %{_h}%h %{_m}%m"

# Where keys come from, as lore lines.
function crateKeySource(t: text) :: texts:
	if {-cfg::crate::%{_t}%::sold} is true:
		add "&7Buy keys: &f/store" to {_l::*}
	else if {_t} is "daily":
		add "&7A free key every day: &f/daily" to {_l::*}
	else:
		add "&7Keys only at special events." to {_l::*}
	return {_l::*}

# /crates (and the phone's Crates app): your keys, what's inside each crate, where to buy keys.
# Nothing opens here (owner, 2026-09-26): crates open at crate stands.
function crateMenu(p: player):
	set {_gui} to chest inventory with 3 rows named "&8Crates"
	set {_pane} to gray stained glass pane named "&r"
	loop 27 times:
		set slot (loop-number - 1) of {_gui} to {_pane}
	crateClearGui({_p})
	set {-crate::gui::%{_p}%} to {_gui}
	set {-crate::view::%{_p}%} to "menu"
	set {_slot} to 10
	loop {-cfg::crates::*}:
		set {_t} to loop-value
		set {_n} to crateKeys({_p}, {_t})
		set {_i} to 1 of {-cfg::crate::%{_t}%::icon}
		delete {_l::*}
		add "&7Your keys: &f%{_n}%" to {_l::*}
		add crateKeySource({_t}) to {_l::*}
		add "&7Open it at a crate stand." to {_l::*}
		add "" to {_l::*}
		add "&eClick: see what's inside" to {_l::*}
		set lore of {_i} to {_l::*}
		if {_n} > 0:
			set {_i} to glint({_i})
		set name of {_i} to colored crateLiveName({_t})
		crateButton({_p}, {_gui}, {_slot}, {_i}, "crate:%{_t}%")
		if {_t} is "hacked":
			crateHackButton({_p}, {_slot}, {_i})
		add 1 to {_slot}
	set {_d} to clock named "&eDaily reward: &f%dailyText({_p})%" with lore "&7A Daily key every day, plus your" and "&7rank's keys (VIP+, Elite, Legend)." and "&eClick to claim."
	crateButton({_p}, {_gui}, 22, {_d}, "daily")
	crateButton({_p}, {_gui}, 18, emerald named "&aBuy keys" with lore "&7Keys for Common to Legendary" and "&7crates are in the store." and "&eClick for the link.", "store")
	crateButton({_p}, {_gui}, 26, barrier named "&cClose", "close")
	open {_gui} to {_p}

# What's inside a crate: every reward with its chance. At a crate stand (stand = true) it has the
# Open button; from /crates it says where to open it.
function cratePreview(p: player, t: text, stand: boolean):
	set {_gui} to chest inventory with 6 rows named "&8%crateName({_t})%: what's inside"
	crateClearGui({_p})
	set {-crate::gui::%{_p}%} to {_gui}
	set {-crate::view::%{_p}%} to "preview"
	set {_total} to crateTotal({_t})
	set {_slot} to 0
	loop crateLines({_t}):
		{_slot} < 45
		set {_i} to crateLineIcon(loop-value)
		set {_pct} to round(1000 * crateWeight(loop-value) / {_total}) / 10
		delete {_l::*}
		add "&7Chance: &f%{_pct}%%%" to {_l::*}
		set {_a::*} to loop-value split at "|"
		if {_a::2} is "cos":
			set {_all} to true
			loop crateCosIds(loop-value-1):
				if cosOwned({_p}, loop-value-2) is false:
					set {_all} to false
			if {_all} is true:
				set {_rar} to crateLineRarity(loop-value, {_t})
				set {_dupe} to {-cfg::rarity::%{_rar}%::dupe}
				add "&aYou have it &7(a repeat pays %formatMoney({_dupe})%&7)" to {_l::*}
		set lore of {_i} to {_l::*}
		set slot {_slot} of {_gui} to {_i}
		add 1 to {_slot}
	# Cars show before they exist, with the chance they'll have (of every line, cars included).
	set {_full} to 0
	loop {-cfg::crate::%{_t}%::rewards::*}:
		set {_a::*} to loop-value split at "|"
		if crateLineLive(loop-value) is true:
			add crateWeight(loop-value) to {_full}
		else if {_a::2} is "car":
			add crateWeight(loop-value) to {_full}
	loop {-cfg::crate::%{_t}%::rewards::*}:
		set {_a::*} to loop-value split at "|"
		if {_a::2} is "car":
			if crateLineLive(loop-value) is false:
				if {_slot} < 45:
					set {_pct} to round(1000 * crateWeight(loop-value) / {_full}) / 10
					set {_i} to crateLineIcon(loop-value)
					set lore of {_i} to "&7Coming with cars: &f%{_pct}%%% &7chance then."
					set slot {_slot} of {_gui} to {_i}
					add 1 to {_slot}
	set {_pane} to gray stained glass pane named "&r"
	loop integers from 45 to 53:
		set slot loop-value of {_gui} to {_pane}
	crateButton({_p}, {_gui}, 45, arrow named "&fAll crates", "menu")
	set {_n} to crateKeys({_p}, {_t})
	delete {_l::*}
	add crateKeySource({_t}) to {_l::*}
	if {_stand} is true:
		if {_n} > 0:
			crateButton({_p}, {_gui}, 49, glint(tripwire hook named "&aOpen one &7(keys: %{_n}%)"), "open:%{_t}%")
		else:
			crateButton({_p}, {_gui}, 49, tripwire hook named "&7No keys" with lore {_l::*}, "none")
	else:
		add "&7Open it at a crate stand." to {_l::*}
		crateButton({_p}, {_gui}, 49, tripwire hook named "&7Your keys: &f%{_n}%" with lore {_l::*}, "none")
	if {-cfg::crate::%{_t}%::sold} is true:
		crateButton({_p}, {_gui}, 51, emerald named "&aBuy keys" with lore "&eClick for the store link.", "store")
	crateButton({_p}, {_gui}, 53, barrier named "&cClose", "close")
	open {_gui} to {_p}

on inventory click:
	{-crate::gui::%player%} is set
	player's current inventory is {-crate::gui::%player%}
	cancel event
	event-inventory is {-crate::gui::%player%}
	set {_slot} to index of event-slot
	set {_act} to {-crate::act::%player%::%{_slot}%}
	{_act} is set
	set {_ok} to false
	if click type is left mouse button:
		set {_ok} to true
	else if click type is right mouse button:
		set {_ok} to true
	{_ok} is true
	# One action per drawn screen (a second click from the same tick finds it used), a tick later.
	if {-crate::gen::%player%} is not set:
		set {-crate::gen::%player%} to 0
	set {_gen} to {-crate::gen::%player%}
	wait 1 tick
	player is online
	{-crate::gui::%player%} is set
	{-crate::gen::%player%} is {_gen}
	add 1 to {-crate::gen::%player%}
	crateAction(player, {_act})

function crateAction(p: player, act: text):
	if {_act} starts with "crate:":
		cratePreview({_p}, subtext of {_act} from characters 7 to (length of {_act}), false)
	else if {_act} starts with "open:":
		crateOpen({_p}, subtext of {_act} from characters 6 to (length of {_act}))
	else if {_act} is "menu":
		crateMenu({_p})
	else if {_act} is "daily":
		close {_p}'s inventory
		dailyClaim({_p})
	else if {_act} is "store":
		close {_p}'s inventory
		msg({_p}, "&6%storeText()% &7Crate keys for Common to Legendary crates. Open them at a crate stand.")
	else if {_act} is "close":
		close {_p}'s inventory

on inventory drag:
	{-crate::gui::%player%} is set
	player's current inventory is {-crate::gui::%player%}
	cancel event

# Closing the spin ends it early: the reward is given at once.
on inventory close:
	{-crate::gui::%player%} is set
	event-inventory is {-crate::gui::%player%}
	set {_spin} to false
	if {-crate::view::%player%} is "spin":
		set {_spin} to true
	crateClearGui(player)
	{_spin} is true
	crateFinish(player)

on quit:
	crateClearGui(player)
	delete {-crate::spinning::%player%}
	delete {-crate::stand::%player%}
	delete {-crate::standkey::%player%}

# A reward left pending by a logout or a crash mid-spin. Not while a new spin runs: that one gives its
# own reward when it ends.
on join:
	wait 2 seconds
	player is online
	{cratepending::%uuid of player%::line} is set
	{-crate::spinning::%player%} is not set
	crateFinish(player)

# ...or by a death mid-spin (death.sk clears the loadout at the death, so it's given after).
on respawn:
	wait 1 second
	player is online
	{cratepending::%uuid of player%::line} is set
	{-crate::spinning::%player%} is not set
	crateFinish(player)

command /crates:
	description: Crates: your keys, what's inside, where to buy keys.
	aliases: /crate
	executable by: players
	trigger:
		crateMenu(player)

# ---------- /daily ----------

# Seconds until the next /daily (0 = ready). Saved as a unix time, so it counts through restarts.
function dailyLeft(p: player) :: number:
	set {_last} to getData({_p}, "daily-at")
	if {_last} is not set:
		return 0
	return max(0, {_last} + cfg("daily::hours") * 3600 - unix timestamp of now)

function dailyClaim(p: player):
	if dailyLeft({_p}) > 0:
		msg({_p}, "&7Your next daily reward is &f%dailyText({_p})%&7.")
		stop
	setData({_p}, "daily-at", unix timestamp of now)
	crateAddKeys({_p}, "daily", 1, "daily")
	set {_d} to crateColored("daily")
	add "%{_d}% key" to {_got::*}
	set {_r} to paidRank({_p})
	if {_r} is not "":
		loop {-cfg::paidrank::%{_r}%::daily-keys::*}:
			crateAddKeys({_p}, loop-value, 1, "daily:%{_r}%")
			add "%crateColored(loop-value)% key" to {_got::*}
	set {_list} to join {_got::*} with "&7, "
	msg({_p}, "&aDaily reward: %{_list}%&a. &7Open them at a crate stand.")
	play sound "entity.player.levelup" with volume 0.6 to {_p}

command /daily:
	description: Your daily crate key.
	executable by: players
	trigger:
		dailyClaim(player)

on join:
	wait 4 seconds
	player is online
	dailyLeft(player) <= 0
	msg(player, "&eYour daily reward is ready: &f/daily")

# ---------- Crate stands (a block that opens a crate) ----------

# A block's x-coordinate is its center (x + 0.5): floor it.
function crateBlockKey(b: block) :: text:
	return "%world of {_b}%:%floor(x-coordinate of {_b})%:%floor(y-coordinate of {_b})%:%floor(z-coordinate of {_b})%"

# Lowest: cancelled before the phone (phone.sk) and a held gun (WeaponMechanics, NORMAL) see the click.
on right click with priority lowest:
	event-block is set
	set {_t} to {crateblock::%crateBlockKey(event-block)%}
	{_t} is set
	cancel event
	crateStandClick(player, {_t}, event-block)

on left click with priority lowest:
	event-block is set
	set {_t} to {crateblock::%crateBlockKey(event-block)%}
	{_t} is set
	cancel event
	crateStandClick(player, {_t}, event-block)

# Both hands fire a click: one menu per 5 ticks. Remembers the stand for the Open button.
function crateStandClick(p: player, t: text, b: block):
	if {-crate::standat::%{_p}%} is set:
		if difference between {-crate::standat::%{_p}%} and now < 0.25 seconds:
			stop
	set {-crate::standat::%{_p}%} to now
	crateExists({_t}) is true
	set {-crate::stand::%{_p}%} to location of {_b}
	set {-crate::standkey::%{_p}%} to crateBlockKey({_b})
	cratePreview({_p}, {_t}, true)

# ---------- Staff and store: /dcrate ----------

function dcrateReply(s: command sender, text: text):
	send "%{_text}%" to {_s}

command /dcrate [<text>]:
	permission: donating.store
	permission message: &cOnly the owner and the store can do that.
	trigger:
		set {_a::*} to arg-1 split at " "
		set {_sub} to {_a::1}
		if {_sub} is "give":
			dcrateKeys(sender, {_a::*}, 1)
			stop
		if {_sub} is "take":
			dcrateKeys(sender, {_a::*}, -1)
			stop
		if {_sub} is "info":
			set {_p} to {_a::2} parsed as offline player
			if {_p} is not set:
				dcrateReply(sender, "CRATE info: /dcrate info <player>")
				stop
			loop {-cfg::crates::*}:
				add "%loop-value%=%crateKeys({_p}, loop-value)%" to {_k::*}
			set {_keys} to join {_k::*} with " "
			set {_pend} to {cratepending::%uuid of {_p}%::line}
			if {_pend} is not set:
				set {_pend} to "none"
			dcrateReply(sender, "CRATE %{_a::2}% keys %{_keys}% pending=%{_pend}%")
			stop
		if {_sub} is "place":
			if sender is not a player:
				dcrateReply(sender, "CRATE place: in game only (look at the block)")
				stop
			set {_t} to {_a::2}
			if crateExists({_t}) is false:
				set {_all} to join {-cfg::crates::*} with "|"
				dcrateReply(sender, "CRATE place: /dcrate place <%{_all}%>")
				stop
			set {_b} to targeted block of player
			if {_b} is not set:
				dcrateReply(sender, "CRATE place: look at a block")
				stop
			set {_key} to crateBlockKey({_b})
			if {crateblock::%{_key}%} is set:
				dcrateReply(sender, "CRATE place: that block is already a %{crateblock::%{_key}%}% crate (/dcrate remove first)")
				stop
			add 1 to {crateblocks::next}
			set {_holo} to "crate_%{crateblocks::next}%"
			set {crateblock::%{_key}%} to {_t}
			set {crateholo::%{_key}%} to {_holo}
			set {_x} to floor(x-coordinate of {_b}) + 0.5
			set {_y} to floor(y-coordinate of {_b}) + 1.9
			set {_z} to floor(z-coordinate of {_b}) + 0.5
			if {_t} is "hacked":
				# The animated name: a placeholder the hologram asks for every 2 ticks.
				execute console command "dh hologram create %{_holo}% -l:%world of {_b}%:%{_x}%:%{_y}%:%{_z}% %%donating_hacked_crate%%"
				execute console command "dh hologram setupdateinterval %{_holo}% 2"
			else:
				execute console command "dh hologram create %{_holo}% -l:%world of {_b}%:%{_x}%:%{_y}%:%{_z}% %crateColored({_t})%"
			execute console command "dh line add %{_holo}% 1 &7Your keys: &f%%donating_keys_%{_t}%%%"
			execute console command "dh line add %{_holo}% 1 &eClick to open"
			crateLog("place %{_t}% %{_key}% holo=%{_holo}% by=%sender%")
			dcrateReply(sender, "CRATE placed %{_t}% at %{_key}% (hologram %{_holo}%)")
			# Crates open only in safe zones (owner, 2026-09-26).
			if isSafeZone(location of {_b}) is false:
				set {_sp} to cfg("pvp::safe-prefix")
				dcrateReply(sender, "CRATE warning: that block isn't in a safe zone, so nobody can open this crate there. Put crate stands inside a safe zone (a region whose id starts with %{_sp}%).")
			stop
		if {_sub} is "remove":
			if sender is not a player:
				dcrateReply(sender, "CRATE remove: in game only (look at the block)")
				stop
			set {_b} to targeted block of player
			if {_b} is not set:
				dcrateReply(sender, "CRATE remove: look at the crate's block")
				stop
			set {_key} to crateBlockKey({_b})
			if {crateblock::%{_key}%} is not set:
				dcrateReply(sender, "CRATE remove: that block isn't a crate")
				stop
			execute console command "dh hologram delete %{crateholo::%{_key}%}%"
			crateLog("remove %{crateblock::%{_key}%}% %{_key}% by=%sender%")
			delete {crateblock::%{_key}%}
			delete {crateholo::%{_key}%}
			dcrateReply(sender, "CRATE removed %{_key}%")
			stop
		if {_sub} is "list":
			loop {crateblock::*}:
				dcrateReply(sender, "CRATE %loop-value% at %loop-index% (hologram %{crateholo::%loop-index%}%)")
			dcrateReply(sender, "CRATE end")
			stop
		dcrateReply(sender, "CRATE usage: /dcrate give|take <player> <crate> [count] | info <player> | place <crate> | remove | list")

# give (sign 1) or take back (sign -1) keys. A store delivery can't be retried by hand easily, so
# every request and refusal is logged.
function dcrateKeys(s: command sender, a: texts, sign: number):
	set {_sub} to "give"
	if {_sign} < 0:
		set {_sub} to "take"
	set {_line} to join {_a::*} with " "
	set {_p} to {_a::2} parsed as offline player
	set {_t} to {_a::3}
	set {_n} to 1
	if {_a::4} is set:
		set {_n} to {_a::4} parsed as integer
	if {_p} is not set:
		crateLog("refused %{_line}% by=%{_s}% (no player)")
		dcrateReply({_s}, "CRATE %{_sub}%: /dcrate %{_sub}% <player> <crate> [count]")
		stop
	if {_t} is not set:
		crateLog("refused %{_line}% by=%{_s}% (no crate)")
		dcrateReply({_s}, "CRATE %{_sub}%: /dcrate %{_sub}% <player> <crate> [count]")
		stop
	if crateExists({_t}) is false:
		crateLog("refused %{_line}% by=%{_s}% (no crate %{_t}%)")
		set {_all} to join {-cfg::crates::*} with ", "
		dcrateReply({_s}, "CRATE %{_sub}%: no crate %{_t}% (%{_all}%)")
		stop
	if {_n} is not set:
		crateLog("refused %{_line}% by=%{_s}% (bad count)")
		dcrateReply({_s}, "CRATE %{_sub}%: the count must be a whole number from 1 to 10000")
		stop
	if {_n} < 1:
		crateLog("refused %{_line}% by=%{_s}% (bad count)")
		dcrateReply({_s}, "CRATE %{_sub}%: the count must be a whole number from 1 to 10000")
		stop
	if {_n} > 10000:
		crateLog("refused %{_line}% by=%{_s}% (bad count)")
		dcrateReply({_s}, "CRATE %{_sub}%: the count must be a whole number from 1 to 10000")
		stop
	if {_sign} > 0:
		crateAddKeys({_p}, {_t}, {_n}, "dcrate by=%{_s}%")
		dcrateReply({_s}, "CRATE %{_a::2}% +%{_n}% %{_t}% (now %crateKeys({_p}, {_t})%)")
		loop all players:
			if uuid of loop-player is uuid of {_p}:
				msg(loop-player, "&aYou got %{_n}% %crateColored({_t})% &akey(s)! &7Open them at a crate stand.")
				play sound "entity.player.levelup" with volume 0.6 to loop-player
		stop
	# Take back only unused keys; what's already opened can't be.
	set {_have} to crateKeys({_p}, {_t})
	set {_take} to min({_have}, {_n})
	set {data::%{_p}%::keys::%{_t}%} to {_have} - {_take}
	crateLog("keys- %{_p}% %uuid of {_p}% %{_t}% -%{_take}% asked=%{_n}% now=%crateKeys({_p}, {_t})% by=%{_s}%")
	dcrateReply({_s}, "CRATE %{_a::2}% -%{_take}% %{_t}% (asked %{_n}%; %{_n} - {_take}% already opened; now %crateKeys({_p}, {_t})%)")
