# zz-testkit.sk: LOCAL TEST HELPERS ONLY. Never upload to Minehut.
# Console commands the bot scenarios use to set up a known inventory.

# A known layout: test sword in hotbar 1, test ammo in the first upper slot, a tier-2 bag.
command /zztestkit <player>:
	executable by: console
	trigger:
		set {_p} to arg-1
		clear {_p}'s inventory
		setData({_p}, "bag-tier", 2)
		applyLayout({_p})
		applyMapVisibility({_p})
		set slot 0 of {_p}'s inventory to tagItem(iron sword named "&fTest Sword", "test:sword")
		set slot 9 of {_p}'s inventory to tagItem(32 gold nuggets named "&eTest Ammo", "test:ammo")
		set slot 10 of {_p}'s inventory to tagItem(32 gold nuggets named "&eTest Ammo", "test:ammo")
		# A block item in the upper inventory: middle-click on a stone block would pull it into the hotbar.
		set slot 20 of {_p}'s inventory to stone
		send "testkit ready for %{_p}%" to console

# One line with every non-empty slot: "slot=material xcount [id]" (slot 40 = offhand, 36-39 = armor).
command /zzdump <player>:
	executable by: console
	trigger:
		set {_p} to arg-1
		set {_out} to ""
		loop integers from 0 to 40:
			set {_i} to slot loop-value of {_p}'s inventory
			if {_i} is not air:
				set {_out} to "%{_out}%%loop-value%=%type of {_i}% x%item amount of {_i}% [%itemId({_i})%] | "
		set {_c} to cursor slot of {_p}
		send "DUMP %{_out}%cursor=%{_c}%"

# LuckPerms answers asynchronously, so its own replies never come back over RCON.
command /zzperm <player> <text>:
	executable by: console
	trigger:
		send "PERM %arg-2% for %arg-1%: %whether arg-1 has permission arg-2%"

command /zzclear <player>:
	executable by: console
	trigger:
		clear arg-1's inventory
		deleteData(arg-1, "bag-tier")
		applyLayout(arg-1)
		applyMapVisibility(arg-1)

# Forgets a player's saved data and balance, so their next join counts as a first join.
command /zzforget <offline player>:
	executable by: console
	trigger:
		delete {data::%arg-1%::*}
		set balance of arg-1 to 0
		send "FORGET %arg-1%"

# Balance as a plain number (EssentialsX's own /balance formats it).
command /zzbal <offline player>:
	executable by: console
	trigger:
		send "BAL %arg-1%: %floor(balance of arg-1)%"

# One setting from core.sk, e.g. /zzcfg money::start
command /zzcfg <text>:
	executable by: console
	trigger:
		send "CFG %arg-1% = %cfg(arg-1)%"

# Changes a number setting until the next loadSettings() (tests put the old value back).
command /zzcfgset <text> <number>:
	executable by: console
	trigger:
		set {-cfg::%arg-1%} to arg-2
		send "CFGSET %arg-1% = %arg-2%"

# afk.sk: pretend the player's last activity was 10 minutes ago (AFK within 10 seconds).
command /zzafk <player>:
	executable by: console
	trigger:
		set {-afk::last::%arg-1%} to 10 minutes ago
		send "AFKSET %arg-1%"

command /zzafkstate <player>:
	executable by: console
	trigger:
		send "AFK %arg-1%: %isAfk(arg-1)%"

# Player data: /zzdata <player> <key> shows it, "... <key> <number>" sets it, "... <key> none" deletes it.
command /zzdata <offline player> <text> [<text>]:
	executable by: console
	trigger:
		if arg-3 is "none":
			deleteData(arg-1, arg-2)
		else if arg-3 is set:
			setData(arg-1, arg-2, arg-3 parsed as number)
		send "DATA %arg-1% %arg-2% = %getData(arg-1, arg-2)%"

# nav.sk: turn passive mode on or off directly (the phone button goes through pvp.sk's rules).
command /zzpassive <player> <text>:
	executable by: console
	trigger:
		if arg-2 is "on":
			setPassive(arg-1, true)
		else:
			setPassive(arg-1, false)
		send "PASSIVE %arg-1%: %isPassive(arg-1)%"

# Phone: the player's phone map id (DonatingPhone metadata), the map id on the slot-8 phone, and
# whether the big map is open.
command /zzphone <player>:
	executable by: console
	trigger:
		set {_meta} to metadata value "donating_phone_map" of arg-1
		set {_slot} to int tag "minecraft:map_id" of nbt of slot 8 of arg-1's inventory
		set {_open} to false
		if arg-1 has scoreboard tag "donating_phone_open":
			set {_open} to true
		send "ZZPHONE %arg-1% meta=%{_meta}% slot8=%{_slot}% open=%{_open}% offhand=%type of offhand tool of arg-1%"

# Navigation: hide or show entities with a scoreboard tag for one player (per-player waypoints).
command /zzhide <player> <text>:
	executable by: console
	trigger:
		set {_n} to 0
		loop all entities:
			if loop-entity has scoreboard tag arg-2:
				hide loop-entity from arg-1
				add 1 to {_n}
		send "HIDDEN %{_n}% from %arg-1%"

command /zzshow <player> <text>:
	executable by: console
	trigger:
		set {_n} to 0
		loop all entities:
			if loop-entity has scoreboard tag arg-2:
				reveal loop-entity to arg-1
				add 1 to {_n}
		send "SHOWN %{_n}% to %arg-1%"

# chat-extras.sk: send the next rotating tip now.
command /zztip:
	executable by: console
	trigger:
		sendTip()
		send "TIP SENT"

# combat-log.sk: the player's combat state, and ending a tag now (the loop tells them within a second).
command /zzcombat <player>:
	executable by: console
	trigger:
		set {_cause} to deathCause(arg-1)
		send "COMBAT %arg-1% tagged=%isCombatTagged(arg-1)% wanted=%isWanted(arg-1)% cause=%{_cause}%"

command /zzcombatend <player>:
	executable by: console
	trigger:
		set {-combat::at::%arg-1%} to 1 hour ago
		delete {-combat::playerat::%arg-1%}
		send "COMBATEND %arg-1%"

# pvp.sk: a cuboid WorldGuard region in the main world (safe zones are regions named safe...), and
# the spawn shield state. Remove a region with: rg remove -w world <id>
command /zzregion <text> <number> <number> <number> <number> <number> <number>:
	executable by: console
	trigger:
		set {_w} to world "world"
		create a cuboid region named arg-1 in {_w} between location(arg-2, arg-3, arg-4, {_w}) and location(arg-5, arg-6, arg-7, {_w})
		send "REGION %arg-1% made"

command /zzshield <player>:
	executable by: console
	trigger:
		send "SHIELD %arg-1% %hasSpawnShield(arg-1)% safe=%isSafeZone(location of arg-1)%"

# Ends the spawn shield now (tests that aren't about it).
command /zzshieldoff <player>:
	executable by: console
	trigger:
		delete {-pvp::shield::%arg-1%}
		send "SHIELDOFF %arg-1%"

# shop.sk: WeaponMechanics items and ammo in the inventory: "WM <slot>=<title>:<loaded>x<amount> | ...
# ammo <type>=<rounds> ...".
command /zzwm <player>:
	executable by: console
	trigger:
		set {_out} to ""
		loop integers from 0 to 40:
			set {_i} to slot loop-value of arg-1's inventory
			set {_w} to wmTitle({_i})
			if {_w} is not "":
				set {_out} to "%{_out}%%loop-value%=%{_w}%:%wmLoaded({_i})%x%item amount of {_i}% | "
		loop {-cfg::shop::ammo::*}:
			set {_out} to "%{_out}%ammo %loop-value%=%ammoCount(arg-1, loop-value)% "
		send "WM %{_out}%"

command /zzammo <player> <text> <number>:
	executable by: console
	trigger:
		send "AMMO added %addAmmo(arg-1, arg-2, arg-3)%"

# Forgets shop data: unlocks, saved loadout, bags; closes the shop.
command /zzshopreset <player>:
	executable by: console
	trigger:
		loop {-cfg::shop::weapons::*}:
			deleteData(arg-1, "wpn::%loop-value%")
		loop integers from 1 to 5:
			deleteData(arg-1, "loadout::%loop-value%")
			deleteData(arg-1, "loadout::%loop-value%::count")
		deleteData(arg-1, "loadout::saved")
		deleteData(arg-1, "bag-tier")
		deleteData(arg-1, "bag-best")
		close arg-1's inventory
		clearShopState(arg-1)
		send "SHOPRESET %arg-1%"

# Fills slots <from>..<to> with stone (full-inventory tests).
command /zzfill <player> <number> <number>:
	executable by: console
	trigger:
		loop integers from arg-2 to arg-3:
			set slot loop-value of arg-1's inventory to stone
		send "FILLED %arg-1%"

command /zzshop <player>:
	executable by: console
	trigger:
		set {_s} to {-shop::status::%arg-1%}
		set {_c} to {-shop::confirm::%arg-1%}
		send "SHOP open=%{-shop::kind::%arg-1%}% tab=%{-shop::tab::%arg-1%}% gen=%{-shop::gen::%arg-1%}% confirm=%{_c}% status=%{_s}%"

command /zztag <player>:
	executable by: console
	trigger:
		tagCombat(arg-1, "trap")
		send "TAGGED %arg-1%"

# bounty.sk: a player's bounty, adding to it (like bag.sk's robbery sales), and the same-IP check
# (every local bot shares 127.0.0.1).
command /zzbounty <offline player> [<number>] [<text>]:
	executable by: console
	trigger:
		if arg-2 is set:
			set {_added} to addBounty(arg-1, arg-2, arg-3 ? "robbery")
			send "BOUNTYADD %arg-1% %{_added}%"
		set {_k} to getData(arg-1, "bounty-kills")
		send "BOUNTY %arg-1% %getBounty(arg-1)% kills=%{_k}%"

command /zzbountyreset <offline player>:
	executable by: console
	trigger:
		clearBounty(arg-1)
		delete {data::%arg-1%::bounty-last::*}
		deleteData(arg-1, "bounty-payout")
		send "BOUNTYRESET %arg-1%"

command /zzbountyip <text>:
	executable by: console
	trigger:
		if arg-1 is "off":
			set {-cfg::bounty::ip-check} to false
		else:
			set {-cfg::bounty::ip-check} to true
		send "BOUNTYIP %{-cfg::bounty::ip-check}%"

# ---------- heists.sk ----------

command /zzheist <text>:
	executable by: console
	trigger:
		set {_h} to arg-1
		if heistExists({_h}) is false:
			send "HEIST %{_h}% unknown"
			stop
		set {_names::*} to heistRobbers({_h})
		set {_names} to join {_names::*} with ","
		set {_reset} to {-heist::%{_h}%::reset-next}
		if {_reset} is not set:
			set {_reset} to "none"
		set {_hunted} to size of {-heist::%{_h}%::hunted::*}
		send "HEIST %{_h}% state=%heistState({_h})% run=%heistRun({_h})% left=%heistSecondsLeft({_h})% inside=%heistRobberCount({_h})% names=%{_names}% alarm=%heistAlarmStage({_h})% wave=%heistWave({_h})% hunted=%{_hunted}% reset=%{_reset}%"

command /zzinheist <player>:
	executable by: console
	trigger:
		set {_in} to heistOf(arg-1)
		if {_in} is "":
			set {_in} to "none"
		set {_hunt} to heistHuntedBy(arg-1)
		if {_hunt} is "":
			set {_hunt} to "none"
		send "INHEIST %arg-1% %{_in}% hunt=%{_hunt}%"

# heists.sk's own teleport (skips the gates; the reconcile decides membership).
command /zzheisttp <player> <number> <number> <number>:
	executable by: console
	trigger:
		heistTeleport(arg-1, location(arg-2, arg-3, arg-4, world "world"))
		send "HEISTTP %arg-1%"

command /zzcfgtime <text> <timespan>:
	executable by: console
	trigger:
		set {-cfg::%arg-1%} to arg-2
		send "CFGTIME %arg-1% = %arg-2%"

command /zzcfgtext <text> <text>:
	executable by: console
	trigger:
		set {-cfg::%arg-1%} to arg-2
		send "CFGTEXT %arg-1% = %arg-2%"

command /zzcfgreload:
	executable by: console
	trigger:
		loadSettings()
		send "CFGRELOAD"

command /zzpapi <player> <text>:
	executable by: console
	trigger:
		set {_v} to placeholder arg-2 from arg-1
		# The console strips color codes: show them as (amp)a, (amp)f ...
		replace all "§" with "(amp)" in {_v}
		replace all "&" with "(amp)" in {_v}
		send "PAPI %arg-2% = %{_v}%"

command /zzpassivewhy <player>:
	executable by: console
	trigger:
		send "PASSIVEWHY %passiveBlockReason(arg-1)%"

# Forgets a heist's memory state, like a restart or Minehut sleep does.
command /zzheistforget <text>:
	executable by: console
	trigger:
		delete {-heist::%arg-1%::*}
		send "HEISTFORGET %arg-1%"

# A staff kick. core.sk flags kicks typed in the console or by staff in game; RCON commands (the tests)
# don't fire Skript's command event, so this flags it the same way first.
command /zzkick <player>:
	executable by: console
	trigger:
		set {_k} to name of arg-1 in lower case
		set {-staffkick::%{_k}%} to true
		kick arg-1 due to "test kick"
		send "KICKED %{_k}%"
		wait 3 seconds
		delete {-staffkick::%{_k}%}

command /zzspawn:
	executable by: console
	trigger:
		set {_l} to spawn of world "world"
		send "SPAWN %x-coordinate of {_l}% %y-coordinate of {_l}% %z-coordinate of {_l}%"

# Puts the owned bag (data bag-tier) into the offhand (inventory.sk's applyBag).
command /zzbagapply <player>:
	executable by: console
	trigger:
		applyBag(arg-1)
		send "BAGAPPLY %arg-1% %itemId(offhand tool of arg-1)%"

# Sends the local test pack again (after tools\build-pack.js), so a client reloads it without rejoining.
command /zzpack <player>:
	executable by: console
	trigger:
		send resource pack from "http://127.0.0.1:8765/pack.zip" to arg-1
		send "PACK sent to %arg-1%"

# ---------- traps.sk ----------

# Health in HP (20 = full): /zzhp <player> [hp]. Also fills food and saturation to 20 / 0 when setting,
# so natural regeneration is slow and predictable (1 HP per 4 s).
command /zzhp <player> [<number>]:
	executable by: console
	trigger:
		if arg-2 is set:
			set health of arg-1 to arg-2 / 2
			set food level of arg-1 to 10
			set saturation of arg-1 to 0
		send "HP %name of arg-1% %health of arg-1 * 2%"


command /zztrap <text>:
	executable by: console
	trigger:
		set {_h} to arg-1
		set {_valid} to 0
		loop {-trapd::%{_h}%::*}:
			if loop-value is valid:
				add 1 to {_valid}
		set {_floors} to ""
		loop {traps::%{_h}%::*}:
			loop-value is "floor"
			set {_st} to {-trapfloor::%{_h}%::%loop-index%}
			if {_st} is not set:
				set {_st} to "up"
			set {_floors} to "%{_floors}%%loop-index%:%{_st}%,"
		send "TRAPS %{_h}% armed=%trapArmed({_h})% alarmed=%whether {-trap::alarmed::%{_h}%} is set% traps=%trapCount({_h})% displays=%{_valid}% floors=%{_floors}%"

command /zztrapstate <text>:
	executable by: console
	trigger:
		set {_p::*} to arg-1 split at "-"
		set {_c} to "%{_p::1}%::%{_p::2}%"
		set {_st} to {-trapfloor::%{_c}%}
		if {_st} is not set:
			set {_st} to "up"
		set {_seen} to ""
		loop {-trapseen::%{_c}%::*}:
			set {_seen} to "%{_seen}%%loop-index%:%loop-value%,"
		set {_d} to {-trapd::%{_c}%}
		set {_dv} to "none"
		if {_d} is set:
			if {_d} is valid:
				set {_dv} to "valid"
		send "TRAPSTATE %arg-1% kind=%{-trapc::%{_c}%::kind}% live=%{-trapc::%{_c}%::live}% vis=%{-trapvis::%{_c}%}% phase=%{-trapc::%{_c}%::phase}% floor=%{_st}% seen=%{_seen}% display=%{_dv}% dmg=%{-trapc::%{_c}%::dmg}%"

# trapScan at a spot: which trap would kill a robber standing, sneaking or swimming there.
command /zztrapprobe <text> <number> <number> <number> <text>:
	executable by: console
	trigger:
		set {_hh} to 1.8
		if arg-5 is "sneak":
			set {_hh} to 1.5
		if arg-5 is "swim":
			set {_hh} to 0.6
		set {_n} to trapScan(arg-1, arg-2, arg-3, arg-4, {_hh})
		if {_n} is "":
			set {_n} to "none"
		send "PROBE %{_n}%"

command /zztrapbench <player> <number>:
	executable by: console
	trigger:
		set {_h} to heistOf(arg-1)
		set {_l} to location of arg-1
		set {_t} to now
		loop arg-2 times:
			trapScan({_h}, x-coordinate of {_l}, y-coordinate of {_l}, z-coordinate of {_l}, 1.8)
		set {_ms} to (difference between {_t} and now) / 1 millisecond
		send "BENCH n=%arg-2% us=%{_ms} * 1000 / arg-2%"

# ---------- loot.sk and bag.sk ----------

# One line per heist: armed run, rolled, left, spots; per spot: kind, state, pieces, $ left, hitboxes,
# registered entities, marker colour.
command /zzloot <text>:
	executable by: console
	trigger:
		set {_h} to arg-1
		set {_out} to "LOOT %{_h}% armed=%lootArmed({_h})% run=%{-lootrun::%{_h}%}% rolled=%lootRolled({_h})% left=%lootLeft({_h})% spots=%lootSpotsText({_h})% pool=%heistLootPool({_h})% state=%heistState({_h})%"
		loop {loots::%{_h}%::*}:
			set {_c} to "%{_h}%::%loop-index%"
			set {_hb} to size of {-loothb::%{_c}%::*}
			set {_ents} to size of {-lootents::%{_c}%::*}
			set {_out} to "%{_out}% | %loop-index%:%loop-value%:%{-lootst::%{_c}%}%:n=%{-lootn::%{_c}%}%:left=%{-lootleft::%{_c}%}%:hb=%{_hb}%:ents=%{_ents}%:mk=%{-lootmkc::%{_c}%}%:claim=%{-lootclaim::%{_c}%::name}%:drill=%{-lootdrill::%{_c}%::done}%"
		send {_out}

# A player's code for a safe (made now if they have none): /zzlootcode <h-n> <player>
command /zzlootcode <text> <player>:
	executable by: console
	trigger:
		set {_p::*} to arg-1 split at "-"
		set {_c} to "%{_p::1}%::%{_p::2}%"
		if {-lootcode::%{_c}%::%arg-2%} is not set:
			set {-lootcode::%{_c}%::%arg-2%} to lootNewCode({-lootc::%{_c}%::digits})
		send "CODE %{-lootcode::%{_c}%::%arg-2%}%"

command /zzbag <player>:
	executable by: console
	trigger:
		set {_lines} to ""
		loop {data::%arg-1%::loot::*}:
			set {_lines} to "%{_lines}%%loop-index%=%loop-value%,"
		set {_sold} to getData(arg-1, "loot-sold")
		set {_rob} to getData(arg-1, "robberies")
		send "BAG %arg-1% tier=%bagTier(arg-1)% total=%bagRecount(arg-1)% room=%bagRoom(arg-1)% pct=%bagPct(arg-1)% lines=%{_lines}% sold=%{_sold}% robberies=%{_rob}%"

# Puts loot straight into a bag line: /zzbagadd <player> <heist#run> <$> (0 deletes the line).
command /zzbagadd <player> <text> <number>:
	executable by: console
	trigger:
		if arg-3 <= 0:
			deleteData(arg-1, "loot::%arg-2%")
		else:
			setData(arg-1, "loot::%arg-2%", arg-3)
		bagRecount(arg-1)
		bagRefresh(arg-1)
		send "BAGADD %arg-1% %arg-2% %arg-3%"

# Heist tools into hotbar slot N (0-4): /zztool <player> <drill|safe-kit> <amount> <slot>
command /zztool <player> <text> <number> <number>:
	executable by: console
	trigger:
		if arg-3 <= 0:
			set slot arg-4 of arg-1's inventory to air
		else:
			set slot arg-4 of arg-1's inventory to toolItem(arg-2, arg-3)
		send "TOOL %arg-1% %arg-2% x%toolCount(arg-1, arg-2)%"

command /zzbagclear <player>:
	executable by: console
	trigger:
		delete {data::%arg-1%::loot::*}
		bagRecount(arg-1)
		bagRefresh(arg-1)
		send "BAGCLEAR %arg-1%"

# The offhand item's name and whether it glints: "OFFHAND <name> glint=<true|false>"
command /zzoffhand <player>:
	executable by: console
	trigger:
		set {_i} to offhand tool of arg-1
		set {_g} to boolean tag "minecraft:enchantment_glint_override" of nbt of {_i}
		if {_g} is not set:
			set {_g} to false
		send "OFFHAND %name of {_i}% glint=%{_g}%"

# The NBT of a shop icon: /zzicon wpn <title> | ammo <type> | bag <tier>
command /zzicon <text> <text>:
	executable by: console
	trigger:
		if arg-1 is "wpn":
			set {_i} to wpnIcon(arg-2)
		else if arg-1 is "gear":
			set {_i} to gearItem(arg-2)
		else if arg-1 is "ammo":
			set {_i} to ammoIcon(arg-2)
		else:
			set {_i} to bagIcon(arg-2 parsed as number)
		send "ICON %type of {_i}% %nbt of {_i}%"

# A text value in player data: /zzdatatext <player> <key> <text>
command /zzdatatext <offline player> <text> <text>:
	executable by: console
	trigger:
		setData(arg-1, arg-2, arg-3)
		send "DATATEXT %arg-1% %arg-2% = %getData(arg-1, arg-2)%"

# loot.sk's cleaned-out rule for a given time left: "CLEAN <T> -> <T'>"
command /zzcleancalc <number>:
	executable by: console
	trigger:
		set {_min} to {-cfg::loot::cleaned-out}
		set {_new} to arg-1
		if arg-1 > {_min}:
			set {_new} to max({_min}, ceil(arg-1 * {-cfg::loot::cleaned-out-factor}))
		send "CLEAN %arg-1% -> %{_new}%"

