# zz-testkit.sk: LOCAL TEST HELPERS ONLY. Never upload to Minehut.
# Console commands the bot scenarios use to set up a known inventory.

# A known layout: test sword in hotbar 1, test ammo in the first upper slot, a tier-2 bag.
command /zztestkit <player>:
	executable by: console
	trigger:
		set {_p} to arg-1
		clear {_p}'s inventory
		setData({_p}, "bag-tier", 2)
		applyLayout({_p})
		applyMapVisibility({_p})
		set slot 0 of {_p}'s inventory to tagItem(iron sword named "&fTest Sword", "test:sword")
		set slot 9 of {_p}'s inventory to tagItem(32 gold nuggets named "&eTest Ammo", "test:ammo")
		set slot 10 of {_p}'s inventory to tagItem(32 gold nuggets named "&eTest Ammo", "test:ammo")
		# A block item in the upper inventory: middle-click on a stone block would pull it into the hotbar.
		set slot 20 of {_p}'s inventory to stone
		send "testkit ready for %{_p}%" to console

# One line with every non-empty slot: "slot=material xcount [id]" (slot 40 = offhand, 36-39 = armor).
command /zzdump <player>:
	executable by: console
	trigger:
		set {_p} to arg-1
		set {_out} to ""
		loop integers from 0 to 40:
			set {_i} to slot loop-value of {_p}'s inventory
			if {_i} is not air:
				set {_out} to "%{_out}%%loop-value%=%type of {_i}% x%item amount of {_i}% [%itemId({_i})%] | "
		set {_c} to cursor slot of {_p}
		send "DUMP %{_out}%cursor=%{_c}%"

# LuckPerms answers asynchronously, so its own replies never come back over RCON.
command /zzperm <player> <text>:
	executable by: console
	trigger:
		send "PERM %arg-2% for %arg-1%: %whether arg-1 has permission arg-2%"

command /zzclear <player>:
	executable by: console
	trigger:
		clear arg-1's inventory
		deleteData(arg-1, "bag-tier")
		# Test bots skip the first-join tutorial (it blocks shops until the first bag): tutorial.js sets it.
		setData(arg-1, "tutorial", "done")
		# ...and the story's missions (story.js sets its own state), Vic's too, and no job boards (jobs.js).
		setData(arg-1, "story", "done")
		setData(arg-1, "vic", "done")
		setData(arg-1, "jobs::mara::unlocked", "off")
		setData(arg-1, "jobs::boss::unlocked", "off")
		applyLayout(arg-1)
		applyMapVisibility(arg-1)

# Forgets a player's saved data and balance, so their next join counts as a first join.
command /zzforget <offline player>:
	executable by: console
	trigger:
		delete {data::%arg-1%::*}
		set balance of arg-1 to 0
		send "FORGET %arg-1%"

# Balance as a plain number (EssentialsX's own /balance formats it).
command /zzbal <offline player>:
	executable by: console
	trigger:
		send "BAL %arg-1%: %floor(balance of arg-1)%"

# One setting from core.sk, e.g. /zzcfg money::start
command /zzcfg <text>:
	executable by: console
	trigger:
		send "CFG %arg-1% = %cfg(arg-1)%"

# Changes a number setting until the next loadSettings() (tests put the old value back).
command /zzcfgset <text> <number>:
	executable by: console
	trigger:
		set {-cfg::%arg-1%} to arg-2
		send "CFGSET %arg-1% = %arg-2%"

# afk.sk: pretend the player's last activity was 10 minutes ago (AFK within 10 seconds).
command /zzafk <player>:
	executable by: console
	trigger:
		set {-afk::last::%arg-1%} to 10 minutes ago
		send "AFKSET %arg-1%"

command /zzafkstate <player>:
	executable by: console
	trigger:
		send "AFK %arg-1%: %isAfk(arg-1)%"

# Player data: /zzdata <player> <key> shows it, "... <key> <number>" sets it, "... <key> none" deletes it.
command /zzdata <offline player> <text> [<text>]:
	executable by: console
	trigger:
		if arg-3 is "none":
			deleteData(arg-1, arg-2)
		else if arg-3 is set:
			setData(arg-1, arg-2, arg-3 parsed as number)
		send "DATA %arg-1% %arg-2% = %getData(arg-1, arg-2)%"

# nav.sk: turn passive mode on or off directly (the phone button goes through pvp.sk's rules).
command /zzpassive <player> <text>:
	executable by: console
	trigger:
		if arg-2 is "on":
			setPassive(arg-1, true)
		else:
			setPassive(arg-1, false)
		send "PASSIVE %arg-1%: %isPassive(arg-1)%"

# Phone: the player's phone map id (DonatingPhone metadata), the map id on the slot-8 phone, and
# whether the big map is open.
command /zzphone <player>:
	executable by: console
	trigger:
		set {_meta} to metadata value "donating_phone_map" of arg-1
		set {_slot} to int tag "minecraft:map_id" of nbt of slot 8 of arg-1's inventory
		set {_open} to false
		if arg-1 has scoreboard tag "donating_phone_open":
			set {_open} to true
		send "ZZPHONE %arg-1% meta=%{_meta}% slot8=%{_slot}% open=%{_open}% offhand=%type of offhand tool of arg-1%"

# Navigation: hide or show entities with a scoreboard tag for one player (per-player waypoints).
command /zzhide <player> <text>:
	executable by: console
	trigger:
		set {_n} to 0
		loop all entities:
			if loop-entity has scoreboard tag arg-2:
				hide loop-entity from arg-1
				add 1 to {_n}
		send "HIDDEN %{_n}% from %arg-1%"

command /zzshow <player> <text>:
	executable by: console
	trigger:
		set {_n} to 0
		loop all entities:
			if loop-entity has scoreboard tag arg-2:
				reveal loop-entity to arg-1
				add 1 to {_n}
		send "SHOWN %{_n}% to %arg-1%"

# chat-extras.sk: send the next rotating tip now.
command /zztip:
	executable by: console
	trigger:
		sendTip()
		send "TIP SENT"

# combat-log.sk: the player's combat state, and ending a tag now (the loop tells them within a second).
command /zzcombat <player>:
	executable by: console
	trigger:
		set {_cause} to deathCause(arg-1)
		send "COMBAT %arg-1% tagged=%isCombatTagged(arg-1)% wanted=%isWanted(arg-1)% cause=%{_cause}%"

command /zzcombatend <player>:
	executable by: console
	trigger:
		set {-combat::at::%arg-1%} to 1 hour ago
		delete {-combat::playerat::%arg-1%}
		send "COMBATEND %arg-1%"

# pvp.sk: a cuboid WorldGuard region in the main world (safe zones are regions named safe...), and
# the spawn shield state. Remove a region with: rg remove -w world <id>
command /zzregion <text> <number> <number> <number> <number> <number> <number>:
	executable by: console
	trigger:
		set {_w} to world "world"
		create a cuboid region named arg-1 in {_w} between location(arg-2, arg-3, arg-4, {_w}) and location(arg-5, arg-6, arg-7, {_w})
		send "REGION %arg-1% made"

command /zzshield <player>:
	executable by: console
	trigger:
		send "SHIELD %arg-1% %hasSpawnShield(arg-1)% safe=%isSafeZone(location of arg-1)%"

# Ends the spawn shield now (tests that aren't about it).
command /zzshieldoff <player>:
	executable by: console
	trigger:
		delete {-pvp::shield::%arg-1%}
		send "SHIELDOFF %arg-1%"

# shop.sk: WeaponMechanics items and ammo in the inventory: "WM <slot>=<title>:<loaded>x<amount> | ...
# ammo <type>=<rounds> ...".
command /zzwm <player>:
	executable by: console
	trigger:
		set {_out} to ""
		loop integers from 0 to 40:
			set {_i} to slot loop-value of arg-1's inventory
			set {_w} to wmTitle({_i})
			if {_w} is not "":
				set {_out} to "%{_out}%%loop-value%=%{_w}%:%wmLoaded({_i})%x%item amount of {_i}% | "
		loop {-cfg::shop::ammo::*}:
			set {_out} to "%{_out}%ammo %loop-value%=%ammoCount(arg-1, loop-value)% "
		send "WM %{_out}%"

command /zzammo <player> <text> <number>:
	executable by: console
	trigger:
		send "AMMO added %addAmmo(arg-1, arg-2, arg-3)%"

# Forgets shop data: unlocks, saved loadout, bags; closes the shop.
command /zzshopreset <player>:
	executable by: console
	trigger:
		loop {-cfg::shop::weapons::*}:
			deleteData(arg-1, "wpn::%loop-value%")
		loop integers from 1 to 5:
			deleteData(arg-1, "loadout::%loop-value%")
			deleteData(arg-1, "loadout::%loop-value%::count")
		deleteData(arg-1, "loadout::saved")
		deleteData(arg-1, "bag-tier")
		deleteData(arg-1, "bag-best")
		close arg-1's inventory
		clearShopState(arg-1)
		send "SHOPRESET %arg-1%"

# Fills slots <from>..<to> with stone (full-inventory tests).
command /zzfill <player> <number> <number>:
	executable by: console
	trigger:
		loop integers from arg-2 to arg-3:
			set slot loop-value of arg-1's inventory to stone
		send "FILLED %arg-1%"

command /zzshop <player>:
	executable by: console
	trigger:
		set {_s} to {-shop::status::%arg-1%}
		set {_c} to {-shop::confirm::%arg-1%}
		send "SHOP open=%{-shop::kind::%arg-1%}% tab=%{-shop::tab::%arg-1%}% gen=%{-shop::gen::%arg-1%}% confirm=%{_c}% status=%{_s}%"

command /zztag <player>:
	executable by: console
	trigger:
		tagCombat(arg-1, "trap")
		send "TAGGED %arg-1%"

# bounty.sk: a player's bounty, adding to it (like bag.sk's robbery sales), and the same-IP check
# (every local bot shares 127.0.0.1).
command /zzbounty <offline player> [<number>] [<text>]:
	executable by: console
	trigger:
		if arg-2 is set:
			set {_added} to addBounty(arg-1, arg-2, arg-3 ? "robbery")
			send "BOUNTYADD %arg-1% %{_added}%"
		set {_k} to getData(arg-1, "bounty-kills")
		send "BOUNTY %arg-1% %getBounty(arg-1)% kills=%{_k}%"

command /zzbountyreset <offline player>:
	executable by: console
	trigger:
		clearBounty(arg-1)
		delete {data::%arg-1%::bounty-last::*}
		deleteData(arg-1, "bounty-payout")
		send "BOUNTYRESET %arg-1%"

command /zzbountyip <text>:
	executable by: console
	trigger:
		if arg-1 is "off":
			set {-cfg::bounty::ip-check} to false
		else:
			set {-cfg::bounty::ip-check} to true
		send "BOUNTYIP %{-cfg::bounty::ip-check}%"

# ---------- heists.sk ----------

command /zzheist <text>:
	executable by: console
	trigger:
		set {_h} to arg-1
		if heistExists({_h}) is false:
			send "HEIST %{_h}% unknown"
			stop
		set {_names::*} to heistRobbers({_h})
		set {_names} to join {_names::*} with ","
		set {_reset} to {-heist::%{_h}%::reset-next}
		if {_reset} is not set:
			set {_reset} to "none"
		set {_hunted} to size of {-heist::%{_h}%::hunted::*}
		send "HEIST %{_h}% state=%heistState({_h})% run=%heistRun({_h})% left=%heistSecondsLeft({_h})% inside=%heistRobberCount({_h})% names=%{_names}% alarm=%heistAlarmStage({_h})% wave=%heistWave({_h})% hunted=%{_hunted}% reset=%{_reset}%"

command /zzinheist <player>:
	executable by: console
	trigger:
		set {_in} to heistOf(arg-1)
		if {_in} is "":
			set {_in} to "none"
		set {_hunt} to heistHuntedBy(arg-1)
		if {_hunt} is "":
			set {_hunt} to "none"
		send "INHEIST %arg-1% %{_in}% hunt=%{_hunt}%"

# heists.sk's own teleport (skips the gates; the reconcile decides membership).
command /zzheisttp <player> <number> <number> <number>:
	executable by: console
	trigger:
		heistTeleport(arg-1, location(arg-2, arg-3, arg-4, world "world"))
		send "HEISTTP %arg-1%"

# Runs a command as the real console (some plugins, like Tebex, refuse the RCON sender); the reply goes
# to the server log.
command /zzconsole <text>:
	executable by: console
	trigger:
		execute console command arg-1
		send "CONSOLE ran %arg-1%"

# boosters.sk: the running booster's seconds left.
command /zzboosterleft <number>:
	executable by: console
	trigger:
		set {booster::left} to arg-1
		send "BOOSTERLEFT %{booster::left}%"

# An active heist's clock: /zzheistleft <id> <seconds left>.
command /zzheistleft <text> <number>:
	executable by: console
	trigger:
		set {-heist::%arg-1%::until} to now
		add 1 second * arg-2 to {-heist::%arg-1%::until}
		send "HEISTLEFT %arg-1% %heistSecondsLeft(arg-1)%"

command /zzcfgtime <text> <timespan>:
	executable by: console
	trigger:
		set {-cfg::%arg-1%} to arg-2
		send "CFGTIME %arg-1% = %arg-2%"

command /zzcfgtext <text> <text>:
	executable by: console
	trigger:
		set {-cfg::%arg-1%} to arg-2
		send "CFGTEXT %arg-1% = %arg-2%"

command /zzcfgreload:
	executable by: console
	trigger:
		loadSettings()
		send "CFGRELOAD"

command /zzpapi <player> <text>:
	executable by: console
	trigger:
		set {_v} to placeholder arg-2 from arg-1
		# The console strips color codes: show them as (amp)a, (amp)f ...
		replace all "§" with "(amp)" in {_v}
		replace all "&" with "(amp)" in {_v}
		send "PAPI %arg-2% = %{_v}%"

command /zzpassivewhy <player>:
	executable by: console
	trigger:
		send "PASSIVEWHY %passiveBlockReason(arg-1)%"

# Forgets a heist's memory state, like a restart or Minehut sleep does.
command /zzheistforget <text>:
	executable by: console
	trigger:
		delete {-heist::%arg-1%::*}
		send "HEISTFORGET %arg-1%"

# A staff kick. core.sk flags kicks typed in the console or by staff in game; RCON commands (the tests)
# don't fire Skript's command event, so this flags it the same way first.
command /zzkick <player>:
	executable by: console
	trigger:
		set {_k} to name of arg-1 in lower case
		set {-staffkick::%{_k}%} to true
		kick arg-1 due to "test kick"
		send "KICKED %{_k}%"
		wait 3 seconds
		delete {-staffkick::%{_k}%}

command /zzspawn:
	executable by: console
	trigger:
		set {_l} to spawn of world "world"
		send "SPAWN %x-coordinate of {_l}% %y-coordinate of {_l}% %z-coordinate of {_l}%"

# Puts the owned bag (data bag-tier) into the offhand (inventory.sk's applyBag).
command /zzbagapply <player>:
	executable by: console
	trigger:
		applyBag(arg-1)
		send "BAGAPPLY %arg-1% %itemId(offhand tool of arg-1)%"

# Sends the local test pack again (after tools\build-pack.js), so a client reloads it without rejoining.
command /zzpack <player>:
	executable by: console
	trigger:
		send resource pack from "http://127.0.0.1:8765/pack.zip" to arg-1
		send "PACK sent to %arg-1%"

# ---------- traps.sk ----------

# Health in HP (20 = full): /zzhp <player> [hp]. Also fills food and saturation to 20 / 0 when setting,
# so natural regeneration is slow and predictable (1 HP per 4 s).
command /zzhp <player> [<number>]:
	executable by: console
	trigger:
		if arg-2 is set:
			set health of arg-1 to arg-2 / 2
			set food level of arg-1 to 10
			set saturation of arg-1 to 0
		send "HP %name of arg-1% %health of arg-1 * 2%"


command /zztrap <text>:
	executable by: console
	trigger:
		set {_h} to arg-1
		set {_valid} to 0
		loop {-trapd::%{_h}%::*}:
			if loop-value is valid:
				add 1 to {_valid}
		set {_floors} to ""
		loop {traps::%{_h}%::*}:
			loop-value is "floor"
			set {_st} to {-trapfloor::%{_h}%::%loop-index%}
			if {_st} is not set:
				set {_st} to "up"
			set {_floors} to "%{_floors}%%loop-index%:%{_st}%,"
		send "TRAPS %{_h}% armed=%trapArmed({_h})% alarmed=%whether {-trap::alarmed::%{_h}%} is set% traps=%trapCount({_h})% displays=%{_valid}% floors=%{_floors}%"

command /zztrapstate <text>:
	executable by: console
	trigger:
		set {_p::*} to arg-1 split at "-"
		set {_c} to "%{_p::1}%::%{_p::2}%"
		set {_st} to {-trapfloor::%{_c}%}
		if {_st} is not set:
			set {_st} to "up"
		set {_seen} to ""
		loop {-trapseen::%{_c}%::*}:
			set {_seen} to "%{_seen}%%loop-index%:%loop-value%,"
		set {_d} to {-trapd::%{_c}%}
		set {_dv} to "none"
		if {_d} is set:
			if {_d} is valid:
				set {_dv} to "valid"
		send "TRAPSTATE %arg-1% kind=%{-trapc::%{_c}%::kind}% live=%{-trapc::%{_c}%::live}% vis=%{-trapvis::%{_c}%}% phase=%{-trapc::%{_c}%::phase}% floor=%{_st}% seen=%{_seen}% display=%{_dv}% dmg=%{-trapc::%{_c}%::dmg}%"

# trapScan at a spot: which trap would kill a robber standing, sneaking or swimming there.
command /zztrapprobe <text> <number> <number> <number> <text>:
	executable by: console
	trigger:
		set {_hh} to 1.8
		if arg-5 is "sneak":
			set {_hh} to 1.5
		if arg-5 is "swim":
			set {_hh} to 0.6
		set {_n} to trapScan(arg-1, arg-2, arg-3, arg-4, {_hh})
		if {_n} is "":
			set {_n} to "none"
		send "PROBE %{_n}%"

command /zztrapbench <player> <number>:
	executable by: console
	trigger:
		set {_h} to heistOf(arg-1)
		set {_l} to location of arg-1
		set {_t} to now
		loop arg-2 times:
			trapScan({_h}, x-coordinate of {_l}, y-coordinate of {_l}, z-coordinate of {_l}, 1.8)
		set {_ms} to (difference between {_t} and now) / 1 millisecond
		send "BENCH n=%arg-2% us=%{_ms} * 1000 / arg-2%"

# ---------- loot.sk and bag.sk ----------

# One line per heist: armed run, rolled, left, spots; per spot: kind, state, pieces, $ left, hitboxes,
# registered entities, marker colour.
command /zzloot <text>:
	executable by: console
	trigger:
		set {_h} to arg-1
		set {_out} to "LOOT %{_h}% armed=%lootArmed({_h})% run=%{-lootrun::%{_h}%}% rolled=%lootRolled({_h})% left=%lootLeft({_h})% spots=%lootSpotsText({_h})% pool=%heistLootPool({_h})% state=%heistState({_h})%"
		loop {loots::%{_h}%::*}:
			set {_c} to "%{_h}%::%loop-index%"
			set {_hb} to size of {-loothb::%{_c}%::*}
			set {_ents} to size of {-lootents::%{_c}%::*}
			set {_out} to "%{_out}% | %loop-index%:%loop-value%:%{-lootst::%{_c}%}%:n=%{-lootn::%{_c}%}%:left=%{-lootleft::%{_c}%}%:hb=%{_hb}%:ents=%{_ents}%:mk=%{-lootmkc::%{_c}%}%:claim=%{-lootclaim::%{_c}%::name}%:drill=%{-lootdrill::%{_c}%::done}%"
		send {_out}

# A player's code for a safe (made now if they have none): /zzlootcode <h-n> <player>
command /zzlootcode <text> <player>:
	executable by: console
	trigger:
		set {_p::*} to arg-1 split at "-"
		set {_c} to "%{_p::1}%::%{_p::2}%"
		if {-lootcode::%{_c}%::%arg-2%} is not set:
			set {-lootcode::%{_c}%::%arg-2%} to lootNewCode({-lootc::%{_c}%::digits})
		send "CODE %{-lootcode::%{_c}%::%arg-2%}%"

command /zzbag <player>:
	executable by: console
	trigger:
		set {_lines} to ""
		loop {data::%arg-1%::loot::*}:
			set {_lines} to "%{_lines}%%loop-index%=%loop-value%,"
		set {_sold} to getData(arg-1, "loot-sold")
		set {_rob} to getData(arg-1, "robberies")
		send "BAG %arg-1% tier=%bagTier(arg-1)% total=%bagRecount(arg-1)% room=%bagRoom(arg-1)% pct=%bagPct(arg-1)% lines=%{_lines}% sold=%{_sold}% robberies=%{_rob}%"

# Puts loot straight into a bag line: /zzbagadd <player> <heist#run> <$> (0 deletes the line).
# Sets a bag line. With "own" the dollars also count as robbed by that player (progress.sk's own-loot ledger: level XP
# from a sale, jobs, Vic), as if they robbed it; without, it's like loot from a picked-up duffel.
command /zzbagadd <player> <text> <number> [<text>]:
	executable by: console
	trigger:
		if arg-3 <= 0:
			deleteData(arg-1, "loot::%arg-2%")
		else:
			setData(arg-1, "loot::%arg-2%", arg-3)
			if arg-4 is "own":
				progRobbed(arg-1, arg-3, arg-2)
		bagRecount(arg-1)
		bagRefresh(arg-1)
		send "BAGADD %arg-1% %arg-2% %arg-3%"

# Heist tools into hotbar slot N (0-4): /zztool <player> <drill|safe-kit> <amount> <slot>
command /zztool <player> <text> <number> <number>:
	executable by: console
	trigger:
		if arg-3 <= 0:
			set slot arg-4 of arg-1's inventory to air
		else:
			set slot arg-4 of arg-1's inventory to toolItem(arg-2, arg-3)
		send "TOOL %arg-1% %arg-2% x%toolCount(arg-1, arg-2)%"

# bag.sk: every dropped duffel in loaded chunks:
# "DUFFELS <n> | <id> lines=<lines> owner=<name> passive=<p> left=<s> at=<x>,<y>,<z> inv=<b> name=<name>"
command /zzduffels:
	executable by: console
	trigger:
		set {_out} to ""
		set {_n} to 0
		loop all dropped items:
			set {_i} to item of loop-entity
			set {_lines} to string tag "donating_duffel" of custom nbt of {_i}
			{_lines} is set
			add 1 to {_n}
			set {_owner} to string tag "donating_duffel_name" of custom nbt of {_i}
			set {_pas} to string tag "donating_duffel_passive" of custom nbt of {_i}
			set {_left} to (double tag "donating_duffel_until" of custom nbt of {_i}) - (unix timestamp of now)
			set {_inv} to false
			if loop-entity is invulnerable:
				set {_inv} to true
			set {_l} to location of loop-entity
			set {_out} to "%{_out}% | %itemId({_i})% lines=%{_lines}% owner=%{_owner}% passive=%{_pas}% left=%floor({_left})% at=%floor(x-coordinate of {_l})%,%floor(y-coordinate of {_l})%,%floor(z-coordinate of {_l})% inv=%{_inv}% name=%uncolored display name of loop-entity%"
		send "DUFFELS %{_n}%%{_out}%"

command /zzbagclear <player>:
	executable by: console
	trigger:
		delete {data::%arg-1%::loot::*}
		bagRecount(arg-1)
		bagRefresh(arg-1)
		send "BAGCLEAR %arg-1%"

# The offhand item's name and whether it glints: "OFFHAND <name> glint=<true|false>"
command /zzoffhand <player>:
	executable by: console
	trigger:
		set {_i} to offhand tool of arg-1
		set {_g} to boolean tag "minecraft:enchantment_glint_override" of nbt of {_i}
		if {_g} is not set:
			set {_g} to false
		send "OFFHAND %name of {_i}% glint=%{_g}%"

# The NBT of a shop icon: /zzicon wpn <title> | ammo <type> | bag <tier>
command /zzicon <text> <text>:
	executable by: console
	trigger:
		if arg-1 is "wpn":
			set {_i} to wpnIcon(arg-2)
		else if arg-1 is "gear":
			set {_i} to gearItem(arg-2)
		else if arg-1 is "ammo":
			set {_i} to ammoIcon(arg-2)
		else:
			set {_i} to bagIcon(arg-2 parsed as number)
		send "ICON %type of {_i}% %nbt of {_i}%"

# A text value in player data: /zzdatatext <player> <key> <text>
command /zzdatatext <offline player> <text> <text>:
	executable by: console
	trigger:
		setData(arg-1, arg-2, arg-3)
		send "DATATEXT %arg-1% %arg-2% = %getData(arg-1, arg-2)%"

# loot.sk's cleaned-out rule for a given time left: "CLEAN <T> -> <T'>"
command /zzcleancalc <number>:
	executable by: console
	trigger:
		set {_min} to {-cfg::loot::cleaned-out}
		set {_new} to arg-1
		if arg-1 > {_min}:
			set {_new} to max({_min}, ceil(arg-1 * {-cfg::loot::cleaned-out-factor}))
		send "CLEAN %arg-1% -> %{_new}%"


# ---------- crates.sk, cosmetics.sk ----------

# Wipes a player's keys, cosmetics, choices and the daily / refresh timers.
command /zzcratereset <offline player>:
	executable by: console
	trigger:
		delete {data::%arg-1%::keys::*}
		delete {data::%arg-1%::cos::*}
		deleteData(arg-1, "daily-at")
		deleteData(arg-1, "refresh-at")
		deleteData(arg-1, "title")
		deleteData(arg-1, "killfx")
		deleteData(arg-1, "bag-skin")
		delete {cratepending::%uuid of arg-1%::*}
		send "CRATERESET %arg-1%"

# A crate's reward lines until the next loadSettings() (lines split by ";"): /zzcratelines common 1|money|777
command /zzcratelines <text> <text>:
	executable by: console
	trigger:
		set {-cfg::crate::%arg-1%::rewards::*} to arg-2 split at ";"
		send "CRATELINES %arg-1% %size of {-cfg::crate::%arg-1%::rewards::*}%"

# A true/false setting until the next loadSettings(): /zzcfgbool cos::denim::retired true
command /zzcfgbool <text> <text>:
	executable by: console
	trigger:
		if arg-2 is "true":
			set {-cfg::%arg-1%} to true
		else:
			delete {-cfg::%arg-1%}
		send "CFGBOOL %arg-1% = %{-cfg::%arg-1%}%"

# Rolls a crate n times without giving anything: "ROLL <crate> total=<w> <line>=<count> | ..."
command /zzcrateroll <text> <number>:
	executable by: console
	trigger:
		loop arg-2 times:
			set {_l} to crateRoll(arg-1)
			add 1 to {_n::%{_l}%}
		loop {_n::*}:
			add "%loop-index%=%loop-value%" to {_out::*}
		set {_o} to join {_out::*} with " | "
		send "ROLL %arg-1% total=%crateTotal(arg-1)% lines=%size of crateLines(arg-1)% %{_o}%"

# The cosmetics a player owns and has chosen.
command /zzcos <offline player>:
	executable by: console
	trigger:
		loop {-cfg::cosmetics::*}:
			if cosOwned(arg-1, loop-value) is true:
				add loop-value to {_o::*}
		set {_owned} to join {_o::*} with ","
		set {_t} to getData(arg-1, "title")
		set {_k} to getData(arg-1, "killfx")
		set {_b} to getData(arg-1, "bag-skin")
		set {_shown} to bagSkinOf(arg-1)
		send "COS %arg-1% owned=%{_owned}% title=%{_t}% killfx=%{_k}% bagskin=%{_b}% skinshown=%{_shown}%"

# Gives a cosmetic directly: /zzcosgive <player> <id>
command /zzcosgive <offline player> <text>:
	executable by: console
	trigger:
		set {_new} to cosGive(arg-1, arg-2, "test")
		send "COSGIVE %arg-1% %arg-2% new=%{_new}%"

# A heist's memory state value: /zzheistvar <id> <key> <text|none> (e.g. alarm warning)
command /zzheistvar <text> <text> <text>:
	executable by: console
	trigger:
		if arg-3 is "none":
			delete {-heist::%arg-1%::%arg-2%}
		else:
			set {-heist::%arg-1%::%arg-2%} to arg-3
		send "HEISTVAR %arg-1% %arg-2% = %{-heist::%arg-1%::%arg-2%}%"

# ---------- cops.sk ----------

# Every NPC entity (Citizens): "NPCS id=<NPC-ID> name at x,y,z tags=... hp=..."
command /zznpcs:
	executable by: console
	trigger:
		loop all entities:
			loop-entity has metadata "NPC"
			set {_id} to metadata value "NPC-ID" of loop-entity
			set {_l} to location of loop-entity
			set {_t} to join scoreboard tags of loop-entity with ","
			add "id=%{_id}% %name of loop-entity% at %floor(x-coordinate of {_l})%,%floor(y-coordinate of {_l})%,%floor(z-coordinate of {_l})% tags=%{_t}% hp=%health of loop-entity% tool=%type of tool of loop-entity%" to {_o::*}
		set {_out} to join {_o::*} with " | "
		send "NPCS %size of {_o::*}% %{_out}%"

# Puts a feather with a WeaponMechanics skin number in every NPC's hand: /zznpctool <model>
command /zznpctool <number>:
	executable by: console
	trigger:
		loop all entities:
			loop-entity has metadata "NPC"
			set {_i} to feather
			set float list tag "minecraft:custom_model_data;floats" of nbt of {_i} to arg-1
			set tool of loop-entity to {_i}
		send "NPCTOOL set"

# A heist's cops: "COPS <h> alive=N total=M ids=a,b saved=x,y"
command /zzcops <text>:
	executable by: console
	trigger:
		set {_ids::*} to indices of {-cop::ids::%arg-1%::*}
		set {_ids} to join {_ids::*} with ","
		set {_saved::*} to indices of {cops::ids::*}
		set {_saved} to join {_saved::*} with ","
		send "COPS %arg-1% alive=%copAlive(arg-1)% total=%copTotal()% ids=%{_ids}% saved=%{_saved}%"

# Forgets the cops in memory (like a restart does), without removing the NPCs.
command /zzcopforget:
	executable by: console
	trigger:
		delete {-cop::*}
		send "COPFORGET done"

# ---------- garage.sk (MTVehicles) ----------
# A new car of an MTV model uuid for a player (no item, nothing spawned): "CARNEW <plate>"
command /zzcarnew <offline player> <text>:
	executable by: console
	trigger:
		set {_car} to a new mtv vehicle with uuid arg-2 and owner arg-1
		if {_car} is not set:
			send "CARNEW failed"
			stop
		set {_plate} to vehicle license plate of {_car}
		send "CARNEW %{_plate}%"

# Spawns a car by plate at x y z in the main world.
command /zzcarspawn <text> <number> <number> <number>:
	executable by: console
	trigger:
		set {_l} to location(arg-2, arg-3, arg-4, world "world")
		spawn mtv vehicle with license plate arg-1 at {_l}
		# A garage car in its garage counts as out where it stands (else car-cleanup.sk's sweep takes it for a stray copy); one
		# already out stays where it is (garage.js spawns a stray copy of it on purpose).
		if carOwnerOf(arg-1) is not "":
			{car::out::%arg-1%} is not set
			set {car::out::%arg-1%} to {_l}
			set {-car::used::%arg-1%} to now
		send "CARSPAWN %arg-1%"

# What MTVehicles knows about a plate, and the loaded stands with it.
command /zzcarinfo <text>:
	executable by: console
	trigger:
		set {_car} to mtv vehicle with license plate arg-1
		if {_car} is not set:
			send "CARINFO %arg-1% none"
			stop
		set {_ok} to "no"
		if vehicle {_car} exists:
			set {_ok} to "yes"
		set {_o} to vehicle owner of {_car}
		set {_n} to 0
		loop all entities:
			if loop-entity is an armor stand:
				if "%name of loop-entity%" contains arg-1:
					add 1 to {_n}
		send "CARINFO %arg-1% exists=%{_ok}% owner=%{_o}% stands=%{_n}% type=%vehicle type of {_car}%"

# Despawns and deletes a car by plate (MTVehicles data too), and forgets it in garage.sk.
command /zzcardelete <text>:
	executable by: console
	trigger:
		set {_car} to mtv vehicle with license plate arg-1
		if {_car} is set:
			delete mtv vehicle {_car}
		# Off its owner's garage list too (else the list keeps a plate with no car).
		set {_o} to carOwnerOf(arg-1)
		if {_o} is not "":
			delete {data::%{_o}%::cars::%arg-1%}
		carForget(arg-1)
		send "CARDELETE %arg-1%"

# Where a player sits: "SEAT <player> driver:<plate>" / "passenger:<plate>" / "" (garage.sk carSeatOf).
command /zzcarseat <player>:
	executable by: console
	trigger:
		send "SEAT %arg-1% %carSeatOf(arg-1)% riding=%{-car::riding::%uuid of arg-1%}% slot8=%itemId(slot 8 of arg-1's inventory)%"

# Makes a player sit in the driver's seat of a plate (MTVehicles' mount effect: no enter event).
command /zzcarmount <player> <text>:
	executable by: console
	trigger:
		set {_car} to mtv vehicle with license plate arg-2
		make arg-1 mount mtv vehicle {_car}
		wait 2 ticks
		carSeatCheck(arg-1, arg-2)
		send "MOUNT %arg-1% %carSeatOf(arg-1)%"

# Why each spot around a player is (not) clear for a car (garage.sk carSpawnSpot).
command /zzcarspot <player>:
	executable by: console
	trigger:
		set {_base} to location of arg-1
		set {_yaw} to yaw of arg-1
		# Coordinates in locals first: "x-coordinate of {_base} + {_dx}" parses as the x of (location + number).
		set {_bx} to x-coordinate of {_base}
		set {_by} to y-coordinate of {_base}
		set {_bz} to z-coordinate of {_base}
		loop 0, 90, -90 and 180:
			set {_a} to {_yaw} + loop-value
			set {_dx} to 0 - sin({_a}) * 3.5
			set {_dz} to cos({_a}) * 3.5
			set {_l} to location(floor({_bx} + {_dx}) + 0.5, floor({_by}), floor({_bz} + {_dz}) + 0.5, world of {_base})
			set {_under} to block at ({_l} ~ vector(0, -1, 0))
			delete {_bad::*}
			loop -1, 0 and 1:
				loop -1, 0 and 1:
					loop 0 and 1:
						set {_b} to block at ({_l} ~ vector(loop-value-2, loop-value-4, loop-value-3))
						if {_b} is not passable:
							add "%type of {_b}%@%loop-value-2%,%loop-value-4%,%loop-value-3%" to {_bad::*}
			set {_bads} to join {_bad::*} with " "
			send "SPOT %loop-value-1% at %{_l}% under=%type of {_under}% bad=%{_bads}%"

# Moves a car (all its loaded stands) to x y z in the main world (MTVehicles' teleport effect).
command /zzcartp <text> <number> <number> <number>:
	executable by: console
	trigger:
		set {_car} to mtv vehicle with license plate arg-1
		teleport mtv vehicle {_car} to location(arg-2, arg-3, arg-4, world "world")
		send "CARTP %arg-1%"

# Grants a crate reward line as if a crate rolled it: /zzcrategrant <player> <crate> <line>
command /zzcrategrant <player> <text> <text>:
	executable by: console
	trigger:
		set {_got} to crateGrant(arg-1, arg-3, arg-2)
		send "CRATEGRANT %arg-1% %{_got}%"

# Whether a heist's alarm would still chase a player where they are (heists.sk heistInRange).
command /zzinrange <player> <text>:
	executable by: console
	trigger:
		send "INRANGE %arg-1% %arg-2% %heistInRange(arg-1, arg-2)% seat=%carSeatOf(arg-1)%"

# Makes a heist's alarm hunt a player (heistHunt), or releases them: /zzhunt <player> <heist> [release]
command /zzhunt <player> <text> [<text>]:
	executable by: console
	trigger:
		if arg-3 is "release":
			heistRelease(arg-1, "staff")
		else:
			heistHunt(arg-1, arg-2)
		send "HUNT %arg-1% by=%heistHuntedBy(arg-1)%"

# ---------- Contracts (contracts.sk) ----------

# ctArrow / ctCompass towards x z from where the player stands and looks, and Skript's atan2(1, 0).
command /zzctdir <player> <number> <number>:
	executable by: console
	trigger:
		set {_to} to location(arg-2, y-coordinate of arg-1, arg-3, world of arg-1)
		log "CTDIR arrow=%gpsArrow(arg-1, {_to})% to %arg-2% %arg-3%" to "zztest"
		send "CTDIR arrow=%gpsArrow(arg-1, {_to})% compass=%ctCompass(location of arg-1, {_to})% yaw=%yaw of arg-1% atan2_1_0=%atan2(1, 0)%"

# Clears a player's job cooldown and offers (and ends a job without a cooldown).
command /zzctreset <player>:
	executable by: console
	trigger:
		set {_u} to "%uuid of arg-1%"
		if {-ctjob::%{_u}%} is set:
			ctEnd({_u}, "staff")
		delete {ctcd::%{_u}%}
		# The tiers' cooldowns after a delivery too (1 h / 3 h / 6 h).
		delete {data::%arg-1%::ctready::*}
		delete {-ctoffer::%{_u}%::*}
		delete {-ctofferat::%{_u}%}
		delete {-ctconfirm::%arg-1%}
		send "CTRESET %arg-1%"

# Sets an offer: /zzctoffer <player> <tier> <model> <color> <spot n>
command /zzctoffer <player> <text> <text> <text> <text>:
	executable by: console
	trigger:
		set {-ctoffer::%uuid of arg-1%::%arg-2%} to "%arg-3%|%arg-4%|%arg-5%"
		set {-ctofferat::%uuid of arg-1%} to now
		send "CTOFFER %arg-1% %arg-2% %{-ctoffer::%uuid of arg-1%::%arg-2%}%"

# Takes a job as if clicked in the menu.
command /zzcttake <player> <text>:
	executable by: console
	trigger:
		ctTake(arg-1, arg-2)
		send "CTTAKE %arg-1% job=%{-ctjob::%uuid of arg-1%}% plate=%{-ctjob::%uuid of arg-1%::plate}%"

# A job's state in one line.
command /zzctstate <player>:
	executable by: console
	trigger:
		set {_u} to "%uuid of arg-1%"
		send "CTSTATE %arg-1% job=%{-ctjob::%{_u}%}% stage=%{-ctjob::%{_u}%::stage}% plate=%{-ctjob::%{_u}%::plate}% fails=%{-ctjob::%{_u}%::fails}% left=%ctLeft({_u})% cd=%ctCooldownLeft(arg-1)% seat=%carSeatOf(arg-1)% qte=%{-ctqte::%arg-1%}% gps=%gpsActive(arg-1)%:%{-gps::questlabel::%{_u}%}% hud=%{-hud::bosslast::%arg-1%::title}%"

# Sets the seconds left in a player's job.
command /zzcttime <player> <number>:
	executable by: console
	trigger:
		set {_until} to now
		add 1 second * arg-2 to {_until}
		set {-ctjob::%uuid of arg-1%::until} to {_until}
		send "CTTIME %arg-1% %arg-2%"

# Sets a player's lockpicks of a tier: /zzpick <player> <tier> <n> (0 removes them, -1 only reads).
command /zzpick <player> <text> <number>:
	executable by: console
	trigger:
		set {_s} to lockpickSlot(arg-1, arg-2)
		if {_s} < 0:
			set {_s} to lockpickFreeSlot(arg-1)
		if arg-3 < 0:
			send "PICK %arg-1% %arg-2% %lockpickCount(arg-1, arg-2)% slot=%{_s}%"
			stop
		if arg-3 = 0:
			set slot {_s} of arg-1's inventory to air
		else:
			set slot {_s} of arg-1's inventory to lockpickItem(arg-2, arg-3)
		send "PICK %arg-1% %arg-2% %lockpickCount(arg-1, arg-2)% slot=%{_s}%"

# Seats a player in the driver's seat of their job's car (MTVehicles' mount effect: no enter event).
command /zzctmount <player>:
	executable by: console
	trigger:
		set {_car} to mtv vehicle with license plate {-ctjob::%uuid of arg-1%::plate}
		make arg-1 mount mtv vehicle {_car}
		wait 2 ticks
		send "CTMOUNT %arg-1% %carSeatOf(arg-1)%"

# The lock-picking minigame's state: marker, target, hits.
command /zzctqte <player>:
	executable by: console
	trigger:
		send "CTQTE %arg-1% pos=%{-ctqte::%arg-1%::pos}% prev=%{-ctqte::%arg-1%::prev}% target=%{-ctqte::%arg-1%::target}% hits=%{-ctqte::%arg-1%::hits}% need=%{-ctqte::%arg-1%::need}%"

# Finishes an open lock-picking minigame as if the last pin was hit (computer-use tests can't time clicks).
command /zzctpick <player>:
	executable by: console
	trigger:
		ctPicked(arg-1)
		send "CTPICK %arg-1% stage=%{-ctjob::%uuid of arg-1%::stage}%"

# The components of a car menu icon (garage.sk carIcon).
command /zzcarflags <text> <text>:
	executable by: console
	trigger:
		set {_i} to carIcon(arg-1, arg-2)
		send "CARFLAGS %nbt of {_i}% flags=%item flags of {_i}%"
		set {_j} to ctOfferIcon(player("Explosde"), "basic", true)
		send "OFFER %nbt of {_j}%"


# ---------- Seasons (seasons.sk, progress.sk) ----------

# Fires a progress event as if it happened: /zzprog <player> <ev> <n> <detail>
command /zzprog <player> <text> <number> <text>:
	executable by: console
	trigger:
		progEvent(arg-1, arg-2, arg-3, arg-4)
		send "PROG %arg-1% %arg-2% %arg-3% %arg-4%"

# A player's season in one line.
command /zzseason <offline player>:
	executable by: console
	trigger:
		set {_u} to "%uuid of arg-1%"
		set {_s} to seasonNum()
		loop {-cfg::season::boards::*}:
			add "%loop-value%=%{ss::%{_s}%::%loop-value%::%{_u}%}%#%{-lb::rank::%loop-value%::%{_u}%}%" to {_o::*}
		set {_all} to join {_o::*} with " "
		set {_keys} to crateKeys(arg-1, "season")
		send "SEASON %arg-1% s=%{_s}% state=%{season::state}% %{_all}% points=%seasonPoints({_u})% ms=%{ss::%{_s}%::ms::%{_u}%}% mins=%{ss::%{_s}%::mins::%{_u}%}% keys=%{_keys}% line=%{-ph::season::%arg-1%}%"

# Sets a player's minutes played this season.
command /zzseasonmins <offline player> <number>:
	executable by: console
	trigger:
		set {ss::%seasonNum()%::mins::%uuid of arg-1%} to arg-2
		send "SEASONMINS %arg-1% %arg-2%"

# Wipes every season (tests only): back to no season at all, so the real first season is Season 1.
command /zzseasonwipe:
	executable by: console
	trigger:
		delete {season::*}
		delete {ss::*}
		delete {ssfinal::*}
		delete {seasonreward::*}
		delete {seasonreview::*}
		delete {seasonpaid::*}
		delete {seasonx::*}
		delete {seasoncos::*}
		delete {-lb::*}
		delete {-ph::lb::*}
		loadSettings()
		send "SEASONWIPE"

# Sets a heist's alarm wave number (a number, unlike /zzheistvar): /zzheistwave <heist> <n> (0 deletes it).
command /zzheistwave <text> <number>:
	executable by: console
	trigger:
		if arg-2 <= 0:
			delete {-heist::%arg-1%::wave}
		else:
			set {-heist::%arg-1%::wave} to arg-2
		send "HEISTWAVE %arg-1% %heistWave(arg-1)%"

# progress.sk (2026-09-27): a player's notes on one heist run ("<heist>#<run>").
command /zzrun <player> <text>:
	executable by: console
	trigger:
		set {_k} to "run::%arg-2%"
		set {_flag} to getData(arg-1, {_k})
		set {_out} to ""
		loop "own", "sold", "loud", "left", "touched", "guesses" and "car":
			set {_v} to getData(arg-1, "%{_k}%::%loop-value%")
			set {_out} to "%{_out}% %loop-value%=%{_v}%"
		send "RUN %arg-1% %arg-2% flag=%{_flag}%%{_out}%"

# progress.sk: forget a player's finished runs now (as after a sale).
command /zzprune <player>:
	executable by: console
	trigger:
		progRunPrune(arg-1)
		send "PRUNED %arg-1%"

# progress.sk: the week number; /zzweek <n> overrides it, /zzweek off goes back to the clock.
command /zzweek [<text>]:
	executable by: console
	trigger:
		if arg-1 is "off":
			delete {-prog::weekoverride}
		else if arg-1 is set:
			set {-prog::weekoverride} to arg-1 parsed as number
		send "WEEK %progWeek()% unix=%progUnix()%"

# progress.sk: a heist's heat; /zzheat <h> <week> <runs> sets that week's count.
command /zzheat <text> [<number>] [<number>]:
	executable by: console
	trigger:
		if arg-3 is set:
			set {heat::w::%arg-2%::%arg-1%} to arg-3
		set {_w} to progWeek()
		set {_c} to {heat::w::%{_w}%::%arg-1%}
		send "HEAT %arg-1% last=%{heat::last::%arg-1%}% lastrun=%{heat::lastrun::%arg-1%}% week=%{_c}%"

# progress.sk: set a run note (true/false, a number, or text): /zzrunset <player> <tag> <key> <value>
command /zzrunset <player> <text> <text> <text>:
	executable by: console
	trigger:
		if arg-4 is "true":
			progTagMark(arg-1, arg-2, arg-3, true)
		else if arg-4 is "false":
			progTagMark(arg-1, arg-2, arg-3, false)
		else if arg-4 parsed as number is set:
			progTagMark(arg-1, arg-2, arg-3, arg-4 parsed as number)
		else:
			progTagMark(arg-1, arg-2, arg-3, arg-4)
		send "RUNSET %arg-1% %arg-2% %arg-3% = %arg-4%"

# A car delivery as progress.sk sees it (jobs.sk, fence.sk): /zzctdeliver <player> <tier> <model> <took s> <misses>
command /zzctdeliver <player> <text> <text> <number> <number>:
	executable by: console
	trigger:
		set {_u} to "%uuid of arg-1%"
		set {-prog::ct::%{_u}%} to "%arg-3%|%arg-4%|%arg-5%"
		progEvent(arg-1, "contract", cfg("contract::%arg-2%::pay"), arg-2)
		delete {-prog::ct::%{_u}%}
		send "CTDELIVER %arg-1% %arg-2% %arg-3% took=%arg-4% misses=%arg-5%"


# fence.sk: pay the premium of the sales made so far (bag.sk calls fenceSalePay after a real sale).
command /zzfencepay <player>:
	executable by: console
	trigger:
		fenceSalePay(arg-1)
		send "FENCEPAY %arg-1%"

# pv.sk: a personal item display for a player at x y z: /zzpv <player> <key> <x> <y> <z>
command /zzpv <player> <text> <number> <number> <number>:
	executable by: console
	trigger:
		set {_l} to location(arg-3, arg-4, arg-5, world of arg-1)
		set {_e} to pvItem(arg-1, arg-2, {_l}, gold ingot, 1)
		if {_e} is set:
			send "PVITEM %arg-1% %arg-2% %uuid of {_e}%"
		else:
			send "PVITEM %arg-1% %arg-2% none"

# pv.sk: a display spawned WITHOUT the pv tag, then adopted (a leak: personal views must switch off).
command /zzpvleak <player>:
	executable by: console
	trigger:
		spawn an item display at location of arg-1:
			make event-display not persistent
			set item of event-display to gold ingot
		set {_e} to last spawned entity
		set {_r} to pvAdopt(arg-1, "leaktest", {_e})
		set {_ad} to false
		if {_r} is set:
			set {_ad} to true
		set {_va} to false
		if {_e} is valid:
			set {_va} to true
		send "PVLEAK %arg-1% adopted=%{_ad}% valid=%{_va}% ready=%pvReady()%"

# A contract offer (contracts.sk) for tests: "model|color|spot" or <none>.
command /zzctofferget <player> <text>:
	executable by: console
	trigger:
		send "CTOFFERGET %arg-1% %arg-2% %{-ctoffer::%uuid of arg-1%::%arg-2%}%"

# hits.sk windows for tests: /zzhitwin <tier> clear | <tier> <k> <unix> (a new unused window this week).
command /zzhitwin <text>:
	executable by: console
	trigger:
		set {_a::*} to arg-1 split at " "
		set {_w} to progWeek()
		if {_a::2} is "clear":
			delete {hit::win::%{_w}%::%{_a::1}%::*}
			delete {hit::used::%{_w}%::%{_a::1}%::*}
			delete {hit::open::%{_a::1}%}
		else:
			set {hit::win::%{_w}%::%{_a::1}%::%{_a::2}%} to {_a::3} parsed as number
			delete {hit::used::%{_w}%::%{_a::1}%::%{_a::2}%}
		send "HITWIN %arg-1% W=%{_w}%"

# Forgets which level rewards a player got (levels.sk marks each one given; tests start over).
command /zzlvlrewards <offline player>:
	executable by: console
	trigger:
		delete {data::%arg-1%::lvlreward::*}
		send "LVLREWARDS %arg-1% cleared"

# A car-crate roll pool for tests (garage.sk carRoll): /zzcarpool <pool> <cars "w|car;..."> <wraps "w|tier;..."> <stages "w|stage;..."> <neon 0-1> <trail 0-1>
command /zzcarpool <text> <text> <text> <text> <number> <number>:
	executable by: console
	trigger:
		set {-cfg::carroll::%arg-1%::cars::*} to arg-2 split at ";"
		set {-cfg::carroll::%arg-1%::wraps::*} to arg-3 split at ";"
		set {-cfg::carroll::%arg-1%::stages::*} to arg-4 split at ";"
		set {-cfg::carroll::%arg-1%::neon} to arg-5
		set {-cfg::carroll::%arg-1%::trail} to arg-6
		set {-cfg::carroll::%arg-1%::special-color} to 0
		send "CARPOOL %arg-1% roll=%carRoll(arg-1)%"

# A heist's clock and its saved reopen time, in seconds from now (-1 = none): /zzheistreopen <id>
command /zzheistreopen <text>:
	executable by: console
	trigger:
		set {_u} to -1
		if {-heist::%arg-1%::until} is set:
			set {_u} to round((difference between now and {-heist::%arg-1%::until}) / 1 second)
			if {-heist::%arg-1%::until} < now:
				set {_u} to 0 - {_u}
		set {_r} to -1
		if {heist::%arg-1%::reopen} is set:
			set {_r} to round((difference between now and {heist::%arg-1%::reopen}) / 1 second)
			if {heist::%arg-1%::reopen} < now:
				set {_r} to 0 - {_r}
		send "REOPEN %arg-1% state=%heistState(arg-1)% until=%{_u}% reopen=%{_r}% rushed=%{-heist::%arg-1%::rushed}%"

# garage.sk's climb out of the water on a car, as if its driver held forward: /zzcarclimb <plate>
command /zzcarclimb <text>:
	executable by: console
	trigger:
		set {_main} to "MTVEHICLES_MAIN_%arg-1%"
		loop all armor stands:
			if name of loop-entity is {_main}:
				carClimbOut(loop-entity)
				set {_l} to location of loop-entity
		send "CLIMB %arg-1% at=%{_l}%"

# A text from a contact, as story.sk's storyText sends it (and messages.sk keeps it): /zztext <player> <from> <text>
command /zztext <player> <text> <text>:
	executable by: console
	trigger:
		storyText(arg-1, arg-2, arg-3)
		send "TEXT %arg-1% n=%msgNewest(arg-1)% unread=%msgUnreadAll(arg-1)%"

# Forgets a player's texts: /zzinboxclear <player>
command /zzinboxclear <player>:
	executable by: console
	trigger:
		delete {data::%arg-1%::inbox::*}
		delete {data::%arg-1%::inbox-seen::*}
		deleteData(arg-1, "inbox-n")
		send "INBOX %arg-1% cleared"
