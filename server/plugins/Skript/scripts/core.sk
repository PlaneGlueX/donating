	set {-cfg::story::c4_big::obj} to "ev|sell|10000|d4"
	set {-cfg::story::c4_big::gps} to "heist:d4"
	set {-cfg::story::c4_big::needs} to "d4"
	set {-cfg::story::c4_big::brief} to "The big banks. Bring back $10,000 from the hardest heists."
	set {-cfg::story::c4_big::done} to "That's serious money."
