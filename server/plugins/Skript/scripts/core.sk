	set {-cfg::story::c4_end::brief} to "It's time. Come to the Safehouse."
	set {-cfg::story::c4_end::talk::*} to "One more job. The biggest this city has seen." and "A safe, a vault, and out past the cops. All in one run."
	set {-cfg::story::c4_end::rewards::*} to "money|15000", "xp|500" and "key|season|1"
	set {-cfg::story::c5_finale::chapter} to 5
