# core.sk: shared settings, money formatting, player data and helper functions.
#
# SETTINGS: every tunable number is in loadSettings() below.
# Skript options ({@x}) only work inside the file that defines them, so shared numbers live in
# memory-only {-cfg::*} variables instead. Read them with {-cfg::bag::1::capacity} or cfg("bag::1::capacity").
# After editing a number: /sk reload core
#
# PLAYER DATA: saved per player under {data::<uuid>::<key>} (Skript stores player UUIDs in variable names).
#   Balance is NOT a variable: it's the EssentialsX economy through Vault ("balance of player").
#   Keys used so far:
#     first-join   date of first join
#     passive      true while in passive mode
#     bounty       current bounty ($)
#     bag-tier     bag tier the player carries now (0 or unset = no bag; death.sk deletes it)
#     bag-best     highest bag tier unlocked (a lost bag's tier stays unlocked)
#     wpn::<W>     true once weapon W (a WeaponMechanics title) is unlocked (shop.sk)
#     loadout::<n> saved loadout for hotbar n (1-5): "wpn:<W>", "con:<W>"; loadout::<n>::count
#   Server stats (saved): {stats::unique-joins} = players who ever joined (join-quit.sk).

on load:
	loadSettings()

function loadSettings():
	delete {-cfg::*}

	# ---------- Messages ----------
	# &r after bold matters: Skript's formatter keeps bold across later color codes.
	set {-cfg::prefix} to "&6&lDONATING&r &8» &7"

	# ---------- Timers (decided in CLAUDE.md unless marked PROPOSAL) ----------
	set {-cfg::afk::after} to 5 minutes
	set {-cfg::chat::cooldown} to 2 seconds # PROPOSAL
	set {-cfg::chat::tip-interval} to 5 minutes # PROPOSAL
	set {-cfg::combat::tag} to 15 seconds # PROPOSAL (combat-tag length isn't set yet)
	set {-cfg::combat::player-hit-priority} to 5 seconds
	# Commands a combat-tagged player can't use (combat-log.sk), without the slash.
	set {-cfg::combat::blocked-commands::*} to "spawn", "home", "homes", "warp", "warps", "tpa", "tpahere", "tpaccept", "tpyes", "back", "tp", "tphere", "rtp" and "hub"
	set {-cfg::pvp::spawn-shield} to 10 seconds
	# WorldGuard regions whose id starts with this are safe zones (pvp.sk).
	set {-cfg::pvp::safe-prefix} to "safe"
	set {-cfg::passive::switch-cooldown} to 10 minutes
	set {-cfg::bounty::repeat-kill-window} to 15 minutes
	set {-cfg::duffel::despawn} to 2 minutes
	set {-cfg::alarm::warning} to 20 seconds
	set {-cfg::alarm::wave-interval} to 10 seconds
	set {-cfg::alarm::max-cops} to 6
	set {-cfg::alarm::chase-radius} to 100
	# ---------- Cops (cops.sk, Citizens + Sentinel): ALL PROPOSALS ----------
	# Each alarm wave brings per-wave cops, up to the heist's cap: C = alarm::max-cops + max(0, R - 3) ×
	# alarm::cops-per-extra-robber, R = the players the alarm hunts (owner, 2026-09-26: +2 per robber
	# above 3, no cap on the whole server). health / damage are HP (20 = a full player); attack-rate in
	# seconds between shots; range = how far they shoot; chase = how far from where they spawned they
	# follow; accuracy 0 = perfect, 5 = poor; speed × a player's walk. model = the WeaponMechanics skin
	# their gun shows; the gun fires arrows (Sentinel treats it as a bow).
	set {-cfg::alarm::cops-per-extra-robber} to 2
	set {-cfg::cop::per-wave} to 2
	set {-cfg::cop::name} to "Cop"
	set {-cfg::cop::range} to 30
	set {-cfg::cop::chase} to 120
	# Stronger heists, stronger cops with better guns (owner, 2026-09-26). Per difficulty 1-4: health,
	# damage per shot, seconds between shots, accuracy, speed, gun (9 .50 GS, 1 Uzi, 5 AK-47).
	set {-cfg::difficulty::1::cop-health} to 16
	set {-cfg::difficulty::1::cop-damage} to 2
	set {-cfg::difficulty::1::cop-attack-rate} to 2
	set {-cfg::difficulty::1::cop-accuracy} to 2.5
	set {-cfg::difficulty::1::cop-speed} to 1.1
	set {-cfg::difficulty::1::cop-model} to 9
	set {-cfg::difficulty::2::cop-health} to 20
	set {-cfg::difficulty::2::cop-damage} to 2.5
	set {-cfg::difficulty::2::cop-attack-rate} to 1.75
	set {-cfg::difficulty::2::cop-accuracy} to 2
	set {-cfg::difficulty::2::cop-speed} to 1.2
	set {-cfg::difficulty::2::cop-model} to 9
	set {-cfg::difficulty::3::cop-health} to 26
	set {-cfg::difficulty::3::cop-damage} to 3
	set {-cfg::difficulty::3::cop-attack-rate} to 1.5
	set {-cfg::difficulty::3::cop-accuracy} to 1.5
	set {-cfg::difficulty::3::cop-speed} to 1.25
	set {-cfg::difficulty::3::cop-model} to 1
	set {-cfg::difficulty::4::cop-health} to 32
	set {-cfg::difficulty::4::cop-damage} to 4
	set {-cfg::difficulty::4::cop-attack-rate} to 1.25
	set {-cfg::difficulty::4::cop-accuracy} to 1
	set {-cfg::difficulty::4::cop-speed} to 1.3
	set {-cfg::difficulty::4::cop-model} to 5
	# Killing cops (owner, 2026-09-26): every cop-bounty-every cops a player kills add cop-bounty to their
	# bounty (never for passive players). Shooting a cop makes you wanted (cops.sk).
	set {-cfg::cop::bounty-every} to 4
	set {-cfg::cop::bounty} to 100
	# The police skin (tools\make-cop-skin.js), signed once by MineSkin (Citizens: npc skin --file police.png, then
	# its saves.yml skintrait textureRaw / signature). "" = Citizens uses the skin of the account named cop::name.
	set {-cfg::cop::skin-texture} to ""
	set {-cfg::cop::skin-signature} to ""
	set {-cfg::car::idle-despawn} to 5 minutes
	set {-cfg::car::other-car-despawn} to 1 minute

	# ---------- Cars (garage.sk, car-cleanup.sk): PROPOSALS ----------
	# Owner, 2026-09-26: cars are a mid-game goal (no starter car; the cheapest about $40,000 at level 2, the
	# best about $1M at level 6). A model is bought once, in a color; it can be repainted in the garage.
	# colors: "Label=MTV uuid=itemDamage" (server\plugins\MTVehicles\vehicles.yml; every uuid there is used here;
	# the damage picks the model in the pack, for the menu icons).
	# crate = only from crates (never sold at the dealer); a crate car needs no level.
	set {-cfg::cars::*} to "sedan", "sportsedan", "jeep", "sports", "hotrod", "suv", "vandal", "specter" and "overclock"
	set {-cfg::car::sedan::name} to "Sedan"
	set {-cfg::car::sedan::price} to 40000
	set {-cfg::car::sedan::level} to 2
	set {-cfg::carcolors::sedan::*} to "Red=GKAH5U=1017", "Gray=BV3W2A=1019", "Black=FFW36Q=1111", "Navy=7JWQYB=1003" and "Beige=58UUXF=1110"
	set {-cfg::car::sportsedan::name} to "Sport Sedan"
	set {-cfg::car::sportsedan::price} to 90000
	set {-cfg::car::sportsedan::level} to 3
	set {-cfg::carcolors::sportsedan::*} to "Obsidian=KG59SJ=1116", "Emerald=RBG6HW=1115" and "Quartz=7BEQ5K=1023"
	set {-cfg::car::jeep::name} to "Jeep"
	set {-cfg::car::jeep::price} to 150000
	set {-cfg::car::jeep::level} to 3
	set {-cfg::carcolors::jeep::*} to "Blue=G2KQ4V=1073" and "Gold=5Z95XA=1074"
	set {-cfg::car::sports::name} to "Sports Car"
	set {-cfg::car::sports::price} to 250000
	set {-cfg::car::sports::level} to 4
	set {-cfg::carcolors::sports::*} to "White=5CD8N4=1060", "Black=W32FND=1070", "Orange=8CUSCG=1068", "Navy=SMV4M6=1002" and "Flame Red=LHBM2X=1063"
	set {-cfg::car::hotrod::name} to "Hotrod"
	set {-cfg::car::hotrod::price} to 450000
	set {-cfg::car::hotrod::level} to 5
	set {-cfg::carcolors::hotrod::*} to "Red=CJF7WX=1006", "Black=6GBKXT=1161" and "Blue=2FWFAS=1159"
	set {-cfg::car::suv::name} to "SUV"
	set {-cfg::car::suv::price} to 1000000
	set {-cfg::car::suv::level} to 6
	set {-cfg::carcolors::suv::*} to "Black=FC98KS=1141", "White=88WPRU=1139" and "Criminal=5R7QP3=1220"
	# The crate cars (crates.sk car lines use these ids): looks only, they drive like their family.
	set {-cfg::car::vandal::name} to "Vandal"
	set {-cfg::car::vandal::crate} to true
	set {-cfg::carcolors::vandal::*} to "Diamond=6FHXGA=1069"
	set {-cfg::car::specter::name} to "Specter"
	set {-cfg::car::specter::crate} to true
	set {-cfg::carcolors::specter::*} to "Rainbow=XJ4Q29=1027"
	set {-cfg::car::overclock::name} to "Overclock"
	set {-cfg::car::overclock::crate} to true
	set {-cfg::carcolors::overclock::*} to "Gold=6WDK7U=1158"
	# Repainting an owned car (another color of its model) in the garage.
	set {-cfg::car::paint-price} to 2500
	# Calling your car to you from the garage: once per this long, and never while in combat.
	set {-cfg::car::call-cooldown} to 20 seconds
	# How far a player may be from a car they send back or lock from the garage menu (0 = anywhere).
	set {-cfg::car::lock-range} to 0
	# Regions whose id starts with this are no-lock zones (car spawn areas): no locking there.
	set {-cfg::car::nolock-prefix} to "nolock"
	# Owner, 2026-09-26: cars are the getaway, but the cops' chase radius is this many times bigger while
	# the hunted robber is in a car (heists.sk heistInRange).
	set {-cfg::alarm::car-chase-factor} to 2
	set {-cfg::lockpick::max-fails} to 3

	# ---------- Car-theft contracts (contracts.sk): PROPOSALS ----------
	# Owner, 2026-09-26: steal a car with a lockpick, drive it to a chop shop for cash; the car is never
	# kept (and no NPC cars at spawn areas). Three tiers; each offers a car of its list at a staff spot.
	set {-cfg::contract::tiers::*} to "basic", "pro" and "master"
	set {-cfg::contract::basic::name} to "Street job"
	set {-cfg::contract::basic::level} to 1
	set {-cfg::contract::basic::pay} to 3000
	set {-cfg::contract::basic::xp} to 30
	set {-cfg::contract::basic::qte-hits} to 3
	set {-cfg::contract::basic::qte-step} to 4
	set {-cfg::contractcars::basic::*} to "sedan" and "sportsedan"
	set {-cfg::contract::pro::name} to "Pro job"
	set {-cfg::contract::pro::level} to 3
	set {-cfg::contract::pro::pay} to 9000
	set {-cfg::contract::pro::xp} to 60
	set {-cfg::contract::pro::qte-hits} to 3
	set {-cfg::contract::pro::qte-step} to 3
	set {-cfg::contractcars::pro::*} to "jeep" and "sports"
	set {-cfg::contract::master::name} to "Master job"
	set {-cfg::contract::master::level} to 5
	set {-cfg::contract::master::pay} to 25000
	set {-cfg::contract::master::xp} to 120
	set {-cfg::contract::master::qte-hits} to 4
	set {-cfg::contract::master::qte-step} to 3
	set {-cfg::contractcars::master::*} to "hotrod" and "suv"
	# Lockpicks (quest items in hotbar 6-8, kept on death): one per tier, lockpick::max-fails misses break one.
	set {-cfg::lockpick::basic::name} to "Basic Lockpick"
	set {-cfg::lockpick::basic::price} to 500
	set {-cfg::lockpick::pro::name} to "Pro Lockpick"
	set {-cfg::lockpick::pro::price} to 1500
	set {-cfg::lockpick::master::name} to "Master Lockpick"
	set {-cfg::lockpick::master::price} to 4000
	set {-cfg::lockpick::max} to 3
	# A contract lasts this long; after one (done, failed or dropped) the next waits this long.
	set {-cfg::contract::time} to 10 minutes
	set {-cfg::contract::cooldown} to 3 minutes
	# Offers are made again this often (per player).
	set {-cfg::contract::refresh} to 10 minutes
	# The lock-picking minigame (like the drill's, loot.sk): the marker moves one slot every qte-step
	# ticks; clicks are ignored this many ticks after a hit / a miss.
	set {-cfg::contract::qte-hit-lock} to 6
	set {-cfg::contract::qte-miss-lock} to 10
	# Chop shops (staff: /dcontract chop add): the stolen car counts as delivered within this many blocks.
	set {-cfg::contract::chop-radius} to 6
	# Car spots and chop shops at least this far apart (/dcontract refuses closer ones).
	set {-cfg::contract::min-distance} to 50

	# ---------- Quest givers (quests.sk): PROPOSAL names ----------
	# Owner, 2026-09-26: quests are given in person by an NPC at a place (e.g. a scrap yard). Per kind: what it
	# gives (under the NPC's name), the NPC's name ("{place}" = the giver's place), the default place name,
	# and what it holds. Jobs and their tools only within quest::reach blocks of a giver of that kind.
	set {-cfg::quests::*} to "contracts"
	set {-cfg::quest::contracts::name} to "Car contracts"
	set {-cfg::quest::contracts::npc} to "{place} Boss"
	set {-cfg::quest::contracts::place} to "Scrap Yard"
	set {-cfg::quest::contracts::hold} to "flint"
	set {-cfg::quest::contracts::hold-model} to "donating:lockpick_basic"
	set {-cfg::quest::reach} to 6

	# ---------- Seasons (seasons.sk): PROPOSAL numbers ----------
	# Owner, 2026-09-27: seasons, three leaderboards with different metrics, prizes for the top; earned titles
	# can't be traded; farming loops closed (Heist Refresh runs count as normal); rank perks count.
	set {-cfg::season::days} to 28
	set {-cfg::season::auto} to true
	set {-cfg::season::boards::*} to "earners", "heisters" and "wheelmen"
	set {-cfg::season::board::earners::name} to "Top Earners"
	set {-cfg::season::board::earners::short} to "Earner"
	set {-cfg::season::board::earners::icon} to gold ingot
	set {-cfg::season::board::earners::what} to "Money from loot sold and car contracts."
	set {-cfg::season::board::heisters::name} to "Master Thieves"
	set {-cfg::season::board::heisters::short} to "Thief"
	set {-cfg::season::board::heisters::icon} to iron door
	set {-cfg::season::board::heisters::what} to "Heist skill: runs, safes, vaults, getaways."
	set {-cfg::season::board::wheelmen::name} to "Wheelmen"
	set {-cfg::season::board::wheelmen::short} to "Wheelman"
	set {-cfg::season::board::wheelmen::icon} to minecart
	set {-cfg::season::board::wheelmen::what} to "Car contracts delivered (Street, Pro, Master)."
	# Master Thieves: a heist run pays up to points, reached once full ($) of its loot is sold (difficulty 1-4,
	# about half the bag typical at that level): a bigger bag (a rank's too) reaches it in fewer trips.
	set {-cfg::season::heist::1::points} to 25
	set {-cfg::season::heist::1::full} to 1000
	set {-cfg::season::heist::2::points} to 50
	set {-cfg::season::heist::2::full} to 3000
	set {-cfg::season::heist::3::points} to 90
	set {-cfg::season::heist::3::full} to 7500
	set {-cfg::season::heist::4::points} to 150
	set {-cfg::season::heist::4::full} to 20000
	set {-cfg::season::points::safe} to 10
	set {-cfg::season::points::vault} to 25
	set {-cfg::season::points::getaway} to 40
	# Wheelmen: points per contract tier.
	set {-cfg::season::contract::basic::points} to 20
	set {-cfg::season::contract::pro::points} to 40
	set {-cfg::season::contract::master::points} to 80
	# Prizes per place on every board (#1, #2-3, #4-10): money and Season keys (and the board's title).
	set {-cfg::season::prize::1::money} to 25000
	set {-cfg::season::prize::1::keys} to 3
	set {-cfg::season::prize::3::money} to 10000
	set {-cfg::season::prize::3::keys} to 2
	set {-cfg::season::prize::10::money} to 5000
	set {-cfg::season::prize::10::keys} to 1
	# Prizes need this many hours played this season (not AFK); they're paid this long after the end (a check).
	set {-cfg::season::min-hours} to 5
	set {-cfg::season::review-hours} to 48
	# Free milestones on season points (Master Thieves + Wheelmen): "points|Season keys[|veteran]".
	set {-cfg::season::milestones::*} to "500|1", "2000|1", "5000|2" and "10000|3|veteran"

	# ---------- Trading (trade.sk): PROPOSAL numbers ----------
	# Owner, 2026-09-26: cars and crate cosmetics, in person, no tax; the server never moves money.
	# Players trade within trade::reach blocks of each other; a request lasts trade::request-time; both being
	# ready starts a countdown of trade::countdown seconds (anything changing stops it).
	set {-cfg::trade::reach} to 5
	set {-cfg::trade::request-time} to 30 seconds
	set {-cfg::trade::countdown} to 5

	# ---------- GPS (gps.sk; the phone plugin finds the way along the roads: CLAUDE.md "GPS") ----------
	# Decided (the owner left the GPS numbers to Claude, 2026-09-26), with the plugin's costs and colors.
	# A pin counts as reached within this many blocks (then it's cleared); the base while carrying loot too.
	set {-cfg::gps::pin-radius} to 8
	set {-cfg::gps::base-radius} to 10

	# ---------- Multipliers (decided) ----------
	set {-cfg::passive::payout-multiplier} to 0.75
	set {-cfg::bounty::robbery-share} to 0.10

	# ---------- Navigation (nav.sk) ----------
	# The city map the phones show is set in plugins\DonatingPhone\config.yml (city-maps), not here.
	# How far a passive player's green locator-bar dot reaches (blocks). Non-passive players send none.
	set {-cfg::nav::passive-range} to 100000
	# Points of interest on the locator bar (nav.sk, /dpoi): types and their dot colors (the names Minecraft's
	# /waypoint command takes). PROPOSAL. Heists get their difficulty's waypoint color while open or running.
	set {-cfg::poi::types::*} to "base", "shop", "spawn" and "landmark"
	set {-cfg::poi::base::color} to "aqua"
	set {-cfg::poi::shop::color} to "yellow"
	set {-cfg::poi::spawn::color} to "white"
	set {-cfg::poi::landmark::color} to "light_purple"
	# Quest givers (quests.sk) get a dot of their own, not listed in /dpoi's types.
	set {-cfg::poi::quest::color} to "blue"
	set {-cfg::poi::range} to 60000000
	set {-cfg::difficulty::1::waypoint} to "green"
	set {-cfg::difficulty::2::waypoint} to "yellow"
	set {-cfg::difficulty::3::waypoint} to "gold"
	set {-cfg::difficulty::4::waypoint} to "dark_red"

	# ---------- Death loss: L = min(B × p, C) ----------
	# p per heist difficulty. Player/trap deaths: 1-5%. Cop deaths: 5-10%.
	# Deaths outside a heist use difficulty 1 and the player's bag capacity.
	set {-cfg::difficulty::1::name} to "Easy"
	set {-cfg::difficulty::1::p} to 0.01
	set {-cfg::difficulty::1::cop-p} to 0.05
	set {-cfg::difficulty::2::name} to "Medium"
	set {-cfg::difficulty::2::p} to 0.02
	set {-cfg::difficulty::2::cop-p} to 0.06
	set {-cfg::difficulty::3::name} to "Hard"
	set {-cfg::difficulty::3::p} to 0.035
	set {-cfg::difficulty::3::cop-p} to 0.08
	set {-cfg::difficulty::4::name} to "Advanced"
	set {-cfg::difficulty::4::p} to 0.05
	set {-cfg::difficulty::4::cop-p} to 0.10

	# ---------- Money: ALL PROPOSALS, waiting for the owner ----------
	# Start money (owner, 2026-09-26: more, and the first-join tutorial makes you buy a bag with it:
	# tutorial.sk). $5,000 = the Gym Bag ($2,400) + a .50 GS ($1,500) + ammo.
	set {-cfg::money::start} to 5000
	# Bag tiers: capacity = the most loot value ($) the bag holds. Owner, 2026-09-26: unlocking a tier
	# costs 120% of what it holds (price = 1.2 × capacity), a new one after losing it 20% (replace below).
	set {-cfg::bag::1::name} to "Gym Bag"
	set {-cfg::bag::1::capacity} to 2000
	set {-cfg::bag::1::price} to 2400
	set {-cfg::bag::2::name} to "Duffel Bag"
	set {-cfg::bag::2::capacity} to 6000
	set {-cfg::bag::2::price} to 7200
	set {-cfg::bag::3::name} to "Hockey Bag"
	set {-cfg::bag::3::capacity} to 15000
	set {-cfg::bag::3::price} to 18000
	set {-cfg::bag::4::name} to "Armored Duffel"
	set {-cfg::bag::4::capacity} to 40000
	set {-cfg::bag::4::price} to 48000
	set {-cfg::bag::5::name} to "Vault Bag"
	set {-cfg::bag::5::capacity} to 100000
	set {-cfg::bag::5::price} to 120000
	# The first-join tutorial (tutorial.sk): a player without a bag can't leave the WorldGuard region
	# whose id starts with this (the spawn safe zone: create it as safe_spawn) until they buy one.
	set {-cfg::tutorial::region} to "safe_spawn"
	# Default loot pool per difficulty (each heist can override its own).
	set {-cfg::difficulty::1::loot-pool} to 3000
	set {-cfg::difficulty::2::loot-pool} to 12000
	set {-cfg::difficulty::3::loot-pool} to 40000
	set {-cfg::difficulty::4::loot-pool} to 120000

	# ---------- Heists (heists.sk) ----------
	# WorldGuard regions "heist_<id>" are heists (staff define them with /dheist).
	set {-cfg::heist::region-prefix} to "heist_"
	# When the escape clock starts: "rob" = at the first robbery (owner, 2026-09-25; loot.sk calls
	# heistStartRun at the first piece taken, glass smashed, safe cracked or drill mounted), "enter" = at
	# the first robber's entry.
	set {-cfg::heist::start-on} to "rob"
	# PROPOSAL: with less than this left, the doors are locked (nobody new can still rob anything).
	set {-cfg::heist::entry-cutoff} to 20 seconds
	# PROPOSAL: chat warnings at these seconds left.
	set {-cfg::heist::warn-at::*} to 60, 30 and 10
	# "The Bank is open!" / "The Bank is closed." to everyone. The only heist chat everyone gets (owner,
	# 2026-09-26): the rest (the clock, warnings, the alarm) goes only to the robbers inside.
	set {-cfg::heist::announce} to true
	# Room resets place one section of at most this many blocks per side per second.
	set {-cfg::heist::reset-section} to 32
	# Largest room a heist may save (blocks). SkBee keeps saved rooms in memory.
	set {-cfg::heist::snapshot-max} to 100000
	# Hologram height above the spot staff stand on.
	set {-cfg::heist::holo-height} to 2.5
	# Escape countdown E and cooldown K per difficulty (owner picked "medium", 2026-09-25). Each heist
	# can override them (/dheist set <id> escape|cooldown <seconds>). The most one heist can put into
	# the game per hour: F = P × 60 / (E + K), with P = its loot per run and E, K in minutes.
	set {-cfg::difficulty::1::escape} to 4 minutes
	set {-cfg::difficulty::2::escape} to 6 minutes
	set {-cfg::difficulty::3::escape} to 8 minutes
	set {-cfg::difficulty::4::escape} to 10 minutes
	set {-cfg::difficulty::1::cooldown} to 6 minutes
	set {-cfg::difficulty::2::cooldown} to 10 minutes
	set {-cfg::difficulty::3::cooldown} to 15 minutes
	set {-cfg::difficulty::4::cooldown} to 30 minutes
	# PROPOSAL: robber level needed (levels.sk; 0 = anyone). Each heist can override it (/dheist set <id>
	# level <n>).
	set {-cfg::difficulty::1::level} to 0
	set {-cfg::difficulty::2::level} to 1
	set {-cfg::difficulty::3::level} to 2
	set {-cfg::difficulty::4::level} to 3
	# Advanced heists have an alarm (decided: only advanced heists).
	set {-cfg::difficulty::1::advanced} to false
	set {-cfg::difficulty::2::advanced} to false
	set {-cfg::difficulty::3::advanced} to false
	set {-cfg::difficulty::4::advanced} to true
	# PvP heists: no crew rule inside, no passive players (per heist: /dheist set <id> pvp true).
	set {-cfg::difficulty::1::pvp-only} to false
	set {-cfg::difficulty::2::pvp-only} to false
	set {-cfg::difficulty::3::pvp-only} to false
	set {-cfg::difficulty::4::pvp-only} to false
	set {-cfg::difficulty::1::color} to "&a"
	set {-cfg::difficulty::2::color} to "&e"
	set {-cfg::difficulty::3::color} to "&6"
	set {-cfg::difficulty::4::color} to "&4"
	# Trap damage m per difficulty (PROPOSAL): a hit does D = max(1, round(d × 2 × m)) / 2 hearts, d = the
	# trap's damage below (or its own damage=). Per heist: /dheist set <id> trap-damage <m>.
	set {-cfg::difficulty::1::trap-damage} to 1.0
	set {-cfg::difficulty::2::trap-damage} to 1.25
	set {-cfg::difficulty::3::trap-damage} to 1.5
	set {-cfg::difficulty::4::trap-damage} to 1.75

	# ---------- Traps (traps.sk): ALL PROPOSALS ----------
	set {-cfg::trap::max-per-heist} to 40      # one display per laser/camera: caps entities and the index
	set {-cfg::trap::cell} to 4                # index cell size (blocks)
	set {-cfg::trap::step} to 0.5              # max blocks between path samples (the hit window is 0.56)
	set {-cfg::trap::max-samples} to 16        # a fall is up to 3.9 blocks per tick
	set {-cfg::trap::grace} to 0.05            # hitbox shrink per side: grazes are forgiven
	set {-cfg::trap::lead} to 4 ticks          # a blinking beam shows this long before it can hurt (ping)
	# Traps hurt, not kill (owner, 2026-09-25). A trap hits on each new touch (off it longer than rearm),
	# never twice within min-gap; lasers again every `every` while you stay in them, plates once per step.
	set {-cfg::trap::rearm} to 4 ticks
	set {-cfg::trap::min-gap} to 10 ticks
	set {-cfg::trap::alarm-repeat} to 2 seconds
	set {-cfg::trap::show-time} to 20 seconds  # /dtrap show
	set {-cfg::trap::laser::effect} to "damage"
	set {-cfg::trap::laser::damage} to 3        # hearts per hit (10 = full health), × trap-damage
	set {-cfg::trap::laser::every} to 1 second # again while you stay in the beam
	set {-cfg::trap::laser::thickness} to 0.06
	set {-cfg::trap::laser::max-length} to 32
	set {-cfg::trap::laser::view-range} to 1.0
	# "laser here" heights above the feet: low = jump it, mid = a timed jump, high = sneak under it.
	set {-cfg::trap::laser::low} to 0.4
	set {-cfg::trap::laser::mid} to 1.0
	set {-cfg::trap::laser::high} to 1.65
	set {-cfg::trap::laser::blink} to false
	set {-cfg::trap::laser::on} to 2 seconds   # a 4 s rhythm is learnable in one cycle
	set {-cfg::trap::laser::off} to 2 seconds
	set {-cfg::trap::laser::offset} to 0 seconds
	set {-cfg::trap::plate::effect} to "damage"
	set {-cfg::trap::plate::damage} to 4        # once per step
	set {-cfg::trap::floor::effect} to "damage"
	set {-cfg::trap::floor::damage} to 4        # then back on the last solid ground you stood on
	set {-cfg::trap::floor::delay} to 10 ticks     # walking over a 1-wide strip takes 0.35 s: keep moving
	set {-cfg::trap::floor::restore} to 10 seconds # 0 = stays down until the room reset
	set {-cfg::trap::floor::drop} to 1.0
	set {-cfg::trap::floor::depth} to 4
	set {-cfg::trap::floor::max-tiles} to 64
	set {-cfg::trap::camera::effect} to "alarm"
	set {-cfg::trap::camera::angle} to 30          # half-angle: a 60° cone
	set {-cfg::trap::camera::range} to 12
	set {-cfg::trap::camera::sneak-range} to 0.5   # sneaking halves the range
	set {-cfg::trap::camera::grace} to 1 second    # seen this long -> it trips
	set {-cfg::trap::camera::turret-grace} to 1 second # effect=damage: seen this long -> the first shot
	set {-cfg::trap::camera::damage} to 1.5     # per turret shot
	set {-cfg::trap::camera::every} to 0.5 seconds # a turret shoots again this often while it sees you
	set {-cfg::trap::camera::sweep} to 0
	set {-cfg::trap::camera::period} to 8 seconds
	set {-cfg::trap::camera::pointer} to true
	set {-cfg::trap::camera::thickness} to 0.05
	# Trap death messages: {name}, {heist} are filled in.
	set {-cfg::trap::death::laser} to "&c{name} &7walked into a laser in the &f{heist}&7."
	set {-cfg::trap::death::plate} to "&c{name} &7stepped on a trap in the &f{heist}&7."
	set {-cfg::trap::death::floor} to "&c{name} &7fell through a trapped floor in the &f{heist}&7."
	set {-cfg::trap::death::camera} to "&c{name} &7was shot by a security turret in the &f{heist}&7."

	# ---------- Loot (loot.sk): ALL PROPOSALS ----------
	# Hold right-click on loot: each click credits min(Δt, credit) seconds (Δt = time since your last
	# click on it); a pause longer than gap starts over. A held button clicks every 0.2 s, so holding is
	# real time and clicking faster gains nothing.
	set {-cfg::loot::reach} to 4.5               # eye to the loot's hitbox (the client clicks within 3)
	set {-cfg::loot::credit} to 0.3              # seconds, at most, per click
	set {-cfg::loot::gap} to 1                   # seconds: a longer pause resets the progress
	set {-cfg::loot::guard} to 0.5 seconds       # no gun shot or phone toggle this long after a loot click
	set {-cfg::loot::claim-range} to 8           # a head start ends when its owner walks this far away
	# Cleaned out (owner, 2026-09-25): every pile empty while the clock runs -> the time left T becomes
	# T' = max(min, ceil(T × factor)); with T at or under min it doesn't change. min 0 = off.
	set {-cfg::loot::cleaned-out} to 60          # min, seconds
	set {-cfg::loot::cleaned-out-factor} to 0.5
	set {-cfg::loot::partial} to true            # less room than a piece: take what fits, the piece shrinks
	set {-cfg::loot::prompt-range} to 3.5
	set {-cfg::loot::piece-view} to 0.5          # display view range (× 64 blocks)
	set {-cfg::loot::marker-view} to 1.0
	set {-cfg::loot::max-spots} to 24            # per heist
	set {-cfg::loot::max-cells} to 12            # per pile
	set {-cfg::loot::max-pieces} to 24           # per pile
	set {-cfg::loot::max-heist-pieces} to 150
	set {-cfg::loot::max-gate-blocks} to 27
	# Pile styles: what a piece looks like and is worth. A pile's value V = n × piece with n rolled at
	# every opening between ceil(min / piece) and floor(max / piece) (/dloot add ... value=MIN-MAX).
	# Rate r = piece / take ($ per second of holding); a bag of capacity C fills in C / r seconds.
	set {-cfg::loot::styles::*} to "cash", "jewel", "gold", "goods" and "art"
	set {-cfg::loot::cash::name} to "Cash stack"
	set {-cfg::loot::cash::piece} to 100
	set {-cfg::loot::cash::take} to 0.8
	set {-cfg::loot::cash::item} to paper
	set {-cfg::loot::cash::per-cell} to 4
	set {-cfg::loot::cash::layers} to 2
	set {-cfg::loot::cash::thick} to 0.06
	set {-cfg::loot::cash::scale} to 0.45
	set {-cfg::loot::jewel::name} to "Jewels"
	set {-cfg::loot::jewel::piece} to 250
	set {-cfg::loot::jewel::take} to 1.0
	set {-cfg::loot::jewel::item} to diamond
	set {-cfg::loot::jewel::per-cell} to 4
	set {-cfg::loot::jewel::layers} to 1
	set {-cfg::loot::jewel::thick} to 0.04
	set {-cfg::loot::jewel::scale} to 0.35
	set {-cfg::loot::gold::name} to "Gold bar"
	set {-cfg::loot::gold::piece} to 500
	set {-cfg::loot::gold::take} to 1.5
	set {-cfg::loot::gold::item} to gold ingot
	set {-cfg::loot::gold::per-cell} to 2
	set {-cfg::loot::gold::layers} to 2
	set {-cfg::loot::gold::thick} to 0.12
	set {-cfg::loot::gold::scale} to 0.5
	set {-cfg::loot::goods::name} to "Valuables"
	set {-cfg::loot::goods::piece} to 200
	set {-cfg::loot::goods::take} to 1.0
	set {-cfg::loot::goods::item} to emerald
	set {-cfg::loot::goods::per-cell} to 2
	set {-cfg::loot::goods::layers} to 1
	set {-cfg::loot::goods::thick} to 0.05
	set {-cfg::loot::goods::scale} to 0.45
	set {-cfg::loot::art::name} to "Artifact"
	set {-cfg::loot::art::piece} to 2000
	set {-cfg::loot::art::take} to 3.0
	set {-cfg::loot::art::item} to gold block
	set {-cfg::loot::art::per-cell} to 1
	set {-cfg::loot::art::layers} to 1
	set {-cfg::loot::art::thick} to 0.3
	set {-cfg::loot::art::scale} to 0.5
	set {-cfg::loot::pile::lift} to 0             # surface above the block top (auto -0.5 on a bottom slab)
	# Gates: glass to smash, a safe to crack (keypad, needs a Safe Kit), a vault door to drill (needs a
	# Drill). claim = the head start of whoever opened it (only they can take from the piles behind it;
	# ends early when their bag fills, they walk claim-range away, leave or die); for a drill, whoever
	# fixed its last jam, else whoever mounted it. Times in seconds.
	set {-cfg::loot::smash::take} to 1.5
	set {-cfg::loot::smash::alarm} to false
	set {-cfg::loot::safe::digits} to 4
	set {-cfg::loot::safe::claim} to 6
	set {-cfg::loot::safe::alarm} to false
	set {-cfg::loot::safe::guess-gap} to 1 second # keys are ignored this long after each guess
	set {-cfg::loot::drill::mount} to 1.5
	set {-cfg::loot::drill::time} to 60            # 90 suggested for difficulty 4
	set {-cfg::loot::drill::jams} to 2             # at 1/3 and 2/3; anyone clears one with the minigame
	# A jam's minigame (owner, 2026-09-25: opening is active work): a marker runs along a row, one slot
	# every qte-step ticks; click while it's on green qte-hits times in a row. A miss starts over and
	# locks clicks for qte-miss-lock ticks; a hit locks them for qte-hit-lock (no double counts).
	set {-cfg::loot::drill::qte-hits} to 3
	set {-cfg::loot::drill::qte-step} to 3
	set {-cfg::loot::drill::qte-miss-lock} to 10
	set {-cfg::loot::drill::qte-hit-lock} to 6
	set {-cfg::loot::drill::claim} to 10
	set {-cfg::loot::drill::alarm} to true
	# Where bags sell: safe zones whose region id starts with this (bag.sk).
	set {-cfg::bag::base-prefix} to "safe_base"
	set {-cfg::bounty::per-kill} to 250
	set {-cfg::bounty::kill-cap} to 25000
	set {-cfg::bounty::min-placed} to 1000
	# No bounty payout (or kill bounty) between players on the same IP address (alts).
	set {-cfg::bounty::ip-check} to true

	# ---------- Shops (shop.sk): ALL PROPOSALS, waiting for the owner ----------
	# Purchases at or above this price need a second click within the window.
	set {-cfg::shop::confirm-above} to 1000
	set {-cfg::shop::confirm-window} to 5 seconds
	# Restore buys ammo up to this many magazines per saved gun (capped at the type's max).
	set {-cfg::shop::restock-mags} to 3
	set {-cfg::shop::keeper-check} to 30 seconds
	set {-cfg::shop::keeper-skin} to "" # "" = the default mannequin skin
	set {-cfg::shop::title::gun} to "Gun Shop"
	set {-cfg::shop::title::gear} to "Gear Shop"
	set {-cfg::shop::title::bag} to "Bag Shop"
	set {-cfg::shop::title::tools} to "Heist Tools"
	set {-cfg::shop::title::cars} to "Car Dealer"

	# Weapons sold at gun shops, in shop order. Keys are WeaponMechanics weapon titles. Owner, 2026-09-26:
	# guns cost 5x the first proposal (the knife isn't a gun); their damage is in the WeaponMechanics
	# files (AK-47 5.5 a body shot: 4 shots unarmored, 11 in a Tactical Helmet + Heavy Vest).
	# Guns need Reload.Ammo in their WeaponMechanics file and an "ammo" here; melee has neither.
	set {-cfg::shop::weapons::*} to "Combat_Knife", "50_GS", "Uzi", "R9_0" and "AK_47"
	set {-cfg::wpn::Combat_Knife::name} to "Combat Knife"
	set {-cfg::wpn::Combat_Knife::kind} to "Melee"
	set {-cfg::wpn::Combat_Knife::price} to 150
	# model = the weapon's WeaponMechanics skin (Skin: Default in its file), the custom_model_data the
	# pack's feather.json turns into its 3D model; the shop's icons use it so they look like the gun.
	set {-cfg::wpn::Combat_Knife::model} to -10
	set {-cfg::wpn::50_GS::name} to ".50 GS"
	set {-cfg::wpn::50_GS::kind} to "Pistol"
	set {-cfg::wpn::50_GS::price} to 1500
	set {-cfg::wpn::50_GS::ammo} to "light"
	set {-cfg::wpn::50_GS::mag} to 7
	set {-cfg::wpn::50_GS::model} to 9
	set {-cfg::wpn::Uzi::name} to "Uzi"
	set {-cfg::wpn::Uzi::kind} to "SMG"
	set {-cfg::wpn::Uzi::price} to 15000
	set {-cfg::wpn::Uzi::ammo} to "light"
	set {-cfg::wpn::Uzi::mag} to 32
	set {-cfg::wpn::Uzi::model} to 1
	set {-cfg::wpn::R9_0::name} to "R9-0"
	set {-cfg::wpn::R9_0::kind} to "Shotgun"
	set {-cfg::wpn::R9_0::price} to 37500
	set {-cfg::wpn::R9_0::ammo} to "shells"
	set {-cfg::wpn::R9_0::mag} to 14
	set {-cfg::wpn::R9_0::model} to 14
	set {-cfg::wpn::AK_47::name} to "AK-47"
	set {-cfg::wpn::AK_47::kind} to "Rifle"
	set {-cfg::wpn::AK_47::price} to 75000
	set {-cfg::wpn::AK_47::ammo} to "rifle"
	set {-cfg::wpn::AK_47::mag} to 30
	set {-cfg::wpn::AK_47::model} to 5

	# Ammo types. "wm" = the ammo's name in plugins\WeaponMechanics\ammos\Donating_Ammos.yml.
	set {-cfg::shop::ammo::*} to "light", "shells" and "rifle"
	set {-cfg::ammo::light::name} to "Light Rounds"
	set {-cfg::ammo::light::wm} to "Donating_Light"
	set {-cfg::ammo::light::item} to iron nugget
	set {-cfg::ammo::light::price} to 1 # per round
	set {-cfg::ammo::light::pack} to 16
	set {-cfg::ammo::light::max} to 256
	set {-cfg::ammo::shells::name} to "Shotgun Shells"
	set {-cfg::ammo::shells::wm} to "Donating_Shells"
	set {-cfg::ammo::shells::item} to copper nugget
	set {-cfg::ammo::shells::price} to 5
	set {-cfg::ammo::shells::pack} to 14
	set {-cfg::ammo::shells::max} to 112
	set {-cfg::ammo::rifle::name} to "Rifle Rounds"
	set {-cfg::ammo::rifle::wm} to "Donating_Rifle"
	set {-cfg::ammo::rifle::item} to gold nugget
	set {-cfg::ammo::rifle::price} to 3
	set {-cfg::ammo::rifle::pack} to 30
	set {-cfg::ammo::rifle::max} to 240

	# Consumables: WeaponMechanics items with Shoot.Consume_Item_On_Shoot (no leftover item).
	set {-cfg::shop::consumables::*} to "Stim"
	set {-cfg::con::Stim::name} to "Stim"
	set {-cfg::con::Stim::price} to 200
	set {-cfg::con::Stim::max} to 3
	set {-cfg::con::Stim::model} to -1

	# Heist tools (loot.sk): carried in hotbar 1-5 (only the gun shop and the tools shop change those),
	# used up by the task (a Safe Kit only when the safe opens), lost on death. Not in Save/Restore.
	set {-cfg::shop::tools::*} to "drill" and "safe-kit"
	set {-cfg::tool::drill::name} to "Drill"
	set {-cfg::tool::drill::enabled} to true
	set {-cfg::tool::drill::price} to 2500
	set {-cfg::tool::drill::max} to 1
	set {-cfg::tool::drill::item} to iron ingot
	set {-cfg::tool::drill::about} to "Drills a vault door open (1 per door)."
	set {-cfg::tool::safe-kit::name} to "Safe Kit"
	set {-cfg::tool::safe-kit::enabled} to true
	set {-cfg::tool::safe-kit::price} to 400
	set {-cfg::tool::safe-kit::max} to 3
	set {-cfg::tool::safe-kit::item} to flint
	set {-cfg::tool::safe-kit::about} to "Cracks a safe's code (used up when it opens)."
	# PROPOSAL: the robber level a tool needs to be bought (levels.sk).
	set {-cfg::tool::safe-kit::level} to 1
	set {-cfg::tool::drill::level} to 2

	# ---------- Robber levels (levels.sk) ----------
	# PROPOSAL: level n needs level::<n>::xp total XP; its name is the level's title. XP comes from
	# selling loot at the base: X = floor(P / level::xp-per-dollars) + level::xp-per-haul × H, P = what
	# the sale paid (passive: 75%), H = the heist runs in it (each run once per player). E.g. a full
	# Duffel Bag ($6,000) from one heist = 60 + 10 = 70 XP.
	set {-cfg::level::max} to 6
	set {-cfg::level::xp-per-dollars} to 100
	set {-cfg::level::xp-per-haul} to 10
	set {-cfg::level::0::name} to "Pickpocket"
	set {-cfg::level::0::xp} to 0
	set {-cfg::level::0::color} to "&7"
	set {-cfg::level::1::name} to "Shoplifter"
	set {-cfg::level::1::xp} to 250
	set {-cfg::level::1::color} to "&f"
	set {-cfg::level::2::name} to "Burglar"
	set {-cfg::level::2::xp} to 1000
	set {-cfg::level::2::color} to "&a"
	set {-cfg::level::3::name} to "Safecracker"
	set {-cfg::level::3::xp} to 3000
	set {-cfg::level::3::color} to "&b"
	set {-cfg::level::4::name} to "Heister"
	set {-cfg::level::4::xp} to 8000
	set {-cfg::level::4::color} to "&e"
	set {-cfg::level::5::name} to "Mastermind"
	set {-cfg::level::5::xp} to 20000
	set {-cfg::level::5::color} to "&6"
	set {-cfg::level::6::name} to "Kingpin"
	set {-cfg::level::6::xp} to 50000
	set {-cfg::level::6::color} to "&c"

	# ---------- Paid ranks (ranks.sk) ----------
	# A tag before the name in the tab list, chat and join messages, a spot higher in the tab list, a bag
	# skin and more bag room (MONETIZATION.md lists what affects gameplay). LuckPerms groups made by
	# /dranks setup; the weight orders them and is
	# the prefix's priority (staff groups are 100). PROPOSAL: names, tags and order (the owner sets
	# prices). Listed highest first. The ids are also in TAB's sorting list (plugins\TAB\config.yml).
	set {-cfg::paidranks::*} to "legend", "elite", "vipplus" and "vip"
	set {-cfg::paidrank::legend::name} to "Legend"
	set {-cfg::paidrank::legend::prefix} to "&d[Legend]"
	set {-cfg::paidrank::legend::weight} to 40
	set {-cfg::paidrank::elite::name} to "Elite"
	set {-cfg::paidrank::elite::prefix} to "&6[Elite]"
	set {-cfg::paidrank::elite::weight} to 30
	set {-cfg::paidrank::vipplus::name} to "VIP+"
	set {-cfg::paidrank::vipplus::prefix} to "&b[VIP+]"
	set {-cfg::paidrank::vipplus::weight} to 20
	set {-cfg::paidrank::vip::name} to "VIP"
	set {-cfg::paidrank::vip::prefix} to "&a[VIP]"
	set {-cfg::paidrank::vip::weight} to 10
	# Bag skins (owner, 2026-09-26): each paid rank's look for whatever bag tier you carry; a rank has every
	# lower rank's skin too. The art is in tools\make-item-art.js (BAGS: camo, arctic, gilded, neon).
	# PROPOSAL: the rank's bag bonus b: capacity × (1 + b) on any bag tier (ranks.sk). Listed in
	# MONETIZATION.md, the pay-to-win disclosure for Minehut.
	set {-cfg::paidrank::vip::bag-bonus} to 0.05
	set {-cfg::paidrank::vipplus::bag-bonus} to 0.1
	# Owner, 2026-09-26: Elite 20%, Legend 25% (was 15% / 20%).
	set {-cfg::paidrank::elite::bag-bonus} to 0.2
	set {-cfg::paidrank::legend::bag-bonus} to 0.25
	# The keys each rank adds to /daily (crates.sk; owner, 2026-09-26). VIP adds none.
	set {-cfg::paidrank::vipplus::daily-keys::*} to "common"
	set {-cfg::paidrank::elite::daily-keys::*} to "common" and "uncommon"
	set {-cfg::paidrank::legend::daily-keys::*} to "common", "uncommon" and "rare"
	# Heist Refresh (ranks.sk /heistrefresh): hours between two refreshes per player; a rank without
	# one can't refresh (owner, 2026-09-26: Elite 12 h, Legend 6 h).
	set {-cfg::paidrank::elite::refresh-hours} to 12
	set {-cfg::paidrank::legend::refresh-hours} to 6
	# Legends own every retired and testing cosmetic (cosmetics.sk; owner, 2026-09-26).
	set {-cfg::paidrank::legend::retired-cosmetics} to true
	set {-cfg::paidrank::vip::skin} to "camo"
	set {-cfg::paidrank::vipplus::skin} to "arctic"
	set {-cfg::paidrank::elite::skin} to "gilded"
	set {-cfg::paidrank::legend::skin} to "neon"
	set {-cfg::bagskin::camo::name} to "Camo"
	set {-cfg::bagskin::arctic::name} to "Arctic"
	set {-cfg::bagskin::gilded::name} to "Gilded"
	set {-cfg::bagskin::neon::name} to "Neon"

	# The Tebex webstore's address, shown by /store and /ranks ("" = not open yet). Tebex (the plugin)
	# delivers purchases by running /dranks give, /dbooster add and /dcrate give from the console
	# (MONETIZATION.md).
	set {-cfg::store::url} to ""

	# ---------- Crates (crates.sk) and cosmetics (cosmetics.sk): ALL PROPOSALS ----------
	# Owner, 2026-09-26: crates daily, common, uncommon, rare, epic, legendary, and hacked (special events
	# only, never sold). Keys are virtual (a count per player, never an item: the inventory is fixed).
	# /daily gives everyone a daily key (plus each rank's daily-keys above); common to legendary keys are
	# sold on Tebex (dcrate give). Rarity colors are used for crates and for cosmetics.
	set {-cfg::rarities::*} to "daily", "common", "uncommon", "rare", "epic", "legendary" and "hacked"
	set {-cfg::rarity::daily::name} to "Daily"
	set {-cfg::rarity::daily::color} to "&e"
	set {-cfg::rarity::common::name} to "Common"
	set {-cfg::rarity::common::color} to "&f"
	set {-cfg::rarity::uncommon::name} to "Uncommon"
	set {-cfg::rarity::uncommon::color} to "&a"
	set {-cfg::rarity::rare::name} to "Rare"
	set {-cfg::rarity::rare::color} to "&9"
	set {-cfg::rarity::epic::name} to "Epic"
	set {-cfg::rarity::epic::color} to "&5"
	set {-cfg::rarity::legendary::name} to "Legendary"
	set {-cfg::rarity::legendary::color} to "&6"
	set {-cfg::rarity::hacked::name} to "Hacked"
	set {-cfg::rarity::hacked::color} to "&2"
	# A cosmetic you already own pays this much instead (by the cosmetic's rarity; owner, 2026-09-26).
	set {-cfg::rarity::daily::dupe} to 200
	set {-cfg::rarity::common::dupe} to 200
	set {-cfg::rarity::uncommon::dupe} to 500
	set {-cfg::rarity::rare::dupe} to 1500
	set {-cfg::rarity::epic::dupe} to 3000
	set {-cfg::rarity::legendary::dupe} to 5000
	set {-cfg::rarity::hacked::dupe} to 7500
	# Season titles (seasons.sk: bound, never in crates) and the Season crate's name and color.
	set {-cfg::rarity::season::name} to "Season"
	set {-cfg::rarity::season::color} to "&b"
	# Crates, in menu order (all of them always show in /crates; owner, 2026-09-26). sold = Tebex sells
	# its keys.
	set {-cfg::crates::*} to "daily", "common", "uncommon", "rare", "epic", "legendary", "hacked" and "season"
	set {-cfg::crate::daily::sold} to false
	set {-cfg::crate::common::sold} to true
	set {-cfg::crate::uncommon::sold} to true
	set {-cfg::crate::rare::sold} to true
	set {-cfg::crate::epic::sold} to true
	set {-cfg::crate::legendary::sold} to true
	set {-cfg::crate::hacked::sold} to false
	# The Season crate: keys only from season milestones and prizes (seasons.sk), never sold; no cosmetics.
	set {-cfg::crate::season::sold} to false
	set {-cfg::crate::season::never-give} to true
	set {-cfg::crate::season::icon} to beacon
	set {-cfg::crate::season::rewards::*} to "300|money|500", "200|money|1000", "60|money|3000", "150|ammo|light|64", "100|ammo|rifle|60", "100|con|Stim|2", "60|tool|safe-kit|2" and "30|tool|drill|1"
	set {-cfg::crate::daily::icon} to chest
	set {-cfg::crate::common::icon} to chest
	set {-cfg::crate::uncommon::icon} to chest
	set {-cfg::crate::rare::icon} to ender chest
	set {-cfg::crate::epic::icon} to ender chest
	set {-cfg::crate::legendary::icon} to ender chest
	set {-cfg::crate::hacked::icon} to sculk shrieker
	# Rewards: "weight|kind|what|amount". The chance of a line = its weight / the crate's total (shown in
	# /crates; the weights here add up to 1000, so 30 = 3%). Kinds: money|<$>; ammo|<type>|<rounds>;
	# con|<consumable>|<n>; tool|<tool>|<n>; cos|<cosmetic id>[,<id>...] (a set: all of them);
	# car|<id>|<Name> (left out of rolls until cars exist: crate::cars, garage.sk). Ammo, consumables and
	# tools that don't fit (full inventory, carry limit, a tool above your level) pay crate::overflow-rate
	# of their shop price in cash, and a cosmetic you own pays its rarity's dupe value.
	# Owner, 2026-09-26: money 50-65% lower than before but more often; cosmetics at most 1 / 3 / 5 / 7 /
