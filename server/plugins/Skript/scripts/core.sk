	# ---------- Boosters (boosters.sk) ----------
	# Kinds (owner, 2026-09-27: a booster category on Tebex): money (loot sales' pay), xp (robber-level XP from
	# sales and contracts), rush (Heist Rush: heists cool down b times faster; no buyer bonus, balanced for
	# everyone). Each kind: its name in messages, the most its multiplier may be, and its buyer's extra.
	set {-cfg::booster::kinds::*} to "money", "xp" and "rush"
	set {-cfg::booster::money::name} to "money"
	set {-cfg::booster::money::max-multiplier} to 2
	set {-cfg::booster::money::buyer-bonus} to 0.5
	set {-cfg::booster::xp::name} to "XP"
	set {-cfg::booster::xp::max-multiplier} to 2
	set {-cfg::booster::xp::buyer-bonus} to 0.5
	set {-cfg::booster::rush::name} to "Heist Rush"
	set {-cfg::booster::rush::max-multiplier} to 2
	# (The money booster's first settings, kept for anything that still reads them.)
	# A server-wide booster multiplies every loot sale's pay for everyone; its buyer gets buyer-bonus on
	# top (owner, 2026-09-26: 1.5× for everyone, 2× for the buyer; 0 = the same for all). Listed in
	# MONETIZATION.md. PROPOSAL: the largest multiplier and the longest booster.
	set {-cfg::booster::buyer-bonus} to 0.5
	set {-cfg::booster::max-multiplier} to 2
	set {-cfg::booster::max-minutes} to 240

	# Helmets and vests: lost on death, bought again. Gun damage D' = D × (1 − 0.03 × armor points).
	set {-cfg::shop::gear::*} to "helmet-1", "helmet-2", "vest-1" and "vest-2"
	set {-cfg::gear::helmet-1::name} to "Light Helmet"
	set {-cfg::gear::helmet-1::slot} to "helmet"
	set {-cfg::gear::helmet-1::item} to iron helmet
	set {-cfg::gear::helmet-1::tier} to 1
	set {-cfg::gear::helmet-1::price} to 750
	set {-cfg::gear::helmet-2::name} to "Tactical Helmet"
	set {-cfg::gear::helmet-2::slot} to "helmet"
	set {-cfg::gear::helmet-2::item} to diamond helmet
	set {-cfg::gear::helmet-2::tier} to 2
	set {-cfg::gear::helmet-2::price} to 2500
	set {-cfg::gear::vest-1::name} to "Light Vest"
	set {-cfg::gear::vest-1::slot} to "vest"
	set {-cfg::gear::vest-1::item} to chainmail chestplate
	set {-cfg::gear::vest-1::tier} to 1
	set {-cfg::gear::vest-1::price} to 1000
	set {-cfg::gear::vest-2::name} to "Heavy Vest"
	set {-cfg::gear::vest-2::slot} to "vest"
	set {-cfg::gear::vest-2::item} to diamond chestplate
	set {-cfg::gear::vest-2::tier} to 2
	set {-cfg::gear::vest-2::price} to 5000

	# Bags: price to replace a lost bag of a tier you've already unlocked (owner, 2026-09-26: 20% of what
	# it holds).
	set {-cfg::bag::1::replace} to 400
	set {-cfg::bag::2::replace} to 1200
	set {-cfg::bag::3::replace} to 3000
	set {-cfg::bag::4::replace} to 8000
	set {-cfg::bag::5::replace} to 20000
	# A player who can't pay for a new Gym Bag (tier 1, already unlocked) gets one free, so a robber who
	# lost everything is never stuck without a bag (PROPOSAL).
	set {-cfg::bag::free-if-broke} to true

	# Season titles made by seasons.sk ({seasoncos::<id>} = "type|name|rarity"): bound, so trades, crates and
	# ranks never include them. Defined here again at every load (loadSettings starts from nothing).
	loop {seasoncos::*}:
		set {_sc::*} to loop-value split at "|"
		set {-cfg::cos::%loop-index%::type} to {_sc::1}
		set {-cfg::cos::%loop-index%::name} to {_sc::2}
		set {-cfg::cos::%loop-index%::rarity} to {_sc::3}
		set {-cfg::cos::%loop-index%::bound} to true
		add loop-index to {-cfg::cosmetics::*}
	# The story's title (story.sk: bound, only for finishing Mara's chapters).
	set {-cfg::cos::story_made::type} to "title"
	set {-cfg::cos::story_made::name} to "Made"
	set {-cfg::cos::story_made::rarity} to "story"
	set {-cfg::cos::story_made::bound} to true
	add "story_made" to {-cfg::cosmetics::*}
	# Vic's title (the end of his arc; bound).
	set {-cfg::cos::vic_guy::type} to "title"
	set {-cfg::cos::vic_guy::name} to "Vic's Guy"
	set {-cfg::cos::vic_guy::rarity} to "story"
	set {-cfg::cos::vic_guy::bound} to true
	add "vic_guy" to {-cfg::cosmetics::*}

	# ---------- Contact jobs (jobs.sk): PROPOSAL numbers, names and texts ----------
	# Owner, 2026-09-27: "Contact Jobs". Each contact leaves a player one job every jobs::hours; up to jobs::slots wait
	# (they never expire); picked up in person. Pay R = max(min-pay, floor50(beta x S)), S = the job's loot goal N
	# (Mara) or the contract's pay (the Boss); paid P = floor(R x (1 + bonus-share K) x (1 + cold-share C) x m).
	# Mara's goal N = max(min-goal, floor100(min(run::<d>, bag-share x the best bag, pool-share x the heist's pool))).
	set {-cfg::jobs::contacts::*} to "mara" and "boss"
	set {-cfg::jobs::mara::name} to "Mara"
	set {-cfg::jobs::mara::giver} to "story"
	set {-cfg::jobs::mara::color} to "&d"
	set {-cfg::jobs::mara::unlock} to "story:done"
	set {-cfg::jobs::mara::templates::*} to "haul", "safe", "vault" and "getaway"
	set {-cfg::jobs::boss::name} to "Boss"
	set {-cfg::jobs::boss::giver} to "contracts"
	set {-cfg::jobs::boss::color} to "&6"
	set {-cfg::jobs::boss::unlock} to "contracts:1"
	set {-cfg::jobs::boss::templates::*} to "tier", "model" and "double"
	set {-cfg::jobs::hours} to 20
	set {-cfg::jobs::slots} to 3
	set {-cfg::jobs::slots-family} to 4
	set {-cfg::jobs::swap-hours} to 20
	set {-cfg::jobs::grace} to 900
	set {-cfg::jobs::gap} to 3
	set {-cfg::jobs::run::1} to 1000
	set {-cfg::jobs::run::2} to 3000
	set {-cfg::jobs::run::3} to 7500
	set {-cfg::jobs::run::4} to 20000
	set {-cfg::jobs::bag-share} to 0.6
	set {-cfg::jobs::pool-share} to 0.25
	set {-cfg::jobs::min-goal} to 500
	set {-cfg::jobs::min-pay} to 500
	set {-cfg::jobs::bonus-share} to 0.5
	set {-cfg::jobs::cold-share} to 0.25
	set {-cfg::jobs::cold-hours} to 24
	set {-cfg::jobs::bonus-rep} to 5
	set {-cfg::jobs::clock-left} to 120
	set {-cfg::jobs::guesses} to 5
	set {-cfg::jobs::fast-secs} to 240
	# Templates: name (without a bonus), goal text ({heist}, {$}, {tier}, {car}), beta, xp, rep, weight, bonuses.
	set {-cfg::jobs::tpl::haul::name} to "Special Delivery"
	set {-cfg::jobs::tpl::haul::goal} to "Sell {$} of loot you robbed from the {heist}"
	set {-cfg::jobs::tpl::haul::beta} to 0.2
	set {-cfg::jobs::tpl::haul::xp} to 15
	set {-cfg::jobs::tpl::haul::rep} to 10
	set {-cfg::jobs::tpl::haul::weight} to 40
	set {-cfg::jobs::tpl::haul::bonuses::*} to "clock", "quiet" and "untouched"
	set {-cfg::jobs::tpl::safe::name} to "Safecracker"
	set {-cfg::jobs::tpl::safe::goal} to "Crack a safe in the {heist}"
	set {-cfg::jobs::tpl::safe::beta} to 0.25
	set {-cfg::jobs::tpl::safe::xp} to 25
	set {-cfg::jobs::tpl::safe::rep} to 15
	set {-cfg::jobs::tpl::safe::weight} to 20
	set {-cfg::jobs::tpl::safe::bonuses::*} to "guesses" and "untouched"
	set {-cfg::jobs::tpl::vault::name} to "Vault Job"
	set {-cfg::jobs::tpl::vault::goal} to "Drill the vault in the {heist}"
	set {-cfg::jobs::tpl::vault::beta} to 0.35
	set {-cfg::jobs::tpl::vault::xp} to 40
	set {-cfg::jobs::tpl::vault::rep} to 20
	set {-cfg::jobs::tpl::vault::weight} to 20
	set {-cfg::jobs::tpl::vault::bonuses::*} to "untouched"
	set {-cfg::jobs::tpl::getaway::name} to "Lose the Heat"
	set {-cfg::jobs::tpl::getaway::goal} to "Rob the {heist} and lose its cops with the loot"
	set {-cfg::jobs::tpl::getaway::beta} to 0.35
	set {-cfg::jobs::tpl::getaway::xp} to 40
	set {-cfg::jobs::tpl::getaway::rep} to 20
	set {-cfg::jobs::tpl::getaway::weight} to 20
	set {-cfg::jobs::tpl::getaway::bonuses::*} to "car"
	set {-cfg::jobs::tpl::tier::name} to "Delivery"
	set {-cfg::jobs::tpl::tier::goal} to "Deliver a {tier} (or better)"
	set {-cfg::jobs::tpl::tier::beta} to 0.15
	set {-cfg::jobs::tpl::tier::xp} to 15
	set {-cfg::jobs::tpl::tier::rep} to 10
	set {-cfg::jobs::tpl::tier::weight} to 40
	set {-cfg::jobs::tpl::tier::bonuses::*} to "fast" and "clean"
	set {-cfg::jobs::tpl::model::name} to "Special Order"
	set {-cfg::jobs::tpl::model::goal} to "Deliver a {car} (any color, a {tier})"
	set {-cfg::jobs::tpl::model::beta} to 0.2
	set {-cfg::jobs::tpl::model::xp} to 25
	set {-cfg::jobs::tpl::model::rep} to 15
	set {-cfg::jobs::tpl::model::weight} to 35
	set {-cfg::jobs::tpl::model::bonuses::*} to "fast" and "clean"
	set {-cfg::jobs::tpl::double::name} to "Busy Day"
