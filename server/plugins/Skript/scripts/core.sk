	set {-cfg::story::c3_end::brief} to "Get over here. The big leagues are calling."
	set {-cfg::story::c3_end::talk::*} to "A car, a drill, a record. Look at you." and "The big jobs have alarms. The cops come in waves. These Stims will keep you standing."
	set {-cfg::story::c3_end::rewards::*} to "money|7500", "xp|200" and "con|Stim|3"
	set {-cfg::story::c4_getaway::chapter} to 4
