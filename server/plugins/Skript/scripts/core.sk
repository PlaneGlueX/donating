# core.sk: shared settings, money formatting, player data and helper functions.
#
# SETTINGS: every tunable number is in loadSettings() below.
# Skript options ({@x}) only work inside the file that defines them, so shared numbers live in
# memory-only {-cfg::*} variables instead. Read them with {-cfg::bag::1::capacity} or cfg("bag::1::capacity").
# After editing a number: /sk reload core
#
# PLAYER DATA: saved per player under {data::<uuid>::<key>} (Skript stores player UUIDs in variable names).
#   Balance is NOT a variable: it's the EssentialsX economy through Vault ("balance of player").
#   Keys used so far:
#     first-join   date of first join
#     passive      true while in passive mode
#     bounty       current bounty ($)
#     bag-tier     bag tier the player carries now (0 or unset = no bag; death.sk deletes it)
#     bag-best     highest bag tier unlocked (a lost bag's tier stays unlocked)
#     wpn::<W>     true once weapon W (a WeaponMechanics title) is unlocked (shop.sk)
#     loadout::<n> saved loadout for hotbar n (1-5): "wpn:<W>", "con:<W>"; loadout::<n>::count
#   Server stats (saved): {stats::unique-joins} = players who ever joined (join-quit.sk).

on load:
	loadSettings()

function loadSettings():
	delete {-cfg::*}

	# ---------- Messages ----------
	# &r after bold matters: Skript's formatter keeps bold across later color codes.
	set {-cfg::prefix} to "&6&lDONATING&r &8» &7"

	# ---------- Timers (decided in CLAUDE.md unless marked PROPOSAL) ----------
	set {-cfg::afk::after} to 5 minutes
	set {-cfg::chat::cooldown} to 2 seconds # PROPOSAL
	set {-cfg::chat::tip-interval} to 5 minutes # PROPOSAL
	set {-cfg::combat::tag} to 15 seconds # PROPOSAL (combat-tag length isn't set yet)
	set {-cfg::combat::player-hit-priority} to 5 seconds
	# Commands a combat-tagged player can't use (combat-log.sk), without the slash.
	set {-cfg::combat::blocked-commands::*} to "spawn", "home", "homes", "warp", "warps", "tpa", "tpahere", "tpaccept", "tpyes", "back", "tp", "tphere", "rtp" and "hub"
	set {-cfg::pvp::spawn-shield} to 10 seconds
	# WorldGuard regions whose id starts with this are safe zones (pvp.sk).
	set {-cfg::pvp::safe-prefix} to "safe"
	set {-cfg::passive::switch-cooldown} to 10 minutes
	set {-cfg::bounty::repeat-kill-window} to 15 minutes
	set {-cfg::duffel::despawn} to 2 minutes
	set {-cfg::alarm::warning} to 20 seconds
	set {-cfg::alarm::wave-interval} to 10 seconds
	set {-cfg::alarm::max-cops} to 6
	set {-cfg::alarm::chase-radius} to 100
	set {-cfg::car::idle-despawn} to 5 minutes
	set {-cfg::car::other-car-despawn} to 1 minute
	set {-cfg::lockpick::max-fails} to 3

	# ---------- Multipliers (decided) ----------
	set {-cfg::passive::payout-multiplier} to 0.75
	set {-cfg::bounty::robbery-share} to 0.10

	# ---------- Navigation (nav.sk) ----------
	# The city map the phones show is set in plugins\DonatingPhone\config.yml (city-maps), not here.
	# How far a passive player's green locator-bar dot reaches (blocks). Non-passive players send none.
	set {-cfg::nav::passive-range} to 100000

	# ---------- Death loss: L = min(B × p, C) ----------
	# p per heist difficulty. Player/trap deaths: 1-5%. Cop deaths: 5-10%.
	# Deaths outside a heist use difficulty 1 and the player's bag capacity.
	set {-cfg::difficulty::1::name} to "Easy"
	set {-cfg::difficulty::1::p} to 0.01
	set {-cfg::difficulty::1::cop-p} to 0.05
	set {-cfg::difficulty::2::name} to "Medium"
	set {-cfg::difficulty::2::p} to 0.02
	set {-cfg::difficulty::2::cop-p} to 0.06
	set {-cfg::difficulty::3::name} to "Hard"
	set {-cfg::difficulty::3::p} to 0.035
	set {-cfg::difficulty::3::cop-p} to 0.08
	set {-cfg::difficulty::4::name} to "Advanced"
	set {-cfg::difficulty::4::p} to 0.05
	set {-cfg::difficulty::4::cop-p} to 0.10

	# ---------- Money: ALL PROPOSALS, waiting for the owner ----------
	set {-cfg::money::start} to 500
	# Bag tiers: capacity = the most loot value ($) the bag holds.
	set {-cfg::bag::1::name} to "Gym Bag"
	set {-cfg::bag::1::capacity} to 2000
	set {-cfg::bag::1::price} to 0
	set {-cfg::bag::2::name} to "Duffel Bag"
	set {-cfg::bag::2::capacity} to 6000
	set {-cfg::bag::2::price} to 7500
	set {-cfg::bag::3::name} to "Hockey Bag"
	set {-cfg::bag::3::capacity} to 15000
	set {-cfg::bag::3::price} to 30000
	set {-cfg::bag::4::name} to "Armored Duffel"
	set {-cfg::bag::4::capacity} to 40000
	set {-cfg::bag::4::price} to 120000
	set {-cfg::bag::5::name} to "Vault Bag"
	set {-cfg::bag::5::capacity} to 100000
	set {-cfg::bag::5::price} to 400000
	# Default loot pool per difficulty (each heist can override its own).
	set {-cfg::difficulty::1::loot-pool} to 3000
	set {-cfg::difficulty::2::loot-pool} to 12000
	set {-cfg::difficulty::3::loot-pool} to 40000
	set {-cfg::difficulty::4::loot-pool} to 120000

	# ---------- Heists (heists.sk) ----------
	# WorldGuard regions "heist_<id>" are heists (staff define them with /dheist).
	set {-cfg::heist::region-prefix} to "heist_"
	# When the escape clock starts: "rob" = at the first robbery (owner, 2026-09-25; loot.sk calls
	# heistStartRun at the first piece taken, glass smashed, safe cracked or drill mounted), "enter" = at
	# the first robber's entry.
	set {-cfg::heist::start-on} to "rob"
	# PROPOSAL: with less than this left, the doors are locked (nobody new can still rob anything).
	set {-cfg::heist::entry-cutoff} to 20 seconds
	# PROPOSAL: chat warnings at these seconds left.
	set {-cfg::heist::warn-at::*} to 60, 30 and 10
	# "The Bank is open!" / "The Bank is closed." to everyone. The only heist chat everyone gets (owner,
	# 2026-09-26): the rest (the clock, warnings, the alarm) goes only to the robbers inside.
	set {-cfg::heist::announce} to true
	# Room resets place one section of at most this many blocks per side per second.
	set {-cfg::heist::reset-section} to 32
	# Largest room a heist may save (blocks). SkBee keeps saved rooms in memory.
	set {-cfg::heist::snapshot-max} to 100000
	# Hologram height above the spot staff stand on.
	set {-cfg::heist::holo-height} to 2.5
	# Escape countdown E and cooldown K per difficulty (owner picked "medium", 2026-09-25). Each heist
	# can override them (/dheist set <id> escape|cooldown <seconds>). The most one heist can put into
	# the game per hour: F = P × 60 / (E + K), with P = its loot per run and E, K in minutes.
	set {-cfg::difficulty::1::escape} to 4 minutes
	set {-cfg::difficulty::2::escape} to 6 minutes
	set {-cfg::difficulty::3::escape} to 8 minutes
	set {-cfg::difficulty::4::escape} to 10 minutes
	set {-cfg::difficulty::1::cooldown} to 6 minutes
	set {-cfg::difficulty::2::cooldown} to 10 minutes
	set {-cfg::difficulty::3::cooldown} to 15 minutes
	set {-cfg::difficulty::4::cooldown} to 30 minutes
	# PROPOSAL: robber rank needed (ranks.sk; 0 = anyone). Each heist can override it (/dheist set <id>
	# rank <n>).
	set {-cfg::difficulty::1::rank} to 0
	set {-cfg::difficulty::2::rank} to 1
	set {-cfg::difficulty::3::rank} to 2
	set {-cfg::difficulty::4::rank} to 3
	# Advanced heists have an alarm (decided: only advanced heists).
	set {-cfg::difficulty::1::advanced} to false
	set {-cfg::difficulty::2::advanced} to false
	set {-cfg::difficulty::3::advanced} to false
	set {-cfg::difficulty::4::advanced} to true
	# PvP heists: no crew rule inside, no passive players (per heist: /dheist set <id> pvp true).
	set {-cfg::difficulty::1::pvp-only} to false
	set {-cfg::difficulty::2::pvp-only} to false
	set {-cfg::difficulty::3::pvp-only} to false
	set {-cfg::difficulty::4::pvp-only} to false
	set {-cfg::difficulty::1::color} to "&a"
	set {-cfg::difficulty::2::color} to "&e"
	set {-cfg::difficulty::3::color} to "&6"
	set {-cfg::difficulty::4::color} to "&4"
	# Trap damage m per difficulty (PROPOSAL): a hit does D = max(1, round(d × 2 × m)) / 2 hearts, d = the
	# trap's damage below (or its own damage=). Per heist: /dheist set <id> trap-damage <m>.
	set {-cfg::difficulty::1::trap-damage} to 1.0
	set {-cfg::difficulty::2::trap-damage} to 1.25
	set {-cfg::difficulty::3::trap-damage} to 1.5
	set {-cfg::difficulty::4::trap-damage} to 1.75

	# ---------- Traps (traps.sk): ALL PROPOSALS ----------
	set {-cfg::trap::max-per-heist} to 40      # one display per laser/camera: caps entities and the index
	set {-cfg::trap::cell} to 4                # index cell size (blocks)
	set {-cfg::trap::step} to 0.5              # max blocks between path samples (the hit window is 0.56)
	set {-cfg::trap::max-samples} to 16        # a fall is up to 3.9 blocks per tick
	set {-cfg::trap::grace} to 0.05            # hitbox shrink per side: grazes are forgiven
	set {-cfg::trap::lead} to 4 ticks          # a blinking beam shows this long before it can hurt (ping)
	# Traps hurt, not kill (owner, 2026-09-25). A trap hits on each new touch (off it longer than rearm),
	# never twice within min-gap; lasers again every `every` while you stay in them, plates once per step.
	set {-cfg::trap::rearm} to 4 ticks
	set {-cfg::trap::min-gap} to 10 ticks
	set {-cfg::trap::alarm-repeat} to 2 seconds
	set {-cfg::trap::show-time} to 20 seconds  # /dtrap show
	set {-cfg::trap::laser::effect} to "damage"
	set {-cfg::trap::laser::damage} to 3        # hearts per hit (10 = full health), × trap-damage
	set {-cfg::trap::laser::every} to 1 second # again while you stay in the beam
	set {-cfg::trap::laser::thickness} to 0.06
	set {-cfg::trap::laser::max-length} to 32
	set {-cfg::trap::laser::view-range} to 1.0
	# "laser here" heights above the feet: low = jump it, mid = a timed jump, high = sneak under it.
	set {-cfg::trap::laser::low} to 0.4
	set {-cfg::trap::laser::mid} to 1.0
	set {-cfg::trap::laser::high} to 1.65
	set {-cfg::trap::laser::blink} to false
	set {-cfg::trap::laser::on} to 2 seconds   # a 4 s rhythm is learnable in one cycle
	set {-cfg::trap::laser::off} to 2 seconds
	set {-cfg::trap::laser::offset} to 0 seconds
	set {-cfg::trap::plate::effect} to "damage"
	set {-cfg::trap::plate::damage} to 4        # once per step
	set {-cfg::trap::floor::effect} to "damage"
	set {-cfg::trap::floor::damage} to 4        # then back on the last solid ground you stood on
	set {-cfg::trap::floor::delay} to 10 ticks     # walking over a 1-wide strip takes 0.35 s: keep moving
	set {-cfg::trap::floor::restore} to 10 seconds # 0 = stays down until the room reset
	set {-cfg::trap::floor::drop} to 1.0
	set {-cfg::trap::floor::depth} to 4
	set {-cfg::trap::floor::max-tiles} to 64
	set {-cfg::trap::camera::effect} to "alarm"
	set {-cfg::trap::camera::angle} to 30          # half-angle: a 60° cone
	set {-cfg::trap::camera::range} to 12
	set {-cfg::trap::camera::sneak-range} to 0.5   # sneaking halves the range
	set {-cfg::trap::camera::grace} to 1 second    # seen this long -> it trips
	set {-cfg::trap::camera::turret-grace} to 1 second # effect=damage: seen this long -> the first shot
	set {-cfg::trap::camera::damage} to 1.5     # per turret shot
	set {-cfg::trap::camera::every} to 0.5 seconds # a turret shoots again this often while it sees you
	set {-cfg::trap::camera::sweep} to 0
	set {-cfg::trap::camera::period} to 8 seconds
	set {-cfg::trap::camera::pointer} to true
	set {-cfg::trap::camera::thickness} to 0.05
	# Trap death messages: {name}, {heist} are filled in.
	set {-cfg::trap::death::laser} to "&c{name} &7walked into a laser in the &f{heist}&7."
	set {-cfg::trap::death::plate} to "&c{name} &7stepped on a trap in the &f{heist}&7."
	set {-cfg::trap::death::floor} to "&c{name} &7fell through a trapped floor in the &f{heist}&7."
	set {-cfg::trap::death::camera} to "&c{name} &7was shot by a security turret in the &f{heist}&7."

	# ---------- Loot (loot.sk): ALL PROPOSALS ----------
	# Hold right-click on loot: each click credits min(Δt, credit) seconds (Δt = time since your last
	# click on it); a pause longer than gap starts over. A held button clicks every 0.2 s, so holding is
	# real time and clicking faster gains nothing.
	set {-cfg::loot::reach} to 4.5               # eye to the loot's hitbox (the client clicks within 3)
	set {-cfg::loot::credit} to 0.3              # seconds, at most, per click
	set {-cfg::loot::gap} to 1                   # seconds: a longer pause resets the progress
	set {-cfg::loot::guard} to 0.5 seconds       # no gun shot or phone toggle this long after a loot click
	set {-cfg::loot::claim-range} to 8           # a head start ends when its owner walks this far away
	# Cleaned out (owner, 2026-09-25): every pile empty while the clock runs -> the time left T becomes
	# T' = max(min, ceil(T × factor)); with T at or under min it doesn't change. min 0 = off.
	set {-cfg::loot::cleaned-out} to 60          # min, seconds
	set {-cfg::loot::cleaned-out-factor} to 0.5
	set {-cfg::loot::partial} to true            # less room than a piece: take what fits, the piece shrinks
	set {-cfg::loot::prompt-range} to 3.5
	set {-cfg::loot::piece-view} to 0.5          # display view range (× 64 blocks)
	set {-cfg::loot::marker-view} to 1.0
	set {-cfg::loot::max-spots} to 24            # per heist
	set {-cfg::loot::max-cells} to 12            # per pile
	set {-cfg::loot::max-pieces} to 24           # per pile
	set {-cfg::loot::max-heist-pieces} to 150
	set {-cfg::loot::max-gate-blocks} to 27
	# Pile styles: what a piece looks like and is worth. A pile's value V = n × piece with n rolled at
	# every opening between ceil(min / piece) and floor(max / piece) (/dloot add ... value=MIN-MAX).
	# Rate r = piece / take ($ per second of holding); a bag of capacity C fills in C / r seconds.
	set {-cfg::loot::styles::*} to "cash", "jewel", "gold", "goods" and "art"
	set {-cfg::loot::cash::name} to "Cash stack"
	set {-cfg::loot::cash::piece} to 100
	set {-cfg::loot::cash::take} to 0.8
	set {-cfg::loot::cash::item} to paper
	set {-cfg::loot::cash::per-cell} to 4
	set {-cfg::loot::cash::layers} to 2
	set {-cfg::loot::cash::thick} to 0.06
	set {-cfg::loot::cash::scale} to 0.45
	set {-cfg::loot::jewel::name} to "Jewels"
	set {-cfg::loot::jewel::piece} to 250
	set {-cfg::loot::jewel::take} to 1.0
	set {-cfg::loot::jewel::item} to diamond
	set {-cfg::loot::jewel::per-cell} to 4
	set {-cfg::loot::jewel::layers} to 1
	set {-cfg::loot::jewel::thick} to 0.04
	set {-cfg::loot::jewel::scale} to 0.35
	set {-cfg::loot::gold::name} to "Gold bar"
	set {-cfg::loot::gold::piece} to 500
	set {-cfg::loot::gold::take} to 1.5
	set {-cfg::loot::gold::item} to gold ingot
	set {-cfg::loot::gold::per-cell} to 2
	set {-cfg::loot::gold::layers} to 2
	set {-cfg::loot::gold::thick} to 0.12
	set {-cfg::loot::gold::scale} to 0.5
	set {-cfg::loot::goods::name} to "Valuables"
	set {-cfg::loot::goods::piece} to 200
	set {-cfg::loot::goods::take} to 1.0
	set {-cfg::loot::goods::item} to emerald
	set {-cfg::loot::goods::per-cell} to 2
	set {-cfg::loot::goods::layers} to 1
	set {-cfg::loot::goods::thick} to 0.05
	set {-cfg::loot::goods::scale} to 0.45
	set {-cfg::loot::art::name} to "Artifact"
	set {-cfg::loot::art::piece} to 2000
	set {-cfg::loot::art::take} to 3.0
	set {-cfg::loot::art::item} to gold block
	set {-cfg::loot::art::per-cell} to 1
	set {-cfg::loot::art::layers} to 1
	set {-cfg::loot::art::thick} to 0.3
	set {-cfg::loot::art::scale} to 0.5
	set {-cfg::loot::pile::lift} to 0             # surface above the block top (auto -0.5 on a bottom slab)
	# Gates: glass to smash, a safe to crack (keypad, needs a Safe Kit), a vault door to drill (needs a
	# Drill). claim = the head start of whoever opened it (only they can take from the piles behind it;
	# ends early when their bag fills, they walk claim-range away, leave or die); for a drill, whoever
	# fixed its last jam, else whoever mounted it. Times in seconds.
	set {-cfg::loot::smash::take} to 1.5
	set {-cfg::loot::smash::alarm} to false
	set {-cfg::loot::safe::digits} to 4
	set {-cfg::loot::safe::claim} to 6
	set {-cfg::loot::safe::alarm} to false
	set {-cfg::loot::safe::guess-gap} to 1 second # keys are ignored this long after each guess
	set {-cfg::loot::drill::mount} to 1.5
	set {-cfg::loot::drill::time} to 60            # 90 suggested for difficulty 4
	set {-cfg::loot::drill::jams} to 2             # at 1/3 and 2/3; anyone clears one with the minigame
	# A jam's minigame (owner, 2026-09-25: opening is active work): a marker runs along a row, one slot
	# every qte-step ticks; click while it's on green qte-hits times in a row. A miss starts over and
	# locks clicks for qte-miss-lock ticks; a hit locks them for qte-hit-lock (no double counts).
	set {-cfg::loot::drill::qte-hits} to 3
	set {-cfg::loot::drill::qte-step} to 3
	set {-cfg::loot::drill::qte-miss-lock} to 10
	set {-cfg::loot::drill::qte-hit-lock} to 6
	set {-cfg::loot::drill::claim} to 10
	set {-cfg::loot::drill::alarm} to true
	# Where bags sell: safe zones whose region id starts with this (bag.sk).
	set {-cfg::bag::base-prefix} to "safe_base"
	set {-cfg::bounty::per-kill} to 250
	set {-cfg::bounty::kill-cap} to 25000
	set {-cfg::bounty::min-placed} to 1000
	# No bounty payout (or kill bounty) between players on the same IP address (alts).
	set {-cfg::bounty::ip-check} to true

	# ---------- Shops (shop.sk): ALL PROPOSALS, waiting for the owner ----------
	# Purchases at or above this price need a second click within the window.
	set {-cfg::shop::confirm-above} to 1000
	set {-cfg::shop::confirm-window} to 5 seconds
	# Restore buys ammo up to this many magazines per saved gun (capped at the type's max).
	set {-cfg::shop::restock-mags} to 3
	set {-cfg::shop::keeper-check} to 30 seconds
	set {-cfg::shop::keeper-skin} to "" # "" = the default mannequin skin
	set {-cfg::shop::title::gun} to "Gun Shop"
	set {-cfg::shop::title::gear} to "Gear Shop"
	set {-cfg::shop::title::bag} to "Bag Shop"
	set {-cfg::shop::title::tools} to "Heist Tools"

	# Weapons sold at gun shops, in shop order. Keys are WeaponMechanics weapon titles.
	# Guns need Reload.Ammo in their WeaponMechanics file and an "ammo" here; melee has neither.
	set {-cfg::shop::weapons::*} to "Combat_Knife", "50_GS", "Uzi", "R9_0" and "AK_47"
	set {-cfg::wpn::Combat_Knife::name} to "Combat Knife"
	set {-cfg::wpn::Combat_Knife::kind} to "Melee"
	set {-cfg::wpn::Combat_Knife::price} to 150
	# model = the weapon's WeaponMechanics skin (Skin: Default in its file), the custom_model_data the
	# pack's feather.json turns into its 3D model; the shop's icons use it so they look like the gun.
	set {-cfg::wpn::Combat_Knife::model} to -10
	set {-cfg::wpn::50_GS::name} to ".50 GS"
	set {-cfg::wpn::50_GS::kind} to "Pistol"
	set {-cfg::wpn::50_GS::price} to 300
	set {-cfg::wpn::50_GS::ammo} to "light"
	set {-cfg::wpn::50_GS::mag} to 7
	set {-cfg::wpn::50_GS::model} to 9
	set {-cfg::wpn::Uzi::name} to "Uzi"
	set {-cfg::wpn::Uzi::kind} to "SMG"
	set {-cfg::wpn::Uzi::price} to 3000
	set {-cfg::wpn::Uzi::ammo} to "light"
	set {-cfg::wpn::Uzi::mag} to 32
	set {-cfg::wpn::Uzi::model} to 1
	set {-cfg::wpn::R9_0::name} to "R9-0"
	set {-cfg::wpn::R9_0::kind} to "Shotgun"
	set {-cfg::wpn::R9_0::price} to 7500
	set {-cfg::wpn::R9_0::ammo} to "shells"
	set {-cfg::wpn::R9_0::mag} to 14
	set {-cfg::wpn::R9_0::model} to 14
	set {-cfg::wpn::AK_47::name} to "AK-47"
	set {-cfg::wpn::AK_47::kind} to "Rifle"
	set {-cfg::wpn::AK_47::price} to 15000
	set {-cfg::wpn::AK_47::ammo} to "rifle"
	set {-cfg::wpn::AK_47::mag} to 30
	set {-cfg::wpn::AK_47::model} to 5

	# Ammo types. "wm" = the ammo's name in plugins\WeaponMechanics\ammos\Donating_Ammos.yml.
	set {-cfg::shop::ammo::*} to "light", "shells" and "rifle"
	set {-cfg::ammo::light::name} to "Light Rounds"
	set {-cfg::ammo::light::wm} to "Donating_Light"
	set {-cfg::ammo::light::item} to iron nugget
	set {-cfg::ammo::light::price} to 1 # per round
	set {-cfg::ammo::light::pack} to 16
	set {-cfg::ammo::light::max} to 256
	set {-cfg::ammo::shells::name} to "Shotgun Shells"
	set {-cfg::ammo::shells::wm} to "Donating_Shells"
	set {-cfg::ammo::shells::item} to copper nugget
	set {-cfg::ammo::shells::price} to 5
	set {-cfg::ammo::shells::pack} to 14
	set {-cfg::ammo::shells::max} to 112
	set {-cfg::ammo::rifle::name} to "Rifle Rounds"
	set {-cfg::ammo::rifle::wm} to "Donating_Rifle"
	set {-cfg::ammo::rifle::item} to gold nugget
	set {-cfg::ammo::rifle::price} to 3
	set {-cfg::ammo::rifle::pack} to 30
	set {-cfg::ammo::rifle::max} to 240

	# Consumables: WeaponMechanics items with Shoot.Consume_Item_On_Shoot (no leftover item).
	set {-cfg::shop::consumables::*} to "Stim"
	set {-cfg::con::Stim::name} to "Stim"
	set {-cfg::con::Stim::price} to 200
	set {-cfg::con::Stim::max} to 3
	set {-cfg::con::Stim::model} to -1

	# Heist tools (loot.sk): carried in hotbar 1-5 (only the gun shop and the tools shop change those),
	# used up by the task (a Safe Kit only when the safe opens), lost on death. Not in Save/Restore.
	set {-cfg::shop::tools::*} to "drill" and "safe-kit"
	set {-cfg::tool::drill::name} to "Drill"
	set {-cfg::tool::drill::enabled} to true
	set {-cfg::tool::drill::price} to 2500
	set {-cfg::tool::drill::max} to 1
	set {-cfg::tool::drill::item} to iron ingot
	set {-cfg::tool::drill::about} to "Drills a vault door open (1 per door)."
	set {-cfg::tool::safe-kit::name} to "Safe Kit"
	set {-cfg::tool::safe-kit::enabled} to true
	set {-cfg::tool::safe-kit::price} to 400
	set {-cfg::tool::safe-kit::max} to 3
	set {-cfg::tool::safe-kit::item} to flint
	set {-cfg::tool::safe-kit::about} to "Cracks a safe's code (used up when it opens)."
	# PROPOSAL: the robber rank a tool needs to be bought (ranks.sk).
	set {-cfg::tool::safe-kit::rank} to 1
	set {-cfg::tool::drill::rank} to 2

	# ---------- Robber ranks (ranks.sk) ----------
	# PROPOSAL: rank n needs rank::<n>::xp total XP. XP comes from selling loot at the base:
	# X = floor(P / rank::xp-per-dollars) + rank::xp-per-haul × H, P = what the sale paid (passive: 75%),
	# H = the heist runs in it. E.g. a full Duffel Bag ($6,000) from one heist = 60 + 10 = 70 XP.
	set {-cfg::rank::max} to 6
	set {-cfg::rank::xp-per-dollars} to 100
	set {-cfg::rank::xp-per-haul} to 10
	set {-cfg::rank::0::name} to "Pickpocket"
	set {-cfg::rank::0::xp} to 0
	set {-cfg::rank::0::color} to "&7"
	set {-cfg::rank::1::name} to "Shoplifter"
	set {-cfg::rank::1::xp} to 250
	set {-cfg::rank::1::color} to "&f"
	set {-cfg::rank::2::name} to "Burglar"
	set {-cfg::rank::2::xp} to 1000
	set {-cfg::rank::2::color} to "&a"
	set {-cfg::rank::3::name} to "Safecracker"
	set {-cfg::rank::3::xp} to 3000
	set {-cfg::rank::3::color} to "&b"
	set {-cfg::rank::4::name} to "Heister"
	set {-cfg::rank::4::xp} to 8000
	set {-cfg::rank::4::color} to "&e"
	set {-cfg::rank::5::name} to "Mastermind"
	set {-cfg::rank::5::xp} to 20000
	set {-cfg::rank::5::color} to "&6"
	set {-cfg::rank::6::name} to "Kingpin"
	set {-cfg::rank::6::xp} to 50000
	set {-cfg::rank::6::color} to "&c"

	# Helmets and vests: lost on death, bought again. Gun damage D' = D × (1 − 0.03 × armor points).
	set {-cfg::shop::gear::*} to "helmet-1", "helmet-2", "vest-1" and "vest-2"
	set {-cfg::gear::helmet-1::name} to "Light Helmet"
	set {-cfg::gear::helmet-1::slot} to "helmet"
	set {-cfg::gear::helmet-1::item} to iron helmet
	set {-cfg::gear::helmet-1::tier} to 1
	set {-cfg::gear::helmet-1::price} to 750
	set {-cfg::gear::helmet-2::name} to "Tactical Helmet"
	set {-cfg::gear::helmet-2::slot} to "helmet"
	set {-cfg::gear::helmet-2::item} to diamond helmet
	set {-cfg::gear::helmet-2::tier} to 2
	set {-cfg::gear::helmet-2::price} to 2500
	set {-cfg::gear::vest-1::name} to "Light Vest"
	set {-cfg::gear::vest-1::slot} to "vest"
	set {-cfg::gear::vest-1::item} to chainmail chestplate
	set {-cfg::gear::vest-1::tier} to 1
	set {-cfg::gear::vest-1::price} to 1000
	set {-cfg::gear::vest-2::name} to "Heavy Vest"
	set {-cfg::gear::vest-2::slot} to "vest"
	set {-cfg::gear::vest-2::item} to diamond chestplate
	set {-cfg::gear::vest-2::tier} to 2
	set {-cfg::gear::vest-2::price} to 5000

	# Bags: price to replace a lost bag of a tier you've already unlocked (10% of unlocking it).
	set {-cfg::bag::1::replace} to 0
	set {-cfg::bag::2::replace} to 750
	set {-cfg::bag::3::replace} to 3000
	set {-cfg::bag::4::replace} to 12000
	set {-cfg::bag::5::replace} to 40000

	set {-cfg::loaded} to true

# Reads a setting by key, e.g. cfg("bag::2::capacity"). Loads settings first if another script
# asks before core.sk's own load event has run (possible at server start).
# A missing key is logged to the console, so a typo shows up instead of an empty value.
# For settings that are optional on purpose (e.g. a per-heist override), read {-cfg::...} directly.
function cfg(key: text) :: object:
	if {-cfg::loaded} is not set:
		loadSettings()
	set {_value} to {-cfg::%{_key}%}
	if {_value} is not set:
		send "[Donating] Missing setting: %{_key}%" to console
	return {_value}

# ---------- Money ----------

# 1234567.8 -> "$1,234,567" (whole dollars, rounded down).
function formatMoney(amount: number) :: text:
	set {_n} to floor(abs({_amount}))
	set {_out} to ""
	while {_n} >= 1000:
		set {_chunk} to "%mod({_n}, 1000)%"
		while length of {_chunk} < 3:
			set {_chunk} to "0%{_chunk}%"
		set {_out} to ",%{_chunk}%%{_out}%"
		set {_n} to floor({_n} / 1000)
	if {_amount} <= -1:
		return "-$%{_n}%%{_out}%"
	return "$%{_n}%%{_out}%"

# 75 -> "1:15", 5 -> "0:05"; negative counts as 0. For countdowns (heists.sk, hud.sk).
function formatClock(seconds: number) :: text:
	set {_s} to max(0, ceil({_seconds}))
	set {_m} to floor({_s} / 60)
	set {_r} to mod({_s}, 60)
	if {_r} < 10:
		return "%{_m}%:0%{_r}%"
	return "%{_m}%:%{_r}%"

# 1234567 -> "$1.2M", 15300 -> "$15.3K", 950 -> "$950". For tight spaces like the sidebar.
function formatMoneyShort(amount: number) :: text:
	set {_a} to abs({_amount})
	if {_a} >= 1000000000:
		set {_out} to "%floor({_a} / 100000000) / 10%B"
	else if {_a} >= 1000000:
		set {_out} to "%floor({_a} / 100000) / 10%M"
	else if {_a} >= 1000:
		set {_out} to "%floor({_a} / 100) / 10%K"
	else:
		set {_out} to "%floor({_a})%"
	if {_amount} <= -1:
		return "-$%{_out}%"
	return "$%{_out}%"

# Balance changes go through these so nothing can push a balance below $0.
function giveMoney(p: offline player, amount: number):
	if {_amount} > 0:
		add {_amount} to balance of {_p}

# All or nothing: true = the whole price was taken (shop purchases). A balance that didn't drop is
# reported and counts as not paid.
function chargeMoney(p: offline player, price: number) :: boolean:
	if {_price} <= 0:
		return true
	set {_before} to balance of {_p}
	if {_before} < {_price}:
		return false
	remove {_price} from balance of {_p}
	if balance of {_p} > {_before} - {_price} + 0.001:
		send "[Donating] chargeMoney: %{_p}% was not charged %{_price}%" to console
		return false
	return true

# Takes up to `amount`; returns how much was actually taken.
function takeMoney(p: offline player, amount: number) :: number:
	set {_taken} to min({_amount}, balance of {_p})
	if {_taken} > 0:
		remove {_taken} from balance of {_p}
		return {_taken}
	return 0

# ---------- Player data ----------

function getData(p: offline player, key: text) :: object:
	return {data::%{_p}%::%{_key}%}

function setData(p: offline player, key: text, value: object):
	set {data::%{_p}%::%{_key}%} to {_value}

function deleteData(p: offline player, key: text):
	delete {data::%{_p}%::%{_key}%}

# ---------- Messages ----------

# Sends a message with the server prefix. Color codes (&a, &7...) in `text` work.
# `colored` only parses safe tags (colors, bold, reset...). Never use `formatted` on text that can
# contain player input: it also parses click/hover tags, so a player could plant a clickable command.
function msg(p: player, text: text):
	send colored "%cfg("prefix")%%{_text}%" to {_p}

function broadcastMsg(text: text):
	broadcast colored "%cfg("prefix")%%{_text}%"

# A text component (e.g. the chat message) as a string with § codes, keeping < and & as typed.
# Putting it in a string ("%message%") gives MiniMessage text instead, where "<" becomes "\<".
function legacyText(t: text) :: text:
	return {_t}

# ---------- Custom items ----------
# Every custom item carries a hidden id in its custom data, e.g. "phone", "bag:2".
# Never use a diamond hoe for custom items: it's MTVehicles' car item.

function tagItem(i: item, id: text) :: item:
	set string tag "donating_id" of custom nbt of {_i} to {_id}
	return {_i}

# The item's id, or "" for items without one.
function itemId(i: item) :: text:
	set {_id} to string tag "donating_id" of custom nbt of {_i}
	if {_id} is set:
		return {_id}
	return ""

# WeaponMechanics keeps its item data in the PDC (custom_data.PublicBukkitValues); SkBee's path
# separator is ";". The weapon title ("AK_47") or "", and the rounds loaded.
function wmTitle(i: item) :: text:
	set {_t} to string tag "PublicBukkitValues;weaponmechanics:weapon-title" of custom nbt of {_i}
	if {_t} is set:
		return {_t}
	return ""

function wmLoaded(i: item) :: number:
	set {_n} to int tag "PublicBukkitValues;weaponmechanics:ammo-left" of custom nbt of {_i}
	if {_n} is set:
		return {_n}
	return 0

# ---------- Permissions ----------

# Staff kicks (console, or a player with essentials.kick): the kicked player is flagged for 3 s, so the
# quit handlers can tell them from a kick the player caused (chat spam, a timed-out client), which
# counts as a normal logout (combat-log.sk, heists.sk). A server stop never reaches quit handlers.
on command:
	set {_parts::*} to command split at ":"
	set {_cmd} to last element of {_parts::*} in lower case
	if {_cmd} is not "kick":
		if {_cmd} is not "ekick":
			stop
	if player is set:
		if player does not have permission "essentials.kick":
			stop
	set {_args::*} to full command split at " "
	set {_k} to {_args::2}
	{_k} is set
	set {_k} to {_k} in lower case
	set {-staffkick::%{_k}%} to true
	wait 3 seconds
	delete {-staffkick::%{_k}%}

function staffKicked(p: player) :: boolean:
	set {_k} to name of {_p} in lower case
	if {-staffkick::%{_k}%} is true:
		return true
	return false

function isStaff(p: player) :: boolean:
	if {_p} has permission "donating.staff":
		return true
	return false
