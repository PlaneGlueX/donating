	set {-cfg::crate::rare::rewards::*} to "230|money|1800", "170|money|2700", "150|money|3600", "90|money|5400", "70|ammo|rifle|240", "50|ammo|shells|112", "50|con|Stim|3", "70|tool|drill|1", "50|tool|safe-kit|3", "12|cos|insideman", "12|cos|phantom", "12|cos|cashburst", "12|cos|souls", "11|cos|cashprint" and "11|cos|crimson"
