# core.sk: shared settings, money formatting, player data and helper functions.
#
# SETTINGS: every tunable number is in loadSettings() below.
# Skript options ({@x}) only work inside the file that defines them, so shared numbers live in
# memory-only {-cfg::*} variables instead. Read them with {-cfg::bag::1::capacity} or cfg("bag::1::capacity").
# After editing a number: /sk reload core
#
# PLAYER DATA: saved per player under {data::<uuid>::<key>} (Skript stores player UUIDs in variable names).
#   Balance is NOT a variable: it's the EssentialsX economy through Vault ("balance of player").
#   Keys used so far:
#     first-join   date of first join
#     passive      true while in passive mode
#     bounty       current bounty ($)
#     bag-tier     bag tier the player carries now (0 or unset = no bag; death.sk deletes it)
#     bag-best     highest bag tier unlocked (a lost bag's tier stays unlocked)
#     wpn::<W>     true once weapon W (a WeaponMechanics title) is unlocked (shop.sk)
#     loadout::<n> saved loadout for hotbar n (1-5): "wpn:<W>", "con:<W>"; loadout::<n>::count
#   Server stats (saved): {stats::unique-joins} = players who ever joined (join-quit.sk).

on load:
	loadSettings()

function loadSettings():
	delete {-cfg::*}

	# ---------- Messages ----------
	# &r after bold matters: Skript's formatter keeps bold across later color codes.
	set {-cfg::prefix} to "&6&lDONATING&r &8» &7"

	# ---------- Timers (decided in CLAUDE.md unless marked PROPOSAL) ----------
	set {-cfg::afk::after} to 5 minutes
	set {-cfg::chat::cooldown} to 2 seconds # PROPOSAL
	set {-cfg::chat::tip-interval} to 5 minutes # PROPOSAL
	set {-cfg::combat::tag} to 15 seconds # PROPOSAL (combat-tag length isn't set yet)
	set {-cfg::combat::player-hit-priority} to 5 seconds
	# Commands a combat-tagged player can't use (combat-log.sk), without the slash.
	set {-cfg::combat::blocked-commands::*} to "spawn", "home", "homes", "warp", "warps", "tpa", "tpahere", "tpaccept", "tpyes", "back", "tp", "tphere", "rtp" and "hub"
	set {-cfg::pvp::spawn-shield} to 10 seconds
	# WorldGuard regions whose id starts with this are safe zones (pvp.sk).
	set {-cfg::pvp::safe-prefix} to "safe"
	set {-cfg::passive::switch-cooldown} to 10 minutes
	set {-cfg::bounty::repeat-kill-window} to 15 minutes
	set {-cfg::duffel::despawn} to 2 minutes
	set {-cfg::alarm::warning} to 20 seconds
	set {-cfg::alarm::wave-interval} to 10 seconds
	set {-cfg::alarm::max-cops} to 6
	set {-cfg::alarm::chase-radius} to 100
	# ---------- Cops (cops.sk, Citizens + Sentinel): ALL PROPOSALS ----------
	# Each alarm wave brings per-wave cops, up to the heist's cap: C = alarm::max-cops + max(0, R - 3) ×
	# alarm::cops-per-extra-robber, R = the players the alarm hunts (owner, 2026-09-26: +2 per robber
	# above 3, no cap on the whole server). health / damage are HP (20 = a full player); attack-rate in
	# seconds between shots; range = how far they shoot; chase = how far from where they spawned they
	# follow; accuracy 0 = perfect, 5 = poor; speed × a player's walk. model = the WeaponMechanics skin
	# their gun shows; the gun fires arrows (Sentinel treats it as a bow).
	set {-cfg::alarm::cops-per-extra-robber} to 2
	set {-cfg::cop::per-wave} to 2
	set {-cfg::cop::name} to "Cop"
	set {-cfg::cop::range} to 30
	set {-cfg::cop::chase} to 120
	# Stronger heists, stronger cops with better guns (owner, 2026-09-26). Per difficulty 1-4: health,
	# damage per shot, seconds between shots, accuracy, speed, gun (9 .50 GS, 1 Uzi, 5 AK-47).
	set {-cfg::difficulty::1::cop-health} to 16
	set {-cfg::difficulty::1::cop-damage} to 2
	set {-cfg::difficulty::1::cop-attack-rate} to 2
	set {-cfg::difficulty::1::cop-accuracy} to 2.5
	set {-cfg::difficulty::1::cop-speed} to 1.1
	set {-cfg::difficulty::1::cop-model} to 9
	set {-cfg::difficulty::2::cop-health} to 20
	set {-cfg::difficulty::2::cop-damage} to 2.5
	set {-cfg::difficulty::2::cop-attack-rate} to 1.75
	set {-cfg::difficulty::2::cop-accuracy} to 2
	set {-cfg::difficulty::2::cop-speed} to 1.2
	set {-cfg::difficulty::2::cop-model} to 9
	set {-cfg::difficulty::3::cop-health} to 26
	set {-cfg::difficulty::3::cop-damage} to 3
	set {-cfg::difficulty::3::cop-attack-rate} to 1.5
	set {-cfg::difficulty::3::cop-accuracy} to 1.5
	set {-cfg::difficulty::3::cop-speed} to 1.25
	set {-cfg::difficulty::3::cop-model} to 1
	set {-cfg::difficulty::4::cop-health} to 32
	set {-cfg::difficulty::4::cop-damage} to 4
	set {-cfg::difficulty::4::cop-attack-rate} to 1.25
	set {-cfg::difficulty::4::cop-accuracy} to 1
	set {-cfg::difficulty::4::cop-speed} to 1.3
	set {-cfg::difficulty::4::cop-model} to 5
	# Killing cops (owner, 2026-09-26): every cop-bounty-every cops a player kills add cop-bounty to their
	# bounty (never for passive players). Shooting a cop makes you wanted (cops.sk).
	set {-cfg::cop::bounty-every} to 4
	set {-cfg::cop::bounty} to 100
	# The police skin (tools\make-cop-skin.js), signed once by MineSkin (Citizens: npc skin --file police.png, then
	# its saves.yml skintrait textureRaw / signature). "" = Citizens uses the skin of the account named cop::name.
	set {-cfg::cop::skin-texture} to ""
	set {-cfg::cop::skin-signature} to ""
	set {-cfg::car::idle-despawn} to 5 minutes
	set {-cfg::car::other-car-despawn} to 1 minute

	# ---------- Cars (garage.sk, car-cleanup.sk): PROPOSALS ----------
	# Owner, 2026-09-26: cars are a mid-game goal (no starter car; the cheapest about $40,000 at level 2, the
	# best about $1M at level 6). A model is bought once, in a color; it can be repainted in the garage.
	# colors: "Label=MTV uuid=itemDamage" (server\plugins\MTVehicles\vehicles.yml; every uuid there is used here;
	# the damage picks the model in the pack, for the menu icons).
	# crate = only from crates (never sold at the dealer); a crate car needs no level.
	set {-cfg::cars::*} to "sedan", "sportsedan", "jeep", "sports", "hotrod", "suv", "vandal", "specter" and "overclock"
	set {-cfg::car::sedan::name} to "Sedan"
	set {-cfg::car::sedan::price} to 40000
	set {-cfg::car::sedan::level} to 2
	set {-cfg::carcolors::sedan::*} to "Red=GKAH5U=1017", "Gray=BV3W2A=1019", "Black=FFW36Q=1111", "Navy=7JWQYB=1003" and "Beige=58UUXF=1110"
	set {-cfg::car::sportsedan::name} to "Sport Sedan"
	set {-cfg::car::sportsedan::price} to 90000
	set {-cfg::car::sportsedan::level} to 3
	set {-cfg::carcolors::sportsedan::*} to "Obsidian=KG59SJ=1116", "Emerald=RBG6HW=1115" and "Quartz=7BEQ5K=1023"
	set {-cfg::car::jeep::name} to "Jeep"
	set {-cfg::car::jeep::price} to 150000
	set {-cfg::car::jeep::level} to 3
	set {-cfg::carcolors::jeep::*} to "Blue=G2KQ4V=1073" and "Gold=5Z95XA=1074"
	set {-cfg::car::sports::name} to "Sports Car"
	set {-cfg::car::sports::price} to 250000
	set {-cfg::car::sports::level} to 4
	set {-cfg::carcolors::sports::*} to "White=5CD8N4=1060", "Black=W32FND=1070", "Orange=8CUSCG=1068", "Navy=SMV4M6=1002" and "Flame Red=LHBM2X=1063"
	set {-cfg::car::hotrod::name} to "Hotrod"
	set {-cfg::car::hotrod::price} to 450000
	set {-cfg::car::hotrod::level} to 5
	set {-cfg::carcolors::hotrod::*} to "Red=CJF7WX=1006", "Black=6GBKXT=1161" and "Blue=2FWFAS=1159"
	set {-cfg::car::suv::name} to "SUV"
	set {-cfg::car::suv::price} to 1000000
	set {-cfg::car::suv::level} to 6
	set {-cfg::carcolors::suv::*} to "Black=FC98KS=1141", "White=88WPRU=1139" and "Criminal=5R7QP3=1220"
	# The crate cars (crates.sk car lines use these ids): looks only, they drive like their family.
	set {-cfg::car::vandal::name} to "Vandal"
	set {-cfg::car::vandal::crate} to true
	set {-cfg::carcolors::vandal::*} to "Diamond=6FHXGA=1069"
	set {-cfg::car::specter::name} to "Specter"
	set {-cfg::car::specter::crate} to true
	set {-cfg::carcolors::specter::*} to "Rainbow=XJ4Q29=1027"
	set {-cfg::car::overclock::name} to "Overclock"
	set {-cfg::car::overclock::crate} to true
	set {-cfg::carcolors::overclock::*} to "Gold=6WDK7U=1158"
	# Repainting an owned car (another color of its model) in the garage.
	set {-cfg::car::paint-price} to 2500
	# Calling your car to you from the garage: once per this long, and never while in combat.
	set {-cfg::car::call-cooldown} to 20 seconds
	# How far a player may be from a car they send back or lock from the garage menu (0 = anywhere).
	set {-cfg::car::lock-range} to 0
	# Regions whose id starts with this are no-lock zones (car spawn areas): no locking there.
	set {-cfg::car::nolock-prefix} to "nolock"
	# The City Garage (citygarage.sk, PROPOSAL): sites are safe-zone regions whose id starts with region-prefix; a car
	# comes out there every takeout-cooldown (Valet anywhere every car::call-cooldown) and goes back if nobody gets in
	# within pickup-idle; driving within return-radius of a return spot parks it. A car standing unused waits while its
	# owner is within idle-near blocks of it or inside a heist.
	set {-cfg::garage::region-prefix} to "safe_garage_"
	set {-cfg::garage::takeout-cooldown} to 5 seconds
	set {-cfg::garage::pickup-idle} to 90 seconds
	set {-cfg::garage::return-radius} to 4
	set {-cfg::car::idle-near} to 64
	# Owner, 2026-09-26: cars are the getaway, but the cops' chase radius is this many times bigger while
	# the hunted robber is in a car (heists.sk heistInRange).
	set {-cfg::alarm::car-chase-factor} to 2
	set {-cfg::lockpick::max-fails} to 3

	# ---------- Car-theft contracts (contracts.sk): PROPOSALS ----------
	# Owner, 2026-09-26: steal a car with a lockpick, drive it to a chop shop for cash; the car is never
	# kept (and no NPC cars at spawn areas). Three tiers; each offers a car of its list at a staff spot.
	set {-cfg::contract::tiers::*} to "basic", "pro" and "master"
	set {-cfg::contract::basic::name} to "Street job"
	set {-cfg::contract::basic::level} to 1
	set {-cfg::contract::basic::pay} to 3000
	set {-cfg::contract::basic::xp} to 30
	set {-cfg::contract::basic::qte-hits} to 3
	set {-cfg::contract::basic::qte-step} to 4
	set {-cfg::contractcars::basic::*} to "sedan" and "sportsedan"
	set {-cfg::contract::pro::name} to "Pro job"
	set {-cfg::contract::pro::level} to 3
	set {-cfg::contract::pro::pay} to 9000
	set {-cfg::contract::pro::xp} to 60
	set {-cfg::contract::pro::qte-hits} to 3
	set {-cfg::contract::pro::qte-step} to 3
	set {-cfg::contractcars::pro::*} to "jeep" and "sports"
	set {-cfg::contract::master::name} to "Master job"
	set {-cfg::contract::master::level} to 5
	set {-cfg::contract::master::pay} to 25000
	set {-cfg::contract::master::xp} to 120
	set {-cfg::contract::master::qte-hits} to 4
	set {-cfg::contract::master::qte-step} to 3
	set {-cfg::contractcars::master::*} to "hotrod" and "suv"
	# Lockpicks (quest items in hotbar 6-8, kept on death): one per tier, lockpick::max-fails misses break one.
	set {-cfg::lockpick::basic::name} to "Basic Lockpick"
	set {-cfg::lockpick::basic::price} to 500
	set {-cfg::lockpick::pro::name} to "Pro Lockpick"
	set {-cfg::lockpick::pro::price} to 1500
	set {-cfg::lockpick::master::name} to "Master Lockpick"
	set {-cfg::lockpick::master::price} to 4000
	set {-cfg::lockpick::max} to 3
	# A contract lasts this long; after one (done, failed or dropped) the next waits this long.
	set {-cfg::contract::time} to 10 minutes
	set {-cfg::contract::cooldown} to 3 minutes
	# Offers are made again this often (per player).
	set {-cfg::contract::refresh} to 10 minutes
	# The lock-picking minigame (like the drill's, loot.sk): the marker moves one slot every qte-step
	# ticks; clicks are ignored this many ticks after a hit / a miss.
	set {-cfg::contract::qte-hit-lock} to 6
	set {-cfg::contract::qte-miss-lock} to 10
	# Chop shops (staff: /dcontract chop add): the stolen car counts as delivered within this many blocks.
	set {-cfg::contract::chop-radius} to 6
	# Car spots and chop shops at least this far apart (/dcontract refuses closer ones).
	set {-cfg::contract::min-distance} to 50

	# ---------- Quest givers (quests.sk): PROPOSAL names ----------
	# Owner, 2026-09-26: quests are given in person by an NPC at a place (e.g. a scrap yard). Per kind: what it
	# gives (under the NPC's name), the NPC's name ("{place}" = the giver's place), the default place name,
	# and what it holds. Jobs and their tools only within quest::reach blocks of a giver of that kind.
	set {-cfg::quests::*} to "contracts", "story", "fence" and "hits"
	set {-cfg::quest::contracts::name} to "Car contracts"
	set {-cfg::quest::contracts::npc} to "{place} Boss"
	set {-cfg::quest::contracts::place} to "Scrap Yard"
	set {-cfg::quest::contracts::hold} to "flint"
	set {-cfg::quest::contracts::hold-model} to "donating:lockpick_basic"
	set {-cfg::quest::story::name} to "Missions"
	set {-cfg::quest::story::npc} to "Mara"
	set {-cfg::quest::story::place} to "Safehouse"
	set {-cfg::quest::story::hold} to "paper"
	set {-cfg::quest::fence::name} to "Wanted List"
	set {-cfg::quest::fence::npc} to "Vic"
	set {-cfg::quest::fence::place} to "Pawn Shop"
	set {-cfg::quest::fence::hold} to "gold_ingot"
	set {-cfg::quest::hits::name} to "Hit contracts"
	set {-cfg::quest::hits::npc} to "The Broker"
	set {-cfg::quest::hits::place} to "Pool Hall"
	set {-cfg::quest::hits::hold} to "book"
	set {-cfg::quest::reach} to 6

	# ---------- The story (story.sk): PROPOSAL texts, names and rewards ----------
	# Owner, 2026-09-27: a personal questline, like GTA. Mara (a quest giver of the kind "story") runs the player
	# through the game in five chapters. Per mission: chapter, from (the contact), label, obj, gps (story, contracts,
	# crate, heist[:safe|drill|adv|d4|finale|new], poi:shop:<word in the shop POI's name>), needs (what the map must
	# have, else it's skipped), brief (the text when it starts), done (the line when it's done), talk (Mara's lines
	# in person, for talk|story), rewards. Never delete a mission id: set story::<id>::retired true instead.
	# needs: heist, heist3 (3 heists the player can enter), safe, drill, adv, d4, finale, contracts, crate. Talk
	# missions have none: without Mara on the map, /missions has a Call Mara button.
	# A mission whose needs go missing (a heist disabled for a rebuild) is checked every needs-check seconds and
	# only skipped after needs-grace seconds in a row.
	# The chains (story.sk): each runs one mission at a time, side by side. Mara's list is story::missions.
	set {-cfg::story::chains::*} to "story" and "vic"
	set {-cfg::chain::story::giver} to "story"
	set {-cfg::chain::story::from} to "Mara"
	set {-cfg::chain::story::color} to "&d"
	set {-cfg::chain::story::bar} to "&d&lMISSION"
	set {-cfg::chain::story::barcolor} to "purple"
	# Vic the Fence (owner, 2026-09-27: "Vic the Fence"): his own arc from level 3, next to Mara's; its end hands
	# over his weekly Wanted List (fence.sk). PROPOSAL texts and rewards.
	set {-cfg::chain::vic::giver} to "fence"
	set {-cfg::chain::vic::from} to "Vic"
	set {-cfg::chain::vic::color} to "&6"
	set {-cfg::chain::vic::bar} to "&6&lVIC"
	set {-cfg::chain::vic::barcolor} to "yellow"
	set {-cfg::chain::vic::start} to "state|level|3"
	set {-cfg::chain::vic::needs} to "fence"
	set {-cfg::chain::vic::missions::*} to "v1_meet", "v2_appraisal", "v3_wheels", "v4_collector", "v5_auction" and "v6_end"
	loop "v1_meet", "v2_appraisal", "v3_wheels", "v4_collector", "v5_auction" and "v6_end":
		set {-cfg::story::%loop-value%::chain} to "vic"
	set {-cfg::story::v1_meet::label} to "Meet Vic at the Pawn Shop"
	set {-cfg::story::v1_meet::obj} to "talk|fence"
	set {-cfg::story::v1_meet::gps} to "fence"
	set {-cfg::story::v1_meet::brief} to "Mara says you've got quick hands. I buy what nobody else can sell. Come to the Pawn Shop."
	set {-cfg::story::v1_meet::talk::*} to "So you're Mara's kid.", "Jewels, cars, art. Things with a history." and "Show me you can bring me something worth my time."
	set {-cfg::story::v2_appraisal::label} to "Sell $4,000 from difficulty 2+ heists"
	set {-cfg::story::v2_appraisal::obj} to "ev|sell|4000|d2+"
	set {-cfg::story::v2_appraisal::gps} to "heist:d2+"
	set {-cfg::story::v2_appraisal::needs} to "d2+"
	set {-cfg::story::v2_appraisal::brief} to "Sell $4,000 of loot from medium heists or harder. Then we talk."
	set {-cfg::story::v2_appraisal::done} to "Hm. Not bad. Not bad at all."
	set {-cfg::story::v2_appraisal::rewards::*} to "money|2000" and "xp|50"
	set {-cfg::story::v3_wheels::label} to "Deliver a Pro car job"
	set {-cfg::story::v3_wheels::obj} to "ev|contract|1|pro+"
	set {-cfg::story::v3_wheels::gps} to "contracts"
	set {-cfg::story::v3_wheels::needs} to "contracts"
	set {-cfg::story::v3_wheels::brief} to "I've got buyers for fast cars. Deliver a Pro job for the Boss: he owes me."
	set {-cfg::story::v3_wheels::done} to "The buyer cried a little. Beautiful."
	set {-cfg::story::v3_wheels::rewards::*} to "money|3000" and "xp|75"
	set {-cfg::story::v4_collector::label} to "Crack a safe in a difficulty 3+ heist"
	set {-cfg::story::v4_collector::obj} to "ev|crack|1|d3+"
	set {-cfg::story::v4_collector::gps} to "heist:safe,d3+"
	set {-cfg::story::v4_collector::needs} to "safe,d3+"
	set {-cfg::story::v4_collector::brief} to "A collector wants what's in a hard heist's safe. Crack one: difficulty 3 or harder."
	set {-cfg::story::v4_collector::done} to "The collector says you have a gift. I say you have a Safe Kit."
	set {-cfg::story::v4_collector::rewards::*} to "money|4000" and "xp|100"
	set {-cfg::story::v5_auction::label} to "Drill a vault and lose the cops, in one run"
	set {-cfg::story::v5_auction::obj} to "combo|adv|drill,getaway"
	set {-cfg::story::v5_auction::gps} to "heist:adv,drill"
	set {-cfg::story::v5_auction::needs} to "adv,drill"
	set {-cfg::story::v5_auction::brief} to "Auction's Friday. I need a centerpiece: in one run of an alarmed heist, drill the vault and lose the cops with the loot."
	set {-cfg::story::v5_auction::done} to "Sold in four minutes. Kid... you're my favorite supplier."
	set {-cfg::story::v5_auction::rewards::*} to "money|6000" and "xp|150"
	set {-cfg::story::v6_end::label} to "Report to Vic"
	set {-cfg::story::v6_end::obj} to "talk|fence"
	set {-cfg::story::v6_end::gps} to "fence"
	set {-cfg::story::v6_end::brief} to "Come by the shop. I've got a proposition."
	set {-cfg::story::v6_end::talk::*} to "You've got taste, and you don't get caught.", "Here's my list. New names every Thursday." and "Bring me what's on it and I pay over the odds."
	set {-cfg::story::v6_end::rewards::*} to "cos|vic_guy", "key|season|1" and "fence|list"
	# Vic's weekly Wanted List (fence.sk): 3 orders a week for everyone, picked up in person at the Pawn Shop.
	# A heist order pays heist::rate on up to L1 = min(cap::<d>, pool-share x the pool) of your own loot from it; a
	# difficulty order diff::rate on up to cap::<d> of your own loot from heists that hard; a car order a flat pay once.
	set {-cfg::fence::level} to 3
	set {-cfg::fence::heist::rate} to 0.3
	set {-cfg::fence::heist::min-difficulty} to 2
	set {-cfg::fence::heist::pool-share} to 0.5
	set {-cfg::fence::heist::cap::2} to 6000
	set {-cfg::fence::heist::cap::3} to 15000
	set {-cfg::fence::heist::cap::4} to 40000
	set {-cfg::fence::diff::rate} to 0.15
	set {-cfg::fence::diff::cycle::*} to 3, 2 and 4
	set {-cfg::fence::diff::cap::2} to 9000
	set {-cfg::fence::diff::cap::3} to 22500
	set {-cfg::fence::diff::cap::4} to 60000
	set {-cfg::fence::car::tiers::*} to "basic" and "pro"
	set {-cfg::fence::car::basic::pay} to 1500
	set {-cfg::fence::car::pro::pay} to 4500
	# progress.sk: the week turns Thursday 00:00 UTC (seconds added to unix time move it), and run notes are kept
	# 14 days at most.
	set {-cfg::week::offset} to 0
	set {-cfg::progress::run-keep-days} to 14
	set {-cfg::story::needs-check} to 30
	set {-cfg::story::needs-grace} to 900
	set {-cfg::story::chapters::*} to 1, 2, 3, 4 and 5
	set {-cfg::story::chapter::1::name} to "Fresh Start"
	set {-cfg::story::chapter::2::name} to "Tools of the Trade"
	set {-cfg::story::chapter::3::name} to "Heavy Metal"
	set {-cfg::story::chapter::4::name} to "Heat"
	set {-cfg::story::chapter::5::name} to "The Big Score"
	set {-cfg::story::missions::*} to "c1_meet", "c1_gun", "c1_rob", "c1_sell", "c1_crate", "c1_level", "c1_end", "c2_safe", "c2_yard", "c2_street", "c2_duffel", "c2_bank", "c2_level", "c2_end", "c3_vest", "c3_drill", "c3_spread", "c3_car", "c3_level", "c3_end", "c4_getaway", "c4_pro", "c4_big", "c4_level", "c4_end", "c5_finale", "c5_level", "c5_master" and "c5_end"
	set {-cfg::story::c1_meet::chapter} to 1
	set {-cfg::story::c1_meet::label} to "Meet Mara at the Safehouse"
	set {-cfg::story::c1_meet::obj} to "talk|story"
	set {-cfg::story::c1_meet::gps} to "story"
	set {-cfg::story::c1_meet::brief} to "New in town? I've got work for someone with nerve. Come see me at the Safehouse."
	set {-cfg::story::c1_meet::talk::*} to "So you're the new face.", "This city runs on heists: banks, jewelers, vaults. All waiting." and "First, get yourself armed. The Gun Shop's on your GPS."
	set {-cfg::story::c1_gun::chapter} to 1
	set {-cfg::story::c1_gun::label} to "Buy a gun"
	set {-cfg::story::c1_gun::obj} to "state|gun"
	set {-cfg::story::c1_gun::gps} to "poi:shop:Gun"
	set {-cfg::story::c1_gun::brief} to "Pick up a piece at the Gun Shop. The .50 GS is cheap and does the job."
	set {-cfg::story::c1_gun::done} to "Nice. Now let's put it to use."
	set {-cfg::story::c1_rob::chapter} to 1
	set {-cfg::story::c1_rob::label} to "Rob a heist"
	set {-cfg::story::c1_rob::obj} to "ev|rob|1"
	set {-cfg::story::c1_rob::gps} to "heist"
	set {-cfg::story::c1_rob::needs} to "heist"
	set {-cfg::story::c1_rob::brief} to "There's an open heist on your GPS. Grab what you can and watch for traps."
	set {-cfg::story::c1_rob::done} to "That's the spirit. Now get out of there."
	set {-cfg::story::c1_sell::chapter} to 1
