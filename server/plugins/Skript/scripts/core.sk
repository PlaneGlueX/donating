	set {-cfg::jobs::tpl::double::beta} to 0.3
	set {-cfg::jobs::tpl::double::xp} to 40
	set {-cfg::jobs::tpl::double::rep} to 20
	set {-cfg::jobs::tpl::double::weight} to 25
	set {-cfg::jobs::tpl::double::bonuses::*} to "fast" and "clean"
	# Bonuses (★, +bonus-share): the job's name when it has one, and what it asks.
	set {-cfg::jobs::bonus::clock::name} to "In and Out"
	set {-cfg::jobs::bonus::clock::text} to "walk out with 2:00+ on the clock"
	set {-cfg::jobs::bonus::quiet::name} to "Quiet Hands"
	set {-cfg::jobs::bonus::quiet::text} to "the cops never chase you"
	set {-cfg::jobs::bonus::untouched::name} to "Ghost"
	set {-cfg::jobs::bonus::untouched::text} to "no trap touches you"
	set {-cfg::jobs::bonus::guesses::name} to "Code Breaker"
	set {-cfg::jobs::bonus::guesses::text} to "crack it in 5 guesses or fewer"
	set {-cfg::jobs::bonus::car::name} to "Wheelman"
	set {-cfg::jobs::bonus::car::text} to "lose them in a car"
	set {-cfg::jobs::bonus::fast::name} to "Speed Run"
	set {-cfg::jobs::bonus::fast::text} to "deliver within 4:00 of taking the car job"
	set {-cfg::jobs::bonus::clean::name} to "Clean Pick"
	set {-cfg::jobs::bonus::clean::text} to "pick the lock without a miss"
	# Rep: tiers per contact, a bound title at 2-4, a 4th slot at 4 (Family).
	set {-cfg::jobs::reptier::1::rep} to 0
	set {-cfg::jobs::reptier::1::name} to "Associate"
	set {-cfg::jobs::reptier::2::rep} to 150
	set {-cfg::jobs::reptier::2::name} to "Trusted"
	set {-cfg::jobs::reptier::3::rep} to 500
	set {-cfg::jobs::reptier::3::name} to "Partner"
	set {-cfg::jobs::reptier::4::rep} to 1200
	set {-cfg::jobs::reptier::4::name} to "Family"
	set {-cfg::jobs::mara::title::2} to "rep_mara_2"
	set {-cfg::jobs::mara::title::3} to "rep_mara_3"
	set {-cfg::jobs::mara::title::4} to "rep_mara_4"
	set {-cfg::jobs::boss::title::2} to "rep_boss_2"
	set {-cfg::jobs::boss::title::3} to "rep_boss_3"
	set {-cfg::jobs::boss::title::4} to "rep_boss_4"
	loop "rep_mara_2|Mara's Crew", "rep_mara_3|Mara's Partner", "rep_mara_4|Mara's Family", "rep_boss_2|Yard Regular", "rep_boss_3|Chop Specialist" and "rep_boss_4|Scrap King":
		set {_rt::*} to loop-value split at "|"
		set {-cfg::cos::%{_rt::1}%::type} to "title"
		set {-cfg::cos::%{_rt::1}%::name} to {_rt::2}
		set {-cfg::cos::%{_rt::1}%::rarity} to "story"
		set {-cfg::cos::%{_rt::1}%::bound} to true
		add {_rt::1} to {-cfg::cosmetics::*}
	# Texts.
	set {-cfg::jobs::mara::line::unlock} to "I said I'd call. Three jobs at the Safehouse, whenever you're ready."
	set {-cfg::jobs::boss::line::unlock} to "Got more work if you want it. Three jobs waiting at the Scrap Yard."
	set {-cfg::jobs::mara::line::text} to "Can't meet today. Sending the details."
	set {-cfg::jobs::boss::line::text} to "Can't meet today. Sending the details."
	set {-cfg::jobs::mara::line::void} to "Change of plans. Here's something else."
	set {-cfg::jobs::boss::line::void} to "Change of plans. Here's something else."
	set {-cfg::jobs::mara::line::done::*} to "Clean work.", "That'll do nicely." and "Knew I could count on you."
	set {-cfg::jobs::boss::line::done::*} to "Nice. Car's already in pieces.", "Good. Clean. Fast." and "That's how it's done."
	set {-cfg::jobs::mara::line::tier::2} to "You're reliable. I like reliable."
	set {-cfg::jobs::mara::line::tier::3} to "Partner. Don't let it go to your head."
	set {-cfg::jobs::mara::line::tier::4} to "You're family now. Act like it."
	set {-cfg::jobs::boss::line::tier::2} to "You don't scratch the paint. Good."
	set {-cfg::jobs::boss::line::tier::3} to "Partner. My yard's your yard."
	set {-cfg::jobs::boss::line::tier::4} to "Scrap King. Heh. Suits you."
	set {-cfg::jobs::mara::greet::*} to "Yes?", "Good to see you.", "Partner. What do you need?" and "There's my favorite."
	set {-cfg::jobs::boss::greet::*} to "Yeah?", "Oh, it's you.", "Partner." and "Kid! Come in."

	# ---------- Hit contracts (hits.sk): PROPOSAL numbers, names and texts ----------
	# Owner, 2026-09-27: one wanted target a week; Easy = in town twice a day for an hour, Medium = once a day, Hard =
	# 5 times spread over the week; harder pays more. Windows are shared and run only while the tier is active (2+
	# online, or a holder of that tier online). Every tier has the same 2 bodyguards (medium strength): only the
	# number of chances to catch the target changes. Pay is never boosted and gives no season points.
	set {-cfg::hit::tiers::*} to "easy", "medium" and "hard"
	set {-cfg::hit::easy::name} to "Easy contract"
	set {-cfg::hit::easy::when} to "In town twice a day, an hour each time"
	set {-cfg::hit::easy::windows} to 14
	set {-cfg::hit::easy::level} to 2
	set {-cfg::hit::easy::pay} to 10000
	set {-cfg::hit::easy::xp} to 100
	set {-cfg::hit::easy::r0} to 120
	set {-cfg::hit::easy::rmin} to 30
	set {-cfg::hit::easy::tip} to 60
	set {-cfg::hit::medium::name} to "Medium contract"
	set {-cfg::hit::medium::when} to "In town once a day, for an hour"
	set {-cfg::hit::medium::windows} to 7
	set {-cfg::hit::medium::level} to 3
	set {-cfg::hit::medium::pay} to 25000
	set {-cfg::hit::medium::xp} to 250
	set {-cfg::hit::medium::r0} to 160
	set {-cfg::hit::medium::rmin} to 40
	set {-cfg::hit::medium::tip} to 90
	set {-cfg::hit::hard::name} to "Hard contract"
	set {-cfg::hit::hard::when} to "In town 5 times a week, an hour each time"
	set {-cfg::hit::hard::windows} to 5
	set {-cfg::hit::hard::level} to 4
	set {-cfg::hit::hard::pay} to 60000
	set {-cfg::hit::hard::xp} to 600
	set {-cfg::hit::hard::keys} to 1
	set {-cfg::hit::hard::r0} to 200
	set {-cfg::hit::hard::rmin} to 50
	set {-cfg::hit::hard::tip} to 120
	# A window: its length in active seconds, and up to overtime seconds more while the hunter is fighting.
	set {-cfg::hit::window-length} to 3600
	set {-cfg::hit::overtime} to 300
	# Dying to a bodyguard: L = min(B x death-p, C), C = the bag's capacity (like a death outside a heist).
	set {-cfg::hit::death-p} to 0.03
	# Streaks: each week in a row adds streak-bonus to the pay (at most streak-max weeks' worth; one missed week is
	# forgiven); titles at 3, 6 and 10 weeks; "Hitman" after pro-at Hard takedowns.
	set {-cfg::hit::streak-bonus} to 0.05
	set {-cfg::hit::streak-max} to 4
	set {-cfg::hit::streak-titles::*} to "3|hit_streak_3", "6|hit_streak_6" and "10|hit_streak_10"
	set {-cfg::hit::pro-at} to 5
	# The target walks the street nodes (/dhit node) at walk-speed blocks/s, starts at least start-away blocks from
	# the hunter, becomes an NPC within materialize blocks and goes back to a walker past dematerialize (10 s); seen
	# within spot-range for a second = spotted. At most cap hit NPCs on the server (3 per hunter).
	set {-cfg::hit::walk-speed} to 1.3
	set {-cfg::hit::start-away} to 150
	set {-cfg::hit::materialize} to 64
	set {-cfg::hit::dematerialize} to 96
	set {-cfg::hit::spot-range} to 40
	set {-cfg::hit::cap} to 15
	set {-cfg::hit::chase} to 48
	set {-cfg::hit::target-health} to 40
	set {-cfg::hit::target-speed} to 1.25
	# The bodyguards: difficulty 2's cop numbers, a .50 GS, and a "shot" = a Sentinel hit from up to guard-reach
	# blocks with line of sight (no projectile anyone else could see or be hit by).
	set {-cfg::hit::guards} to 2
	set {-cfg::hit::guard-name} to "Hired Gun"
	set {-cfg::hit::guard-model} to 9
	set {-cfg::hit::guard-health} to 20
	set {-cfg::hit::guard-damage} to 2.5
	set {-cfg::hit::guard-rate} to 1.75
	set {-cfg::hit::guard-reach} to 16
	set {-cfg::hit::guard-speed} to 1.2
	# The targets: one a week, never one of the last two. npc = the NPC's name (hidden; a space in it keeps Citizens
	# from showing the skin of a Minecraft account with that name). skin-texture / skin-signature: optional.
	set {-cfg::hit::targets::*} to "vinnie", "dmitri", "sal", "rico", "pike" and "lena"
	loop "vinnie|Vinnie Marchetti|Vinnie M|Skimmed the Broker's cut from three bank jobs.|a white suit and a gold chain", "dmitri|Dmitri Volkov|Dmitri V|Sold a whole crew out to the cops.|a black coat, shaved head", "sal|Sal Esposito|Sal E|Runs fake IDs on the Broker's turf.|a brown jacket and a cap", "rico|Rico Vance|Rico V|Hijacked a truck meant for the Broker.|a red hoodie", "pike|Officer Pike|Officer P|A crooked cop on three payrolls.|a blue uniform shirt" and "lena|Lena Kross|Lena K|Double-crossed the Broker on a vault job.|a green jacket":
		set {_ht::*} to loop-value split at "|"
		set {-cfg::hit::target::%{_ht::1}%::name} to {_ht::2}
		set {-cfg::hit::target::%{_ht::1}%::npc} to {_ht::3}
		set {-cfg::hit::target::%{_ht::1}%::crime} to {_ht::4}
		set {-cfg::hit::target::%{_ht::1}%::looks} to {_ht::5}
	loop "hit_streak_3|Cleaner", "hit_streak_6|Professional", "hit_streak_10|The Reaper" and "hit_pro|Hitman":
		set {_rt::*} to loop-value split at "|"
		set {-cfg::cos::%{_rt::1}%::type} to "title"
		set {-cfg::cos::%{_rt::1}%::name} to {_rt::2}
		set {-cfg::cos::%{_rt::1}%::rarity} to "story"
		set {-cfg::cos::%{_rt::1}%::bound} to true
		add {_rt::1} to {-cfg::cosmetics::*}
	set {-cfg::loaded} to true

# Reads a setting by key, e.g. cfg("bag::2::capacity"). Loads settings first if another script
# asks before core.sk's own load event has run (possible at server start).
# A missing key is logged to the console, so a typo shows up instead of an empty value.
# For settings that are optional on purpose (e.g. a per-heist override), read {-cfg::...} directly.
function cfg(key: text) :: object:
	if {-cfg::loaded} is not set:
		loadSettings()
	set {_value} to {-cfg::%{_key}%}
	if {_value} is not set:
		send "[Donating] Missing setting: %{_key}%" to console
	return {_value}

# ---------- Money ----------

# 1234567.8 -> "$1,234,567" (whole dollars, rounded down).
function formatMoney(amount: number) :: text:
	set {_n} to floor(abs({_amount}))
	set {_out} to ""
	while {_n} >= 1000:
		set {_chunk} to "%mod({_n}, 1000)%"
		while length of {_chunk} < 3:
			set {_chunk} to "0%{_chunk}%"
		set {_out} to ",%{_chunk}%%{_out}%"
		set {_n} to floor({_n} / 1000)
	if {_amount} <= -1:
		return "-$%{_n}%%{_out}%"
	return "$%{_n}%%{_out}%"

# 75 -> "1:15", 5 -> "0:05"; negative counts as 0. For countdowns (heists.sk, hud.sk).
function formatClock(seconds: number) :: text:
	set {_s} to max(0, ceil({_seconds}))
	set {_m} to floor({_s} / 60)
	set {_r} to mod({_s}, 60)
	if {_r} < 10:
		return "%{_m}%:0%{_r}%"
	return "%{_m}%:%{_r}%"

# 1234567 -> "$1.2M", 15300 -> "$15.3K", 950 -> "$950". For tight spaces like the sidebar.
function formatMoneyShort(amount: number) :: text:
	set {_a} to abs({_amount})
	if {_a} >= 1000000000:
		set {_out} to "%floor({_a} / 100000000) / 10%B"
	else if {_a} >= 1000000:
		set {_out} to "%floor({_a} / 100000) / 10%M"
	else if {_a} >= 1000:
		set {_out} to "%floor({_a} / 100) / 10%K"
	else:
		set {_out} to "%floor({_a})%"
	if {_amount} <= -1:
		return "-$%{_out}%"
	return "$%{_out}%"

# Balance changes go through these so nothing can push a balance below $0.
function giveMoney(p: offline player, amount: number):
	if {_amount} > 0:
		add {_amount} to balance of {_p}

# All or nothing: true = the whole price was taken (shop purchases). A balance that didn't drop is
# reported and counts as not paid.
function chargeMoney(p: offline player, price: number) :: boolean:
	if {_price} <= 0:
		return true
	set {_before} to balance of {_p}
	if {_before} < {_price}:
		return false
	remove {_price} from balance of {_p}
	if balance of {_p} > {_before} - {_price} + 0.001:
		send "[Donating] chargeMoney: %{_p}% was not charged %{_price}%" to console
		return false
	return true

# Takes up to `amount`; returns how much was actually taken.
function takeMoney(p: offline player, amount: number) :: number:
	set {_taken} to min({_amount}, balance of {_p})
	if {_taken} > 0:
		remove {_taken} from balance of {_p}
		return {_taken}
	return 0

# ---------- Player data ----------

function getData(p: offline player, key: text) :: object:
	return {data::%{_p}%::%{_key}%}

function setData(p: offline player, key: text, value: object):
	set {data::%{_p}%::%{_key}%} to {_value}

function deleteData(p: offline player, key: text):
	delete {data::%{_p}%::%{_key}%}

# ---------- Messages ----------

# Sends a message with the server prefix. Color codes (&a, &7...) in `text` work.
# `colored` only parses safe tags (colors, bold, reset...). Never use `formatted` on text that can
# contain player input: it also parses click/hover tags, so a player could plant a clickable command.
function msg(p: player, text: text):
	send colored "%cfg("prefix")%%{_text}%" to {_p}

function broadcastMsg(text: text):
	broadcast colored "%cfg("prefix")%%{_text}%"

# A text component (e.g. the chat message) as a string with § codes, keeping < and & as typed.
# Putting it in a string ("%message%") gives MiniMessage text instead, where "<" becomes "\<".
function legacyText(t: text) :: text:
	return {_t}

# ---------- Custom items ----------
# Every custom item carries a hidden id in its custom data, e.g. "phone", "bag:2".
# Never use a diamond hoe for custom items: it's MTVehicles' car item.

function tagItem(i: item, id: text) :: item:
	set string tag "donating_id" of custom nbt of {_i} to {_id}
	return {_i}

# The item's id, or "" for items without one.
function itemId(i: item) :: text:
	set {_id} to string tag "donating_id" of custom nbt of {_i}
	if {_id} is set:
		return {_id}
	return ""

# WeaponMechanics keeps its item data in the PDC (custom_data.PublicBukkitValues); SkBee's path
# separator is ";". The weapon title ("AK_47") or "", and the rounds loaded.
function wmTitle(i: item) :: text:
	set {_t} to string tag "PublicBukkitValues;weaponmechanics:weapon-title" of custom nbt of {_i}
	if {_t} is set:
		return {_t}
	return ""

function wmLoaded(i: item) :: number:
	set {_n} to int tag "PublicBukkitValues;weaponmechanics:ammo-left" of custom nbt of {_i}
	if {_n} is set:
		return {_n}
	return 0

# ---------- Permissions ----------

# Staff kicks (console, or a player with essentials.kick): the kicked player is flagged for 3 s, so the
# quit handlers can tell them from a kick the player caused (chat spam, a timed-out client), which
# counts as a normal logout (combat-log.sk, heists.sk). A server stop never reaches quit handlers.
on command:
	set {_parts::*} to command split at ":"
	set {_cmd} to last element of {_parts::*} in lower case
	if {_cmd} is not "kick":
		if {_cmd} is not "ekick":
			stop
	if player is set:
		if player does not have permission "essentials.kick":
			stop
	set {_args::*} to full command split at " "
	set {_k} to {_args::2}
	{_k} is set
	set {_k} to {_k} in lower case
	set {-staffkick::%{_k}%} to true
	wait 3 seconds
	delete {-staffkick::%{_k}%}

function staffKicked(p: player) :: boolean:
	set {_k} to name of {_p} in lower case
	if {-staffkick::%{_k}%} is true:
		return true
	return false

# A Citizens NPC (a cop, cops.sk). Citizens drops the "NPC" metadata of a dead NPC in its own death
# handler, so later death handlers also check its CITIZENS_NPC scoreboard tag, which stays.
function isNpc(e: entity) :: boolean:
	if {_e} has metadata "NPC":
		return true
	if {_e} has scoreboard tag "CITIZENS_NPC":
		return true
	return false

# True while a Citizens NPC is being made (cops.sk, hits.sk): one at a time on the whole server, so the new NPC
# with that name at the spot is the one just made. At most 3 s (a stuck flag can't block NPCs for good).
function npcBusy() :: boolean:
	if {-npc::busy} is set:
		if difference between {-npc::busy} and now < 3 seconds:
			return true
	return false

function isStaff(p: player) :: boolean:
	if {_p} has permission "donating.staff":
		return true
	return false
