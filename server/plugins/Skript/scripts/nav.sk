# nav.sk: who shows up on the phone's GPS map and on the locator bar.
#
# Phone map: every player's phone is their own map id, drawn by the DonatingPhone plugin (phone.sk has
# the controls). The plugin draws the viewer, plus every player with the scoreboard tag
# "donating_passive" as a green arrow with a green name. Nobody else ever shows up.
# Locator bar (the 1.21.6+ bar above the hotbar): players send no waypoint unless passive, then a
# green dot. Without this, vanilla shows every player to everyone.
#
# pvp.sk owns passive mode's rules (switch cooldown, bounties) and calls setPassive().

function isPassive(p: offline player) :: boolean:
	if getData({_p}, "passive") is true:
		return true
	return false

# Puts a player's map and locator-bar visibility in line with their passive state.
function applyMapVisibility(p: player):
	# Before the phone plugin, a "map cloak" in the boots slot hid players: take any old one off.
	if itemId(boots of {_p}) is "map-cloak":
		set boots of {_p} to air
	if isPassive({_p}) is true:
		add "donating_passive" to scoreboard tags of {_p}
		execute console command "attribute %{_p}% minecraft:waypoint_transmit_range base set %cfg("nav::passive-range")%"
		execute console command "waypoint modify %{_p}% color green"
	else:
		remove "donating_passive" from scoreboard tags of {_p}
		execute console command "attribute %{_p}% minecraft:waypoint_transmit_range base set 0"

# Turns passive mode on or off and tells the player who can see them now.
function setPassive(p: player, on: boolean):
	if {_on} is true:
		setData({_p}, "passive", true)
		applyMapVisibility({_p})
		msg({_p}, "Passive mode &aon&7. Other players can now see you on their map and compass.")
	else:
		deleteData({_p}, "passive")
		applyMapVisibility({_p})
		msg({_p}, "Passive mode &coff&7. You're hidden from other players' maps again.")

# Inside a heist a robber receives no waypoints, so the XP fill bar (the bag meter) shows instead of
# the locator bar (CLAUDE.md, Navigation). "base reset" puts back the player default (6.0E7).
function applyWaypointReceive(p: player):
	if heistOf({_p}) is not "":
		execute console command "attribute %{_p}% minecraft:waypoint_receive_range base set 0"
	else:
		execute console command "attribute %{_p}% minecraft:waypoint_receive_range base reset"

on join:
	applyMapVisibility(player)
	applyWaypointReceive(player)

on respawn:
	wait 1 tick
	player is online
	applyMapVisibility(player)
	applyWaypointReceive(player)

# ---------- Points of interest on the locator bar (2026-09-26) ----------
# A POI is an invisible marker armor stand that sends a colored waypoint to every player: the base,
# shops, the spawn, landmarks (staff: /dpoi), and every heist while it's open or running (at its
# hologram, in its difficulty's color; off while it cools down). Robbers inside a heist receive no
# waypoints (applyWaypointReceive above), so the ammo bar stays there. A waypoint entity is only sent
# while its chunk is loaded, so every POI's chunk is force-loaded. Stands are summoned like the
# shopkeepers: every 10 s each POI gets exactly one (a missing one comes back, extras go). Quest givers
# (quests.sk) get one too ("q_<n>", poi::quest::color), always shown.
# Saved: {poi::<n>} = "type|world|x|y|z|name" (only POIs under poi::, the counter is {poicounter}). Colors: core.sk poi::<type>::color and
# difficulty::<d>::waypoint (names from Minecraft's /waypoint command: aqua, yellow, gold, ...). POIs live in
# the main world (Nether and End are off): the console summons them there, so /dpoi refuses other worlds
# and a heist in another world gets no POI. Each POI remembers where its stand is ({poiat::<id>}) and
# which chunk it force-loaded ({poichunk::<id>} = "cx:cz"): a POI that moves (a heist's hologram set
# again) loses its old stand, and a chunk no POI uses any more is released.

function poiTag(id: text) :: text:
	return "poi_%{_id}%"

# The world the console's summon lands in (the first world the server lists).
function poiMainWorld() :: world:
	loop all worlds:
		return loop-value

# Releases a POI's force-loaded chunk unless another POI still sits in it, and forgets its stand.
function poiRelease(id: text):
	set {_c} to {poichunk::%{_id}%}
	delete {poichunk::%{_id}%}
	delete {poiat::%{_id}%}
	delete {-poi::state::%{_id}%}
	{_c} is set
	loop {poichunk::*}:
		if loop-value is {_c}:
			stop
	set {_p::*} to {_c} split at ":"
	set {_bx} to ({_p::1} parsed as number) * 16
	set {_bz} to ({_p::2} parsed as number) * 16
	execute console command "forceload remove %{_bx}% %{_bz}%"

# The stand of a POI (staff ones by number, heists by "h_<id>"), summoned if missing.
function poiEnsure(id: text, l: location, color: text, on: boolean):
	set {_tag} to poiTag({_id})
	if world of {_l} is not poiMainWorld():
		if {-poi::warned::%{_id}%} is not set:
			set {-poi::warned::%{_id}%} to true
			send "[Donating] nav: POI %{_id}% is outside the main world; it gets no stand" to console
		stop
	# Moved (a heist's hologram set again): the old stand and its chunk go first.
	set {_ax} to x-coordinate of {_l}
	set {_ay} to y-coordinate of {_l}
	set {_az} to z-coordinate of {_l}
	set {_ax} to round({_ax} * 100) / 100
	set {_ay} to round({_ay} * 100) / 100
	set {_az} to round({_az} * 100) / 100
	set {_at} to "%world of {_l}%:%{_ax}%:%{_ay}%:%{_az}%"
	if {poiat::%{_id}%} is set:
		if {poiat::%{_id}%} is not {_at}:
			execute console command "minecraft:kill @e[tag=%{_tag}%]"
			poiRelease({_id})
			stop
	set {poiat::%{_id}%} to {_at}
	set {_n} to 0
	loop all entities in radius 2 around {_l}:
		if loop-entity has scoreboard tag {_tag}:
			add 1 to {_n}
			if {_n} > 1:
				kill loop-entity
	set {_range} to 0
	if {_on} is true:
		set {_range} to cfg("poi::range")
	if {_n} is 0:
		set {_x} to x-coordinate of {_l}
		set {_y} to y-coordinate of {_l}
		set {_z} to z-coordinate of {_l}
		set {_cx} to floor({_x} / 16)
		set {_cz} to floor({_z} / 16)
		execute console command "forceload add %{_cx} * 16% %{_cz} * 16%"
		set {poichunk::%{_id}%} to "%{_cx}%:%{_cz}%"
		execute console command "summon minecraft:armor_stand %{_x}% %{_y}% %{_z}% {Tags:[""donating_poi"",""%{_tag}%""],Invisible:1b,Invulnerable:1b,NoGravity:1b,Silent:1b,Marker:1b}"
		# A new stand has the default range and color: always set them.
		delete {-poi::state::%{_id}%}
	# A stand summoned before chunks were tracked: remember its chunk now.
	if {poichunk::%{_id}%} is not set:
		set {poichunk::%{_id}%} to "%floor(x-coordinate of {_l} / 16)%:%floor(z-coordinate of {_l} / 16)%"
	# Every pass: the color, the icon and whether it's shown (cheap, and survives /waypoint or attribute edits).
	set {_style} to poiStyle({_id})
	if {-poi::state::%{_id}%} is not "%{_color}%:%{_range}%:%{_style}%":
		execute console command "attribute @e[tag=%{_tag}%,limit=1] minecraft:waypoint_transmit_range base set %{_range}%"
		execute console command "waypoint modify @e[tag=%{_tag}%,limit=1] color %{_color}%"
		if {_style} is "default":
			execute console command "waypoint modify @e[tag=%{_tag}%,limit=1] style reset"
		else:
			execute console command "waypoint modify @e[tag=%{_tag}%,limit=1] style set %{_style}%"
		set {-poi::state::%{_id}%} to "%{_color}%:%{_range}%:%{_style}%"

# A POI's locator-bar icon (core.sk poi::<kind>::style): heists "h_<id>", quest givers "q_<n>", staff POIs by their type.
function poiStyle(id: text) :: text:
	set {_k} to "none"
	if {_id} starts with "h_":
		set {_k} to "heist"
	else if {_id} starts with "q_":
		set {_k} to "quest"
	else if {poi::%{_id}%} is set:
		set {_p::*} to {poi::%{_id}%} split at "|"
		set {_k} to {_p::1}
	set {_s} to "default"
	if {-cfg::poi::%{_k}%::style} is set:
		set {_s} to {-cfg::poi::%{_k}%::style}
	return {_s}

function poiLocation(v: text) :: location:
	set {_p::*} to {_v} split at "|"
	return location(({_p::3} parsed as number), ({_p::4} parsed as number), ({_p::5} parsed as number), world({_p::2}))

function poiReconcile():
	loop {poi::*}:
		set {_p::*} to loop-value split at "|"
		set {_color} to {-cfg::poi::%{_p::1}%::color}
		if {_color} is not set:
			set {_color} to "white"
		poiEnsure(loop-index, poiLocation(loop-value), {_color}, true)
	# Heists: at the hologram (else the region's centre), shown while open or running.
	loop {heists::*}:
		set {_h} to loop-index
		set {_l} to {heist::%{_h}%::holo}
		if {_l} is not set:
			set {_l} to heistCenter({_h})
		if {_l} is set:
			set {_s} to heistState({_h})
			set {_on} to false
			if {_s} is "open":
				set {_on} to true
			else if {_s} is "active":
				set {_on} to true
			set {_d} to heistDifficulty({_h})
			set {_color} to {-cfg::difficulty::%{_d}%::waypoint}
			if {_color} is not set:
				set {_color} to "red"
			poiEnsure("h_%{_h}%", {_l}, {_color}, {_on})
	# Quest givers (quests.sk): a dot at each, always shown.
	loop {quest::giver::*}:
		set {_l} to questLoc(loop-index)
		if {_l} is set:
			set {_color} to {-cfg::poi::quest::color}
			if {_color} is not set:
				set {_color} to "blue"
			poiEnsure("q_%loop-index%", {_l}, {_color}, true)
	# Stands nothing refers to any more (a removed POI, a deleted heist) go.
	loop all entities:
		if loop-entity has scoreboard tag "donating_poi":
			set {_known} to false
			loop scoreboard tags of loop-entity:
				if loop-value-2 starts with "poi_h_":
					set {_hid} to subtext of loop-value-2 from characters 7 to (length of loop-value-2)
					if {heists::%{_hid}%} is set:
						set {_known} to true
				else if loop-value-2 starts with "poi_q_":
					set {_qid} to subtext of loop-value-2 from characters 7 to (length of loop-value-2)
					if {quest::giver::%{_qid}%} is set:
						set {_known} to true
				else if loop-value-2 starts with "poi_":
					set {_pid} to subtext of loop-value-2 from characters 5 to (length of loop-value-2)
					if {poi::%{_pid}%} is set:
						set {_known} to true
			if {_known} is false:
				kill loop-entity
	# ...and their force-loaded chunks.
	loop {poichunk::*}:
		set {_id} to loop-index
		set {_known} to false
		if {_id} starts with "h_":
			set {_hid} to subtext of {_id} from characters 3 to (length of {_id})
			if {heists::%{_hid}%} is set:
				set {_known} to true
		else if {_id} starts with "q_":
			set {_qid} to subtext of {_id} from characters 3 to (length of {_id})
			if {quest::giver::%{_qid}%} is set:
				set {_known} to true
		else if {poi::%{_id}%} is set:
			set {_known} to true
		if {_known} is false:
			poiRelease({_id})

every 10 seconds:
	poiReconcile()
	poiMapReconcile()

# ---------- The places on the phone's map (2026-09-28; CLAUDE.md's ideas: "POI icons on the phone map") ----------
# Every POI also shows on the phone's map as a colored banner (DonatingPhone's /dphone place: base light blue, shop orange,
# spawn white, landmark magenta, garage cyan, quest givers blue, heists by difficulty: a store light gray, then lime,
# yellow, red, black), its name while the big map's cursor is on it (a left-click there pins it: gps.sk snaps to POIs).
# Heists only while open or running, like their locator dot. Sent when a place changes ({-mapplace::<id>} = what was
# sent) and all again every minute (the plugin keeps them in memory: a restart of it forgets them).
function poiMapWant(id: text, type: text, l: location, name: text):
	set {_x} to x-coordinate of {_l}
	set {_z} to z-coordinate of {_l}
	set {-mapwant::%{_id}%} to "%{_type}% %world of {_l}% %round({_x})% %round({_z})% %{_name}%"

function poiMapReconcile():
	delete {-mapwant::*}
	loop {poi::*}:
		set {_p::*} to loop-value split at "|"
		set {_name} to {_p::6}
		if {_name} is not set:
			set {_name} to "%{_p::1}%"
		if "%{_name}%" is "":
			set {_name} to "%{_p::1}%"
		poiMapWant("p%loop-index%", {_p::1}, poiLocation(loop-value), "%{_name}%")
	loop {heists::*}:
		set {_h} to loop-index
		set {_s} to heistState({_h})
		set {_on} to false
		if {_s} is "open":
			set {_on} to true
		else if {_s} is "active":
			set {_on} to true
		if {_on} is true:
			set {_l} to {heist::%{_h}%::holo}
			if {_l} is not set:
				set {_l} to heistCenter({_h})
			if {_l} is set:
				poiMapWant("h%{_h}%", "heist%heistDifficulty({_h})%", {_l}, heistName({_h}))
	loop {quest::giver::*}:
		set {_l} to questLoc(loop-index)
		if {_l} is set:
			poiMapWant("q%loop-index%", "quest", {_l}, "%questNpcName(loop-index)% (%questPlace(loop-index)%)")
	# Places that are gone first (before the minute's reset below forgets what was sent: review of this change).
	loop {-mapplace::sent::*}:
		if {-mapwant::%loop-index%} is not set:
			add loop-index to {_gone::*}
	loop {_gone::*}:
		delete {-mapplace::sent::%loop-value%}
		execute console command "dphone place remove %loop-value%"
	# Everything again every minute: the plugin forgets its places first (in the same tick: nothing flickers), so nothing
	# the plugin still has can be left behind, and a restarted plugin gets them all.
	add 1 to {-mapplace::pass}
	if {-mapplace::pass} >= 6:
		set {-mapplace::pass} to 0
		delete {-mapplace::sent::*}
		execute console command "dphone place clear"
	loop {-mapwant::*}:
		if {-mapplace::sent::%loop-index%} is not loop-value:
			set {-mapplace::sent::%loop-index%} to loop-value
			execute console command "dphone place set %loop-index% %loop-value%"

on load:
	wait 3 seconds
	delete {-poi::state::*}
	# The counter used to live inside the list (it was read as a POI): moved out.
	if {poi::next} is set:
		set {poicounter} to {poi::next}
		delete {poi::next}
	poiReconcile()

command /dpoi [<text>]:
	permission: donating.staff
	permission message: &cStaff only.
	trigger:
		set {_a::*} to arg-1 split at " "
		set {_sub} to {_a::1}
		if {_sub} is "add":
			if sender is not a player:
				send "POI add: in game only (stand on the spot)" to sender
				stop
			if world of player is not poiMainWorld():
				send "POI add: only in the main world (%poiMainWorld()%)" to sender
				stop
			set {_type} to {_a::2}
			if {-cfg::poi::types::*} does not contain {_type}:
				set {_all} to join {-cfg::poi::types::*} with ", "
				send "POI add: /dpoi add <%{_all}%> [name]" to sender
				stop
			set {_name} to ""
			if size of {_a::*} > 2:
				loop integers from 3 to size of {_a::*}:
					set {_name} to "%{_name}% %{_a::%loop-value%}%"
			add 1 to {poicounter}
			set {_id} to "%{poicounter}%"
			set {_x} to floor(x-coordinate of player) + 0.5
			set {_y} to y-coordinate of player
			set {_z} to floor(z-coordinate of player) + 0.5
			set {poi::%{_id}%} to "%{_type}%|%world of player%|%{_x}%|%{_y}%|%{_z}%|%{_name}%"
			poiReconcile()
			send "POI %{_id}% %{_type}% at %{_x}% %{_y}% %{_z}%%{_name}%" to sender
		else if {_sub} is "remove":
			set {_id} to {_a::2}
			if {poi::%{_id}%} is not set:
				send "POI remove: no POI %{_id}% (/dpoi list)" to sender
				stop
			set {_tag} to poiTag({_id})
			execute console command "minecraft:kill @e[tag=%{_tag}%]"
			delete {poi::%{_id}%}
			poiRelease({_id})
			send "POI %{_id}% removed" to sender
		else if {_sub} is "list":
			loop {poi::*}:
				send "POI %loop-index%: %loop-value%" to sender
			send "POI end" to sender
		else if {_sub} is "dump":
			# The lines to run on Minehut: stand there and add (or teleport first).
			loop {poi::*}:
				set {_p::*} to loop-value split at "|"
				send "/minecraft:tp @s %{_p::3}% %{_p::4}% %{_p::5}% then /dpoi add %{_p::1}%%{_p::6}%" to sender
		else:
			send "POI usage: /dpoi add <type> [name] | remove <n> | list | dump" to sender
