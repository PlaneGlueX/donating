# phone.sk: the phone's controls and its apps menu. The DonatingPhone plugin draws the screen; nav.sk
# decides who shows up on it.
#   - Hold the phone (hotbar 9): a GPS map that follows you (small, next to the bag).
#   - Right-click: opens the big map (the whole city). The bag leaves the offhand while it's open,
#     because a map only shows big and centered with an empty offhand. Right-click again, switch
#     slots, press F, die or leave: it closes and the bag comes back.
#   - F (swap-hand key): the apps menu below.
# The plugin reads the scoreboard tag "donating_phone_open" to know which view to draw.
#
# The home screen (6 rows, drawn as a phone: ui.sk, toolsmake-phone-ui.js; slots on its screen, columns 2-6):
#    2 crates   3 cosmetics   4 season   5 bounties   6 you (your head)
#   11 passive mode   12 how to play
#   the dock: 38 messages   39 GPS (quests, heists, shops, places: gps.sk)   40 missions   41 garage   42 bag
#   49 the home button (close)
# Each app opens its script's menu (garage: garage.sk's garageMenu, your cars); every app's main page has "◀ Phone"
# back here (the Back buttons section below). Bounties shows bounty.sk's list in chat. The big map doesn't open while
# driving (a stolen car keeps the phone in slot 9); left-click on it drops a GPS pin (the plugin runs gps.sk's /gpspick).
#
# Every click is cancelled while the menu is open, also for staff with the inventory bypass. This
# runs at Skript's default priority, before inventory.sk's lock (CLAUDE.md: GUI menus).
# Memory only: {-phone::gui::<uuid>} = the player's open apps menu, {-phone::clicked::<uuid>} = last
# right-click.

on right click:
	itemId(player's tool) is "phone"
	# Skript's click event also covers entities: NPC shops, other players and cars must still work.
	clicked entity is not set
	cancel event
	# One right-click on a block can arrive as two clicks (block, then air), and holding the button
	# repeats the click every 0.2 s: every click restarts the 0.3 s wait, so it toggles once.
	set {_last} to {-phone::clicked::%player%}
	set {-phone::clicked::%player%} to now
	# Owner, 2026-09-27: no block use with the phone out. A button, door, lever and the like isn't used and
	# the map stays as it is (a quiet hint says why); a plain block toggles the map.
	if event-block is set:
		if phoneUsable(event-block) is true:
			phoneHint(player, "use that")
			stop
	if {_last} is set:
		if difference between {_last} and now < 0.3 seconds:
			stop
	if player has scoreboard tag "donating_phone_open":
		closePhoneMap(player)
	else:
		openPhoneMap(player)

# Blocks a player would use with a right-click (by the block's name: "oak button", "iron trapdoor", ...).
function phoneUsable(b: block) :: boolean:
	set {_t} to "%type of {_b}%"
	loop "button", "lever", "door", "fence gate", "bell", "note block", "repeater", "comparator", "daylight detector", "chest", "barrel", "shulker box", "hopper", "dispenser", "dropper", "furnace", "smoker", "anvil", "table", "lectern", "loom", "grindstone", "stonecutter", "brewing stand", "beacon", "jukebox", " bed", "cake", "candle", "composter", "cauldron", "campfire", "flower pot", "respawn anchor", "sign", "crafter" and "vault":
		if {_t} contains loop-value:
			return true
	return false

# The quiet hint for something the phone in hand stops (a block, loot): the action bar, at most once a second.
# It also swallows the click's second half (block, then air), so the map doesn't toggle right after.
function phoneHint(p: player, what: text):
	set {-phone::clicked::%{_p}%} to now
	if {-phone::hintat::%{_p}%} is set:
		if difference between {-phone::hintat::%{_p}%} and now < 1 second:
			stop
	set {-phone::hintat::%{_p}%} to now
	hudBar({_p}, "&7Put your phone away to %{_what}%.", 1)

# The tag first, so inventory.sk's watchdog doesn't put the bag straight back. Only the bag leaves
# the offhand: anything else there (staff with the inventory bypass) stays, and the map stays small.
function openPhoneMap(p: player):
	# Not while driving (a stolen car keeps the phone in slot 9): the held phone's GPS view still shows.
	if carSeatOf({_p}) starts with "driver:":
		hudBar({_p}, "&7Stop the car to open the big map.", 1)
		stop
	add "donating_phone_open" to scoreboard tags of {_p}
	if itemId(offhand tool of {_p}) starts with "bag:":
		set offhand tool of {_p} to air
	else if itemId(offhand tool of {_p}) is "hands":
		set offhand tool of {_p} to air
	play sound "item.book.page_turn" with volume 0.6 to {_p}
	# Once per player: how to drop a GPS pin (gps.sk).
	if getData({_p}, "gps-tip") is not set:
		setData({_p}, "gps-tip", true)
		msg({_p}, "&bTip: &7left-click the big map to drop a GPS pin where the cursor is (aim with your head). The GPS shows the way along the roads. &f/gps")

# Does nothing when the big map isn't open.
function closePhoneMap(p: player):
	{_p} has scoreboard tag "donating_phone_open"
	remove "donating_phone_open" from scoreboard tags of {_p}
	if offhand tool of {_p} is air:
		applyBag({_p})
	play sound "item.book.page_turn" with volume 0.4 and pitch 0.8 to {_p}

on held item change:
	closePhoneMap(player)

# Getting hurt closes the big map (2026-09-29, from the ideas list): while it's open the camera is tilted and the bag
# is off, so a player reading the map couldn't fight back. Monitor: only a hit that lands.
on damage of player with priority monitor:
	victim has scoreboard tag "donating_phone_open"
	closePhoneMap(victim)
	hudBar(victim, "&7Hit: your map closed.", 1)

# F with the phone in hand: the apps menu. Runs before inventory.sk's lock (priority highest), which
# cancels F for everyone else. WeaponMechanics only reads F for guns.
on swap hand items:
	itemId(player's tool) is "phone"
	cancel event
	closePhoneMap(player)
	openPhone(player)

# ---------- Back buttons (owner, 2026-09-28: "make sure all menus have a back button to their main page") ----------
# Every menu page that isn't a main page has "◀ Back" to the page it came from; every app's main page (the ones the phone
# opens: garage, GPS, crates, season, missions, bag, cosmetics, messages) has "◀ Phone" to the phone's apps, however it
# was opened (a command, an NPC). The quest menus (contracts, jobs, hits) open from the GPS's Quests page and go back there. Minigames (lock picking, a safe's keypad, fixing a drill, a crate's spin)
# and the trade window have none: closing them is the way out. Each script handles the click in its own menu code and
# calls openPhone(p) for "◀ Phone". Put them in the bottom row's first slot when it's free.
function backItem(to: text) :: item:
	# {_to} (the page it goes back to) is for reading the code: the arrow says enough.
	return arrow named "&f◀ Back"

function phoneBackItem() :: item:
	return arrow named "&f◀ Phone"

# The phone's home screen (2026-09-29, owner: "make a phone style apps menu (its very cluttered right now)" and "most
# people can use context clues"): a phone drawn by the title (ui.sk), apps on its screen (columns 2-6 of a 6-row chest),
# the dock (row 4) and the home button (slot 49: Close). Each app is its name, plus only what's live: unread texts as
# the icon's count, your keys and a ready daily key, the bag, the mission, the season. Contracts, jobs and hits live in
# the GPS's Quests (gps.sk), where their menus open. Clicks go by the item's id ("phone:<app>"), not by the slot.
function openPhone(p: player):
	set {_gui} to chest inventory with 6 rows named phoneTitle("home", phoneClock({_p}))
	# Row 0: Crates, Cosmetics, Season, Bounties, you.
	set {_keys} to 0
	loop {-cfg::crates::*}:
		add crateKeys({_p}, loop-value) to {_keys}
	set {_i} to appIcon("crates", "&fCrates")
	delete {_l::*}
	if {_keys} > 0:
		add "&7Keys: &f%{_keys}%" to {_l::*}
	if dailyText({_p}) is "ready":
		add "&aDaily key ready" to {_l::*}
		set {_i} to glint({_i})
	if {_l::*} is set:
		set lore of {_i} to {_l::*}
	set slot 2 of {_gui} to tagItem({_i}, "phone:crates")
	set slot 3 of {_gui} to tagItem(appIcon("cosmetics", "&fCosmetics"), "phone:cosmetics")
	set {_i} to appIcon("season", "&fSeason")
	set {_s} to {-ph::season::%{_p}%}
	if {_s} is set:
		if "%{_s}%" is not "&r":
			set lore of {_i} to colored "&7%{_s}%"
	set slot 4 of {_gui} to tagItem({_i}, "phone:season")
	set {_i} to appIcon("bounties", "&fBounties")
	set {_b} to getData({_p}, "bounty")
	if {_b} is set:
		if {_b} > 0:
			set lore of {_i} to "&7Yours: &c%formatMoney({_b})%"
	set slot 5 of {_gui} to tagItem({_i}, "phone:bounties")
	set slot 6 of {_gui} to phoneStats({_p})
	# Row 1: passive mode, how to play.
	set slot 11 of {_gui} to phonePassive({_p})
	set slot 12 of {_gui} to tagItem(appIcon("help", "&fHow to play"), "phone:help")
	# The dock: Messages, GPS, Missions, Garage, Bag.
	set {_i} to appIcon("messages", "&fMessages")
	set {_unread} to msgUnreadAll({_p})
	if {_unread} > 0:
		set item amount of {_i} to min({_unread}, 64)
		set lore of {_i} to "&a%{_unread}% new"
		set {_i} to glint({_i})
	set slot 38 of {_gui} to tagItem({_i}, "phone:messages")
	set slot 39 of {_gui} to tagItem(appIcon("gps", "&fGPS"), "phone:gps")
	set {_i} to appIcon("missions", "&fMissions")
	set {_m} to {-ph::mission::%{_p}%}
	if {_m} is set:
		if "%{_m}%" is not "&r":
			if "%{_m}%" is not "":
				set lore of {_i} to colored "%{_m}%"
	set slot 40 of {_gui} to tagItem({_i}, "phone:missions")
	set slot 41 of {_gui} to tagItem(appIcon("garage", "&fGarage"), "phone:garage")
	set {_i} to appIcon("bag", "&fBag")
	set lore of {_i} to "&f%formatMoney(bagTotal({_p}))% &7/ %formatMoney(bagCapacity({_p}))%"
	set slot 42 of {_gui} to tagItem({_i}, "phone:bag")
	# The home button (drawn by the background; the icon is see-through).
	set slot 49 of {_gui} to tagItem(appIcon("blank", "&fClose"), "phone:close")
	set {-phone::gui::%{_p}%} to {_gui}
	open {_gui} to {_p}
	play sound "item.book.page_turn" with volume 0.6 to {_p}

# The Profile app: your head with your numbers.
function phoneStats(p: player) :: item:
	add "&7Level: &f%levelOf({_p})% %levelColored(levelOf({_p}))% &7(%levelNum(levelXp({_p}))% XP)" to {_l::*}
	add "&7Balance: &a%formatMoney(balance of {_p})%" to {_l::*}
	set {_bounty} to getData({_p}, "bounty")
	if {_bounty} is not set:
		set {_bounty} to 0
	add "&7Bounty: &c%formatMoney({_bounty})%" to {_l::*}
	set {_tier} to getData({_p}, "bag-tier")
	if {_tier} is set:
		if {_tier} > 0:
			set {_bagName} to cfg("bag::%{_tier}%::name")
			set {_bag} to "&6%{_bagName}% &7(%formatMoney(bagCapacity({_p}))%)"
	if {_bag} is not set:
		set {_bag} to "&7none (hands: %formatMoney(bagCapacity({_p}))%)"
	add "&7Bag: %{_bag}%" to {_l::*}
	set {_played} to time played of {_p}
	set {_hours} to floor({_played} / 1 hour)
	set {_minutes} to mod(floor({_played} / 1 minute), 60)
	add "&7Played: &f%{_hours}%h %{_minutes}%m" to {_l::*}
	set {_first} to getData({_p}, "first-join")
	if {_first} is set:
		set {_since} to {_first} formatted as "MMM d, yyyy"
		add "&7Since: &f%{_since}%" to {_l::*}
	return tagItem(skull of {_p} named "&f%name of {_p}%" with lore {_l::*}, "phone:stats")

# Passive mode's switch: its effects aren't obvious, so one line says them.
function phonePassive(p: player) :: item:
	set {_multiplier} to cfg("passive::payout-multiplier")
	set {_cut} to round((1 - {_multiplier}) * 100)
	if isPassive({_p}) is true:
		set {_i} to appIcon("passive_on", "&aPassive: on")
	else:
		set {_i} to appIcon("passive_off", "&7Passive: off")
	set lore of {_i} to "&7No PvP · you show on maps · heists pay %{_cut}%%% less"
	return tagItem({_i}, "phone:passive")

function phoneButton(p: player, act: text):
	if {_act} is "phone:passive":
		# Close first: chat is hidden while a menu is open, and togglePassive's message matters.
		close {_p}'s inventory
		togglePassive({_p})
	else if {_act} is "phone:garage":
		close {_p}'s inventory
		garageMenu({_p})
	else if {_act} is "phone:gps":
		close {_p}'s inventory
		gpsMenu({_p})
	else if {_act} is "phone:crates":
		close {_p}'s inventory
		crateMenu({_p})
	else if {_act} is "phone:season":
		close {_p}'s inventory
		lbOpen({_p}, "")
	else if {_act} is "phone:missions":
		close {_p}'s inventory
		storyMenu({_p})
	else if {_act} is "phone:bounties":
		close {_p}'s inventory
		bountyPage({_p})
	else if {_act} is "phone:help":
		close {_p}'s inventory
		helpPage({_p})
	else if {_act} is "phone:bag":
		close {_p}'s inventory
		bagMenu({_p})
	else if {_act} is "phone:cosmetics":
		close {_p}'s inventory
		cosMenu({_p})
	else if {_act} is "phone:messages":
		close {_p}'s inventory
		msgMenu({_p})
	else if {_act} is "phone:close":
		close {_p}'s inventory

on inventory click:
	{-phone::gui::%player%} is set
	player's current inventory is {-phone::gui::%player%}
	cancel event
	event-inventory is {-phone::gui::%player%}
	set {_act} to itemId(event-item)
	{_act} starts with "phone:"
	# The button runs a tick later, after the click is done. Only while the menu is still open, so a
	# second click queued in the same tick (spam, lag) doesn't run a button twice.
	wait 1 tick
	player is online
	{-phone::gui::%player%} is set
	phoneButton(player, {_act})

on inventory drag:
	{-phone::gui::%player%} is set
	player's current inventory is {-phone::gui::%player%}
	cancel event

on inventory close:
	{-phone::gui::%player%} is set
	event-inventory is {-phone::gui::%player%}
	delete {-phone::gui::%player%}

on quit:
	closePhoneMap(player)
	delete {-phone::gui::%player%}
	delete {-phone::clicked::%player%}
