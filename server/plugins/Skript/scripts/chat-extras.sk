# chat-extras.sk: chat cooldown, @mentions, staff chat, /broadcast and rotating tips. Players on the prison's tutorial
# course (core.sk chatQuiet) get neither other players' chat nor tips (owner, 2026-10-21).
#
# LPC formats chat at HIGHEST priority, after these handlers (Skript's default is high). LPC strips
# & color codes from players without lpc.colorcodes but keeps § codes, so a mention is colored with
# § codes inside a raw (unparsed) text component: players still can't color their own text or add
# <tags>. Player text only goes through `colored` in staff chat and /broadcast (staff only;
# `colored` allows colors but never click/hover tags). Never use `formatted` on player text.
#
# Uses rankedName() from join-quit.sk.

on load:
	# The section sign, for colors that survive LPC's & stripping.
	set {-chat::s} to character from codepoint 167
	loadTips()
	set {-tip::last} to now

on quit:
	delete {-chat::last::%player%}
	delete {-chat::staff-mode::%player%}

on chat:
	# The tutorial course hears nothing but itself (owner, 2026-10-21: "while on the course, hide every chat line not
	# about the tutorial"): course players don't see other players' chat (core.sk chatQuiet).
	loop all players:
		if loop-player is not player:
			if chatQuiet(loop-player) is true:
				remove loop-player from chat recipients
	# Staff chat mode (/sc): the message goes to staff only.
	if {-chat::staff-mode::%player%} is set:
		if isStaff(player) is true:
			cancel event
			# MiniMessage text: typed <tags> stay escaped (literal), & colors still work.
			staffChat(player, "%message%")
			stop
		delete {-chat::staff-mode::%player%}

	# The chat filter (core.sk chat::filter-*): the line is never sent.
	if chatBlocked(legacyText(message)) is true:
		cancel event
		chatFilterHit(player, legacyText(message))
		stop

	# Cooldown between messages (staff are exempt).
	if isStaff(player) is false:
		set {_cooldown} to cfg("chat::cooldown")
		if {-chat::last::%player%} is set:
			if difference between {-chat::last::%player%} and now < {_cooldown}:
				cancel event
				msg(player, "&cSlow down! &7Wait a moment before chatting again.")
				stop
		set {-chat::last::%player%} to now
		# The same line again (any case) within chat::repeat-window: refused.
		set {_line} to legacyText(message) in lowercase
		if {-chat::lastline::%player%} is {_line}:
			if difference between {-chat::lastlineat::%player%} and now < cfg("chat::repeat-window"):
				cancel event
				msg(player, "&7You just said that.")
				stop
		set {-chat::lastline::%player%} to {_line}
		set {-chat::lastlineat::%player%} to now

	# @mentions: the name turns lime for everyone, and the mentioned player hears a ping.
	set {_text} to legacyText(message)
	{_text} contains "@"
	loop all players:
		set {_name} to name of loop-player
		if {_text} contains "@%{_name}%":
			# \b: "@Bob" must not match inside "@Bobby".
			set {_before} to {_text}
			regex replace "(?i)@%{_name}%\b" in {_text} with "%{-chat::s}%a@%{_name}%%{-chat::s}%r"
			if {_text} is not {_before}:
				set {_changed} to true
				if loop-player is not player:
					add loop-player to {_pinged::*}
	{_changed} is set
	set message to raw {_text}
	# Sounds run on the main thread (chat events are async; code after a wait runs synced).
	wait 1 tick
	loop {_pinged::*}:
		if loop-value is online:
			play sound "entity.experience_orb.pickup" with volume 0.8 and pitch 1.5 to loop-value

# A death message (whatever is left of it after every other handler: hit contracts and prison guards delete theirs) goes
# to everyone but players on the tutorial course, and the console. Only while one is online (else the server's own
# broadcast, unchanged).
on death of player with priority monitor:
	set {_quiet} to false
	loop all players:
		if chatQuiet(loop-player) is true:
			set {_quiet} to true
	{_quiet} is true
	death message is set
	set {_dm} to death message
	delete death message
	loop all players:
		if chatQuiet(loop-player) is false:
			send {_dm} to loop-player
	send {_dm} to console

# ---------- Staff chat ----------

function staffChat(from: player, text: text):
	loop all players:
		if isStaff(loop-player) is true:
			send colored "&c[Staff] %rankedName({_from})%&7: &f%{_text}%" to loop-player
	send "[Staff] %{_from}%: %{_text}%" to console

# /sc <message> sends one message to staff; /sc alone toggles staff chat mode.
command /staffchat [<text>]:
	aliases: /sc
	description: Talk to staff only.
	permission: donating.staff
	permission message: &cYou can't use staff chat.
	executable by: players
	trigger:
		if arg-1 is set:
			staffChat(player, arg-1)
			stop
		if {-chat::staff-mode::%player%} is set:
			delete {-chat::staff-mode::%player%}
			msg(player, "Staff chat &coff&7: your messages go to everyone again.")
		else:
			set {-chat::staff-mode::%player%} to true
			msg(player, "Staff chat &aon&7: your messages go to staff only. &e/sc&7 turns it off.")

# ---------- /broadcast ----------
# Replaces EssentialsX's /broadcast and /bc. /bc is its own command, not an alias: Skript takes
# over another plugin's command name but not its alias, so "aliases: /bc" still ran EssentialsX's.

function staffBroadcast(text: text):
	broadcastMsg("&e%{_text}%")
	play sound "block.note_block.pling" with volume 0.6 to all players

command /broadcast <text>:
	description: Announce something to everyone.
	permission: donating.staff
	permission message: &cYou can't broadcast.
	trigger:
		staffBroadcast(arg-1)

command /bc <text>:
	description: Announce something to everyone.
	permission: donating.staff
	permission message: &cYou can't broadcast.
	trigger:
		staffBroadcast(arg-1)

# ---------- Rotating tips ----------
# One tip every cfg("chat::tip-interval"), in order, only while someone is online.
# {-tips::*} holds only the tips (its size is the tip count); the timer lives in {-tip::*}.

function loadTips():
	delete {-tips::*}
	add "Loot goes into your bag (offhand), and it sells by itself when you reach the base." to {-tips::*}
	add "Dying drops your bag. Anyone nearby can grab your loot." to {-tips::*}
	add "Get out before the heist timer hits 0, or you lose what you took there." to {-tips::*}
	add "Guns are yours for good once bought. Only ammo and consumables run out." to {-tips::*}
	add "Passive mode (phone) keeps other robbers off you, but heists pay less." to {-tips::*}
	add "Type @name in chat to ping a player." to {-tips::*}
	add "New here? Type /help for the basics." to {-tips::*}

function sendTip():
	add 1 to {-tip::next}
	if {-tip::next} > size of {-tips::*}:
		set {-tip::next} to 1
	# Not to players on the tutorial course (core.sk chatQuiet).
	loop all players:
		if chatQuiet(loop-player) is false:
			send colored "&e&lTIP&r &7» &7%{-tips::%{-tip::next}%}%" to loop-player

every 1 minute:
	if number of all players is 0:
		stop
	set {_interval} to cfg("chat::tip-interval")
	if difference between {-tip::last} and now < {_interval}:
		stop
	set {-tip::last} to now
	sendTip()

# ---------- The chat filter (2026-11-10) ----------
# Lowercase, common letter swaps (0 o, 1 i, 3 e, 4 a, 5 s, @ a, $ s, ! i), then a whole-word match, then a match of the
# parts on the letters alone ("f.u c k").
# shortcut: no stretched letters ("fuuuck") or look-alike Unicode letters, upgrade to a filter plugin if players find ways round it.
function chatBlocked(text: text) :: boolean:
	set {_t} to {_text} in lowercase
	regex replace "§." in {_t} with ""
	replace all "0" with "o" in {_t}
	replace all "1" with "i" in {_t}
	replace all "3" with "e" in {_t}
	replace all "4" with "a" in {_t}
	replace all "5" with "s" in {_t}
	replace all "@" with "a" in {_t}
	replace all "$" with "s" in {_t}
	replace all "!" with "i" in {_t}
	set {_w} to cfg("chat::filter-words")
	if {_t} matches ".*(^|[^a-z])(%{_w}%)([^a-z]|$).*":
		return true
	set {_l} to {_t}
	regex replace "[^a-z]" in {_l} with ""
	set {_p} to cfg("chat::filter-parts")
	if {_l} matches ".*(%{_p}%).*":
		return true
	return false

function chatFilterHit(p: player, text: text):
	msg({_p}, "&7That word isn't allowed here.")
	log "%name of {_p}% %uuid of {_p}% %{_text}%" to "chat-filter"

# Private messages and /me go through the filter too (EssentialsX's commands and their aliases).
on command:
	sender is a player
	set {_c} to command in lowercase
	{_c} is "msg" or "tell" or "w" or "whisper" or "m" or "t" or "pm" or "emsg" or "etell" or "ewhisper" or "r" or "reply" or "er" or "mail" or "email" or "me" or "eme"
	chatBlocked(full command) is true
	cancel event
	chatFilterHit(player, full command)
