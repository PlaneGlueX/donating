# placeholders.sk: PlaceholderAPI placeholders for TAB (script 18, started 2026-09-25 for the tab list).
# Prefix "donating" (skript-placeholders allows it in several scripts; heists.sk answers the heist
# ones). An empty result would make PlaceholderAPI show the raw %placeholder%, so "nothing" is "&r".
# TAB asks from its own thread, so these only read memory and saved variables, never call a function
# (a function being reloaded is missing for a moment: a Severe Error on TAB's thread). The balance, the
# bounty's money texts and the heist's name are copied into memory once a second.
#   %donating_balance%       "$12,345" (your own, footer)
#   %donating_bounty%        the bounty as a whole number (sorting, the list's score column)
#   %donating_bounty_fancy%  "&c$2.5K", or "&r" (nothing) with no bounty (the score column's text)
#   %donating_bounty_money%  "$2,500" (your own, footer; "$0" with none)
#   %donating_max_players%   the server's player limit (TAB 6 has no %maxplayers%)
#   %donating_passive%       yes / no
#   %donating_afk%           yes / no
#   %donating_name_color%    "&a" for passive players (green, like their map arrow), else "&f"
#   %donating_tab_suffix%    " &7AFK" while AFK, else "&r"
#   %donating_bag%           "$2.7K/$6K" (your bag), "no bag"          %donating_bag_pct%   "45%"
#   %donating_heist_loot%    loot left in your heist ("$18.4K")        %donating_heist_spots% "3/5"
#   %donating_heist_haul%    your loot from this run                   %donating_heist_risk%  bag + a death's loss
# (loot.sk copies these into memory once a second.)
#   %donating_rank%          your robber rank in its color ("&aBurglar")
#   %donating_rank_xp%       "1,240/3,000 XP" to the next rank, or "max rank" (ranks.sk keeps both in memory)

every second:
	loop all players:
		set {-ph::balance::%loop-player%} to formatMoney(balance of loop-player)
		set {_n} to {data::%loop-player%::bounty}
		if {_n} is not set:
			set {_n} to 0
		set {-ph::bountymoney::%loop-player%} to formatMoney({_n})
		if {_n} > 0:
			set {-ph::bountyfancy::%loop-player%} to "&c%formatMoneyShort({_n})%"
		else:
			set {-ph::bountyfancy::%loop-player%} to "&r"
		set {_h} to {-heistin::%loop-player%}
		if {_h} is set:
			set {-ph::heistname::%loop-player%} to heistName({_h})
		else:
			delete {-ph::heistname::%loop-player%}

on quit:
	delete {-ph::balance::%player%}
	delete {-ph::bountymoney::%player%}
	delete {-ph::bountyfancy::%player%}
	delete {-ph::heistname::%player%}

placeholderapi placeholder with the prefix "donating":
	player is set
	set {_i} to the placeholder identifier
	if {_i} is "balance":
		set {_b} to {-ph::balance::%player%}
		if {_b} is not set:
			set {_b} to "$0"
		set the placeholder result to {_b}
	else if {_i} is "bounty":
		set {_n} to {data::%player%::bounty}
		if {_n} is not set:
			set {_n} to 0
		set the placeholder result to "%floor({_n})%"
	else if {_i} is "bounty_fancy":
		set the placeholder result to "&r"
		if {-ph::bountyfancy::%player%} is set:
			set the placeholder result to {-ph::bountyfancy::%player%}
	else if {_i} is "bounty_money":
		set the placeholder result to "$0"
		if {-ph::bountymoney::%player%} is set:
			set the placeholder result to {-ph::bountymoney::%player%}
	else if {_i} is "max_players":
		set the placeholder result to "%max players count%"
	else if {_i} is "passive":
		set the placeholder result to "no"
		if {data::%player%::passive} is true:
			set the placeholder result to "yes"
	else if {_i} is "afk":
		set the placeholder result to "no"
		if {-afk::is::%player%} is set:
			set the placeholder result to "yes"
	else if {_i} is "name_color":
		set the placeholder result to "&f"
		if {data::%player%::passive} is true:
			set the placeholder result to "&a"
	else if {_i} is "tab_suffix":
		set the placeholder result to "&r"
		if {-afk::is::%player%} is set:
			set the placeholder result to " &7AFK"
	else if {_i} is "rank":
		set the placeholder result to "&7Pickpocket"
		if {-ph::rank::%player%} is set:
			set the placeholder result to {-ph::rank::%player%}
	else if {_i} is "rank_xp":
		set the placeholder result to "&r"
		if {-ph::rankxp::%player%} is set:
			set the placeholder result to {-ph::rankxp::%player%}
	else if {_i} is "bag" or "bag_pct" or "heist_haul" or "heist_risk" or "heist_loot" or "heist_spots":
		# Memory only (loot.sk copies these once a second); nothing yet is "&r", never the raw %placeholder%.
		set {_h} to {-heistin::%player%}
		if {_i} is "bag":
			set {_v} to {-ph::bag::%player%}
		else if {_i} is "bag_pct":
			set {_v} to {-ph::bagpct::%player%}
		else if {_i} is "heist_haul":
			set {_v} to {-ph::haul::%player%}
		else if {_i} is "heist_risk":
			set {_v} to {-ph::risk::%player%}
		else if {_h} is set:
			if {_i} is "heist_loot":
				set {_v} to {-ph::heistloot::%{_h}%}
			else:
				set {_v} to {-ph::heistspots::%{_h}%}
		set the placeholder result to "&r"
		if {_v} is set:
			set the placeholder result to {_v}
