# levels.sk: robber levels (CLAUDE.md, Skripts: 17). Built 2026-09-26 as "robber ranks"; renamed to
# levels the same day (owner: paid ranks show in the tab list, levels stay in your footer: two different
# things, two different words; ranks.sk has the paid ranks).
#
# Robbers earn XP by selling loot at the base (bag.sk's bagSell calls levelSale):
#   X = floor(P / cfg level::xp-per-dollars) + cfg level::xp-per-haul × H
#   P = what the sale paid (passive players get 75%, so their XP too), H = the heist runs in the sale
#   not credited to this player before (bag.sk keeps data "level-haul::<h>", the last run credited), so
#   selling one run's loot in several trips pays the bonus once.
# Level 1 needs cfg level::first XP and each level after needs g more than the one before, g easing from level::growth-start
# to level::growth-end by level::growth-until (owner, 2026-09-27: about level 150 after a month of 2 hours a day; 2026-09-28:
# "each level should get a little harder each time"). T(n) = the XP level n needs in total, a table worked out once per
# settings load (levelTable). A range of levels shares a title (cfg level::brackets: 0 Pickpocket ... 200 Godfather). All
# the numbers are PROPOSALs in core.sk (tools\progress-sim.js times them). A level unlocks:
#   - heists: heistLevel(h), the heist's /dheist set level, else its difficulty's default in core.sk
#     (heists.sk's heistLevelOk asks levelOk);
#   - heist tools, weapons and bag tiers: cfg tool::<t>::level, wpn::<W>::level, bag::<t>::level (shop.sk);
#   - car models (garage.sk), car-job tiers (contracts.sk), hit contracts (hits.sk), Vic (fence.sk);
#   - members-only areas: a WorldGuard region "lvl<N>_<name>" lets in level N and up (levelZoneBlock);
#   and some levels give a reward once (cfg level::rewards: bound titles, kill effects, keys, money; levelRewards).
# XP is never taken away and a level never drops by itself (only staff can lower one).
# Level-ups are told to that player only (a title, a sound and what it unlocks in chat): no chat spam.
# Saved: data "level-xp" (total XP), "level" (the level it gives), "level-haul::<h>". Memory:
# {-ph::level::<p>}, {-ph::levelnum::<p>}, {-ph::levelxp::<p>} for the tab list's footer (placeholders.sk;
# TAB asks from its own thread).
# Players: /level (yours, the progress, what the next level unlocks), /levels (all of them).
# Staff: /dlevel info|set|xp|reset <player> [value]. Log: plugins\Skript\logs\levels.log.

function levelLog(text: text):
	log {_text} to "levels"

# ---------- Reading ----------

function levelXp(p: offline player) :: number:
	set {_x} to getData({_p}, "level-xp")
	if {_x} is set:
		return {_x}
	return 0

function levelOf(p: offline player) :: number:
	set {_r} to getData({_p}, "level")
	if {_r} is set:
		return {_r}
	return 0

# heists.sk, shop.sk, later garage.sk: does the player have at least level `need`?
function levelOk(p: offline player, need: number) :: boolean:
	if levelOf({_p}) >= {_need}:
		return true
	return false

# The bracket a level falls in: "from|name|color" (the highest whose start is at most n).
function levelBracket(n: number) :: text:
	set {_b} to "0|Level|&7"
	loop {-cfg::level::brackets::*}:
		set {_a::*} to loop-value split at "|"
		set {_from} to {_a::1} parsed as integer
		if {_from} is set:
			if {_from} <= {_n}:
				set {_b} to loop-value
	return {_b}

# The level's title ("Burglar").
function levelName(n: number) :: text:
	set {_a::*} to levelBracket({_n}) split at "|"
	return {_a::2}

# The title in its color: "&aBurglar".
function levelColored(n: number) :: text:
	set {_a::*} to levelBracket({_n}) split at "|"
	return "%{_a::3}%%{_a::2}%"

# The XP table {-level::t::<n>} = T(n): need(1) = level::first, need(n) = need(n - 1) × (1 + g(n)), g easing in a straight
# line from level::growth-start (level 2) to level::growth-end (level::growth-until) and staying there; T(n) = the sum,
# rounded. Worked out again only when one of those settings changed (the key). False without them (a typo in core.sk
# must not level everyone up: no level can be reached then). tools\progress-sim.js builds the same table.
function levelTable() :: boolean:
	set {_first} to {-cfg::level::first}
	set {_g0} to {-cfg::level::growth-start}
	set {_g1} to {-cfg::level::growth-end}
	set {_until} to {-cfg::level::growth-until}
	set {_max} to {-cfg::level::max}
	if {_first} is not set:
		return false
	if {_g0} is not set:
		return false
	if {_g1} is not set:
		return false
	if {_until} is not set:
		return false
	if {_max} is not set:
		return false
	if {_first} <= 0:
		return false
	set {_key} to "%{_first}%|%{_g0}%|%{_g1}%|%{_until}%|%{_max}%"
	if {-level::key} is {_key}:
		return true
	delete {-level::t::*}
	set {-level::t::0} to 0
	set {_need} to {_first}
	set {_total} to 0
	set {_span} to max(1, {_until} - 2)
	loop {_max} times:
		set {_n} to loop-number
		if {_n} > 1:
			set {_f} to min(1, ({_n} - 2) / {_span})
			set {_need} to {_need} * (1 + {_g0} + ({_g1} - {_g0}) * {_f})
		set {_total} to {_total} + {_need}
		set {-level::t::%{_n}%} to round({_total})
	set {-level::key} to {_key}
	return true

# XP level n needs in total (T(n) from the table); an unreachable number without the settings.
function levelNeed(n: number) :: number:
	if {_n} <= 0:
		return 0
	if levelTable() is false:
		return 1000000000000
	set {_t} to {-level::t::%{_n}%}
	if {_t} is not set:
		return 1000000000000
	return {_t}

# The level a total of xp gives: the highest n with T(n) <= xp (a binary search over the table).
function levelFor(xp: number) :: number:
	if levelTable() is false:
		return 0
	set {_lo} to 0
	set {_hi} to {-cfg::level::max}
	loop 20 times:
		if {_lo} < {_hi}:
			set {_mid} to ceil(({_lo} + {_hi}) / 2)
			if {-level::t::%{_mid}%} <= {_xp}:
				set {_lo} to {_mid}
			else:
				set {_hi} to {_mid} - 1
	return {_lo}

# A whole number with thousands commas ("12,500").
function levelNum(n: number) :: text:
	set {_t} to formatMoney({_n})
	replace all "$" with "" in {_t}
	return {_t}

# What level n unlocks: tools, weapons, bags, heists, cars, car jobs, hits and Vic that need exactly that level.
function levelUnlocks(n: number) :: texts:
	loop {-cfg::shop::weapons::*}:
		if {-cfg::wpn::%loop-value%::level} is {_n}:
			if {_n} > 0:
				set {_w} to {-cfg::wpn::%loop-value%::name}
				add "the %{_w}%" to {_u::*}
	loop {-cfg::shop::consumables::*}:
		if {-cfg::con::%loop-value%::level} is {_n}:
			if {_n} > 0:
				set {_cn} to {-cfg::con::%loop-value%::name}
				add "%{_cn}%s" to {_u::*}
	loop integers from 2 to 5:
		if {-cfg::bag::%loop-value%::level} is {_n}:
			set {_bag} to {-cfg::bag::%loop-value%::name}
			add "the %{_bag}%" to {_u::*}
	loop "easy", "medium" and "hard":
		if {-cfg::hit::%loop-value%::level} is {_n}:
			set {_hn} to {-cfg::hit::%loop-value%::name}
			add "%{_hn}%s (the Broker)" to {_u::*}
	if {-cfg::fence::level} is {_n}:
		add "Vic the Fence (the Pawn Shop)" to {_u::*}
	loop {-cfg::shop::tools::*}:
		set {_need} to cfg("tool::%loop-value%::level")
		if {_need} is {_n}:
			set {_tool} to cfg("tool::%loop-value%::name")
			add "the %{_tool}%" to {_u::*}
	loop {heists::*}:
		if heistState(loop-index) is not "disabled":
			if heistLevel(loop-index) is {_n}:
				set {_heist} to heistName(loop-index)
				add "the %{_heist}%" to {_u::*}
	# Cars at the Car Dealer (garage.sk; crate cars need no level).
	loop {-cfg::cars::*}:
		if {-cfg::car::%loop-value%::crate} is not true:
			if {-cfg::car::%loop-value%::level} is {_n}:
				set {_car} to {-cfg::car::%loop-value%::name}
				add "the %{_car}% (car)" to {_u::*}
	# Car-theft jobs (contracts.sk).
	loop {-cfg::contract::tiers::*}:
		if {-cfg::contract::%loop-value%::level} is {_n}:
			set {_job} to {-cfg::contract::%loop-value%::name}
			add "%{_job}% car contracts (/contracts)" to {_u::*}
	# Rewards given at that level (levelRewards).
	loop {-cfg::level::rewards::*}:
		set {_ra::*} to loop-value split at "|"
		if {_ra::1} is "%{_n}%":
			set {_rt} to levelRewardText({_ra::*})
			if {_rt} is not "":
				add {_rt} to {_u::*}
	return {_u::*}

# ---------- Earning ----------

# Adds XP (whole, never negative) and returns the level after it. A level-up: the title, a sound and
# what it unlocks, to that player only.
function levelAddXp(p: player, xp: number, why: text) :: number:
	set {_old} to levelOf({_p})
	set {_add} to max(0, floor(levelBoosted({_p}, {_xp}, {_why})))
	set {_total} to levelXp({_p}) + {_add}
	setData({_p}, "level-xp", {_total})
	set {_new} to max({_old}, levelFor({_total}))
	if {_new} is not {_old}:
		setData({_p}, "level", {_new})
	levelLog("xp %name of {_p}% %uuid of {_p}% +%{_add}% why=%{_why}% total=%{_total}% level=%{_old}%->%{_new}%")
	levelRefresh({_p})
	if {_new} > {_old}:
		levelUp({_p}, {_old}, {_new})
	return {_new}

# XP after an XP booster (boosters.sk): sales and contracts only, never staff grants.
function levelBoosted(p: player, xp: number, why: text) :: number:
	if {_why} is "staff":
		return {_xp}
	# A mission's reward (story.sk) is a fixed amount.
	if {_why} is "story":
		return {_xp}
	# A contact job's reward (jobs.sk) too.
	if {_why} is "job":
		return {_xp}
	# A hit contract's (hits.sk) too.
	if {_why} is "hit":
		return {_xp}
	return floor({_xp} * boosterForKind({_p}, "xp"))

function levelUp(p: player, old: number, new: number):
	set {_name} to levelColored({_new})
	send title colored "&6&lLEVEL UP&r" with subtitle colored "&7Level %{_new}% · %{_name}%" to {_p} for 3 seconds
	play sound "ui.toast.challenge_complete" with volume 0.8 to {_p}
	msg({_p}, "&6Level up! &fYou're level %{_new}% now: %{_name}%&f.")
	set {_from} to {_old} + 1
	loop integers from {_from} to {_new}:
		set {_u::*} to levelUnlocks(loop-value)
		loop {_u::*}:
			msg({_p}, "&7 Unlocked: &f%loop-value-2%")
	levelLog("up %name of {_p}% %uuid of {_p}% %{_old}%->%{_new}%")
	levelRewards({_p})

# bag.sk's bagSell: the XP for a sale that paid `pay` for `hauls` new heist runs. Returns the XP.
function levelSale(p: player, pay: number, hauls: number) :: number:
	set {_xp} to floor({_pay} / cfg("level::xp-per-dollars")) + cfg("level::xp-per-haul") * {_hauls}
	if {_xp} <= 0:
		return 0
	set {_shown} to levelBoosted({_p}, {_xp}, "sell")
	levelAddXp({_p}, {_xp}, "sell")
	if {_shown} > {_xp}:
		set {_boost} to boosterText(boosterForKind({_p}, "xp"))
		msg({_p}, "&b+%levelNum({_shown})% XP &6⚡ %{_boost}% &7(%levelProgressText({_p})%&7)")
	else:
		msg({_p}, "&b+%levelNum({_xp})% XP &7(%levelProgressText({_p})%&7)")
	return {_shown}

# "Level 2 Burglar · 1,240 / 3,000 XP to level 3", or "Level 6 Kingpin · max level".
function levelProgressText(p: player) :: text:
	set {_r} to levelOf({_p})
	set {_x} to levelXp({_p})
	if {_r} >= cfg("level::max"):
		return "Level %{_r}% %levelColored({_r})% &7· max level"
	set {_next} to {_r} + 1
	return "Level %{_r}% %levelColored({_r})% &7· %levelNum({_x})% / %levelNum(levelNeed({_next}))% XP to level %{_next}%"

# The tab list's copies (placeholders.sk reads memory only). Also catches a player up when the XP they
# have is worth a higher level than they're saved at (the thresholds were lowered in core.sk).
function levelRefresh(p: player):
	set {_r} to levelOf({_p})
	set {_f} to levelFor(levelXp({_p}))
	if {_f} > {_r}:
		setData({_p}, "level", {_f})
		levelLog("catch-up %name of {_p}% %uuid of {_p}% %{_r}%->%{_f}% xp=%levelXp({_p})%")
		levelUp({_p}, {_r}, {_f})
		set {_r} to {_f}
	set {-ph::level::%{_p}%} to levelColored({_r})
	set {-ph::levelnum::%{_p}%} to "%{_r}%"
	if {_r} >= cfg("level::max"):
		set {-ph::levelxp::%{_p}%} to "max level"
	else:
		set {_next} to {_r} + 1
		set {-ph::levelxp::%{_p}%} to "%levelNum(levelXp({_p}))%/%levelNum(levelNeed({_next}))% XP"

on join:
	# Saved under the old name ("robber ranks", earlier on 2026-09-26): moved once.
	set {_old} to getData(player, "rank-xp")
	if {_old} is set:
		if getData(player, "level-xp") is not set:
			setData(player, "level-xp", {_old})
			set {_r} to getData(player, "rank")
			if {_r} is set:
				setData(player, "level", {_r})
		deleteData(player, "rank-xp")
		deleteData(player, "rank")
		delete {data::%player%::rank-haul::*}
	levelRefresh(player)
	# Rewards for levels reached before they existed (or before a restart finished giving them).
	set {_got::*} to levelRewards(player)
	if size of {_got::*} > 0:
		set {_list} to join {_got::*} with ", "
		msg(player, "&6Level rewards: &f%{_list}%")

on load:
	loop all players:
		levelRefresh(loop-player)

# Follows a settings reload (/sk reload core) and a changed threshold within a few seconds.
every 5 seconds:
	loop all players:
		levelRefresh(loop-player)

on quit:
	delete {-ph::level::%player%}
	delete {-ph::levelnum::%player%}
	delete {-ph::levelxp::%player%}

# ---------- Rewards past the unlocks, and members-only areas ----------
# Owner, 2026-09-28: "think of some good rewards past 100 and 150, something new added to the map, or something that
# unlocks". Each cfg level::rewards line "level|kind|what[|n]" is given once, at that level: title, killfx, bagskin or gunskin (a
# bound cosmetic: never traded or in crates), key|<crate>|<n>, money|<$>. A player already past a line gets it at the next
# join (data lvlreward::<the line with - for |>). The rest past 100 is on the map: the extreme cars at the Car Dealer, a
# heist set to level 100 (/dheist set <id> level 100 and pool), and members-only areas.

function levelRewardKey(line: text) :: text:
	set {_k} to {_line}
	replace all "|" with "-" in {_k}
	return {_k}

# "the «Kingpin» title", "2 Legendary Crate keys", "$50,000", or "" for a line that doesn't work.
function levelRewardText(a: texts) :: text:
	set {_kind} to {_a::2}
	set {_what} to {_a::3}
	set {_n} to 1
	if {_a::4} is set:
		set {_n} to {_a::4} parsed as integer
	if {_kind} is "key":
		if {-cfg::rarity::%{_what}%::name} is not set:
			return ""
		if {_n} is 1:
			return "a %crateName({_what})% key"
		return "%{_n}% %crateName({_what})% keys"
	if {_kind} is "money":
		set {_m} to {_what} parsed as integer
		if {_m} is not set:
			return ""
		return formatMoney({_m})
	if cosExists({_what}) is false:
		return ""
	set {_name} to {-cfg::cos::%{_what}%::name}
	if {_kind} is "title":
		return "the «%{_name}%» title"
	if {_kind} is "killfx":
		return "the %{_name}% kill effect"
	if {_kind} is "bagskin":
		return "the %{_name}% bag skin"
	if {_kind} is "gunskin":
		return "the %{_name}% gun skin"
	return ""

# Gives every reward the player's level has reached and they don't have yet; returns what was given (texts).
function levelRewards(p: player) :: texts:
	set {_lv} to levelOf({_p})
	loop {-cfg::level::rewards::*}:
		set {_a::*} to loop-value split at "|"
		set {_at} to {_a::1} parsed as integer
		if {_at} is set:
			if {_at} <= {_lv}:
				set {_k} to levelRewardKey(loop-value)
				if {data::%{_p}%::lvlreward::%{_k}%} is not set:
					set {_t} to levelRewardText({_a::*})
					if {_t} is not "":
						# Marked first: a reward is never given twice.
						set {data::%{_p}%::lvlreward::%{_k}%} to true
						if {_a::2} is "key":
							set {_kn} to 1
							if {_a::4} is set:
								set {_kn} to {_a::4} parsed as integer
							crateAddKeys({_p}, {_a::3}, {_kn}, "level:%{_at}%")
						else if {_a::2} is "money":
							giveMoney({_p}, {_a::3} parsed as integer)
						else:
							cosGive({_p}, {_a::3}, "level:%{_at}%")
						add {_t} to {_out::*}
						levelLog("reward %name of {_p}% %uuid of {_p}% %loop-value%")
	return {_out::*}

# The level a region's id asks for: "lvl150_lounge" -> 150; 0 for any other region.
function levelZoneNeed(id: text) :: number:
	set {_id} to {_id} in lower case
	if {_id} does not start with "lvl":
		return 0
	set {_parts::*} to {_id} split at "_"
	set {_d} to subtext of {_parts::1} from characters 4 to (length of {_parts::1})
	set {_n} to {_d} parsed as integer
	if {_n} is not set:
		return 0
	return max(0, {_n})

# "" when the player may enter that region, else why not. Staff always may.
function levelZoneBlock(p: player, id: text) :: text:
	set {_need} to levelZoneNeed({_id})
	if {_need} <= 0:
		return ""
	if isStaff({_p}) is true:
		return ""
	if levelOk({_p}, {_need}) is true:
		return ""
	return "Members only: level %{_need}% %levelColored({_need})%&c and up."

# "" when the player may stand at l (every members-only region there), else why not.
function levelZoneBlockAt(p: player, l: location) :: text:
	loop regions at {_l}:
		set {_why} to levelZoneBlock({_p}, name of loop-value)
		if {_why} is not "":
			return {_why}
	return ""

# Walking or teleporting in (WorldGuard pushes them back or cancels the teleport).
on region enter:
	set {_why} to levelZoneBlock(player, name of the worldguard region)
	{_why} is not ""
	cancel event
	hudBar(player, "&c%{_why}%", 2)

# Driving in (MTVehicles checks a car's regions itself; cancelling puts the driver out). Passengers fire no region
# events of their own, so the car stops when any of them may not come in (review 2026-09-28).
on mtv vehicle region enter:
	set {_why} to levelZoneBlock(player, event-text)
	if {_why} is "":
		set {_seat} to carSeatOf(player)
		if {_seat} starts with "driver:":
			set {_plate} to subtext of {_seat} from characters 8 to (length of {_seat})
			loop all players:
				if carSeatOf(loop-player) is "passenger:%{_plate}%":
					if levelZoneBlock(loop-player, event-text) is not "":
						set {_why} to "A passenger isn't allowed in there."
	{_why} is not ""
	cancel event
	hudBar(player, "&c%{_why}%", 2)

# The backstop, every second (review 2026-09-28): anyone standing where they may not (a passenger carried in, a
# rejoin inside: WorldGuard fires no enter event for a login spot) goes back to the last spot they stood where they
# could, else to spawn.
every second:
	loop all players:
		set {_p} to loop-player
		set {_why} to levelZoneBlockAt({_p}, location of {_p})
		if {_why} is "":
			if {_p} is alive:
				set {-lvlzone::ok::%{_p}%} to location of {_p}
		else if {_p} is alive:
			if vehicle of {_p} is set:
				make {_p} dismount
			set {_back} to {-lvlzone::ok::%{_p}%}
			# (A zone drawn around where they stood makes that spot a members-only one too: spawn then.)
			if {_back} is set:
				if levelZoneBlockAt({_p}, {_back}) is not "":
					delete {_back}
			if {_back} is not set:
				set {_back} to spawn of world "world"
			teleport {_p} to {_back}
			hudBar({_p}, "&c%{_why}%", 2)
			levelLog("zone-out %name of {_p}% %uuid of {_p}% %{_why}%")

on quit:
	delete {-lvlzone::ok::%player%}

# ---------- /level and /levels ----------

function levelShow(p: player):
	set {_r} to levelOf({_p})
	set {_x} to levelXp({_p})
	set {_max} to cfg("level::max")
	msg({_p}, "&6Your level: &f%{_r}% %levelColored({_r})% &7· &f%levelNum({_x})% XP")
	if {_r} >= {_max}:
		send colored "&7 That's the top level." to {_p}
	else:
		set {_next} to {_r} + 1
		set {_from} to levelNeed({_r})
		set {_to} to levelNeed({_next})
		set {_pct} to 0
		if {_to} > {_from}:
			set {_pct} to max(0, min(100, floor(100 * ({_x} - {_from}) / ({_to} - {_from}))))
		set {_full} to floor({_pct} / 5)
		set {_bar} to ""
		loop 20 times:
			if loop-number <= {_full}:
				set {_bar} to "%{_bar}%&a|"
			else:
				set {_bar} to "%{_bar}%&8|"
		send colored "&7 Next: level %{_next}% %levelColored({_next})% &7at %levelNum({_to})% XP  %{_bar}% &7%{_pct}%%%" to {_p}
		set {_u::*} to levelUnlocks({_next})
		if size of {_u::*} > 0:
			set {_list} to join {_u::*} with ", "
			send colored "&7 It unlocks: &f%{_list}%" to {_p}
	set {_per} to cfg("level::xp-per-dollars")
	set {_haul} to cfg("level::xp-per-haul")
	send colored "&7 XP: 1 per %formatMoney({_per})% of loot sold, +%{_haul}% a heist; jobs, hits and missions too. &f/levels" to {_p}

command /level:
	description: Your robber level.
	aliases: /lvl
	executable by: players
	trigger:
		levelShow(player)

command /levels:
	description: Every robber level and what it unlocks.
	executable by: players
	trigger:
		set {_me} to levelOf(player)
		msg(player, "&6Robber levels &7(you: level %{_me}% %levelColored({_me})%&7)")
		loop levelMilestones():
			set {_n} to loop-value
			set {_u::*} to levelUnlocks({_n})
			set {_what} to ""
			if size of {_u::*} > 0:
				set {_list} to join {_u::*} with ", "
				set {_what} to " &7· %{_list}%"
			set {_title} to ""
			set {_a::*} to levelBracket({_n}) split at "|"
			if {_a::1} is "%{_n}%":
				set {_title} to " %levelColored({_n})%"
			set {_you} to ""
			if {_n} <= {_me}:
				set {_you} to " &a✔"
			send colored "&7 %{_n}%.%{_title}% &7- &f%levelNum(levelNeed({_n}))% XP%{_what}%%{_you}%" to player
			delete {_u::*}

# The levels worth listing: each title's start and every level that unlocks something (in order, once each).
function levelMilestones() :: numbers:
	loop {-cfg::level::brackets::*}:
		set {_a::*} to loop-value split at "|"
		set {_n} to {_a::1} parsed as integer
		if {_n} is set:
			set {_m::%{_n}%} to {_n}
	loop {-cfg::shop::weapons::*}:
		set {_n} to {-cfg::wpn::%loop-value%::level}
		if {_n} is set:
			set {_m::%{_n}%} to {_n}
	loop {-cfg::shop::tools::*}:
		set {_n} to {-cfg::tool::%loop-value%::level}
		if {_n} is set:
			set {_m::%{_n}%} to {_n}
	loop {-cfg::shop::consumables::*}:
		set {_n} to {-cfg::con::%loop-value%::level}
		if {_n} is set:
			if {_n} > 0:
				set {_m::%{_n}%} to {_n}
	loop integers from 2 to 5:
		set {_n} to {-cfg::bag::%loop-value%::level}
		if {_n} is set:
			set {_m::%{_n}%} to {_n}
	loop {-cfg::cars::*}:
		if {-cfg::car::%loop-value%::crate} is not true:
			set {_n} to {-cfg::car::%loop-value%::level}
			if {_n} is set:
				set {_m::%{_n}%} to {_n}
	loop {-cfg::contract::tiers::*}:
		set {_n} to {-cfg::contract::%loop-value%::level}
		if {_n} is set:
			set {_m::%{_n}%} to {_n}
	loop "easy", "medium" and "hard":
		set {_n} to {-cfg::hit::%loop-value%::level}
		if {_n} is set:
			set {_m::%{_n}%} to {_n}
	if {-cfg::fence::level} is set:
		set {_n} to {-cfg::fence::level}
		set {_m::%{_n}%} to {_n}
	loop {-cfg::level::rewards::*}:
		set {_ra::*} to loop-value split at "|"
		set {_n} to {_ra::1} parsed as integer
		if {_n} is set:
			set {_m::%{_n}%} to {_n}
	loop {heists::*}:
		if heistState(loop-index) is not "disabled":
			set {_n} to heistLevel(loop-index)
			set {_m::%{_n}%} to {_n}
	return sorted {_m::*}

# ---------- Staff: /dlevel ----------

function dlevelReply(s: command sender, text: text):
	send "%{_text}%" to {_s}

command /dlevel [<text>]:
	permission: donating.staff
	permission message: &cStaff only.
	trigger:
		set {_a::*} to arg-1 split at " "
		set {_sub} to {_a::1}
		if {_a::2} is not set:
			dlevelReply(sender, "LEVEL usage: /dlevel info|set|xp|reset <player> [level|xp]")
			stop
		set {_p} to {_a::2} parsed as player
		if {_p} is not set:
			dlevelReply(sender, "LEVEL %{_a::2}% isn't online")
			stop
		if {_sub} is "info":
			dlevelReply(sender, "LEVEL %name of {_p}% level=%levelOf({_p})% xp=%levelXp({_p})% name=%levelName(levelOf({_p}))%")
		else if {_sub} is "set":
			set {_r} to {_a::3} parsed as integer
			if {_r} is not set:
				set {_max} to cfg("level::max")
				dlevelReply(sender, "LEVEL set: /dlevel set <player> <0-%{_max}%>")
				stop
			set {_r} to max(0, min({_r}, cfg("level::max")))
			# Staff can move a level either way; the XP goes to that level's start, so they stay in step.
			setData({_p}, "level", {_r})
			setData({_p}, "level-xp", levelNeed({_r}))
			levelRefresh({_p})
			levelLog("set %name of {_p}% %uuid of {_p}% level=%{_r}% by=%sender%")
			msg({_p}, "&7Your level is now %{_r}% %levelColored({_r})%&7 (staff).")
			dlevelReply(sender, "LEVEL %name of {_p}% set to %{_r}% (%levelName({_r})%), xp=%levelXp({_p})%")
		else if {_sub} is "xp":
			set {_x} to {_a::3} parsed as integer
			if {_x} is not set:
				dlevelReply(sender, "LEVEL xp: /dlevel xp <player> <amount>")
				stop
			if {_x} <= 0:
				dlevelReply(sender, "LEVEL xp: only adds (XP is never taken away; use set)")
				stop
			levelAddXp({_p}, {_x}, "staff")
			dlevelReply(sender, "LEVEL %name of {_p}% +%{_x}% xp=%levelXp({_p})% level=%levelOf({_p})%")
		else if {_sub} is "reset":
			deleteData({_p}, "level")
			deleteData({_p}, "level-xp")
			# The heist runs already credited (bag.sk), so the next sale of any run pays its bonus again.
			delete {data::%{_p}%::level-haul::*}
			levelRefresh({_p})
			levelLog("reset %name of {_p}% %uuid of {_p}% by=%sender%")
			dlevelReply(sender, "LEVEL %name of {_p}% reset to 0")
		else:
			dlevelReply(sender, "LEVEL usage: /dlevel info|set|xp|reset <player> [level|xp]")
