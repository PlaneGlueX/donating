# tabcomplete.sk: tab completion for Donating's commands. Built 2026-09-27 (owner, 2026-09-27: "make sure all
# commands have tab fill feature for args and names (where applicable)").
#
# SkBee's tab complete event (checked in SkBee 3.25.4 and Paper 1.21.11): it runs on the main thread, for players only;
# "tab completions for position N" only apply while the player types the Nth word after the command, and SkBee keeps
# the entries that contain what's typed so far; "tab arg-N" is the Nth word as typed. Setting an empty list (or
# clearing it) leaves one blank entry, and a blank entry would erase the word being typed, so lists that can be empty
# are only set when they have values. SkBee's "remove ... from tab completions" can't remove anything from Bukkit's
# own lists (they can't be changed; SkBee ignores the error), so a list is always built here, never trimmed. A
# cancelled event suggests nothing; Paper sends nothing for an empty list.
# Commands without arguments and free-text arguments (chat, broadcasts) are left alone: Skript's own completer
# suggests nothing there. Player names are only the players the viewer can see (EssentialsX vanish hides staff).
# Console-only commands suggest nothing; local test helpers (zz-*) are completed for the owner only (zz-tab.sk). Every handler also answers the
# namespaced label ("/skript:bounty"): SkBee compares the typed label with each listed one, so both are listed.
# /dphone completes in Java (DonatingPhone).
#
# Permissions (owner, 2026-10-19: "if the player has permission for the command make sure it has the tab fill option so
# they can see all command arguments"): a command with a permission: line is left out of the command list Paper sends a
# player without it (so it isn't suggested after "/"), and Bukkit's command map never asks for its completions then (no
# tab complete event: checked with bots). A player with it gets every argument at every position: subcommands, the
# players they can see, ids and values the command takes now, and their own coordinates where coordinates go. Parts a
# command refuses without a second permission (donating.quests.admin, donating.season.admin) are only listed, with their
# arguments, for players who have it. Commands with no permission line that only some may use: /console (the owner's
# UUIDs) and the console-only /dshop and /gpspick are taken out of everyone else's command list below.
# Since then: /dpv, /dskins, /dsetup prison, /dquest addatw, coordinates, the add settings of /dtrap and /dloot, /djobs
# post, /dhit's districts and windows (2026-10-19). The prison's handlers live with their scripts (prison.sk,
# jailcops.sk, jailjobs.sk), /console's in owner.sk, /carcam's in carcam.sk, /voiceline's in voice.sk.

# ---------- Lists ----------

# The players the viewer can see (a vanished staff member never shows up), the viewer included.
function tabPlayerNames(viewer: player) :: texts:
	loop all players:
		if {_viewer} can see loop-player:
			add name of loop-player to {_out::*}
	return {_out::*}

function tabHeists() :: texts:
	loop {heists::*}:
		add loop-index to {_out::*}
	return {_out::*}

# "<heist>-<n>" of every trap (kind "trap") or loot spot (kind "loot"). {traps::<h>} and {loots::<h>} hold only
# sub-lists (never a value of their own), so a loop over them runs zero times: go through the heists instead.
function tabSpots(kind: text) :: texts:
	loop {heists::*}:
		set {_h} to loop-index
		if {_kind} is "trap":
			loop {traps::%{_h}%::*}:
				add "%{_h}%-%loop-index-2%" to {_out::*}
		else:
			loop {loots::%{_h}%::*}:
				add "%{_h}%-%loop-index-2%" to {_out::*}
	return {_out::*}

function tabOwnedCos(p: player, type: text) :: texts:
	loop cosOwnedOf({_p}, {_type}):
		add loop-value to {_out::*}
	return {_out::*}

function tabIndices(kind: text) :: texts:
	if {_kind} is "poi":
		loop {poi::*}:
			add loop-index to {_out::*}
	else if {_kind} is "giver":
		loop {quest::giver::*}:
			add loop-index to {_out::*}
	else if {_kind} is "keeper":
		loop {shop::keepers::*}:
			add loop-index to {_out::*}
	else if {_kind} is "spot":
		loop {contract::spot::*}:
			add loop-index to {_out::*}
	else if {_kind} is "chop":
		loop {contract::chop::*}:
			add loop-index to {_out::*}
	return {_out::*}

# The viewer's own spot on one axis, for an argument that takes coordinates: "x", "y", "z" the block, "cx", "cz" the
# middle of the block (where you'd stand), "yaw" in whole degrees.
function tabPos(p: player, axis: text) :: text:
	set {_l} to location of {_p}
	if {_axis} is "x":
		set {_v} to floor(x-coordinate of {_l})
	else if {_axis} is "y":
		set {_v} to floor(y-coordinate of {_l})
	else if {_axis} is "z":
		set {_v} to floor(z-coordinate of {_l})
	else if {_axis} is "cx":
		set {_b} to floor(x-coordinate of {_l})
		set {_v} to {_b} + 0.5
	else if {_axis} is "cz":
		set {_b} to floor(z-coordinate of {_l})
		set {_v} to {_b} + 0.5
	else:
		set {_v} to round(yaw of {_l})
	return "%{_v}%"

function tabWorlds() :: texts:
	loop all worlds:
		add "%loop-world%" to {_out::*}
	return {_out::*}

# The settings a loot spot of that kind takes (loot.sk lootKeyType).
function tabLootKeys(kind: text) :: texts:
	if {_kind} is "pile":
		return "name", "value", "style", "behind", "piece", "take", "per-cell", "layers" and "lift"
	if {_kind} is "smash":
		return "name", "alarm" and "take"
	if {_kind} is "safe":
		return "name", "alarm", "digits" and "claim"
	if {_kind} is "drill":
		return "name", "alarm", "time", "mount", "claim" and "jams"
	return "name"

# A trap's key=value settings (traps.sk trapKeyType), effect=alarm only in an advanced heist.
function tabTrapKeys(h: text) :: texts:
	add "effect=damage" to {_out::*}
	if heistIsAdvanced({_h}) is true:
		add "effect=alarm" to {_out::*}
	loop "damage", "every", "blink", "on", "off", "offset", "delay", "restore", "depth", "angle", "range", "sweep", "period" and "grace":
		add "%loop-value%=" to {_out::*}
	return {_out::*}

# ---------- Who sees which commands ----------

# /console is the owner's (owner.sk, by UUID: no permission line), /dshop and /gpspick the console's: nobody else gets
# them suggested after "/" (the namespaced labels too).
on send command list:
	if ownerIs(player) is false:
		remove "console" and "skript:console" from command list
	remove "dshop", "skript:dshop", "gpspick" and "skript:gpspick" from command list

# ---------- Players ----------

# Only the players you could trade with right now (next to you, the command's own check), and "cancel".
on tab complete of "/trade" and "/skript:trade":
	if {-trade::sid::%uuid of player%} is not set:
		loop all players:
			if player can see loop-player:
				if {-trade::sid::%uuid of loop-player%} is not set:
					if tradeBlock(player, loop-player, false) is "":
						add name of loop-player to {_n::*}
	set tab completions for position 1 to "cancel" and {_n::*}

# The players you could place a bounty on: the ones you can see, not yourself, not passive players, and nobody while
# you're passive or still in the tutorial. With nobody to suggest the event is cancelled, or Bukkit's own list for the
# <offline player> argument (everyone) would come back. Then the amounts (the minimum, 5x, 10x) you can pay.
on tab complete of "/bounty" and "/skript:bounty":
	# Names only where a bounty can be posted (next to the Broker, or anywhere without one).
	if isPassive(player) is false:
		if tutorialNeedsBag(player) is false:
			bountyPostBlock(player) is ""
			loop all players:
				if loop-player is not player:
					if player can see loop-player:
						if isPassive(loop-player) is false:
							add name of loop-player to {_n::*}
	if {_n::*} is not set:
		cancel event
		stop
	set tab completions for position 1 to {_n::*}
	set {_min} to cfg("bounty::min-placed")
	set {_m5} to {_min} * 5
	set {_m10} to {_min} * 10
	loop {_min}, {_m5} and {_m10}:
		if balance of player >= loop-value:
			add "%loop-value%" to {_amt::*}
	if {_amt::*} is set:
		set tab completions for position 2 to {_amt::*}

on tab complete of "/title" and "/skript:title":
	set tab completions for position 1 to "none" and tabOwnedCos(player, "title")

on tab complete of "/killeffect" and "/skript:killeffect":
	set tab completions for position 1 to "none" and tabOwnedCos(player, "killfx")

on tab complete of "/bagskin" and "/skript:bagskin":
	set tab completions for position 1 to "default" and bagSkinsOwned(player)

# /gunskin <gun> <look|default> (cosmetics.sk): the guns you have skins for (their names without spaces: "ClassicPistol",
# "AK-48"), then "default" and the looks you own (the second word can't see the first: every gun's).
on tab complete of "/gunskin" and "/skript:gunskin":
	loop {-cfg::gunskin::guns::*}:
		set {_own::*} to gunSkinsOwned(player, loop-value)
		if size of {_own::*} > 0:
			set {_g} to "%{-cfg::wpn::%loop-value%::name}%"
			replace all " " with "" in {_g}
			add {_g} to {_guns::*}
			loop {_own::*}:
				set {_l} to "%{-cfg::cos::%loop-value-2%::look}%"
				replace all " " with "" in {_l}
				if {_looks::*} does not contain {_l}:
					add {_l} to {_looks::*}
	if {_guns::*} is not set:
		cancel event
		stop
	set tab completions for position 1 to {_guns::*}
	set tab completions for position 2 to "default" and {_looks::*}

# Only for a player whose refresh is ready and who isn't in combat: the heists it would take (cooling down, their
# level allows).
on tab complete of "/heistrefresh" and "/skript:heistrefresh":
	if refreshLeft(player) is 0:
		if isCombatTagged(player) is false:
			loop {heists::*}:
				if heistRefreshBlock(loop-index) is "":
					if heistLevelOk(player, loop-index) is true:
						add loop-index to {_h::*}
	if {_h::*} is set:
		set tab completions for position 1 to {_h::*}

# /messages <contact>: the contacts who texted you (messages.sk).
on tab complete of "/messages", "/texts", "/inbox", "/skript:messages", "/skript:texts" and "/skript:inbox":
	set {_c::*} to msgContacts(player)
	if {_c::*} is set:
		set tab completions for position 1 to {_c::*}

# /gps: its pages (gps.sk gpsCat) and removing the pin.
on tab complete of "/gps" and "/skript:gps":
	set tab completions for position 1 to "quests", "heists", "shops", "places", "clear" and "off"

on tab complete of "/leaderboard", "/lb", "/skript:leaderboard" and "/skript:lb":
	set tab completions for position 1 to {-cfg::season::boards::*}

# /tutorial confirm (while the prison runs) and stop (only during a replay of the course: jailcourse.sk jcReplaying).
on tab complete of "/tutorial" and "/skript:tutorial":
	jailOn() is true
	set {_t::*} to "confirm"
	if jcReplaying(player) is true:
		add "stop" to {_t::*}
	set tab completions for position 1 to {_t::*}

# ---------- Console only: nothing ----------

on tab complete of "/dshop", "/gpspick", "/skript:dshop" and "/skript:gpspick":
	cancel event

# ---------- Staff ----------

on tab complete of "/dheist" and "/skript:dheist":
	set tab completions for position 1 to "create", "set", "exit", "snapshot", "holo", "lock", "enable", "disable", "open", "start", "end", "reset", "alarm", "kick", "info", "list", "dump" and "delete"
	set {_s} to tab arg-1
	if {_s} is "list":
		stop
	if {_s} is "kick":
		loop all players:
			if player can see loop-player:
				if heistOf(loop-player) is not "":
					add name of loop-player to {_k::*}
		if {_k::*} is set:
			set tab completions for position 2 to {_k::*}
		stop
	if {_s} is "create":
		# The heist regions you stand in that aren't a heist yet (trap sub-regions like heist_bank_vault aren't ids).
		set {_pre} to {-cfg::heist::region-prefix}
		loop regions at location of player:
			set {_rid} to name of loop-value
			if {_rid} starts with {_pre}:
				set {_id} to subtext of {_rid} from characters (length of {_pre} + 1) to (length of {_rid})
				if {_id} matches "[a-z0-9]{1,16}":
					if {heists::%{_id}%} is not set:
						add {_id} to {_new::*}
		if {_new::*} is set:
			set tab completions for position 2 to {_new::*}
		set tab completions for position 3 to "0", "1", "2", "3" and "4"
	else:
		# Only the heists this subcommand takes in their state (heists.sk refuses the others).
		loop {heists::*}:
			set {_st} to heistState(loop-index)
			if {_s} is "enable" or "snapshot":
				if {_st} is "disabled":
					add loop-index to {_l::*}
			else if {_s} is "open":
				if {_st} is "cooldown":
					add loop-index to {_l::*}
			else if {_s} is "start":
				if {_st} is "open":
					add loop-index to {_l::*}
			else if {_s} is "end":
				if {_st} is "active":
					add loop-index to {_l::*}
			else if {_s} is "reset":
				if {_st} is "open" or "cooldown":
					add loop-index to {_l::*}
			else if {_s} is "alarm":
				if heistIsAdvanced(loop-index) is true:
					if {-heist::%loop-index%::alarm} is not set:
						if {_st} is "open" or "active":
							add loop-index to {_l::*}
			else:
				add loop-index to {_l::*}
		if {_l::*} is set:
			set tab completions for position 2 to {_l::*}
		if {_s} is "set":
			set tab completions for position 3 to "name", "difficulty", "escape", "cooldown", "pool", "level", "advanced", "pvp", "police" and "trap-damage"
			set {_k} to tab arg-3
			if {_k} is "advanced", "pvp" or "police":
				set tab completions for position 4 to "true", "false" and "default"
			else if {_k} is "level":
				loop levelMilestones():
					add "%loop-value%" to {_lv::*}
				add "default" to {_lv::*}
				set tab completions for position 4 to {_lv::*}
			else if {_k} is "difficulty":
				set tab completions for position 4 to "0", "1", "2", "3" and "4"
			else if {_k} is not "name":
				set tab completions for position 4 to "default"
		else if {_s} is "lock":
			set tab completions for position 3 to "add", "list", "clear" and "test"
			# lock <id> add x1 y1 z1 x2 y2 z2 [block]: your block as a start, then the block (iron bars by default).
			if tab arg-3 is "add":
				set tab completions for position 4 to tabPos(player, "x")
				set tab completions for position 5 to tabPos(player, "y")
				set tab completions for position 6 to tabPos(player, "z")
				set tab completions for position 7 to tabPos(player, "x")
				set tab completions for position 8 to tabPos(player, "y")
				set tab completions for position 9 to tabPos(player, "z")
				set tab completions for position 10 to "iron_bars", "glass" and "iron_block"
		else if {_s} is "exit":
			# exit <id> [x y z [yaw]]: where you stand (or type a spot).
			set tab completions for position 3 to tabPos(player, "cx")
			set tab completions for position 4 to tabPos(player, "y")
			set tab completions for position 5 to tabPos(player, "cz")
			set tab completions for position 6 to tabPos(player, "yaw")
		else if {_s} is "holo":
			set tab completions for position 3 to "remove"
		else if {_s} is "delete":
			set tab completions for position 3 to "confirm"

on tab complete of "/dtrap" and "/skript:dtrap":
	set tab completions for position 1 to "pos1", "pos2", "add", "set", "list", "info", "remove", "clear", "show", "dry", "dump" and "reload"
	set {_s} to tab arg-1
	if {_s} is "set" or "info" or "remove":
		set {_l::*} to tabSpots("trap")
		if {_l::*} is set:
			set tab completions for position 2 to {_l::*}
		if {_s} is "set":
			set tab completions for position 3 to "damage", "effect", "every", "blink", "on", "off", "offset", "delay", "restore", "depth", "angle", "range", "sweep", "period" and "grace"
			set {_key} to tab arg-3
			if {_key} is "effect":
				set {_tp::*} to (tab arg-2) split at "-"
				if heistIsAdvanced({_tp::1}) is true:
					set tab completions for position 4 to "damage", "alarm" and "default"
				else:
					set tab completions for position 4 to "damage" and "default"
			else if {_key} is "blink":
				set tab completions for position 4 to "true", "false" and "default"
			else:
				set tab completions for position 4 to "default"
	else if {_s} is "dry":
		set tab completions for position 2 to tabPlayerNames(player)
		set tab completions for position 3 to "on" and "off"
	else if {_s} is "add" or "list" or "clear" or "show" or "dump":
		set {_l::*} to tabHeists()
		if {_l::*} is set:
			set tab completions for position 2 to {_l::*}
		if {_s} is "add":
			set tab completions for position 3 to "laser", "plate", "floor" and "camera"
			# Then key=value settings (corners come from /dtrap pos1 and pos2, or typed numbers).
			if tab arg-3 is set:
				set {_kv::*} to tabTrapKeys(tab arg-2)
				loop integers from 4 to 16:
					set tab completions for position loop-value to {_kv::*}
				if tab arg-3 is "laser":
					set tab completions for position 4 to "here" and {_kv::*}
					if tab arg-4 is "here":
						set tab completions for position 5 to "low", "mid", "high" and {_kv::*}
		else if {_s} is "clear":
			set tab completions for position 3 to "confirm"
		else if {_s} is "show":
			set tab completions for position 3 to "30", "60" and "off"

on tab complete of "/dloot" and "/skript:dloot":
	set tab completions for position 1 to "pos1", "pos2", "add", "set", "list", "info", "remove", "clear", "show", "preview", "roll", "regate", "check", "dump" and "reload"
	set {_s} to tab arg-1
	if {_s} is "regate":
		loop tabSpots("loot"):
			set {_q::*} to loop-value split at "-"
			if lootIsGate({loots::%{_q::1}%::%{_q::2}%}) is true:
				if heistState({_q::1}) is "disabled":
					add loop-value to {_g::*}
		if {_g::*} is set:
			set tab completions for position 2 to {_g::*}
	else if {_s} is "preview" or "roll":
		set {_want} to "disabled"
		if {_s} is "roll":
			set {_want} to "open"
		loop {heists::*}:
			if heistState(loop-index) is {_want}:
				add loop-index to {_hl::*}
		if {_hl::*} is set:
			set tab completions for position 2 to {_hl::*}
	else if {_s} is "set" or "info" or "remove":
		set {_l::*} to tabSpots("loot")
		if {_l::*} is set:
			set tab completions for position 2 to {_l::*}
		if {_s} is "set":
			# The settings of that spot's kind (loot.sk lootKeyType).
			set {_p::*} to (tab arg-2) split at "-"
			set {_kind} to {loots::%{_p::1}%::%{_p::2}%}
			if {_kind} is set:
				set tab completions for position 3 to tabLootKeys({_kind})
			set {_key} to tab arg-3
			if {_key} is "style":
				set tab completions for position 4 to {-cfg::loot::styles::*} and "default"
			else if {_key} is "alarm":
				set tab completions for position 4 to "true", "false" and "default"
			else if {_key} is "per-cell":
				set tab completions for position 4 to "1", "2", "4" and "default"
			else if {_key} is "layers":
				set tab completions for position 4 to "1", "2", "3" and "default"
			else if {_key} is "digits":
				set tab completions for position 4 to "3", "4", "5" and "default"
			else if {_key} is "jams":
				set tab completions for position 4 to "0", "1", "2", "3", "4", "5" and "default"
			else if {_key} is "behind":
				# The gate numbers of that heist.
				loop {loots::%{_p::1}%::*}:
					if lootIsGate(loop-value) is true:
						add loop-index to {_gn::*}
				set tab completions for position 4 to {_gn::*} and "default"
			else if {_key} is not "value":
				set tab completions for position 4 to "default"
	else if {_s} is "add" or "list" or "clear" or "show" or "check" or "dump":
		set {_l::*} to tabHeists()
		if {_l::*} is set:
			set tab completions for position 2 to {_l::*}
		if {_s} is "add":
			set tab completions for position 3 to "pile", "smash", "safe" and "drill"
			# Then that kind's key=value settings (corners from /dloot pos1 and pos2, or typed numbers); a pile needs
			# value=MIN-MAX.
			set {_kind} to tab arg-3
			if {_kind} is "pile" or "smash" or "safe" or "drill":
				loop tabLootKeys({_kind}):
					if loop-value is "value":
						add "value=500-2000" to {_kv::*}
					else if loop-value is "style":
						loop {-cfg::loot::styles::*}:
							add "style=%loop-value-2%" to {_kv::*}
					else:
						add "%loop-value%=" to {_kv::*}
				loop integers from 4 to 16:
					set tab completions for position loop-value to {_kv::*}
		else if {_s} is "clear":
			set tab completions for position 3 to "confirm"
		else if {_s} is "show":
			set tab completions for position 3 to "20" and "60"

# /dcops <heist> add [x y z] | list | clear | spawn | removeall | dump.
on tab complete of "/dcops" and "/skript:dcops":
	set {_l::*} to tabHeists()
	if {_l::*} is set:
		set tab completions for position 1 to {_l::*}
	set tab completions for position 2 to "add", "list", "clear", "spawn", "removeall" and "dump"
	if tab arg-2 is "add":
		set tab completions for position 3 to tabPos(player, "cx")
		set tab completions for position 4 to tabPos(player, "y")
		set tab completions for position 5 to tabPos(player, "cz")

on tab complete of "/dcrate" and "/skript:dcrate":
	set tab completions for position 1 to "give", "take", "info", "place", "remove" and "list"
	set {_s} to tab arg-1
	if {_s} is "give" or "take" or "info":
		set tab completions for position 2 to tabPlayerNames(player)
		if {_s} is "give":
			# Never a crate that's never given (the Season crate).
			loop {-cfg::crates::*}:
				if {-cfg::crate::%loop-value%::never-give} is not set:
					add loop-value to {_give::*}
			set tab completions for position 3 to {_give::*}
			set tab completions for position 4 to "1", "5" and "10"
		else if {_s} is "take":
			set tab completions for position 3 to {-cfg::crates::*}
			set tab completions for position 4 to "1", "5" and "10"
	else if {_s} is "place":
		set tab completions for position 2 to {-cfg::crates::*}
	else if {_s} is "remove":
		# remove [x y z [world]]: the stands' blocks ({crateblock::<world>:<x>:<y>:<z>}), each word narrowing the next.
		loop {crateblock::*}:
			set {_k::*} to loop-index split at ":"
			if {_xs::*} does not contain {_k::2}:
				add {_k::2} to {_xs::*}
			if {_k::2} is tab arg-2:
				if {_ys::*} does not contain {_k::3}:
					add {_k::3} to {_ys::*}
				if {_k::3} is tab arg-3:
					if {_zs::*} does not contain {_k::4}:
						add {_k::4} to {_zs::*}
					if {_k::4} is tab arg-4:
						add {_k::1} to {_ws::*}
		if {_xs::*} is set:
			set tab completions for position 2 to {_xs::*}
		if {_ys::*} is set:
			set tab completions for position 3 to {_ys::*}
		if {_zs::*} is set:
			set tab completions for position 4 to {_zs::*}
		if {_ws::*} is set:
			set tab completions for position 5 to {_ws::*}

on tab complete of "/dranks" and "/skript:dranks":
	set tab completions for position 1 to "setup", "give", "take" and "list"
	set {_s} to tab arg-1
	if {_s} is "give" or "take":
		set tab completions for position 2 to tabPlayerNames(player)
		if {_s} is "give":
			set tab completions for position 3 to {-cfg::paidranks::*} and "none"
		else:
			set tab completions for position 3 to {-cfg::paidranks::*}

# dbooster add <player> [money|xp|rush] <multiplier> <minutes> [count]: without a kind the multiplier comes third.
on tab complete of "/dbooster" and "/skript:dbooster":
	set tab completions for position 1 to "add", "stop", "clear" and "info"
	set {_s} to tab arg-1
	if {_s} is "add":
		set tab completions for position 2 to tabPlayerNames(player)
		set tab completions for position 3 to {-cfg::booster::kinds::*}, "1.5" and "2"
		# Then [count] (the store's {purchaseQuantity}).
		if {-cfg::booster::kinds::*} contains tab arg-3:
			set tab completions for position 4 to "1.5" and "2"
			set tab completions for position 5 to "5", "30" and "60"
			set tab completions for position 6 to "1", "2" and "10"
		else:
			set tab completions for position 4 to "5", "30" and "60"
			set tab completions for position 5 to "1", "2" and "10"
	else:
		set tab completions for position 2 to {-cfg::booster::kinds::*}

on tab complete of "/dlevel" and "/skript:dlevel":
	set tab completions for position 1 to "info", "set", "xp" and "reset"
	set tab completions for position 2 to tabPlayerNames(player)
	if tab arg-1 is "set":
		loop levelMilestones():
			add "%loop-value%" to {_lv::*}
		set tab completions for position 3 to {_lv::*}
	else if tab arg-1 is "xp":
		set tab completions for position 3 to "100", "1000" and "10000"

on tab complete of "/dpoi" and "/skript:dpoi":
	set tab completions for position 1 to "add", "remove", "list" and "dump"
	set {_s} to tab arg-1
	if {_s} is "add":
		set tab completions for position 2 to {-cfg::poi::types::*}
	else if {_s} is "remove":
		set {_l::*} to tabIndices("poi")
		if {_l::*} is set:
			set tab completions for position 2 to {_l::*}

on tab complete of "/dsetup" and "/skript:dsetup":
	set tab completions for position 1 to "all", "heists", "story", "places", "flags", "shops", "quests", "jobs", "crates", "cars", "fuel", "server", "phone" and "prison"

on tab complete of "/ddistrict" and "/skript:ddistrict":
	set tab completions for position 1 to "name", "list", "here" and "dump"
	if tab arg-1 is "name":
		set {_l::*} to districtIds()
		if {_l::*} is set:
			set tab completions for position 2 to {_l::*}
		set tab completions for position 3 to "default"

on tab complete of "/dquest" and "/skript:dquest":
	set tab completions for position 1 to "add", "addat", "addatw", "remove", "list", "dump" and "open"
	set {_s} to tab arg-1
	if {_s} is "add" or "addat" or "addatw":
		set tab completions for position 2 to {-cfg::quests::*}
		# add <kind> [place] | addat <kind> <x> <y> <z> <yaw> [place] | addatw <kind> <world> <x> <y> <z> <yaw> [place]:
		# where you stand, and the kind's default place.
		set {_k} to tab arg-2
		set {_place} to {-cfg::quest::%{_k}%::place}
		set {_at} to 3
		if {_s} is "addatw":
			set tab completions for position 3 to tabWorlds()
			set {_at} to 4
		if {_s} is not "add":
			loop "cx", "y", "cz" and "yaw":
				set tab completions for position {_at} to tabPos(player, loop-value)
				add 1 to {_at}
		if {_place} is set:
			set tab completions for position {_at} to {_place}
	else if {_s} is "remove":
		set {_l::*} to tabIndices("giver")
		if {_l::*} is set:
			set tab completions for position 2 to {_l::*}
	else if {_s} is "open":
		set tab completions for position 2 to tabPlayerNames(player)
		set {_l::*} to tabIndices("giver")
		if {_l::*} is set:
			set tab completions for position 3 to {_l::*}

on tab complete of "/dseason" and "/skript:dseason":
	if player has permission "donating.season.admin":
		set tab completions for position 1 to "info", "finals", "rank", "holo", "start", "end", "extend", "approve", "void" and "reset"
	else:
		set tab completions for position 1 to "info", "finals", "rank" and "holo"
	set {_s} to tab arg-1
	# The admin parts' arguments only for season admins (seasons.sk refuses the rest).
	if {_s} is "start" or "end" or "extend" or "approve" or "void" or "reset":
		if player does not have permission "donating.season.admin":
			stop
	if {_s} is "holo":
		set tab completions for position 2 to {-cfg::season::boards::*}
	else if {_s} is "void" or "reset":
		set tab completions for position 2 to tabPlayerNames(player)
		if {_s} is "void":
			# The season under review, and any other one whose prizes wait.
			add "%seasonNum()%" to {_v::*}
			loop {seasonreview::*}:
				add loop-index to {_v::*}
			set tab completions for position 3 to {_v::*}
	else if {_s} is "finals":
		# Only seasons that have finals (frozen).
		loop seasonNum() times:
			if {seasonx::%loop-number%::frozen} is true:
				add "%loop-number%" to {_f::*}
		if {_f::*} is set:
			set tab completions for position 2 to {_f::*}
		set tab completions for position 3 to {-cfg::season::boards::*}
	else if {_s} is "approve":
		loop {seasonreview::*}:
			add loop-index to {_r::*}
		if {_r::*} is set:
			set tab completions for position 2 to {_r::*}
	else if {_s} is "start" or "extend":
		set tab completions for position 2 to "7", "14" and "28"

# set and reset need donating.quests.admin (story.sk).
on tab complete of "/dstory" and "/skript:dstory":
	if player has permission "donating.quests.admin":
		set tab completions for position 1 to "info", "set", "reset" and "skip"
	else:
		set tab completions for position 1 to "info" and "skip"
		if tab arg-1 is "set" or "reset":
			stop
	set tab completions for position 2 to tabPlayerNames(player)
	if tab arg-1 is "set":
		# Every chain's missions (Mara's, Vic's, Lefty's in the prison).
		loop {-cfg::story::chains::*}:
			add storyList(loop-value) to {_ms::*}
		if {_ms::*} is set:
			set tab completions for position 3 to {_ms::*}
	else:
		set tab completions for position 3 to {-cfg::story::chains::*}

on tab complete of "/dshopkeeper" and "/skript:dshopkeeper":
	set tab completions for position 1 to "add", "remove" and "list"
	set {_s} to tab arg-1
	if {_s} is "add":
		set tab completions for position 2 to "gun", "gear", "bag", "tools", "cars" and "garage"
	else if {_s} is "remove":
		set {_l::*} to tabIndices("keeper")
		if {_l::*} is set:
			set tab completions for position 2 to {_l::*}

on tab complete of "/dgarage" and "/skript:dgarage":
	set tab completions for position 1 to "give", "build", "take", "info", "store" and "roll"
	set {_s} to tab arg-1
	if {_s} is "store":
		loop all players:
			if player can see loop-player:
				if {car::outof::%uuid of loop-player%} is set:
					add name of loop-player to {_o::*}
		if {_o::*} is set:
			set tab completions for position 2 to {_o::*}
	else:
		set tab completions for position 2 to tabPlayerNames(player)
	if {_s} is "roll":
		set tab completions for position 2 to "supercar" and "hypercar"
	else if {_s} is "build":
		# build <player> <model|color|wrap|engine|turbo|handling|neon|trail>: a stock build of each car to start from
		# ("-" = none), in its first one-word color (a space would split the build into two arguments).
		loop {-cfg::cars::*}:
			set {_col} to ""
			loop carColorLabels(loop-value-1):
				if {_col} is "":
					if loop-value-2 does not contain " ":
						set {_col} to loop-value-2
			if {_col} is not "":
				add "%loop-value-1%|%{_col}%|-|0|0|0|-|-" to {_bt::*}
		if {_bt::*} is set:
			set tab completions for position 3 to {_bt::*}
	else if {_s} is "give":
		# Several of a model are fine now: every car, then that car's colors.
		set tab completions for position 3 to {-cfg::cars::*}
		set {_car} to tab arg-3
		if {_car} is set:
			set {_c::*} to carColorLabels({_car})
			if {_c::*} is set:
				set tab completions for position 4 to {_c::*}
	else if {_s} is "take":
		# The target's plates (online players only: no profile lookups here).
		set {_t} to (tab arg-2) parsed as player
		if {_t} is set:
			set {_c3::*} to carsOf({_t})
			if {_c3::*} is set:
				set tab completions for position 3 to {_c3::*}

on tab complete of "/dcontract" and "/skript:dcontract":
	set tab completions for position 1 to "spot", "chop", "dump", "info" and "end"
	set {_s} to tab arg-1
	if {_s} is "spot" or "chop":
		set tab completions for position 2 to "add", "addat", "addatw", "remove" and "list"
		if tab arg-2 is "remove":
			set {_l::*} to tabIndices({_s})
			if {_l::*} is set:
				set tab completions for position 3 to {_l::*}
		else if tab arg-2 is "addat":
			# addat <x> <y> <z> [yaw]: where you stand.
			set tab completions for position 3 to tabPos(player, "cx")
			set tab completions for position 4 to tabPos(player, "y")
			set tab completions for position 5 to tabPos(player, "cz")
			set tab completions for position 6 to tabPos(player, "yaw")
		else if tab arg-2 is "addatw":
			# addatw <world> <x> <y> <z> [yaw]: where you stand.
			set tab completions for position 3 to "%world of player%"
			set tab completions for position 4 to tabPos(player, "cx")
			set tab completions for position 5 to tabPos(player, "y")
			set tab completions for position 6 to tabPos(player, "cz")
			set tab completions for position 7 to tabPos(player, "yaw")
	else if {_s} is "info":
		set tab completions for position 2 to tabPlayerNames(player)
	else if {_s} is "end":
		loop all players:
			if player can see loop-player:
				if {-ctjob::%uuid of loop-player%} is set:
					add name of loop-player to {_j::*}
		if {_j::*} is set:
			set tab completions for position 2 to {_j::*}

# met, post, unlock, empty, lock, clear and rep need donating.quests.admin (jobs.sk): only listed for players with it.
# post <player> <contact> <slot> <template> <heist|tier> [bonus|-] [model].
on tab complete of "/djobs" and "/skript:djobs":
	set {_subs::*} to "info", "take", "fill" and "stats"
	if player has permission "donating.quests.admin":
		add "met", "post", "unlock", "empty", "lock", "clear" and "rep" to {_subs::*}
	set tab completions for position 1 to {_subs::*}
	set {_s} to tab arg-1
	if {_s} is not set:
		stop
	if {_subs::*} does not contain {_s}:
		stop
	if {_s} is "stats":
		stop
	set tab completions for position 2 to tabPlayerNames(player)
	set tab completions for position 3 to {-cfg::jobs::contacts::*}
	set {_c} to tab arg-3
	if {_s} is "met" or "post":
		set {_slots} to {-cfg::jobs::slots-family}
		loop {_slots} times:
			add "%loop-number%" to {_n::*}
		if {_n::*} is set:
			set tab completions for position 4 to {_n::*}
	else if {_s} is "rep":
		set tab completions for position 4 to "10", "100" and "1000"
	if {_s} is "post":
		if {_c} is set:
			set tab completions for position 5 to {-cfg::jobs::%{_c}%::templates::*}
			if {_c} is "mara":
				set {_hl::*} to tabHeists()
				if {_hl::*} is set:
					set tab completions for position 6 to {_hl::*}
			else:
				set tab completions for position 6 to {-cfg::contract::tiers::*}
				# The model: a car of that tier's contract list.
				set {_t} to tab arg-6
				if {_t} is set:
					set {_m::*} to {-cfg::contractcars::%{_t}%::*}
					if {_m::*} is set:
						set tab completions for position 8 to {_m::*}
			set {_tpl} to tab arg-5
			if {_tpl} is set:
				set tab completions for position 7 to "-" and {-cfg::jobs::tpl::%{_tpl}%::bonuses::*}

# roll [week] and reset need donating.quests.admin (fence.sk).
on tab complete of "/dfence" and "/skript:dfence":
	if player has permission "donating.quests.admin":
		set tab completions for position 1 to "list", "roll", "info", "take" and "reset"
		if tab arg-1 is "roll":
			set {_w} to progWeek()
			set {_w2} to {_w} + 1
			set tab completions for position 2 to "%{_w}%" and "%{_w2}%"
			stop
	else:
		set tab completions for position 1 to "list", "info" and "take"
		if tab arg-1 is "roll" or "reset":
			stop
	if tab arg-1 is "info" or "take" or "reset":
		set tab completions for position 2 to tabPlayerNames(player)

on tab complete of "/dtutorial" and "/skript:dtutorial":
	set tab completions for position 1 to tabPlayerNames(player)
	set tab completions for position 2 to "reset" and "done"

# give, reset, window and week reroll need donating.quests.admin (hits.sk): only listed for players with it.
on tab complete of "/dhit" and "/skript:dhit":
	set {_adm} to false
	if player has permission "donating.quests.admin":
		set {_adm} to true
	if {_adm} is true:
		set tab completions for position 1 to "node", "route", "week", "window", "info", "give", "end" and "reset"
	else:
		set tab completions for position 1 to "node", "route", "week", "info" and "end"
		if tab arg-1 is "give" or "reset" or "window":
			stop
	set {_s} to tab arg-1
	set {_d::*} to districtIds()
	if {_s} is "node":
		set tab completions for position 2 to "add", "addat", "link", "unlink", "remove", "clear", "list", "dump" and "show"
		set {_op} to tab arg-2
		if {_op} is "remove" or "link" or "unlink":
			loop {hit::node::*}:
				add loop-index to {_n::*}
			if {_n::*} is set:
				set tab completions for position 3 to {_n::*}
				set tab completions for position 4 to {_n::*}
		else if {_op} is "add":
			# add [district]: the district the node is in.
			if {_d::*} is set:
				set tab completions for position 3 to {_d::*}
		else if {_op} is "addat":
			# addat <x> <y> <z> [district]
			set tab completions for position 3 to tabPos(player, "cx")
			set tab completions for position 4 to tabPos(player, "y")
			set tab completions for position 5 to tabPos(player, "cz")
			if {_d::*} is set:
				set tab completions for position 6 to {_d::*}
	else if {_s} is "route":
		set tab completions for position 2 to "on" and "off"
		if tab arg-2 is "on":
			if {_d::*} is set:
				set tab completions for position 3 to {_d::*}
	else if {_s} is "week":
		if {_adm} is true:
			set tab completions for position 2 to "list" and "reroll"
		else:
			set tab completions for position 2 to "list"
	else if {_s} is "window":
		set tab completions for position 2 to {-cfg::hit::tiers::*}
		set tab completions for position 3 to "open" and "close"
		# open [seconds]
		if tab arg-3 is "open":
			set tab completions for position 4 to "300", "1800" and "3600"
	else if {_s} is "info" or "give" or "end" or "reset":
		set tab completions for position 2 to tabPlayerNames(player)
		if {_s} is "give":
			set tab completions for position 3 to {-cfg::hit::tiers::*}

on tab complete of "/dclerk" and "/skript:dclerk":
	set {_l::*} to "list"
	loop {heists::*}:
		if heistIsStore(loop-index) is true:
			add loop-index to {_l::*}
	set tab completions for position 1 to {_l::*}
	set {_h} to tab arg-1
	if {_h} is not "list":
		set tab completions for position 2 to "set", "setat", "shelf", "shelfat", "remove", "info", "spawn" and "dump"
	set {_s} to tab arg-2
	if {_s} is "shelf":
		set tab completions for position 3 to "add", "remove" and "clear"
		if tab arg-3 is "remove":
			loop {store::%{_h}%::shelf::*}:
				add loop-index to {_n::*}
			if {_n::*} is set:
				set tab completions for position 4 to {_n::*}
	else if {_s} is "setat":
		set tab completions for position 3 to tabPos(player, "cx")
		set tab completions for position 4 to tabPos(player, "y")
		set tab completions for position 5 to tabPos(player, "cz")
		set tab completions for position 6 to tabPos(player, "yaw")
	else if {_s} is "shelfat":
		set tab completions for position 3 to tabPos(player, "cx")
		set tab completions for position 4 to tabPos(player, "y")
		set tab completions for position 5 to tabPos(player, "cz")

on tab complete of "/dclock" and "/skript:dclock":
	set tab completions for position 1 to "info", "set" and "day"
	if tab arg-1 is "set":
		set tab completions for position 2 to "6:00", "9:00", "12:00" and "7:30"
		set tab completions for position 3 to "am" and "pm"
	else if tab arg-1 is "day":
		set tab completions for position 2 to "%clockDayCount()%"

on tab complete of "/dfuel" and "/skript:dfuel":
	set tab completions for position 1 to "pumpat", "pump", "remove", "list", "dump", "car" and "info"
	set {_s} to tab arg-1
	if {_s} is "pump":
		set tab completions for position 2 to "add"
	else if {_s} is "remove":
		loop {fuel::pump::*}:
			add loop-index to {_n::*}
		if {_n::*} is set:
			set tab completions for position 2 to {_n::*}
	else if {_s} is "pumpat":
		loop all worlds:
			add "%loop-value%" to {_w::*}
		set tab completions for position 2 to {_w::*}
	else if {_s} is "info":
		loop all players:
			if player can see loop-player:
				add name of loop-player to {_p::*}
		if {_p::*} is set:
			set tab completions for position 2 to {_p::*}

on tab complete of "/dbike" and "/skript:dbike":
	set tab completions for position 1 to "spotat", "spot", "remove", "list", "dump" and "reset"
	set {_s} to tab arg-1
	if {_s} is "spot":
		set tab completions for position 2 to "add"
	else if {_s} is "remove":
		loop {bike::spot::*}:
			add loop-index to {_n::*}
		if {_n::*} is set:
			set tab completions for position 2 to {_n::*}
	else if {_s} is "spotat":
		loop all worlds:
			add "%loop-value%" to {_w::*}
		set tab completions for position 2 to {_w::*}

on tab complete of "/dgaragesite" and "/skript:dgaragesite":
	set tab completions for position 1 to "exit", "return", "bay", "exitat", "returnat", "bayat", "remove", "list", "show", "dump" and "holo"
	set {_s} to tab arg-1
	if {_s} is "exit" or "return" or "bay":
		set tab completions for position 2 to "add"
	else if {_s} is "remove" or "exitat" or "returnat" or "bayat" or "holo":
		loop {garagesites::*}:
			add loop-index to {_g::*}
		if {_g::*} is set:
			set tab completions for position 2 to {_g::*}
		if {_s} is "remove":
			set tab completions for position 3 to "exit", "return" and "bay"
			set {_site} to tab arg-2
			set {_kind} to tab arg-3
			if {_site} is set:
				if {_kind} is set:
					loop {garagesite::%{_site}%::%{_kind}%::*}:
						add loop-index to {_ix::*}
					if {_ix::*} is set:
						set tab completions for position 4 to {_ix::*}
		else if {_s} is "exitat" or "returnat" or "bayat":
			# <site> <x> <y> <z> <yaw>: where you stand.
			set tab completions for position 3 to tabPos(player, "cx")
			set tab completions for position 4 to tabPos(player, "y")
			set tab completions for position 5 to tabPos(player, "cz")
			set tab completions for position 6 to tabPos(player, "yaw")

# /dpv xray on|off | info <player> | reset (pv.sk).
on tab complete of "/dpv" and "/skript:dpv":
	set tab completions for position 1 to "xray", "info" and "reset"
	if tab arg-1 is "xray":
		set tab completions for position 2 to "on" and "off"
	else if tab arg-1 is "info":
		set tab completions for position 2 to tabPlayerNames(player)

# /dskins [respawn] (skins.sk).
on tab complete of "/dskins" and "/skript:dskins":
	set tab completions for position 1 to "respawn"

# /help and /adminhelp (help.sk).
on tab complete of "/help" and "/skript:help":
	set tab completions for position 1 to "commands"

on tab complete of "/adminhelp" and "/skript:adminhelp" and "/ahelp" and "/skript:ahelp":
	set tab completions for position 1 to "heists", "map", "players", "store" and "tests"
