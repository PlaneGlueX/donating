# gps.sk: the GPS. Built 2026-09-26 (owner, 2026-09-26: waypoints you set on the minimap or that quests set
# automatically, shown on the minimap, with an arrow or highlight in the game that goes away once you're in the
# waypoint's area; it has to follow the roads and cope with a player taking another way).
#
# This script decides each player's target. The phone plugin (DonatingPhone: /dphone gps, see CLAUDE.md "GPS")
# finds the way along the city's roads and shows it: a flow field, like water running downhill to a drain, so
# from anywhere the best way is already known and taking another street is a new route at once. It draws the
# route and the target on the phone (the name and distance in the held phone's strip), and in the world, to that
# player only: a dust trail on the road ahead, a ring around the target's area and a dot on the locator bar at
# the next corner. All of it goes away inside the area, and inside heists (the tag donating_gps_paused).
#
# Targets, the newest first (like GTA's custom waypoint): a pin (dropped on the phone's big map with a
# left-click, or picked in /gps) or a quest's objective (contracts.sk: the car, then any chop shop). A new pin
# puts the quest's route aside; the quest's next objective puts the pin aside; /gps switches back. With neither:
# the base while you carry loot. A pin is cleared once you arrive.
# Memory only (a restart clears pins; quests set theirs again):
#   {-gps::pin::<u>} location, {-gps::pinlabel::<u>}
#   {-gps::quest::<u>} spots "x,y,z;x,y,z", {-gps::questworld::<u>}, ::questlabel, ::questradius, ::questby,
#   ::questobj (the objective: a new one makes the quest the active target)
#   {-gps::active::<u>} "pin" or "quest": which was set last
#   {-gps::sent::<u>::<pin|quest|loot|active>} the last line sent to the plugin for it (only changes are sent)
# The plugin keeps a slot per kind (pin, quest, loot: all drawn as icons on the phone map) and routes to the
# active one.

function gpsSpot(l: location) :: text:
	# Coordinates in locals first: "x-coordinate of {_l} * 10" parses as the x of (location * 10).
	set {_x} to x-coordinate of {_l}
	set {_y} to y-coordinate of {_l}
	set {_z} to z-coordinate of {_l}
	set {_x} to round({_x} * 10) / 10
	set {_y} to round({_y} * 10) / 10
	set {_z} to round({_z} * 10) / 10
	return "%{_x}%,%{_y}%,%{_z}%"

# What the plugin worked out (player metadata, see Gps.java): the next corner, blocks left, the state.
function gpsNext(p: player) :: location:
	return metadata value "donating_gps_next" of {_p}

function gpsLeft(p: player) :: number:
	set {_v} to metadata value "donating_gps_left" of {_p}
	if {_v} is set:
		return {_v}
	return -1

function gpsState(p: player) :: text:
	set {_v} to metadata value "donating_gps_state" of {_p}
	if {_v} is set:
		return "%{_v}%"
	return "none"

# "pin", "quest", "loot" or "": what the GPS is showing now.
function gpsActive(p: player) :: text:
	set {_u} to "%uuid of {_p}%"
	set {_a} to {-gps::active::%{_u}%}
	if {_a} is "pin":
		if {-gps::pin::%{_u}%} is set:
			return "pin"
	if {-gps::quest::%{_u}%} is set:
		return "quest"
	if {-gps::pin::%{_u}%} is set:
		return "pin"
	if gpsLootSpots({_p}) is not "":
		return "loot"
	return ""

# The base while carrying loot (outside heists): every staff base POI (nav.sk), the nearest by road wins.
function gpsLootSpots(p: player) :: text:
	set {_out} to ""
	if bagTotal({_p}) > 0:
		if heistOf({_p}) is "":
			loop {poi::*}:
				set {_a::*} to loop-value split at "|"
				if {_a::1} is "base":
					if {_a::2} is "%world of {_p}%":
						if {_out} is "":
							set {_out} to "%{_a::3}%,%{_a::4}%,%{_a::5}%"
						else:
							set {_out} to "%{_out}%;%{_a::3}%,%{_a::4}%,%{_a::5}%"
	return {_out}

# Tells the plugin each slot and which one is active (only what changed).
function gpsPush(p: player):
	set {_u} to "%uuid of {_p}%"
	set {_l} to {-gps::pin::%{_u}%}
	set {_line} to "clear pin"
	if {_l} is set:
		set {_line} to "set pin %world of {_l}% %cfg("gps::pin-radius")% %gpsSpot({_l})% %{-gps::pinlabel::%{_u}%}%"
	gpsSend({_p}, "pin", {_line})
	set {_line} to "clear quest"
	if {-gps::quest::%{_u}%} is set:
		set {_line} to "set quest %{-gps::questworld::%{_u}%}% %{-gps::questradius::%{_u}%}% %{-gps::quest::%{_u}%}% %{-gps::questlabel::%{_u}%}%"
	gpsSend({_p}, "quest", {_line})
	set {_spots} to gpsLootSpots({_p})
	set {_line} to "clear loot"
	if {_spots} is not "":
		set {_line} to "set loot %world of {_p}% %cfg("gps::base-radius")% %{_spots}% Base: sell loot"
	gpsSend({_p}, "loot", {_line})
	set {_a} to gpsActive({_p})
	if {_a} is "":
		set {_a} to "none"
	gpsSend({_p}, "active", "active %{_a}%")

function gpsSend(p: player, key: text, line: text):
	set {_u} to "%uuid of {_p}%"
	{-gps::sent::%{_u}%::%{_key}%} is not {_line}
	set {-gps::sent::%{_u}%::%{_key}%} to {_line}
	execute console command "dphone gps %name of {_p}% %{_line}%"

# ---------- Pins ----------

function gpsPin(p: player, l: location, label: text):
	set {_u} to "%uuid of {_p}%"
	set {-gps::pin::%{_u}%} to {_l}
	set {-gps::pinlabel::%{_u}%} to {_label}
	set {-gps::active::%{_u}%} to "pin"
	gpsPush({_p})
	set {_d} to round(distance between (location of {_p}) and {_l})
	if {-gps::quest::%{_u}%} is set:
		hudBar({_p}, "&dPin set · &f%{_label}% &7(%{_d}%m) · your job's route is on hold: &f/gps", 1)
	else:
		hudBar({_p}, "&dPin set · &f%{_label}% &7(%{_d}%m)", 1)
	play sound "block.note_block.pling" with volume 0.5 and pitch 1.5 to {_p}

function gpsUnpin(p: player, why: text):
	set {_u} to "%uuid of {_p}%"
	{-gps::pin::%{_u}%} is set
	set {_label} to {-gps::pinlabel::%{_u}%}
	delete {-gps::pin::%{_u}%}
	delete {-gps::pinlabel::%{_u}%}
	if {-gps::active::%{_u}%} is "pin":
		delete {-gps::active::%{_u}%}
	gpsPush({_p})
	if {_why} is "arrived":
		hudBar({_p}, "&aArrived · &f%{_label}%", 1)
		play sound "block.note_block.chime" with volume 0.7 and pitch 1.2 to {_p}
	else if {_why} is "removed":
		hudBar({_p}, "&7Pin removed.", 1)
		play sound "block.note_block.hat" with volume 0.6 to {_p}

# The big map's left-click (the plugin runs this as the console): the pin under the cursor goes, else a new
# pin there, named after the place it's on (a POI or a heist within reach) when there is one.
command /gpspick <player> <number> <number> <number>:
	executable by: console
	trigger:
		gpsPick(arg-1, arg-2, arg-3, arg-4)

function gpsPick(p: player, x: number, z: number, reach: number):
	set {_u} to "%uuid of {_p}%"
	set {_pin} to {-gps::pin::%{_u}%}
	if {_pin} is set:
		if world of {_pin} is world of {_p}:
			set {_px} to x-coordinate of {_pin}
			set {_pz} to z-coordinate of {_pin}
			set {_dx} to {_px} - {_x}
			set {_dz} to {_pz} - {_z}
			if sqrt({_dx} * {_dx} + {_dz} * {_dz}) <= {_reach}:
				gpsUnpin({_p}, "removed")
				stop
	# At the player's own height (a pin counts by flat distance; reading the ground there could load or even
	# make land anywhere on the city map: review fix).
	set {_l} to location({_x}, y-coordinate of {_p}, {_z}, world of {_p})
	set {_label} to "Pin"
	# On a heist building: its exit spot (the building is a heist region, where the GPS pauses).
	set {_h} to heistAt({_l})
	if {_h} is not "":
		set {_ex} to {heist::%{_h}%::exit}
		if {_ex} is set:
			set {_l} to {_ex}
			set {_label} to heistName({_h})
	else:
		# Near a place: the place itself, by its name.
		set {_near} to gpsPlaceNear({_p}, {_l}, max({_reach}, 12))
		if {_near} is not "":
			set {_a::*} to {_near} split at "|"
			set {_l} to location(({_a::2} parsed as number), ({_a::3} parsed as number), ({_a::4} parsed as number), world({_a::1}))
			set {_label} to {_a::5}
	gpsPin({_p}, {_l}, {_label})

# The place nearest a spot within reach ("world|x|y|z|name|kind" as in gpsPlaces, "" if none).
function gpsPlaceNear(p: player, l: location, reach: number) :: text:
	set {_best} to {_reach}
	set {_found} to ""
	set {_lx} to x-coordinate of {_l}
	set {_lz} to z-coordinate of {_l}
	loop gpsPlaces({_p}):
		set {_a::*} to loop-value split at "|"
		if {_a::1} is "%world of {_l}%":
			set {_dx} to ({_a::2} parsed as number) - {_lx}
			set {_dz} to ({_a::4} parsed as number) - {_lz}
			set {_d} to sqrt({_dx} * {_dx} + {_dz} * {_dz})
			if {_d} <= {_best}:
				set {_best} to {_d}
				set {_found} to loop-value
	return {_found}

# Places to pick in /gps, as "world|x|y|z|name|kind": staff POIs, quest givers, open heists, your car.
function gpsPlaces(p: player) :: texts:
	loop {poi::*}:
		set {_a::*} to loop-value split at "|"
		set {_n} to {_a::6}
		if {_n} is not set:
			set {_n} to ""
		# /dpoi add keeps a space before the name.
		set {_n} to "%{_n}%"
		if {_n} starts with " ":
			set {_n} to subtext of {_n} from characters 2 to (length of {_n})
		if {_n} is "":
			set {_n} to "%{_a::1}% %loop-index%"
		add "%{_a::2}%|%{_a::3}%|%{_a::4}%|%{_a::5}%|%{_n}%|%{_a::1}%" to {_out::*}
	loop questPlaces():
		add loop-value to {_out::*}
	loop {heists::*}:
		set {_h} to loop-index
		set {_s} to heistState({_h})
		if {_s} is "open" or "active":
			# Its exit spot (outside the building: the GPS pauses inside heists), else the hologram or centre.
			set {_l} to {heist::%{_h}%::exit}
			if {_l} is not set:
				set {_l} to {heist::%{_h}%::holo}
			if {_l} is not set:
				set {_l} to heistCenter({_h})
			if {_l} is set:
				add "%world of {_l}%|%x-coordinate of {_l}%|%y-coordinate of {_l}%|%z-coordinate of {_l}%|%heistName({_h})%|heist" to {_out::*}
	set {_plate} to {car::outof::%uuid of {_p}%}
	if {_plate} is set:
		set {_l} to {car::out::%{_plate}%}
		if {_l} is set:
			set {_car} to carName(carModelOf("%{_plate}%"))
			add "%world of {_l}%|%x-coordinate of {_l}%|%y-coordinate of {_l}%|%z-coordinate of {_l}%|Your %{_car}%|car" to {_out::*}
	return {_out::*}

# ---------- Quests (contracts.sk) ----------

# A quest's target: spots "x,y,z;x,y,z" (the nearest along the roads wins), its name, the area's radius, which
# quest (by) and which objective (obj: a new one puts a pin aside; the same one moving, e.g. a car, doesn't).
function gpsQuest(p: player, w: text, spots: text, label: text, radius: number, by: text, obj: text):
	set {_u} to "%uuid of {_p}%"
	if {-gps::questobj::%{_u}%} is not {_obj}:
		set {-gps::active::%{_u}%} to "quest"
		if {-gps::pin::%{_u}%} is set:
			hudBar({_p}, "&6New objective: &f%{_label}% &7· your pin is on hold: &f/gps", 1)
	set {-gps::quest::%{_u}%} to {_spots}
	set {-gps::questworld::%{_u}%} to {_w}
	set {-gps::questlabel::%{_u}%} to {_label}
	set {-gps::questradius::%{_u}%} to {_radius}
	set {-gps::questby::%{_u}%} to {_by}
	set {-gps::questobj::%{_u}%} to {_obj}
	gpsPush({_p})

function gpsQuestClear(p: player, by: text):
	set {_u} to "%uuid of {_p}%"
	{-gps::questby::%{_u}%} is {_by}
	delete {-gps::quest::%{_u}%}
	delete {-gps::questworld::%{_u}%}
	delete {-gps::questlabel::%{_u}%}
	delete {-gps::questradius::%{_u}%}
	delete {-gps::questby::%{_u}%}
	delete {-gps::questobj::%{_u}%}
	if {-gps::active::%{_u}%} is "quest":
		delete {-gps::active::%{_u}%}
	gpsPush({_p})

# ---------- Every second: arriving at a pin, the heist pause, the loot target ----------

every second:
	loop all players:
		set {_p} to loop-player
		if heistOf({_p}) is not "":
			add "donating_gps_paused" to scoreboard tags of {_p}
		else if scoreboard tags of {_p} contain "donating_gps_paused":
			remove "donating_gps_paused" from scoreboard tags of {_p}
		if gpsActive({_p}) is "pin":
			if gpsState({_p}) is "arrived":
				gpsUnpin({_p}, "arrived")
		gpsPush({_p})

on quit:
	set {_u} to "%uuid of player%"
	delete {-gps::pin::%{_u}%}
	delete {-gps::pinlabel::%{_u}%}
	delete {-gps::quest::%{_u}%}
	delete {-gps::questworld::%{_u}%}
	delete {-gps::questlabel::%{_u}%}
	delete {-gps::questradius::%{_u}%}
	delete {-gps::questby::%{_u}%}
	delete {-gps::questobj::%{_u}%}
	delete {-gps::active::%{_u}%}
	delete {-gps::sent::%{_u}%::*}
	delete {-gps::gui::%player%}
	delete {-gps::act::%player%::*}
	remove "donating_gps_paused" from scoreboard tags of player

# ---------- The boss bar (hud.sk, after the heist, cop and contract bars) ----------

# An arrow from where you look toward the next corner of the way ("↑" ahead), and the blocks left.
function gpsArrow(p: player, to: location) :: text:
	set {_from} to location of {_p}
	set {_dx} to x-coordinate of {_to}
	set {_fx} to x-coordinate of {_from}
	set {_dx} to {_dx} - {_fx}
	set {_dz} to z-coordinate of {_to}
	set {_fz} to z-coordinate of {_from}
	set {_dz} to {_dz} - {_fz}
	# Minecraft's yaw: 0 faces +z (south), 90 faces -x (west); the yaw facing the spot is atan2(-dx, dz), and
	# Skript's atan2(x, y) is Java's Math.atan2(y, x).
	set {_want} to atan2({_dz}, 0 - {_dx})
	set {_rel} to mod({_want} - (yaw of {_p}) + 540, 360) - 180
	set {_i} to mod(round({_rel} / 45) + 8, 8)
	set {_arrows::*} to "↑", "↗", "→", "↘", "↓", "↙", "←" and "↖"
	return {_arrows::%{_i} + 1%}

# "↗ 142m" toward the way's next corner, "turn right in 40m · 320m" with a turn coming up (the ↱ glyph was a tiny tick
# in the boss bar, 26.3 client), "here" inside the area
# ("" when the GPS has nothing yet).
function gpsWay(p: player) :: text:
	set {_s} to gpsState({_p})
	if {_s} is "arrived":
		return "&ahere"
	set {_n} to gpsNext({_p})
	set {_left} to gpsLeft({_p})
	if {_n} is not set:
		return ""
	if world of {_n} is not world of {_p}:
		return ""
	set {_d} to round({_left})
	if {_left} < 0:
		set {_d} to round(distance between (location of {_p}) and {_n})
	set {_tv} to metadata value "donating_gps_turn" of {_p}
	set {_turn} to "%{_tv}%"
	set {_in} to metadata value "donating_gps_turn_in" of {_p}
	if {_in} is set:
		if {_in} >= 0:
			if {_in} <= 60:
				if {_turn} is "right":
					return "&eturn right in %round({_in})%m &7· %{_d}%m"
				if {_turn} is "left":
					return "&eturn left in %round({_in})%m &7· %{_d}%m"
	return "&e%gpsArrow({_p}, {_n})% %{_d}%m"

function gpsHud(p: player) :: boolean:
	set {_shown} to false
	set {_a} to gpsActive({_p})
	if {_a} is "pin":
		set {_label} to {-gps::pinlabel::%uuid of {_p}%}
		hudBossSet({_p}, "&b&lGPS&r &7· &f%{_label}% %gpsWay({_p})%", "white", 1)
		set {_shown} to true
	else if {_a} is "loot":
		hudBossSet({_p}, "&a&lLOOT&r &7· &fsell it at the base %gpsWay({_p})%", "green", 1)
		set {_shown} to true
	return {_shown}

# ---------- /gps (and the phone's GPS app) ----------

function gpsButton(p: player, gui: inventory, slot: number, i: item, act: text):
	set slot {_slot} of {_gui} to {_i}
	set {-gps::act::%{_p}%::%{_slot}%} to {_act}

# The GPS app (2026-09-29, owner: "a lot of the quests that require talking to an npc first can just be put in their own
# category under GPS (categorize quests, heists, and shops)"): a phone app page (ui.sk). The main page shows where the GPS
# is headed (click: remove the pin), what's on hold, and four categories; each category lists its places nearest first,
# 20 a page. Quests: one entry per quest line (left-click: the GPS leads there, right-click: its menu), so the phone's
# home no longer needs Contracts, Jobs and Hits. Slots: the toolbar row 0 (2 back, 4-6 the route, 5/6 page arrows on a
# list), content rows 1-4 (columns 2-6), the home button 49 (the phone's home).
function gpsMenu(p: player):
	closePhoneMap({_p})
	set {_u} to "%uuid of {_p}%"
	set {_gui} to chest inventory with 6 rows named phoneTitle("app", "GPS")
	delete {-gps::act::%{_p}%::*}
	set {-gps::view::%{_p}%} to "main"
	gpsButton({_p}, {_gui}, 2, appIcon("back", "&f◀ Phone"), "phone")
	set {_a} to gpsActive({_p})
	set {_way} to gpsWay({_p})
	if {_a} is "pin":
		set {_i} to appIcon("pin", "&fHeading to &d%{-gps::pinlabel::%{_u}%}%")
		set lore of {_i} to "&7%{_way}%" and "&7Click: remove"
		gpsButton({_p}, {_gui}, 4, {_i}, "clear")
	else if {_a} is "quest":
		set {_i} to appIcon("pin", "&fHeading to &6%{-gps::questlabel::%{_u}%}%")
		set lore of {_i} to "&7%{_way}%"
		set slot 4 of {_gui} to {_i}
	else if {_a} is "loot":
		set {_i} to appIcon("base", "&fHeading to &athe base")
		set lore of {_i} to "&7%{_way}%"
		set slot 4 of {_gui} to {_i}
	# The one on hold: click to switch back to it.
	if {-gps::pin::%{_u}%} is set:
		if {_a} is not "pin":
			set {_i} to appIcon("pin", "&7On hold: &d%{-gps::pinlabel::%{_u}%}%")
			set lore of {_i} to "&7Right-click: remove"
			gpsButton({_p}, {_gui}, 5, {_i}, "active:pin")
	if {-gps::quest::%{_u}%} is set:
		if {_a} is not "quest":
			gpsButton({_p}, {_gui}, 6, appIcon("quests", "&7On hold: &6%{-gps::questlabel::%{_u}%}%"), "active:quest")
	set {_i} to appIcon("quests", "&fQuests")
	set {_m} to {-ph::mission::%{_p}%}
	if {_m} is set:
		if "%{_m}%" is not "&r":
			if "%{_m}%" is not "":
				set lore of {_i} to colored "%{_m}%"
	gpsButton({_p}, {_gui}, 11, {_i}, "cat:quests:1")
	set {_open} to 0
	loop {heists::*}:
		if heistState(loop-index) is "open" or "active":
			add 1 to {_open}
	set {_i} to appIcon("heists", "&fHeists")
	if {_open} > 0:
		set lore of {_i} to "&a%{_open}% open"
	gpsButton({_p}, {_gui}, 12, {_i}, "cat:heists:1")
	gpsButton({_p}, {_gui}, 13, appIcon("shops", "&fShops"), "cat:shops:1")
	gpsButton({_p}, {_gui}, 14, appIcon("places", "&fPlaces"), "cat:places:1")
	# Your car, when one is out.
	set {_plate} to {car::outof::%{_u}%}
	if {_plate} is set:
		set {_l} to {car::out::%{_plate}%}
		if {_l} is set:
			set {_cn} to carName(carModelOf("%{_plate}%"))
			set {_i} to appIcon("car", "&fYour %{_cn}%")
			set lore of {_i} to "&7%gpsDist({_p}, {_l})%"
			gpsButton({_p}, {_gui}, 15, {_i}, "car")
	gpsButton({_p}, {_gui}, 49, appIcon("blank", "&fHome"), "phone")
	gpsOpen({_p}, {_gui})

function gpsOpen(p: player, gui: inventory):
	set {-gps::gui::%{_p}%} to {_gui}
	if {-gps::gen::%{_p}%} is not set:
		set {-gps::gen::%{_p}%} to 0
	open {_gui} to {_p}

# "320m" (or "far" in another world).
function gpsDist(p: player, l: location) :: text:
	if world of {_l} is world of {_p}:
		return "%round(distance between (location of {_p}) and {_l})%m"
	return "far"

# A category's entries as "icon|name|lore;;lore|act|world|x|y|z" (the last four for sorting by distance; quests keep
# their order).
function gpsEntries(p: player, cat: text) :: texts:
	set {_u} to "%uuid of {_p}%"
	if {_cat} is "quests":
		# Mara's missions.
		set {_line} to storyLine({_p}, "story")
		if storyIdOf({_p}, "story") is "done":
			set {_line} to "&7Story done"
		add "head:mara|&fMissions|%{_line}%;;%gpsGiverText({_p}, "story")%;;&eClick: GPS · Right-click: open|q:story" to {_out::*}
		# Car contracts.
		set {_st} to ""
		if {-ctjob::%{_u}%} is set:
			set {_st} to "&eYour job: %formatClock(ctLeft({_u}))% left"
		add "head:boss|&fCar contracts|%{_st}%;;%gpsGiverText({_p}, "contracts")%;;&eClick: GPS · Right-click: open|q:contracts" to {_out::*}
		# Side jobs (Mara's and the Boss's boards).
		set {_w} to 0
		set {_t} to 0
		loop {-cfg::jobs::contacts::*}:
			set {_c} to loop-value
			if jobsUnlocked({_p}, {_c}) is true:
				loop jobsSlots({_p}, {_c}) times:
					set {_k} to loop-value-2
					set {_s} to jobsState({_p}, {_c}, {_k})
					if {_s} is "waiting":
						add 1 to {_w}
					else if {_s} is "taken":
						add 1 to {_t}
		set {_st} to "&7Nothing waiting"
		if {_w} + {_t} > 0:
			set {_st} to "&f%{_w}% waiting · %{_t}% taken"
		add "quests|&fSide jobs|%{_st}%;;&eClick: GPS · Right-click: open|q:jobs" to {_out::*}
		# Vic's Wanted List.
		set {_st} to "&7New list in %fenceLeftText(fenceWeekLeft())%"
		if levelOf({_p}) < cfg("fence::level"):
			set {_st} to "&7Level %cfg("fence::level")%"
		else if getData({_p}, "fence::took") is progWeek():
			set {_st} to "&aThis week's list ✔ &7· new in %fenceLeftText(fenceWeekLeft())%"
		add "head:vic|&fWanted List|%{_st}%;;%gpsGiverText({_p}, "fence")%;;&eClick: GPS · Right-click: open|q:vic" to {_out::*}
		# Hit contracts.
		set {_tier} to hitTierOf({_p})
		if {_tier} is "":
			set {_st} to "&f%hitTargetName()%"
		else:
			set {_st} to "&f%hitTargetName()% &7· %hitWindowText({_tier})%"
		add "head:broker|&fHit contracts|%{_st}%;;%gpsGiverText({_p}, "hits")%;;&eClick: GPS · Right-click: open|q:hits" to {_out::*}
		# Bounties (posted with the Broker).
		set {_st} to ""
		set {_b} to getData({_p}, "bounty")
		if {_b} is set:
			if {_b} > 0:
				set {_st} to "&7Yours: &c%formatMoney({_b})%"
		add "bounties|&fBounties|%{_st}%;;%gpsGiverText({_p}, "hits")%;;&eRight-click: the list|q:bounties" to {_out::*}
		return {_out::*}
	if {_cat} is "heists":
		loop {heists::*}:
			set {_h} to loop-index
			if heistState({_h}) is not "disabled":
				set {_l} to {heist::%{_h}%::exit}
				if {_l} is not set:
					set {_l} to {heist::%{_h}%::holo}
				if {_l} is set:
					set {_lore} to "%{-heist::%{_h}%::status}%"
					if heistLevelOk({_p}, {_h}) is false:
						if heistIsStore({_h}) is true:
							set {_lore} to "%{_lore}%;;&cUp to level %heistMaxLevel({_h})%"
						else:
							set {_lore} to "%{_lore}%;;&cLevel %heistLevel({_h})%"
					set {_lore} to "%{_lore}%;;&7%gpsDist({_p}, {_l})%"
					add "heist_%heistDifficulty({_h})%|&f%heistName({_h})%|%{_lore}%|pin|%world of {_l}%|%x-coordinate of {_l}%|%y-coordinate of {_l}%|%z-coordinate of {_l}%" to {_out::*}
		return {_out::*}
	if {_cat} is "shops":
		# The nearest shopkeeper of each kind, then shop POIs with no shopkeeper next to them.
		loop "gun", "gear", "bag", "tools" and "cars":
			set {_k} to loop-value
			delete {_best}
			loop {shop::keepers::*}:
				if loop-value-2 is {_k}:
					set {_kl} to {shop::keeper::%loop-index%::loc}
					if {_kl} is set:
						if world of {_kl} is world of {_p}:
							if {_best} is not set:
								set {_best} to {_kl}
							else if distance between {_kl} and location of {_p} < distance between {_best} and location of {_p}:
								set {_best} to {_kl}
			if {_best} is set:
				set {_title} to cfg("shop::title::%{_k}%")
				add "shop_%{_k}%|&f%{_title}%|&7%gpsDist({_p}, {_best})%|pin|%world of {_best}%|%x-coordinate of {_best}%|%y-coordinate of {_best}%|%z-coordinate of {_best}%" to {_out::*}
		loop {poi::*}:
			set {_a::*} to loop-value split at "|"
			if {_a::1} is "shop":
				set {_l} to poiLocation(loop-value)
				if {_l} is set:
					set {_near} to false
					loop {shop::keepers::*}:
						set {_kl} to {shop::keeper::%loop-index-2%::loc}
						if {_kl} is set:
							if world of {_kl} is world of {_l}:
								if distance between {_kl} and {_l} < 16:
									set {_near} to true
					if {_near} is false:
						set {_n} to gpsPoiName(loop-value, loop-index)
						add "%gpsShopIcon({_n})%|&f%{_n}%|&7%gpsDist({_p}, {_l})%|pin|%world of {_l}%|%x-coordinate of {_l}%|%y-coordinate of {_l}%|%z-coordinate of {_l}%" to {_out::*}
		return {_out::*}
	# Places: base, garages, spawn, landmarks, crate stands (the nearest of each crate).
	loop {poi::*}:
		set {_a::*} to loop-value split at "|"
		if {_a::1} is not "shop":
			set {_l} to poiLocation(loop-value)
			if {_l} is set:
				set {_icon} to {_a::1}
				if {_icon} is "garage":
					set {_icon} to "garagepl"
				add "%{_icon}%|&f%gpsPoiName(loop-value, loop-index)%|&7%gpsDist({_p}, {_l})%|pin|%world of {_l}%|%x-coordinate of {_l}%|%y-coordinate of {_l}%|%z-coordinate of {_l}%" to {_out::*}
	loop {-cfg::crates::*}:
		set {_c} to loop-value
		delete {_best}
		loop {crateblock::*}:
			if loop-value-2 is {_c}:
				set {_sl} to setupStandLoc(loop-index-2)
				if {_sl} is set:
					if world of {_sl} is world of {_p}:
						if {_best} is not set:
							set {_best} to {_sl}
						else if distance between {_sl} and location of {_p} < distance between {_best} and location of {_p}:
							set {_best} to {_sl}
		if {_best} is set:
			add "crate|&f%crateName({_c})% crate|&7%gpsDist({_p}, {_best})%|pin|%world of {_best}%|%x-coordinate of {_best}%|%y-coordinate of {_best}%|%z-coordinate of {_best}%" to {_out::*}
	return {_out::*}

# A POI's name ("Gun Shop"), or its type and number.
function gpsPoiName(v: text, n: text) :: text:
	set {_a::*} to {_v} split at "|"
	set {_nm} to "%{_a::6}%"
	if {_a::6} is not set:
		set {_nm} to ""
	if {_nm} starts with " ":
		set {_nm} to subtext of {_nm} from characters 2 to (length of {_nm})
	if {_nm} is "":
		return "%{_a::1}% %{_n}%"
	return {_nm}

# A shop POI's icon by a word in its name.
function gpsShopIcon(n: text) :: text:
	loop "gun", "gear", "bag", "tool" and "car":
		if {_n} contains loop-value:
			if loop-value is "tool":
				return "shop_tools"
			if loop-value is "car":
				return "shop_cars"
			return "shop_%loop-value%"
	return "shop_other"

# Where a quest's giver is ("Scrap Yard · 140m"), or that there's none yet.
function gpsGiverText(p: player, kind: text) :: text:
	set {_n} to questNearest({_p}, {_kind})
	if {_n} is "":
		return "&7Not in town yet"
	# The NPC's name, and its place unless the name says it ("Scrap Yard Boss · 140m", "Mara · Safehouse · 90m").
	set {_nm} to questNpcName({_n})
	set {_pl} to questPlace({_n})
	if {_nm} contains {_pl}:
		return "&7%{_nm}% · %gpsDist({_p}, questLoc({_n}))%"
	return "&7%{_nm}% · %{_pl}% · %gpsDist({_p}, questLoc({_n}))%"

function gpsCat(p: player, cat: text, page: number):
	closePhoneMap({_p})
	set {_title} to "Quests"
	if {_cat} is "heists":
		set {_title} to "Heists"
	else if {_cat} is "shops":
		set {_title} to "Shops"
	else if {_cat} is "places":
		set {_title} to "Places"
	set {_gui} to chest inventory with 6 rows named phoneTitle("app", "GPS · %{_title}%")
	delete {-gps::act::%{_p}%::*}
	set {-gps::view::%{_p}%} to "%{_cat}%:%{_page}%"
	gpsButton({_p}, {_gui}, 2, appIcon("back", "&f◀ GPS"), "main")
	# Nearest first (quests keep their order).
	set {_e::*} to gpsEntries({_p}, {_cat})
	set {_n} to 0
	if {_cat} is "quests":
		loop {_e::*}:
			add 1 to {_n}
			set {_s::%{_n}%} to loop-value
	else:
		loop {_e::*}:
			set {_a::*} to loop-value split at "|"
			set {_d} to 1000000000
			if {_a::5} is "%world of {_p}%":
				set {_d} to distance between (location of {_p}) and location(({_a::6} parsed as number), ({_a::7} parsed as number), ({_a::8} parsed as number), world of {_p})
			set {_dist::%loop-index%} to {_d}
		loop sorted indices of {_dist::*} in ascending order:
			add 1 to {_n}
			set {_s::%{_n}%} to {_e::%loop-value%}
	set {_pages} to max(1, ceil({_n} / 20))
	if {_page} > {_pages}:
		set {_page} to {_pages}
	if {_page} > 1:
		gpsButton({_p}, {_gui}, 5, appIcon("prev", "&fPage %{_page} - 1%"), "cat:%{_cat}%:%{_page} - 1%")
	if {_page} < {_pages}:
		gpsButton({_p}, {_gui}, 6, appIcon("next", "&fPage %{_page} + 1%"), "cat:%{_cat}%:%{_page} + 1%")
	set {_slots::*} to 11, 12, 13, 14, 15, 20, 21, 22, 23, 24, 29, 30, 31, 32, 33, 38, 39, 40, 41 and 42
	set {_first} to ({_page} - 1) * 20
	loop 20 times:
		set {_k} to {_first} + loop-number
		if {_s::%{_k}%} is set:
			set {_a::*} to {_s::%{_k}%} split at "|"
			if {_a::1} starts with "head:":
				set {_i} to msgIcon(subtext of {_a::1} from characters 6 to (length of {_a::1}))
				set name of {_i} to colored {_a::2}
			else:
				set {_i} to appIcon({_a::1}, {_a::2})
			delete {_lore::*}
			loop {_a::3} split at ";;":
				if loop-value-2 is not "":
					add colored loop-value-2 to {_lore::*}
			if {_lore::*} is set:
				set lore of {_i} to {_lore::*}
			set {_act} to {_a::4}
			if {_act} is "pin":
				set {_act} to "place:%{_a::5}%|%{_a::6}%|%{_a::7}%|%{_a::8}%|%uncolored {_a::2}%"
				# The place the pin is on now glints.
				if gpsPinnedAt({_p}, {_a::5}, ({_a::6} parsed as number), ({_a::8} parsed as number)) is true:
					set {_i} to glint({_i})
			gpsButton({_p}, {_gui}, {_slots::%loop-number%}, {_i}, {_act})
	if {_n} is 0:
		set slot 22 of {_gui} to appIcon("blank", "&7Nothing here yet")
	gpsButton({_p}, {_gui}, 49, appIcon("blank", "&fHome"), "phone")
	gpsOpen({_p}, {_gui})

# Is the player's pin at that spot (within 2 blocks)?
function gpsPinnedAt(p: player, w: text, x: number, z: number) :: boolean:
	set {_pin} to {-gps::pin::%uuid of {_p}%}
	if {_pin} is not set:
		return false
	if "%world of {_pin}%" is not {_w}:
		return false
	set {_px} to x-coordinate of {_pin}
	set {_pz} to z-coordinate of {_pin}
	if abs({_px} - {_x}) <= 2:
		if abs({_pz} - {_z}) <= 2:
			return true
	return false

on inventory click:
	{-gps::gui::%player%} is set
	player's current inventory is {-gps::gui::%player%}
	cancel event
	event-inventory is {-gps::gui::%player%}
	set {_act} to {-gps::act::%player%::%index of event-slot%}
	{_act} is set
	set {_right} to false
	set {_ok} to false
	if click type is left mouse button:
		set {_ok} to true
	else if click type is right mouse button:
		set {_ok} to true
		set {_right} to true
	{_ok} is true
	set {_gen} to {-gps::gen::%player%}
	wait 1 tick
	player is online
	{-gps::gui::%player%} is set
	{-gps::gen::%player%} is {_gen}
	add 1 to {-gps::gen::%player%}
	gpsAction(player, {_act}, {_right})

on inventory drag:
	{-gps::gui::%player%} is set
	player's current inventory is {-gps::gui::%player%}
	cancel event

on inventory close:
	{-gps::gui::%player%} is set
	event-inventory is {-gps::gui::%player%}
	delete {-gps::gui::%player%}
	delete {-gps::act::%player%::*}

function gpsAction(p: player, act: text, right: boolean):
	set {_u} to "%uuid of {_p}%"
	if {_act} is "close":
		close {_p}'s inventory
	else if {_act} is "phone":
		# Opening the phone closes this menu; the close handler only forgets the menu, nothing is lost.
		openPhone({_p})
	else if {_act} is "main":
		gpsMenu({_p})
	else if {_act} starts with "cat:":
		set {_a::*} to {_act} split at ":"
		gpsCat({_p}, {_a::2}, ({_a::3} parsed as number))
	else if {_act} is "clear":
		close {_p}'s inventory
		gpsUnpin({_p}, "removed")
	else if {_act} is "active:pin":
		close {_p}'s inventory
		if {_right} is true:
			gpsUnpin({_p}, "removed")
		else:
			set {-gps::active::%{_u}%} to "pin"
			gpsPush({_p})
	else if {_act} is "active:quest":
		close {_p}'s inventory
		set {-gps::active::%{_u}%} to "quest"
		gpsPush({_p})
	else if {_act} is "car":
		close {_p}'s inventory
		set {_plate} to {car::outof::%{_u}%}
		if {_plate} is set:
			garageFindCar({_p}, "%{_plate}%")
	else if {_act} starts with "q:":
		gpsQuestAction({_p}, subtext of {_act} from characters 3 to (length of {_act}), {_right})
	else if {_act} starts with "place:":
		close {_p}'s inventory
		set {_a::*} to (subtext of {_act} from characters 7 to (length of {_act})) split at "|"
		set {_l} to location(({_a::2} parsed as number), ({_a::3} parsed as number), ({_a::4} parsed as number), world({_a::1}))
		# The place already pinned: a second click removes it.
		if gpsPinnedAt({_p}, {_a::1}, ({_a::2} parsed as number), ({_a::4} parsed as number)) is true:
			gpsUnpin({_p}, "removed")
		else:
			gpsPin({_p}, {_l}, {_a::5})

# A quest entry: right-click opens its menu (their back button leads here); left-click puts it on the GPS: the running
# objective when there is one, else the nearest giver.
function gpsQuestAction(p: player, q: text, right: boolean):
	set {_u} to "%uuid of {_p}%"
	if {_right} is true:
		if {_q} is "story":
			storyMenu({_p})
		else if {_q} is "contracts":
			ctMenu({_p})
		else if {_q} is "jobs" or "vic":
			jobsMenu({_p})
		else if {_q} is "hits":
			hitMenu({_p})
		else if {_q} is "bounties":
			close {_p}'s inventory
			showBounties({_p})
		stop
	close {_p}'s inventory
	if {_q} is "story":
		if storyGpsSpots({_p}, storyIdOf({_p}, "story")) is not "":
			storyTrack({_p}, "story")
		else:
			questFind({_p}, "story")
	else if {_q} is "contracts":
		if {-ctjob::%{_u}%} is set:
			set {-gps::active::%{_u}%} to "quest"
			gpsPush({_p})
			hudBar({_p}, "&6The GPS shows your car job.", 1)
		else:
			questFind({_p}, "contracts")
	else if {_q} is "jobs":
		set {_done} to false
		loop {-cfg::jobs::contacts::*}:
			set {_c} to loop-value
			if {_done} is false:
				loop jobsSlots({_p}, {_c}) times:
					if {_done} is false:
						set {_k} to loop-value-2
						if jobsState({_p}, {_c}, {_k}) is "taken":
							jobsTrack({_p}, {_c}, {_k})
							set {_done} to true
		if {_done} is false:
			loop {-cfg::jobs::contacts::*}:
				set {_c} to loop-value
				if {_done} is false:
					if jobsUnlocked({_p}, {_c}) is true:
						questFind({_p}, jobsGiver({_c}))
						set {_done} to true
		if {_done} is false:
			hudBar({_p}, "&7No side jobs yet.", 1)
	else if {_q} is "vic":
		if storyLive(storyIdOf({_p}, "vic")) is true:
			storyTrack({_p}, "vic")
		else:
			questFind({_p}, "fence")
	else if {_q} is "hits":
		if {-gps::questby::%{_u}%} is "hit":
			set {-gps::active::%{_u}%} to "quest"
			gpsPush({_p})
			hudBar({_p}, "&cThe GPS shows the search area.", 1)
		else:
			questFind({_p}, "hits")
	else if {_q} is "bounties":
		questFind({_p}, "hits")

command /gps [<text>]:
	description: The GPS: pin a place, or see where you're headed.
	executable by: players
	trigger:
		if arg-1 is "clear" or "off":
			gpsUnpin(player, "removed")
			stop
		if arg-1 is "quests" or "heists" or "shops" or "places":
			gpsCat(player, arg-1, 1)
			stop
		gpsMenu(player)
