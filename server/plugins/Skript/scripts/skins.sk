# skins.sk: the NPCs' own skins (owner, 2026-09-27: custom skins for the hit targets, the quest givers and the
# shopkeepers; 2026-10-19: "give everyone skins"). Drawn by tools\skins\make-*-skins.js (pixel art, the police
# skin's style), signed once by MineSkin (tools\sign-skins.js: Citizens uploads each PNG and saves the signed
# texture), and kept here in memory as {-skin::<id>::texture|signature} (outside {-cfg::*}, which a settings reload
# clears). A skin that isn't here yet leaves that NPC with the default look.
#   ids: mara, boss, vic, broker (quest givers); gun, gear, bag, tools, cars, garage (shopkeepers, by shop kind);
#        vinnie, dmitri, sal, rico, pike, lena (hit targets, by target id); guard (the bodyguards);
#        lefty, rusty, tank, whisper (the prison's inmates, quest givers by kind); jailguard (the prison guards and
#        the course's sleeping guard); jailshop (the Prison Gun Shop's keeper: a gun keeper inside the walls);
#        police (the city cops: core.sk cop::skin-*, tools\make-cop-skin.js).
# Mannequins (shop.sk, quests.sk, jailcourse.sk) get it in their summon NBT (skinProfile) and a look tag (quests.sk
# questLook, skinLook here): one summoned with an older look is replaced when its chunk is next checked, so bump
# the tag when a mannequin's skin changes. Citizens NPCs (cops.sk, jailcops.sk, hits.sk) by "npc skin -t".
# The Messages app's heads: core.sk msgcontact::<key>::skin.
#   /dskins [info | respawn]   staff (respawn: the loaded mannequins come back at once, the prison guards re-skinned)

on load:
	skinsLoad()

function skinsLoad():
	delete {-skin::*}
	# SKINS-BEGIN (tools\sign-skins.js writes the lines between these markers)
	set {-skin::bag::texture} to ""
	set {-skin::bag::signature} to ""
	set {-skin::boss::texture} to ""
	set {-skin::boss::signature} to ""
	set {-skin::broker::texture} to ""
	set {-skin::broker::signature} to ""
	set {-skin::cars::texture} to ""
	set {-skin::cars::signature} to ""
	set {-skin::dmitri::texture} to ""
	set {-skin::dmitri::signature} to ""
	set {-skin::garage::texture} to ""
	set {-skin::garage::signature} to ""
	set {-skin::gear::texture} to ""
	set {-skin::gear::signature} to ""
	set {-skin::guard::texture} to ""
	set {-skin::guard::signature} to ""
	set {-skin::gun::texture} to ""
	set {-skin::gun::signature} to ""
	set {-skin::jailguard::texture} to ""
	set {-skin::jailguard::signature} to ""
	set {-skin::jailshop::texture} to ""
	set {-skin::jailshop::signature} to ""
	set {-skin::lefty::texture} to ""
	set {-skin::lefty::signature} to ""
	set {-skin::lena::texture} to ""
	set {-skin::lena::signature} to ""
	set {-skin::mara::texture} to ""
	set {-skin::mara::signature} to ""
	set {-skin::pike::texture} to ""
	set {-skin::pike::signature} to ""
	set {-skin::rico::texture} to ""
	set {-skin::rico::signature} to ""
	set {-skin::rusty::texture} to ""
	set {-skin::rusty::signature} to ""
	set {-skin::sal::texture} to ""
	set {-skin::sal::signature} to ""
	set {-skin::tank::texture} to ""
	set {-skin::tank::signature} to ""
	set {-skin::tools::texture} to ""
	set {-skin::tools::signature} to ""
	set {-skin::vic::texture} to ""
	set {-skin::vic::signature} to ""
	set {-skin::vinnie::texture} to ""
	set {-skin::vinnie::signature} to ""
	set {-skin::whisper::texture} to ""
	set {-skin::whisper::signature} to ""
	# SKINS-END

function skinTexture(id: text) :: text:
	if {-skin::%{_id}%::texture} is set:
		return {-skin::%{_id}%::texture}
	if {_id} is "police":
		if {-cfg::cop::skin-texture} is set:
			return {-cfg::cop::skin-texture}
	return ""

function skinSignature(id: text) :: text:
	if {-skin::%{_id}%::signature} is set:
		return {-skin::%{_id}%::signature}
	if {_id} is "police":
		if {-cfg::cop::skin-signature} is set:
			return {-cfg::cop::skin-signature}
	return ""

# The mannequin NBT for a skin (",profile:{...}", to put inside the summon's braces), or "" for the default look.
function skinProfile(id: text) :: text:
	set {_t} to skinTexture({_id})
	set {_s} to skinSignature({_id})
	if {_t} is "":
		return ""
	if {_s} is "":
		return ""
	return ",profile:{properties:[{name:""textures"",value:""%{_t}%"",signature:""%{_s}%""}]}"

# The look tag of shop.sk's keepers and jailcourse.sk's sleeping guard (quests.sk has its own, questLook): a
# mannequin without it was summoned with an older skin and is replaced. Bump it when one of their skins changes.
function skinLook() :: text:
	return "skinlook_2"

# A quest giver's skin by its kind (quests.sk). The prison's inmates (lefty, rusty, tank, whisper) by their kind.
function questSkinId(kind: text) :: text:
	if {_kind} is "story":
		return "mara"
	if {_kind} is "contracts":
		return "boss"
	if {_kind} is "fence":
		return "vic"
	if {_kind} is "hits":
		return "broker"
	return {_kind}

# A shopkeeper's skin by its kind and spot (shop.sk spawnKeeper): a gun keeper inside the prison's walls (the
# Prison Gun Shop) is the inmate who runs the yard's shop, whether the prison is switched on or not.
function keeperSkinId(kind: text, l: location) :: text:
	if {_kind} is "gun":
		if jailPolyRaw({_l}, "wall") is true:
			if skinTexture("jailshop") is not "":
				return "jailshop"
	return {_kind}

# The prison guards' skin (jailcops.sk's NPCs, jailcourse.sk's sleeping guard): the corrections officer, or the
# city police skin while that one isn't signed.
function jailGuardSkinId() :: text:
	if skinTexture("jailguard") is not "":
		return "jailguard"
	return "police"

command /dskins [<text>]:
	permission: donating.staff
	permission message: &cStaff only.
	trigger:
		if arg-1 is "respawn":
			# The loaded mannequins go and come back at once with their skins (shop.sk keeperCheck, quests.sk questCheck,
			# jailcourse.sk jcGuardCheck while the prison runs); those in unloaded chunks are replaced by their look tag
			# when their chunk loads. The prison guards (Citizens) get their skin again.
			set {_n} to 0
			loop all entities:
				if loop-entity has scoreboard tag "donating_shop":
					kill loop-entity
					add 1 to {_n}
				else if loop-entity has scoreboard tag "donating_quest":
					kill loop-entity
					add 1 to {_n}
				else if loop-entity has scoreboard tag "jail_guard":
					kill loop-entity
					add 1 to {_n}
			loop {shop::keepers::*}:
				keeperCheck(loop-index)
			loop {quest::giver::*}:
				questCheck(loop-index)
			jcGuardCheck()
			set {_g} to 0
			set {_sk} to jailGuardSkinId()
			set {_t} to skinTexture({_sk})
			set {_s} to skinSignature({_sk})
			if {_t} is not "":
				if {_s} is not "":
					loop {-jailcop::id::*}:
						execute console command "npc skin -t %{_sk}% %{_t}% %{_s}% --id %loop-index%"
						add 1 to {_g}
			send "SKINS respawn: %{_n}% mannequins (shopkeepers, quest givers, the sleeping guard) replaced, %{_g}% prison guards re-skinned (%{_sk}%)" to sender
			stop
		loop "mara", "boss", "vic", "broker", "gun", "gear", "bag", "tools", "cars", "garage", "vinnie", "dmitri", "sal", "rico", "pike", "lena", "guard", "lefty", "rusty", "tank", "whisper", "jailguard", "jailshop" and "police":
			if skinTexture(loop-value) is not "":
				add loop-value to {_have::*}
			else:
				add loop-value to {_miss::*}
		set {_h} to join {_have::*} with ","
		set {_m} to join {_miss::*} with ","
		send "SKINS have=%{_h}% missing=%{_m}%" to sender
