# car-cleanup.sk: cars go back to the garage by themselves (never lost). Built 2026-09-26 (Phase 2).
# CLAUDE.md "Cars": despawn when the car stands empty for car::idle-despawn (5 minutes), when its owner
# drives another car for car::other-car-despawn (1 minute), and when its owner logs out.
# Every 10 s it also sweeps loaded MTVehicles stands: a car of ours that isn't out (left by a crash or an
# unloaded chunk when it was sent back) is despawned, and so is a plate spawned twice (MTVehicles has no
# duplicate check); a car that's out but whose stands vanished (killed by a command) is marked back in
# the garage.

every 10 seconds:
	loop {car::out::*}:
		set {_plate} to loop-index in upper case
		set {_o} to carOwnerOf({_plate})
		if {-car::driver::%{_plate}%} is set:
			set {-car::used::%{_plate}%} to now
			set {_d} to {-car::driver::%{_plate}%}
			set {_where} to "lane"
			set {_blocks} to garageInLane(location of {_d})
			if {_blocks} is false:
				set {_blocks} to garageOnBay(location of {_d})
				set {_where} to "bay"
			if {_blocks} is false:
				delete {-car::lanesince::%{_plate}%}
			else if {-car::lanesince::%{_plate}%} is not set:
				set {-car::lanesince::%{_plate}%} to now
			else:
				set {_lim} to cfg("car::idle-despawn")
				if isAfk({_d}) is true:
					set {_lim} to cfg("garage::pickup-idle")
				if difference between {-car::lanesince::%{_plate}%} and now >= {_lim}:
					delete {-car::lanesince::%{_plate}%}
					make {_d} dismount
					carStopDriving({_d}, {_plate})
					carCleanupStore({_plate}, {_where})
		else if {-car::fresh::%{_plate}%} is set:
			# Taken out at a garage and never entered (citygarage.sk): back after garage::pickup-idle, freeing the lane.
			if difference between {-car::fresh::%{_plate}%} and now >= cfg("garage::pickup-idle"):
				delete {-car::fresh::%{_plate}%}
				carCleanupStore({_plate}, "pickup-idle")
		else:
			if {-car::used::%{_plate}%} is not set:
				# After a restart: start counting now.
				set {-car::used::%{_plate}%} to now
			set {_at} to {car::out::%{_plate}%}
			set {_where} to "lane"
			set {_blocks} to garageInLane({_at})
			if {_blocks} is false:
				set {_blocks} to garageOnBay({_at})
				set {_where} to "bay"
			if {_blocks} is true:
				# Left standing in a garage's exit lane (or on a bay) it blocks it: back after pickup-idle, owner near or not.
				if difference between {-car::used::%{_plate}%} and now >= cfg("garage::pickup-idle"):
					carCleanupStore({_plate}, {_where})
			else:
				# A parked car waits for its owner (owner, 2026-09-27): while they're near it or inside a heist.
				if carWaitsFor({_plate}, {_o}) is true:
					set {-car::used::%{_plate}%} to now
				if difference between {-car::used::%{_plate}%} and now >= cfg("car::idle-despawn"):
					carCleanupStore({_plate}, "idle")
	carOtherCarCheck()
	carSweep()

# Whether a parked car still waits for its owner: online and inside a heist (a getaway car outside a long heist), or in
# the same world within car::idle-near blocks of it.
function carWaitsFor(plate: text, o: text) :: boolean:
	if {_o} is "":
		return false
	set {_at} to {car::out::%{_plate}%}
	if {_at} is not set:
		return false
	loop all players:
		if "%uuid of loop-player%" is {_o}:
			if heistOf(loop-player) is not "":
				return true
			if world of loop-player is world of {_at}:
				if distance between (location of loop-player) and {_at} <= cfg("car::idle-near"):
					return true
	return false

# The owner is in another car (not theirs, e.g. an NPC car later) for car::other-car-despawn.
function carOtherCarCheck():
	loop all players:
		set {_mine} to {car::outof::%uuid of loop-player%}
		set {_riding} to {-car::riding::%uuid of loop-player%}
		set {_seat} to carSeatOf(loop-player)
		set {_other} to false
		if {_mine} is set:
			# Only driving another car counts (riding along with a friend doesn't).
			if {_seat} starts with "driver:":
				if {_seat} does not end with ":%{_mine}%":
					set {_other} to true
		if {_other} is false:
			delete {-car::othersince::%uuid of loop-player%}
		else if {-car::othersince::%uuid of loop-player%} is not set:
			set {-car::othersince::%uuid of loop-player%} to now
		else if difference between {-car::othersince::%uuid of loop-player%} and now >= cfg("car::other-car-despawn"):
			delete {-car::othersince::%uuid of loop-player%}
			carCleanupStore("%{_mine}%", "other-car")

# Sends a car back and tells its owner (if online).
function carCleanupStore(plate: text, why: text):
	set {_o} to carOwnerOf({_plate})
	set {_m} to carModelOf({_plate})
	carStore({_plate}, {_why})
	loop all players:
		if "%uuid of loop-player%" is {_o}:
			set {_how} to "&f/garage"
			if garagesExist() is true:
				if remoteOk(loop-player, "garage") is false:
					set {_how} to "&7Take it out at a garage: &f/gps"
			if {_why} is "idle":
				msg(loop-player, "&7Your %carName({_m})% stood unused, so it went back to the garage. %{_how}%")
			else if {_why} is "pickup-idle":
				msg(loop-player, "&7Nobody picked up your %carName({_m})%, so it went back to the garage.")
			else if {_why} is "lane":
				msg(loop-player, "&7Your %carName({_m})% stood in the garage's exit lane, so it went back. %{_how}%")
			else if {_why} is "bay":
				msg(loop-player, "&7Your %carName({_m})% stood on a garage bay, so it went back. %{_how}%")
			else if {_why} is "other-car":
				msg(loop-player, "&7You're in another car, so your %carName({_m})% went back to the garage. %{_how}%")

on quit:
	set {_plate} to {car::outof::%uuid of player%}
	{_plate} is set
	carStore("%{_plate}%", "quit")

# Loaded stands that shouldn't be there, and cars that are out but gone. Stands are removed one by one
# (MTVehicles' despawn takes every copy of a plate, also the one being driven): a stand of ours is kept
# only when its car is out and it's near the car's tracked spot (the driver, else where it's parked); a
# stand of a plate MTVehicles doesn't know any more is a ghost. Review, 2026-09-26: a car sent back while
# its chunk was unloaded left a copy behind.
function carSweep():
	loop all armor stands:
		set {_n} to "%name of loop-entity%"
		if {_n} starts with "MTVEHICLES_":
			set {_a::*} to {_n} split at "_"
			set {_plate} to {_a::3}
			if {_n} starts with "MTVEHICLES_MAIN_":
				add 1 to {_count::%{_plate}%}
			if carStandStray(loop-entity, {_plate}) is true:
				carLog("sweep %{_n}% at %location of loop-entity% (a stray copy)")
				carKillStand(loop-entity)
	loop {car::out::*}:
		set {_plate} to loop-index in upper case
		if {_count::%{_plate}%} is not set:
			set {_l} to loop-value
			if chunk at {_l} is loaded:
				if {-car::driver::%{_plate}%} is not set:
					carLog("sweep %{_plate}% (out but its stands are gone)")
					carStore({_plate}, "vanished")

# Whether a loaded car stand shouldn't be there.
function carStandStray(e: entity, plate: text) :: boolean:
	if carOwnerOf({_plate}) is "":
		# Not ours: NPC cars (later) and staff tests are MTVehicles' own; a plate it forgot is a ghost.
		if carAlive({_plate}) is false:
			return true
		return false
	if {car::out::%{_plate}%} is not set:
		return true
	set {_track} to {car::out::%{_plate}%}
	set {_d} to {-car::driver::%{_plate}%}
	if {_d} is set:
		if {_d} is online:
			set {_track} to location of {_d}
	if world of {_e} is not world of {_track}:
		return true
	if distance between (location of {_e}) and {_track} > 8:
		return true
	return false

# Removes a stand without drops (its helmet is the car item, cleared first). Skript's kill ends with a plain
# remove when the damage is cancelled (garage.sk protects car stands); checked 2026-09-28: gone, nothing dropped.
# (The vanilla kill command echoed "[Server: Killed MTVEHICLES_...]" into every op's chat.)
function carKillStand(e: entity):
	set helmet of {_e} to air
	kill {_e}
