# bounty.sk: bounties (CLAUDE.md, PvP, passive mode, bounties; Default rules).
#   - Killing a player adds cfg("bounty::per-kill") to the killer's bounty. Bounty from kills is
#     capped at cfg("bounty::kill-cap"); killing the same player again within
#     cfg("bounty::repeat-kill-window") adds nothing.
#   - Robberies: bag.sk calls addBounty(p, sale value × cfg("bounty::robbery-share"), "robbery").
#   - Players can place a bounty on someone else: /bounty <player> <amount>, at least
#     cfg("bounty::min-placed"). The money is taken from the placer. It's posted in person with the Broker (hits.sk's
#     quest giver, within quest::reach); a map with no Broker keeps posting anywhere. /bounty alone lists them anywhere.
#   - A bounty stays until a player kills you (combat logs count, credited by combat-log.sk), then the
#     killer is paid all of it and it's gone. Cop and trap deaths leave it. The victim of that kill also pays
#     cfg("bounty::victim-fee") (10%) of the part of their bounty they earned (robberies, contracts, kills) on top of the
#     death's cost (owner, 2026-09-28; it disappears). Not of the part other players placed (review 2026-09-28: a placer
#     could put a bounty on someone, claim it back and cost them 10% every time, for free).
#   - Passive players can't gain, claim or place bounties, and nobody can place one on them.
#   - No payout (and no kill bounty) between players on the same IP (alts), while
#     cfg("bounty::ip-check") is true; a killer who is offline at the claim is compared by the IP they last
#     played from (data "last-ip", review 2026-09-28: a combat log credited to an offline main skipped the check).
#
# Data: "bounty" = the whole bounty ($), "bounty-placed" = the part other players placed, "bounty-kills" = the part that
# came from kills (for the cap),
# "bounty-last::<victim uuid>" = when this player last got kill bounty for that victim,
# "bounty-payout" = money waiting for a killer who was offline at the claim (paid on join).
# The death cause comes from death.sk (data "last-death-cause"); this runs after it (priority monitor).

function bountyLog(text: text):
	log {_text} to "bounty"

function getBounty(p: offline player) :: number:
	set {_b} to getData({_p}, "bounty")
	if {_b} is set:
		return {_b}
	return 0

# Adds to a player's bounty (never for passive players). Returns what was added.
function addBounty(p: offline player, amount: number, source: text) :: number:
	if isPassive({_p}) is true:
		return 0
	set {_add} to floor({_amount})
	if {_source} is "kill":
		set {_kills} to getData({_p}, "bounty-kills")
		if {_kills} is not set:
			set {_kills} to 0
		set {_add} to max(0, min({_add}, cfg("bounty::kill-cap") - {_kills}))
		setData({_p}, "bounty-kills", {_kills} + {_add})
	if {_add} <= 0:
		return 0
	setData({_p}, "bounty", getBounty({_p}) + {_add})
	if {_source} is "placed":
		set {_pl} to getData({_p}, "bounty-placed")
		if {_pl} is not set:
			set {_pl} to 0
		setData({_p}, "bounty-placed", {_pl} + {_add})
	return {_add}

function clearBounty(p: offline player):
	deleteData({_p}, "bounty")
	deleteData({_p}, "bounty-kills")
	deleteData({_p}, "bounty-placed")

# The online player with this uuid text, if any.
function playerByUuid(u: text) :: player:
	loop all players:
		if "%uuid of loop-player%" is {_u}:
			return loop-player

function sameIp(a: player, b: player) :: boolean:
	if cfg("bounty::ip-check") is not true:
		return false
	if ip of {_a} is ip of {_b}:
		return true
	return false

on death of player with priority monitor:
	# Cops (Citizens NPCs, cops.sk) are player entities too: their deaths aren't a robber's.
	isNpc(victim) is false
	set {_cause} to getData(victim, "last-death-cause")
	{_cause} is set
	{_cause} starts with "player:"
	set {_ku} to last element of ({_cause} split at ":")
	set {_vu} to "%uuid of victim%"
	{_ku} is not {_vu}
	set {_killer} to playerByUuid({_ku})
	# (Nested ifs with stop: a condition line inside an if block would only skip that block.)
	if {_killer} is set:
		if sameIp({_killer}, victim) is true:
			stop
		if isPassive({_killer}) is true:
			stop
	else if cfg("bounty::ip-check") is true:
		if {data::%{_ku}%::last-ip} is ip of victim:
			stop
	set {_vname} to name of victim
	# 1. The victim's bounty goes to the killer, and the victim pays the fee on it (owner, 2026-09-28).
	set {_bounty} to getBounty(victim)
	if {_bounty} > 0:
		set {_placed} to getData(victim, "bounty-placed")
		if {_placed} is not set:
			set {_placed} to 0
		set {_earned} to max(0, {_bounty} - {_placed})
		clearBounty(victim)
		set {_fee} to takeMoney(victim, floor({_earned} * cfg("bounty::victim-fee")))
		if {_fee} > 0:
			msg(victim, "&cYour %formatMoney({_bounty})% bounty was claimed: you paid a %cfg("bounty::victim-fee") * 100%%% fee on what you earned of it (&f%formatMoney({_fee})%&c) on top of your death.")
			bountyLog("fee %name of victim% %uuid of victim% bounty=%{_bounty}% fee=%{_fee}% killer=%{_ku}%")
		set {_money} to formatMoney({_bounty})
		if {_killer} is set:
			giveMoney({_killer}, {_bounty})
			set {_kname} to name of {_killer}
			broadcastMsg("&6%{_kname}% claimed %{_vname}%'s %{_money}% bounty!")
		else:
			set {_owed} to {data::%{_ku}%::bounty-payout}
			if {_owed} is not set:
				set {_owed} to 0
			set {data::%{_ku}%::bounty-payout} to {_owed} + {_bounty}
			broadcastMsg("&6%{_vname}%'s %{_money}% bounty was claimed.")
	# 2. The killer's own bounty grows (not twice for the same victim within the window).
	{_killer} is set
	set {_last} to getData({_killer}, "bounty-last::%{_vu}%")
	if {_last} is set:
		if difference between {_last} and now < cfg("bounty::repeat-kill-window"):
			stop
	setData({_killer}, "bounty-last::%{_vu}%", now)
	set {_added} to addBounty({_killer}, cfg("bounty::per-kill"), "kill")
	{_added} > 0
	set {_total} to formatMoney(getBounty({_killer}))
	msg({_killer}, "&cYour bounty is now %{_total}%. &7If a player claims it, you pay a %cfg("bounty::victim-fee") * 100%%% fee.")

# The IP a player last played from (the same-IP check for a killer who is offline at the claim).
on quit:
	setData(player, "last-ip", ip of player)

on join:
	set {_pay} to getData(player, "bounty-payout")
	{_pay} is set
	deleteData(player, "bounty-payout")
	giveMoney(player, {_pay})
	set {_money} to formatMoney({_pay})
	msg(player, "&6You were paid %{_money}% for a bounty you claimed.")

# ---------- Placing bounties ----------

command /bounty [<offline player>] [<number>]:
	trigger:
		if arg-1 is not set:
			showBounties(player)
			stop
		if arg-2 is not set:
			set {_min} to formatMoney(cfg("bounty::min-placed"))
			msg(player, "&7Place a bounty: /bounty <player> <amount> (at least %{_min}%).")
			stop
		placeBounty(player, arg-1, arg-2)

# "" when the player may post a bounty here: next to the Broker, or anywhere while no Broker stands in their world.
function bountyPostBlock(p: player) :: text:
	if questNear({_p}, "hits") is not "":
		return ""
	set {_n} to questNearestText({_p}, "hits")
	if {_n} is "":
		return ""
	return "Bounties are posted with the Broker at the %{_n}%: the GPS leads you there."

function placeBounty(p: player, target: offline player, amount: number):
	set {_amount} to floor({_amount})
	set {_tname} to name of {_target}
	if "%uuid of {_target}%" is "%uuid of {_p}%":
		msg({_p}, "&cYou can't put a bounty on yourself.")
		stop
	if isPassive({_p}) is true:
		msg({_p}, "&cPassive players can't place bounties.")
		stop
	if tutorialNeedsBag({_p}) is true:
		msg({_p}, "&cBuy your bag first (Bag Shop): you can't leave spawn without one.")
		stop
	if {_target} has not played before:
		if {_target} is not online:
			msg({_p}, "&cNobody called %{_tname}% has played here.")
			stop
	if isPassive({_target}) is true:
		msg({_p}, "&c%{_tname}% is in passive mode: no bounties on them.")
		stop
	if {_amount} < cfg("bounty::min-placed"):
		set {_min} to formatMoney(cfg("bounty::min-placed"))
		msg({_p}, "&cA bounty is at least %{_min}%.")
		stop
	set {_money} to formatMoney({_amount})
	if balance of {_p} < {_amount}:
		msg({_p}, "&cYou don't have %{_money}%.")
		stop
	# Everything else checked first, so nobody walks to the Broker only to be refused there.
	set {_bw} to bountyPostBlock({_p})
	if {_bw} is not "":
		msg({_p}, "&7%{_bw}%")
		questFind({_p}, "hits")
		stop
	if chargeMoney({_p}, {_amount}) is not true:
		msg({_p}, "&cYou don't have %{_money}%.")
		stop
	addBounty({_target}, {_amount}, "placed")
	set {_total} to formatMoney(getBounty({_target}))
	set {_pname} to name of {_p}
	msg({_p}, "You put %{_money}% on %{_tname}%. Their bounty is now %{_total}%.")
	set {_tp} to playerByUuid("%uuid of {_target}%")
	if {_tp} is set:
		msg({_tp}, "&c%{_pname}% put %{_money}% on your head. Your bounty is %{_total}%.")

# The phone's Bounties app and /bounty: the biggest bounties of players online.
function showBounties(p: player):
	loop all players:
		set {_b} to getBounty(loop-player)
		{_b} > 0
		set {_list::%loop-player%} to {_b}
	msg({_p}, "&6Bounties (players online):")
	set {_n} to 0
	loop sorted indices of {_list::*} in descending order:
		{_n} < 10
		add 1 to {_n}
		set {_who} to playerByUuid(loop-value)
		set {_name} to name of {_who}
		set {_money} to formatMoney({_list::%loop-value%})
		send colored "&7 %{_n}%. &f%{_name}% &c%{_money}%" to {_p}
	if {_n} is 0:
		send colored "&7 Nobody online has a bounty." to {_p}
	set {_min} to formatMoney(cfg("bounty::min-placed"))
	send colored "&7Place one: &f/bounty <player> <amount> &7(at least %{_min}%)" to {_p}

# ---------- The Bounties page (the phone's Bounties app, the hits menu's Bounties button) ----------
# A phone page (ui.sk): 2 back to the phone, 4 your own bounty, 6 "Post one" (a bounty is posted with /bounty at the
# Broker: away from him a click leads the GPS there, bountyPostBlock's rule); the content is every online player with a
# bounty, highest first, 20 a page (3/5 the page arrows: 6 is Post one). Look only. /bounty alone stays in chat.
function bountyButton(p: player, gui: inventory, slot: number, i: item, act: text):
	set slot {_slot} of {_gui} to {_i}
	set {-bounty::act::%{_p}%::%{_slot}%} to {_act}

function bountyPage(p: player):
	bountyPageN({_p}, 1)

function bountyPageN(p: player, page: number):
	closePhoneMap({_p})
	set {_gui} to phonePage("Bounties")
	delete {-bounty::act::%{_p}%::*}
	bountyButton({_p}, {_gui}, 2, phoneBackIcon("Phone"), "phone")
	set slot 4 of {_gui} to skull of {_p} named "&fYours" with lore "&c%formatMoney(getBounty({_p}))%"
	set {_min} to formatMoney(cfg("bounty::min-placed"))
	set {_i} to appIcon("bounties", "&fPost one")
	if isPassive({_p}) is true:
		set lore of {_i} to "&7Not while passive"
		set slot 6 of {_gui} to {_i}
	else if bountyPostBlock({_p}) is "":
		set lore of {_i} to "&7/bounty <player> <amount> · at least %{_min}%"
		bountyButton({_p}, {_gui}, 6, {_i}, "how")
	else:
		set lore of {_i} to "&7At the Broker (%questNearestText({_p}, "hits")%)" and "&7Click: find him"
		bountyButton({_p}, {_gui}, 6, {_i}, "find")
	# Online players with a bounty, highest first.
	loop all players:
		set {_b} to getBounty(loop-player)
		if {_b} > 0:
			set {_list::%uuid of loop-player%} to {_b}
	set {_n} to 0
	loop sorted indices of {_list::*} in descending order:
		add 1 to {_n}
		set {_order::%{_n}%} to loop-value
	set {_pages} to max(1, ceil({_n} / 20))
	if {_page} > {_pages}:
		set {_page} to {_pages}
	if {_page} < 1:
		set {_page} to 1
	if {_page} > 1:
		bountyButton({_p}, {_gui}, 3, phonePrevIcon({_page}), "page:%{_page} - 1%")
	if {_page} < {_pages}:
		bountyButton({_p}, {_gui}, 5, phoneNextIcon({_page}), "page:%{_page} + 1%")
	set {_slots::*} to phoneSlots()
	set {_first} to ({_page} - 1) * 20
	loop 20 times:
		set {_k} to {_first} + loop-number
		set {_id} to {_order::%{_k}%}
		if {_id} is set:
			set {_who} to playerByUuid({_id})
			if {_who} is set:
				set {_i} to skull of {_who} named "&f%name of {_who}%" with lore "&c%formatMoney({_list::%{_id}%})%"
				set slot {_slots::%loop-number%} of {_gui} to {_i}
	if {_n} is 0:
		set slot 22 of {_gui} to phoneEmptyIcon("Nobody online has one")
	bountyButton({_p}, {_gui}, 49, phoneHomeIcon(), "phone")
	set {-bounty::gui::%{_p}%} to {_gui}
	if {-bounty::gen::%{_p}%} is not set:
		set {-bounty::gen::%{_p}%} to 0
	open {_gui} to {_p}

on inventory click:
	{-bounty::gui::%player%} is set
	player's current inventory is {-bounty::gui::%player%}
	cancel event
	event-inventory is {-bounty::gui::%player%}
	set {_act} to {-bounty::act::%player%::%index of event-slot%}
	{_act} is set
	set {_gen} to {-bounty::gen::%player%}
	wait 1 tick
	player is online
	{-bounty::gui::%player%} is set
	{-bounty::gen::%player%} is {_gen}
	add 1 to {-bounty::gen::%player%}
	if {_act} is "phone":
		# Opening the phone closes this page; the close handler only forgets it.
		openPhone(player)
	else if {_act} is "how":
		close player's inventory
		set {_min} to formatMoney(cfg("bounty::min-placed"))
		msg(player, "&7Place a bounty: &f/bounty <player> <amount> &7(at least %{_min}%).")
	else if {_act} is "find":
		close player's inventory
		questFind(player, "hits")
	else if {_act} starts with "page:":
		bountyPageN(player, (subtext of {_act} from characters 6 to (length of {_act})) parsed as number)

on inventory drag:
	{-bounty::gui::%player%} is set
	player's current inventory is {-bounty::gui::%player%}
	cancel event

on inventory close:
	{-bounty::gui::%player%} is set
	event-inventory is {-bounty::gui::%player%}
	delete {-bounty::gui::%player%}
	delete {-bounty::act::%player%::*}
