# hud.sk: the HUD (CLAUDE.md, Heist UI). Built so far:
#   - The XP bar shows the held gun's ammo (owner, 2026-09-25): the level number is every round left
#     for it (the magazine plus that ammo type in the inventory), the bar is how full the magazine is,
#     draining as you shoot. A melee weapon shows a full bar with no number (it never runs out), a
#     consumable (Stim) how many you carry, anything else an empty bar. The pack draws the XP bar as a
#     brass ammo belt.
#   - Outside heists the locator bar (passive players, POIs) takes the bar's place except for 5 s after
#     each change, so the bar shows while you shoot; the number above it always shows. Inside heists
#     players receive no waypoints (nav.sk), so the bar is always there.
#   - hudBar(p, text, prio): the action bar with priorities. A text with a lower priority than the last
#     one is dropped for 1.5 s, so a loot prompt can't wipe a trap hit. Priorities: a prison guard's arrest
#     clock 4 (jailcops.sk: CUFFING, broke free), combat tag 3, trap hits and heist gates 2 (traps.sk), loot
#     progress and results 1 (loot.sk), prompts 0.
#   - The boss bar (2026-09-26): the heist you're in and its escape clock; red with the alarm ("Cops in
#     20s", then the wave and the next one's timer); while the cops chase you outside, how far you
#     still have to go. See hudBoss.
#   - Sounds for the heist's big moments (heistNotify: the clock starts, time warnings, the alarm, thrown
#     out, lost the cops) and a title for the alarm.

function hudBar(p: player, text: text, prio: number):
	set {_at} to {-hud::barat::%{_p}%}
	if {_at} is set:
		if {-hud::barprio::%{_p}%} > {_prio}:
			if difference between {_at} and now < 1.5 seconds:
				stop
	set {-hud::barat::%{_p}%} to now
	set {-hud::barprio::%{_p}%} to {_prio}
	send action bar colored {_text} to {_p}

on quit:
	delete {-hud::barat::%player%}
	delete {-hud::barprio::%player%}

# Level number and bar for what the player holds.
function ammoBar(p: player):
	set {_i} to tool of {_p}
	set {_w} to wmTitle({_i})
	set {_level} to 0
	set {_bar} to 0
	if {_w} is not "":
		set {_type} to {-cfg::wpn::%{_w}%::ammo}
		if {_type} is set:
			set {_loaded} to wmLoaded({_i})
			set {_level} to {_loaded} + ammoCount({_p}, {_type})
			set {_mag} to {-cfg::wpn::%{_w}%::mag}
			if {_mag} > 0:
				set {_bar} to min(1, {_loaded} / {_mag})
		else if {-cfg::con::%{_w}%::name} is set:
			set {_level} to item amount of {_i}
			set {_bar} to 1
		else if {-cfg::wpn::%{_w}%::name} is set:
			set {_bar} to 1
	# A full bar (1) rolls over into the next level in vanilla: keep it just under.
	set {_bar} to min({_bar}, 0.999)
	# Only send what changed (a changed XP bar is a packet).
	if {_p}'s level is not {_level}:
		set {_p}'s level to {_level}
	if difference between ({_p}'s level progress) and {_bar} > 0.001:
		set {_p}'s level progress to {_bar}

every 2 ticks:
	loop all players:
		ammoBar(loop-player)

# ---------- The boss bar ----------
# One bar per player (Skript 2.16 boss bars, {-hud::boss::<p>}), worked out every 5 ticks; only what
# changed is sent. What it shows:
#   - inside an open heist: "Bank · the clock starts at the first robbery" (white, full).
#   - inside an active heist: "Bank · Escape 3:42"; the bar is T / E (T = time left, E = the heist's
#     escape time), green down to half, then yellow, red for the last minute.
#   - the alarm (advanced heists; a store once its clerk hit the panic button), red: "ALARM · Cops in 17s · Escape
#     3:42" (the bar counts down the response time), then the assaults (heists.sk, 2026-10-21): "ASSAULT 2 · 0:34 · 7
#     cops · Escape 3:42" (red; the bar is the assault's time left: the assault meter), "BREAK · assault 3 in 0:18 ·
#     Escape 3:42" (yellow). A store shows its loot left instead of the escape clock.
#   - hunted outside the heist (the cops chase you), red: "COPS · assault 2 · 42 blocks to lose them"; the
#     bar is what's left of the chase radius R: (R − d) / R, d = your distance from the heist.
#   - anything else: no bar.

function hudBossSet(p: player, title: text, color: text, progress: number):
	set {_progress} to max(0, min(1, {_progress}))
	set {_b} to {-hud::boss::%{_p}%}
	if {_b} is not set:
		set {_b} to a new boss bar
		set {-hud::boss::%{_p}%} to {_b}
		delete {-hud::bosslast::%{_p}%::*}
	if {-hud::bosslast::%{_p}%::title} is not {_title}:
		set {-hud::bosslast::%{_p}%::title} to {_title}
		set title of {_b} to colored {_title}
	if {-hud::bosslast::%{_p}%::color} is not {_color}:
		set {-hud::bosslast::%{_p}%::color} to {_color}
		if {_color} is "red":
			set color of {_b} to red
		else if {_color} is "yellow":
			set color of {_b} to yellow
		else if {_color} is "green":
			set color of {_b} to green
		else if {_color} is "purple":
			set color of {_b} to purple
		else if {_color} is "blue":
			set color of {_b} to blue
		else if {_color} is "pink":
			set color of {_b} to pink
		else:
			set color of {_b} to white
	set {_last} to {-hud::bosslast::%{_p}%::progress}
	if {_last} is not set:
		set {_last} to -1
	if difference between {_last} and {_progress} > 0.004:
		set {-hud::bosslast::%{_p}%::progress} to {_progress}
		set progress of {_b} to {_progress}
	if {-hud::bosslast::%{_p}%::shown} is not set:
		set {-hud::bosslast::%{_p}%::shown} to true
		add {_p} to viewers of {_b}

function hudBossOff(p: player):
	set {_b} to {-hud::boss::%{_p}%}
	{_b} is set
	remove {_p} from viewers of {_b}
	delete {-hud::boss::%{_p}%}
	delete {-hud::bosslast::%{_p}%::*}

function hudBoss(p: player):
	# The prison (prison.sk) comes first: the course, the guards, the cell, the C4, the lot.
	if prisonHud({_p}) is true:
		stop
	set {_h} to heistOf({_p})
	if {_h} is not "":
		set {_name} to heistName({_h})
		set {_s} to heistState({_h})
		if {_s} is "open":
			if heistIsStore({_h}) is true:
				hudBossSet({_p}, "&f%{_name}% &7· no clock", "white", 1)
			else:
				hudBossSet({_p}, "&f%{_name}% &7· the clock starts at the first robbery", "white", 1)
			stop
		if {_s} is not "active":
			hudBossOff({_p})
			stop
		set {_alarm} to heistAlarmStage({_h})
		# A store has no clock: what's left to grab instead.
		if heistIsStore({_h}) is true:
			set {_rolled} to max(1, heistLootPool({_h}))
			set {_lootLeft} to lootLeft({_h})
			if {_alarm} is not "none":
				hudAlarmBar({_p}, {_h}, "&a%formatMoneyShort({_lootLeft})% &7left")
				stop
			hudBossSet({_p}, "&f%{_name}% &7· no clock · &a%formatMoneyShort({_lootLeft})% &7left", "white", min(1, {_lootLeft} / {_rolled}))
			stop
		set {_left} to heistSecondsLeft({_h})
		set {_total} to max(1, heistEscape({_h}) / 1 second)
		set {_clock} to formatClock({_left})
		if {_alarm} is not "none":
			hudAlarmBar({_p}, {_h}, "Escape %{_clock}%")
		else if {_left} <= 60:
			hudBossSet({_p}, "&f%{_name}% &7· Escape &c%{_clock}%", "red", {_left} / {_total})
		else if {_left} <= {_total} / 2:
			hudBossSet({_p}, "&f%{_name}% &7· Escape &e%{_clock}%", "yellow", {_left} / {_total})
		else:
			hudBossSet({_p}, "&f%{_name}% &7· Escape &a%{_clock}%", "green", {_left} / {_total})
		stop
	set {_h} to heistHuntedBy({_p})
	if {_h} is not "":
		set {_c} to heistCenter({_h})
		if {_c} is set:
			if world of {_c} is world of {_p}:
				set {_r} to heistChaseRadius({_p}, {_h})
				set {_away} to max(0, ceil({_r} - distance between (location of {_p}) and {_c}))
				set {_n} to heistPhaseLeft({_h})
				set {_st} to heistAlarmStage({_h})
				if {_st} is "warning":
					set {_what} to "cops in %{_n}%s"
				else if {_st} is "break":
					set {_what} to "break %formatClock({_n})%"
				else:
					set {_what} to "assault %heistAssault({_h})%"
				hudBossSet({_p}, "&4&lCOPS&r &c· %{_what}% &7· &f%{_away}% &7blocks to lose them", "red", {_away} / max(1, {_r}))
				stop
	# A hit contract (hits.sk): the target spotted, the search area, or overtime.
	if hitHud({_p}) is true:
		stop
	# A car-theft job (contracts.sk): where to go, and the time left.
	if ctHud({_p}) is true:
		stop
	# The GPS (gps.sk): a pin, or the base while carrying loot.
	if gpsHud({_p}) is true:
		stop
	# A mission's target on the GPS (story.sk).
	if storyHud({_p}) is true:
		stop
	# A contact job's target on the GPS (jobs.sk).
	if jobsHud({_p}) is true:
		stop
	hudBossOff({_p})

# The alarm's bar (heists.sk's phases): the response time, an assault (its meter: the time left), a break. tail = the
# escape clock, or a store's loot left.
function hudAlarmBar(p: player, h: text, tail: text):
	set {_st} to heistAlarmStage({_h})
	set {_n} to heistPhaseLeft({_h})
	set {_f} to {_n} / heistPhaseLength({_h})
	set {_a} to heistAssault({_h})
	if {_st} is "warning":
		hudBossSet({_p}, "&4&lALARM&r &c· Cops in %{_n}%s &7· %{_tail}%", "red", {_f})
	else if {_st} is "break":
		set {_next} to {_a} + 1
		hudBossSet({_p}, "&e&lBREAK&r &e· assault %{_next}% in %formatClock({_n})% &7· %{_tail}%", "yellow", {_f})
	else:
		set {_cops} to heistCopsAlive({_h}) + heistPool({_h})
		hudBossSet({_p}, "&4&lASSAULT %{_a}%&r &c· %formatClock({_n})% · %{_cops}% cops &7· %{_tail}%", "red", {_f})

every 5 ticks:
	loop all players:
		hudBoss(loop-player)

on quit:
	hudBossOff(player)

# ---------- Heist moments (heists.sk's heistNotify) ----------
# kind: enter, leave, start, warn, evict, alarm, lost-cops. The text always goes to chat too.
function hudNotify(p: player, kind: text, text: text):
	msg({_p}, {_text})
	if {_kind} is "start":
		play sound "block.note_block.pling" with volume 0.8 and pitch 1.2 to {_p}
	else if {_kind} is "warn":
		play sound "block.note_block.bell" with volume 1 and pitch 0.7 to {_p}
	else if {_kind} is "alarm":
		# Owner, 2026-09-26: a big WANTED on screen the moment you become wanted.
		set {_h} to heistHuntedBy({_p})
		set {_warn} to cfg("alarm::warning") / 1 second
		if {_h} is not "":
			set {_warn} to heistPhaseLeft({_h})
		send title colored "&4&lWANTED" with subtitle colored "&cAlarm! Cops in %{_warn}%s. Get out!" to {_p} for 3 seconds
		play sound "block.bell.use" with volume 1 and pitch 0.8 to {_p}
	else if {_kind} is "assault":
		set {_h} to heistHuntedBy({_p})
		set {_a} to 1
		if {_h} is not "":
			set {_a} to heistAssault({_h})
		send title colored "&4&lASSAULT %{_a}%" with subtitle colored "&cThe cops are moving in" to {_p} for 2 seconds
		play sound "event.raid.horn" with volume 0.5 and pitch 1.1 to {_p}
	else if {_kind} is "break":
		play sound "block.note_block.chime" with volume 0.8 and pitch 1.2 to {_p}
	else if {_kind} is "wanted":
		send title colored "&4&lWANTED" with subtitle colored "&cYou shot a cop" to {_p} for 3 seconds
		play sound "block.bell.use" with volume 1 and pitch 0.8 to {_p}
	else if {_kind} is "evict":
		play sound "entity.villager.no" with volume 0.8 to {_p}
	else if {_kind} is "lost-cops":
		play sound "entity.player.levelup" with volume 0.6 and pitch 1.4 to {_p}
