# ranks.sk: paid ranks (CLAUDE.md, Monetization). Built 2026-09-26 (owner: "make separate monetized ranks
# that show next to tab list (higher ranks are higher on the tab list)"). Robber levels are levels.sk.
#
# Cosmetic only, never an advantage: a rank is a tag before your name in the tab list, in chat and in
# join messages, and a spot higher in the tab list (TAB sorts staff first, then these ranks, highest
# first, then the biggest bounty, then A-Z).
# Each rank is a LuckPerms group (core.sk paidrank::<id>::name|prefix|weight, PROPOSAL; the owner sets
# names and prices): its weight orders it and is also its prefix's priority, so a player with two ranks
# shows the higher one, and staff prefixes (weight 100) beat every paid one.
#   /dranks setup                   creates or updates the groups from core.sk (run it once on a new
#                                   server, e.g. Minehut, and after changing a rank there)
#   /dranks give <player> <id|none> takes away every other paid rank, then adds that one (a store runs
#                                   this from the console when someone buys a rank)
#   /dranks list                    who online has which rank
# Players: /ranks (the ranks, their tags, yours). Log: plugins\Skript\logs\ranks.log.
# LuckPerms runs its commands asynchronously: a change shows a moment later (TAB follows LuckPerms).

function rankLog(text: text):
	log {_text} to "ranks"

# The highest paid rank the player has ("" for none), by their LuckPerms groups (Vault). LuckPerms
# gives Vault the groups' display names (its vault-group-use-displaynames), so a group matches by its id
# or by its name ("vipplus" or "VIP+").
function paidRank(p: offline player) :: text:
	set {_g::*} to groups of {_p}
	set {_best} to ""
	set {_bw} to -1
	loop {-cfg::paidranks::*}:
		set {_id} to loop-value
		set {_nm} to cfg("paidrank::%{_id}%::name")
		loop {_g::*}:
			set {_hit} to false
			if loop-value-2 is {_id}:
				set {_hit} to true
			else if loop-value-2 is {_nm}:
				set {_hit} to true
			if {_hit} is true:
				set {_w} to cfg("paidrank::%{_id}%::weight")
				if {_w} > {_bw}:
					set {_bw} to {_w}
					set {_best} to {_id}
	return {_best}

# The tag ("&6[Elite]"), or "" for none.
function paidRankTag(id: text) :: text:
	if {_id} is "":
		return ""
	set {_t} to cfg("paidrank::%{_id}%::prefix")
	if {_t} is set:
		return {_t}
	return ""

command /ranks:
	description: The server's ranks.
	executable by: players
	trigger:
		msg(player, "&6Ranks &7(cosmetic: they support the server)")
		# Highest first, like the tab list (core.sk lists them that way).
		loop {-cfg::paidranks::*}:
			set {_id} to loop-value
			set {_name} to cfg("paidrank::%{_id}%::name")
			set {_tag} to cfg("paidrank::%{_id}%::prefix")
			send colored "&8 » %{_tag}%&r &f%{_name}%" to player
		send colored "&7 A rank puts its tag before your name in the tab list and in chat, and moves you up the tab list. Nothing else: no money, guns or bags." to player
		set {_mine} to paidRank(player)
		if {_mine} is "":
			send colored "&7 Yours: &fnone yet. &8Store: coming soon." to player
		else:
			set {_name} to cfg("paidrank::%{_mine}%::name")
			send colored "&7 Yours: %paidRankTag({_mine})%&r &f%{_name}%&7. Thank you!" to player
		send colored "&8 Your robber level (from selling loot) is something else: /level" to player

# ---------- Staff: /dranks ----------

function drankReply(s: command sender, text: text):
	send "%{_text}%" to {_s}

command /dranks [<text>]:
	permission: donating.staff
	permission message: &cStaff only.
	trigger:
		set {_a::*} to arg-1 split at " "
		set {_sub} to {_a::1}
		if {_sub} is "setup":
			loop {-cfg::paidranks::*}:
				set {_id} to loop-value
				set {_w} to cfg("paidrank::%{_id}%::weight")
				set {_prefix} to cfg("paidrank::%{_id}%::prefix")
				set {_name} to cfg("paidrank::%{_id}%::name")
				execute console command "lp creategroup %{_id}%"
				execute console command "lp group %{_id}% setweight %{_w}%"
				execute console command "lp group %{_id}% setdisplayname %{_name}%"
				execute console command "lp group %{_id}% meta setprefix %{_w}% ""%{_prefix}%"""
			rankLog("setup by=%sender%")
			drankReply(sender, "RANKS setup: %size of {-cfg::paidranks::*}% LuckPerms groups created/updated (LuckPerms finishes it a moment later)")
			stop
		if {_sub} is "list":
			loop all players:
				set {_r} to paidRank(loop-player)
				if {_r} is not "":
					drankReply(sender, "RANKS %name of loop-player% %{_r}%")
			drankReply(sender, "RANKS end")
			stop
		if {_sub} is "give":
			set {_p} to {_a::2} parsed as offline player
			set {_id} to {_a::3}
			if {_p} is not set:
				drankReply(sender, "RANKS give: /dranks give <player> <rank|none>")
				stop
			if {_id} is not set:
				drankReply(sender, "RANKS give: /dranks give <player> <rank|none>")
				stop
			if {_id} is not "none":
				if cfg("paidrank::%{_id}%::name") is not set:
					set {_all} to join {-cfg::paidranks::*} with ", "
					drankReply(sender, "RANKS give: no rank %{_id}% (ranks: %{_all}%, or none)")
					stop
			# One paid rank at a time: the others go first. By UUID: LuckPerms only knows the names of
			# players who joined, and a store may sell a rank to someone who hasn't yet.
			set {_u} to "%uuid of {_p}%"
			loop {-cfg::paidranks::*}:
				if loop-value is not {_id}:
					execute console command "lp user %{_u}% parent remove %loop-value%"
			if {_id} is not "none":
				execute console command "lp user %{_u}% parent add %{_id}%"
			rankLog("give %{_a::2}% %uuid of {_p}% %{_id}% by=%sender%")
			drankReply(sender, "RANKS %{_a::2}% -> %{_id}%")
			stop
		drankReply(sender, "RANKS usage: /dranks setup | give <player> <rank|none> | list")
