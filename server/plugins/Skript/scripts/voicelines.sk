# voicelines.sk: GENERATED by tools\make-voice-lines.js from tools\voicelines.json. Do not edit: change the table and run
# the tool again (it also makes the OGGs and the pack's donating.voice.<clip> events).
# Each recorded line is found by its speaker (messages.sk's msgKey of the name: "lefty") and the exact words the
# recording says, so a line changed in a script finds no clip and plays nothing, never the old words (the tool's
# report lists it as stale). voice.sk plays the clips (voiceSay, from messages.sk's msgSpeak).

# The clip for a line ("" = none).
function voiceClip(who: text, line: text) :: text:
	if {_who} is "lefty":
		if {_line} is "New fish? Come sit with me in Hall B. Free advice.":
			return "lefty_meet"
		if {_line} is "Nobody stays in here forever.":
			return "lefty_nobody_stays"
		if {_line} is "Three ways past the fences: a keycard through the police station, C4 on the vehicle gate, or over the fence by the Gun Shop.":
			return "lefty_three_ways"
		if {_line} is "Then the lot. The front gate opens from the gatehouse booth: a keycard gets you in, or punch its fuse box when the guards look away.":
			return "lefty_the_lot"
		if {_line} is "First, get yourself sorted.":
			return "lefty_get_sorted"
		if {_line} is "Putty in the workshop, wires in the supply closet, a timer in the infirmary: hold right-click to search each. Bring me all three and I put it together.":
			return "lefty_c4_brief"
		if {_line} is "Careful with that. The vehicle gate by the plaza: hold right-click on it to plant it, and you're in the lot.":
			return "lefty_c4_done"
		if {_line} is "Knock a guard down, or ask Rusty in B1: he trades for donuts.":
			return "lefty_card_brief"
		if {_line} is "Knew you had it in you. Mara runs things out there: find her.":
			return "lefty_out_done"
		if {_line} is "Give me those. There: hold right-click on the vehicle gate by the plaza, then get clear.":
			return "lefty_c4_assemble"
		if {_line} is "Four marks round the yard. Touch them in order; the clock starts at the first.":
			return "lefty_yardrun"
		if {_line} is "One at a time. Use the one you've got.":
			return "lefty_one_at_a_time"
		if {_line} is "Free up a hand first.":
			return "lefty_free_hand"
		if {_line} is "Mm, chocolate.":
			return "lefty_chocolate"
		if {_line} is "You're not done down there yet.":
			return "lefty_not_done"
		if {_line} is "Got it. Whisper sends his regards, huh.":
			return "lefty_got_note"
		if {_line} is "Or skip the gate: there's a hole by the lot's west fence. Dig under it.":
			return "lefty_skip_gate"
		if {_line} is "So which way? Talk to me and pick one: I'll walk you through it. And do the odd job for the others in here: it's a head start.":
			return "lefty_way_brief"
		if {_line} is "The vehicle gate by the plaza: hold right-click on it with the C4 in hand. Five seconds, get clear, then through the hole before they rebuild it.":
			return "lefty_c4lot_brief"
		if {_line} is "The station's yard door opens as your card walks up. Through the lobby, out the south door: that's the lot. The desk guard watches the doors.":
			return "lefty_police_brief"
		if {_line} is "The box by the gate between the Gun Shop and the police station: punch it ten times when no guard's near, or show it a keycard. The gate slides open; the crates in the annex take you over the fence.":
			return "lefty_parkour_brief"
		if {_line} is "First the lot. No card? The quiet way is the parkour: punch the box by the gate between the Gun Shop and the police station, then over the annex fence.":
			return "lefty_diglot_brief"
		if {_line} is "West end of the lot, by the fence: down the ladder, hold right-click on the dirt under the fence, and out the other side before it caves in.":
			return "lefty_dig_brief"
		if {_line} is "C4 it is. Find me the putty, the wires and a timer.":
			return "lefty_way_c4"
		if {_line} is "A card, then. Get one, and the police station's your door.":
			return "lefty_way_card"
		if {_line} is "Over the fence. Watch for guards near that box.":
			return "lefty_way_parkour"
		if {_line} is "Digging. Get into the lot first; the hole's by the west fence.":
			return "lefty_way_dig"
		if {_line} is "The police station's yard door, the Gun Shop and the gatehouse all open for it.":
			return "lefty_card_done"
		if {_line} is "That's everything I know. In the lot, open the front gate from the booth, or climb the ladder over the south fence, and go.":
			return "lefty_out_brief"
	else if {_who} is "rusty":
		if {_line} is "Took you long enough. Name's Rusty.":
			return "rusty_took_long"
		if {_line} starts with "Here, a knife.":
			return "rusty_knife"
		if {_line} is "Your phone's in slot 9: press 9 and right-click to open the map. Out in the city it's your GPS; F opens the apps. The door opens from in here when you walk up to it.":
			return "rusty_phone"
		if {_line} is "Good. The Security Office is down the hall, same keycard. Up the ladder and you're in the main block.":
			return "rusty_security"
		if {_line} is "Bring me a donut from the cafeteria counter. I make it worth your while.":
			return "rusty_donut_ask"
		if {_line} is "Ahh. Here.":
			return "rusty_trade"
		if {_line} is "Do what I said.":
			return "rusty_do_what_i_said"
		if {_line} is "Got it. Whisper sends his regards, huh.":
			return "rusty_got_note"
	else if {_who} is "tank":
		if {_line} is "Get the guards on your tail, then shake them. I need them looking the other way.":
			return "tank_distraction"
		if {_line} is "You're not done down there yet.":
			return "tank_not_done"
		if {_line} is "Got it. Whisper sends his regards, huh.":
			return "tank_got_note"
	else if {_who} is "whisper":
		if {_line} is "Somebody hid a stash in the yard. Bring it to me, and keep it away from the guards.":
			return "whisper_stash"
		if {_line} is "Nice. Here's your cut.":
			return "whisper_cut"
		if {_line} is "You're not done down there yet.":
			return "whisper_not_done"
	else if {_who} is "mara":
		if {_line} is "New in town? I've got work for someone with nerve. Come see me at the Safehouse.":
			return "mara_meet_brief"
		if {_line} is "Heard you broke out. Nice. I've got work for someone with nerve: come see me at the Safehouse.":
			return "mara_meet_escaped"
		if {_line} is "So you're the new face.":
			return "mara_new_face"
		if {_line} is "No bag, no gun, no ride. Let's fix that.":
			return "mara_no_bag"
		if {_line} is "Here's a lockpick. The Scrap Yard Boss pays cash for cars: go see him.":
			return "mara_lockpick"
		if {_line} is "Your hands hold $1,000 of loot at most. A Gym Bag holds $2,000: get one at the Bag Shop.":
			return "mara_bag_brief"
		if {_line} is "Now you can carry a real haul.":
			return "mara_bag_done"
		if {_line} is "Level 5: the Gun Shop will sell you a Classic Pistol now. Time to trade up from the knife.":
			return "mara_gun_brief"
		if {_line} is "Nice. Now let's put it to use.":
			return "mara_gun_done"
		if {_line} is "Stores are easy money for new faces: no clock. Smack the clerk, grab the register, and duck whatever they throw at you.":
			return "mara_rob_brief"
		if {_line} is "That's the spirit. Now get out of there.":
			return "mara_rob_done"
		if {_line} is "Loot's worth nothing in a bag. Take it to the base: your GPS knows the way.":
			return "mara_sell_brief"
		if {_line} is "Cash in hand. Feels good, huh? Here's a crate key for your trouble.":
			return "mara_sell_done"
		if {_line} is "Guns need a name on the street: level 5. Until then, a knife from the Gun Shop.":
			return "mara_knife_brief"
		if {_line} is "Keep it sharp.":
			return "mara_knife_done"
		if {_line} is "Use that key at a crate stand. And grab /daily every day: free keys.":
			return "mara_crate_brief"
		if {_line} is "Lucky you.":
			return "mara_crate_done"
		if {_line} is "Keep robbing and selling. Level 5 opens your first gun, the Safe Kit, Street jobs, the Duffel Bag and the medium heists.":
			return "mara_level_brief"
		if {_line} is "Level 5 already? Come by the Safehouse. I've got something for you.":
			return "mara_end_brief"
		if {_line} is "You've got talent. Most rookies don't make it this far.":
			return "mara_talent"
		if {_line} is "Safes hold the good stuff. Here's a Safe Kit: guess the code, green means right.":
			return "mara_safes"
	else if {_who} is "sparks":
		if {_line} is "Sharp end out. You didn't get it from me.":
			return "sparks_shiv"
		if {_line} is "Keep 'em at arm's length. Longer than that, even.":
			return "sparks_spear"
		if {_line} is "Heavy. Swing it like you mean it.":
			return "sparks_club"
	return ""

