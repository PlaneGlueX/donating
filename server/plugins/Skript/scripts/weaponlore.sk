	if {_w} is "Uzi":
		return "&7A full-auto SMG with a curved magazine.", "&7Fast, steady and easy to control.", "&r", "&7Weapon Statistics &6-&7 64.5", "&6➣&7 61 &6⟸ &7Accuracy", "&6➣&7 67 &6⟸ &7Damage", "&6➣&7 49 &6⟸ &7Range", "&6➣&7 64 &6⟸ &7Fire Rate", "&6➣&7 74 &6⟸ &7Mobility" and "&6➣&7 72 &6⟸ &7Control"
	if {_w} is "STG44":
		return "&7A drum-fed tommy gun with a wooden stock.", "&7A 50-round drum and steady full-auto.", "&r", "&7Weapon Statistics &6-&7 65.8", "&6➣&7 66 &6⟸ &7Accuracy", "&6➣&7 72 &6⟸ &7Damage", "&6➣&7 58 &6⟸ &7Range", "&6➣&7 57 &6⟸ &7Fire Rate", "&6➣&7 72 &6⟸ &7Mobility" and "&6➣&7 70 &6⟸ &7Control"
	if {_w} is "R9_0":
		return "&7A short pump shotgun with a pistol grip.", "&7Loads one shell at a time; deadly up close.", "&r", "&7Weapon Statistics &6-&7 62.0", "&6➣&7 55 &6⟸ &7Accuracy", "&6➣&7 79 &6⟸ &7Damage", "&6➣&7 42 &6⟸ &7Range", "&6➣&7 51 &6⟸ &7Fire Rate", "&6➣&7 71 &6⟸ &7Mobility" and "&6➣&7 74 &6⟸ &7Control"
	if {_w} is "M4A1":
