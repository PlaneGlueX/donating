	if {_w} is "50_GS":
		return "&7A chunky chrome pistol with a leather grip.", "&7Semi-automatic; quick to reload.", "&r", "&7Weapon Statistics &6-&7 60.2", "&6➣&7 54 &6⟸ &7Accuracy", "&6➣&7 65 &6⟸ &7Damage", "&6➣&7 52 &6⟸ &7Range", "&6➣&7 53 &6⟸ &7Fire Rate", "&6➣&7 77 &6⟸ &7Mobility" and "&6➣&7 60 &6⟸ &7Control"
	if {_w} is "357_Magnum":
