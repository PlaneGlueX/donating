# weaponlore.sk: GENERATED by tools\make-weapon-lore.js from the WeaponMechanics files: never edit it by hand.
# After changing a sold weapon's or consumable's lore (Info.Weapon_Item.Lore in plugins\WeaponMechanics\weapons\)
# or core.sk's shop::weapons / shop::consumables, run tools\node\node.exe tools\make-weapon-lore.js and
# /sk reload weaponlore (--check tells whether this file is up to date; bots\run.js shop runs it).
#
# wpnLore(title) = that weapon's own lore (what it is and its stats) in & colors, for the shop's hover details
# (shop.sk's Weapons tab and the Items tab's consumables; owner, 2026-10-13: "display weapon and consumable details
# while hovering over the item in the shop page"). Empty lines are &r. A title it doesn't know returns nothing.
# A pure function: no variables, so it can be called from anywhere.

function wpnLore(w: text) :: texts:
	if {_w} is "Combat_Knife":
		return "&7Short, quick and simple: the street's starter blade.", "&r", "&7Weapon Statistics", "&6➣&7 5 &6⟸ &7Damage", "&6➣&7 1 &6⟸ &7Hits per second" and "&6➣&7 4 &6⟸ &7Range in blocks"
	if {_w} is "Baseball_Bat":
		return "&7Slow, heavy swings that knock people back.", "&r", "&7Weapon Statistics", "&6➣&7 5 &6⟸ &7Damage", "&6➣&7 0.7 &6⟸ &7Hits per second", "&6➣&7 4 &6⟸ &7Range in blocks" and "&6➣&7 High &6⟸ &7Knockback"
	if {_w} is "Brass_Knuckles":
		return "&7A brass duster over a tactical glove.", "&7Quick jabs, but only at arm's length.", "&r", "&7Weapon Statistics", "&6➣&7 3.5 &6⟸ &7Damage", "&6➣&7 1.7 &6⟸ &7Hits per second" and "&6➣&7 3 &6⟸ &7Range in blocks"
	if {_w} is "Dagger":
		return "&7A long blade with a red-wrapped hilt.", "&7The longest reach of any melee.", "&r", "&7Weapon Statistics", "&6➣&7 5 &6⟸ &7Damage", "&6➣&7 1.25 &6⟸ &7Hits per second" and "&6➣&7 4.5 &6⟸ &7Range in blocks"
