	if {_w} is "AK_47":
		return "&7A scoped rifle with a laser and an underbarrel tube.", "&7Full-auto and the hardest hitter in town.", "&r", "&7Weapon Statistics &6-&7 66.5", "&6➣&7 68 &6⟸ &7Accuracy", "&6➣&7 76 &6⟸ &7Damage", "&6➣&7 67 &6⟸ &7Range", "&6➣&7 61 &6⟸ &7Fire Rate", "&6➣&7 59 &6⟸ &7Mobility" and "&6➣&7 68 &6⟸ &7Control"
	if {_w} is "AX_50":
		return "&7A long wooden bolt-action rifle with a big scope.", "&7Bolt-action; the scope zooms in twice.", "&r", "&7Weapon Statistics &6-&7 66.3", "&6➣&7 82 &6⟸ &7Accuracy", "&6➣&7 85 &6⟸ &7Damage", "&6➣&7 79 &6⟸ &7Range", "&6➣&7 38 &6⟸ &7Fire Rate", "&6➣&7 44 &6⟸ &7Mobility" and "&6➣&7 70 &6⟸ &7Control"
	if {_w} is "MG34":
		return "&7A WWII light machine gun on a bipod.", "&7A 50-round magazine; it holds up at range.", "&r", "&7Weapon Statistics &6-&7 59.8", "&6➣&7 60 &6⟸ &7Accuracy", "&6➣&7 66 &6⟸ &7Damage", "&6➣&7 74 &6⟸ &7Range", "&6➣&7 57 &6⟸ &7Fire Rate", "&6➣&7 40 &6⟸ &7Mobility" and "&6➣&7 62 &6⟸ &7Control"
	if {_w} is "FN_FAL":
