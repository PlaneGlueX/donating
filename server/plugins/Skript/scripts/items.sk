# items.sk: rules for the melee weapons and consumables of 2026-09-28 (owner: "more melee weapons/consumables") that
# WeaponMechanics can't express. Built from the abuse review (2026-09-28).
#
# Energy Drink (WeaponMechanics consumable Energy_Drink: Speed II for 3 s since the owner's test, 2026-09-28):
#   - never inside a heist: drinking there is refused, and entering one takes Speed off (heists.sk's heistOnEnter
#     calls itemsOnEnter). Speed crossed collapsing floors built to be uncrossable, and camera cones.
# Pipe Wrench (WeaponMechanics title Baseball_Bat; the Baseball Bat until 2026-10-13): its knockback lives here (it
# was MechanicsCore's Push in Baseball_Bat.yml). Only hits that land (priority monitor), never on a cop or another NPC
# (2026-10-13), and never when the victim is in a heist or would be shoved into one (outsiders pushed robbers into
# armor-ignoring traps, and bystanders into a heist whose alarm then hunted them).
# Gold Nunchucks (WeaponMechanics title Gold_Nunchucks, 2026-10-13): a burst of gold dust on every hit that lands (its
# cash-register sound is in Gold_Nunchucks.yml). Only hits that land (priority monitor), only between real players.

# ---------- Energy Drink ----------

on right click with priority lowest:
	wmTitle(player's tool) is "Energy_Drink"
	heistOf(player) is not ""
	cancel event
	hudBar(player, "&cNo energy drinks inside a heist.", 2)

function itemsOnEnter(p: player, h: text):
	{_p} has speed
	remove speed from {_p}
	hudBar({_p}, "&7Your energy drink wore off at the door.", 1)

# ---------- Pipe Wrench (WeaponMechanics title Baseball_Bat) ----------

on damage of player with priority monitor:
	attacker is a player
	attacker is not victim
	isNpc(attacker) is false
	isNpc(victim) is false
	wmTitle(attacker's tool) is "Baseball_Bat"
	# A melee hit only: a bullet or thrown knife that lands after switching to the wrench is "projectile".
	damage cause is attack
	heistOf(victim) is ""
	set {_ax} to x-coordinate of attacker
	set {_az} to z-coordinate of attacker
	set {_vx} to x-coordinate of victim
	set {_vz} to z-coordinate of victim
	set {_dx} to {_vx} - {_ax}
	set {_dz} to {_vz} - {_az}
	set {_len} to sqrt({_dx} * {_dx} + {_dz} * {_dz})
	{_len} > 0.01
	set {_ux} to {_dx} / {_len}
	set {_uz} to {_dz} / {_len}
	# Where the shove would carry them (about 3.5 blocks): no heist on the way.
	set {_ok} to true
	loop 1, 2, 3 and 4:
		set {_c} to (location of victim) ~ vector({_ux} * loop-value, 0.5, {_uz} * loop-value)
		if heistAt({_c}) is not "":
			set {_ok} to false
	{_ok} is true
	wait 1 tick
	victim is alive
	set velocity of victim to vector({_ux} * cfg("bat::knockback"), cfg("bat::lift"), {_uz} * cfg("bat::knockback"))

# ---------- Gold Nunchucks (WeaponMechanics title Gold_Nunchucks) ----------
# A burst of gold on every hit that lands (priority monitor: a cancelled hit, like one on a passive player or in a safe
# zone, never gets here). Only on real players: a hit contract's target and bodyguards are seen by their hunter alone,
# and particles would show everyone else where they are. The cash-register sound is the weapon file's.

on damage of player with priority monitor:
	attacker is a player
	attacker is not victim
	isNpc(attacker) is false
	isNpc(victim) is false
	wmTitle(attacker's tool) is "Gold_Nunchucks"
	# A melee hit only: a bullet or thrown knife that lands after switching to the nunchucks is "projectile".
	damage cause is attack
	set {_l} to (location of victim) ~ vector(0, 1.2, 0)
	draw 10 rgb(255, 212, 64) dust particles of size 1.1 with offset vector(0.3, 0.35, 0.3) at {_l}
	draw 6 rgb(214, 158, 30) dust particles of size 0.8 with offset vector(0.4, 0.45, 0.4) at {_l}

# ---------- Melee specials (owner, 2026-11-10: "make melees more desirable since guns are op, so like have each melee
# have its own special effect") ----------
# Only melee hits that land (priority monitor) between real players, like the wrench's knockback. PROPOSAL numbers:
#   Combat Knife    bleed: 3 more ticks of 1 damage, a second apart (never the killing blow: it stops at 1 heart)
#   Pipe Wrench     daze: Slowness I for 2 s (with its knockback above)
#   Brass Knuckles  stagger: every 3rd hit in a row on the same player (each within 4 s) slows them nearly to a stop
#   Katana          lunge: its swinger gets Speed I for 2 s
#   Gold Nunchucks  jackpot: every 4th hit in a row on the same player hits for 1.5 more
on damage of player with priority monitor:
	attacker is a player
	attacker is not victim
	isNpc(attacker) is false
	isNpc(victim) is false
	damage cause is attack
	set {_w} to wmTitle(attacker's tool)
	if {_w} is "Combat_Knife":
		meleeBleed(victim)
	else if {_w} is "Baseball_Bat":
		apply potion effect of slowness of tier 1 to victim for 2 seconds
	else if {_w} is "Brass_Knuckles":
		if meleeCombo(attacker, victim, 3) is true:
			apply potion effect of slowness of tier 5 to victim for 15 ticks
			play sound "entity.player.attack.strong" with volume 1 and pitch 0.6 at victim
			draw 12 crit particles with offset vector(0.3, 0.4, 0.3) at (location of victim) ~ vector(0, 1.6, 0)
	else if {_w} is "Dagger":
		apply potion effect of speed of tier 1 to attacker for 2 seconds
	else if {_w} is "Gold_Nunchucks":
		if meleeCombo(attacker, victim, 4) is true:
			wait 1 tick
			victim is alive
			damage victim by 0.75
			play sound "block.note_block.bell" with volume 1 and pitch 1.6 at victim
			draw 20 rgb(255, 212, 64) dust particles of size 1.4 with offset vector(0.5, 0.6, 0.5) at (location of victim) ~ vector(0, 1.2, 0)

# True on every n-th hit in a row by a on v (each within 4 s of the last), then counts again from 0.
function meleeCombo(a: player, v: player, n: number) :: boolean:
	set {_k} to "%uuid of {_a}%>%uuid of {_v}%"
	set {_last} to {-melee::comboat::%{_k}%}
	set {_c} to {-melee::combo::%{_k}%}
	if {_c} is not set:
		set {_c} to 0
	if {_last} is set:
		if difference between {_last} and now > 4 seconds:
			set {_c} to 0
	add 1 to {_c}
	set {-melee::comboat::%{_k}%} to now
	if {_c} >= {_n}:
		delete {-melee::combo::%{_k}%}
		return true
	set {-melee::combo::%{_k}%} to {_c}
	return false

# The knife's bleed: a new cut while bleeding starts the 3 ticks over (no stacking).
function meleeBleed(v: player):
	set {_u} to "%uuid of {_v}%"
	set {-melee::bleed::%{_u}%} to 3
	{-melee::bleeding::%{_u}%} is not set
	set {-melee::bleeding::%{_u}%} to true
	while {-melee::bleed::%{_u}%} > 0:
		wait 1 second
		if {_v} is not online:
			delete {-melee::bleed::%{_u}%}
		else if {_v} is dead:
			delete {-melee::bleed::%{_u}%}
		else:
			remove 1 from {-melee::bleed::%{_u}%}
			draw 8 rgb(170, 20, 20) dust particles of size 1 with offset vector(0.25, 0.4, 0.25) at (location of {_v}) ~ vector(0, 1, 0)
			if health of {_v} > 1.5:
				damage {_v} by 0.5
	delete {-melee::bleeding::%{_u}%}
	delete {-melee::bleed::%{_u}%}

on quit:
	delete {-melee::bleed::%uuid of player%}
