# boosters.sk: server-wide boosters (CLAUDE.md, Monetization). Built 2026-09-26 (money); XP and Heist Rush
# added 2026-09-27 (owner: "want to add other boosters so i can make a booster category in the tebex").
#
# Someone buys a booster (Tebex runs "dbooster add <player> <kind> <multiplier> <minutes> [count]" from the
# console; the old "dbooster add <player> <multiplier> <minutes> [count]" is a money booster). While it runs,
# for everyone on the server:
#   money  every loot sale at the base pays P' = floor(P × b), the buyer's own floor(P × (b + buyer-bonus))
#          (owner, 2026-09-26: "someone buys 1.5x money for the server for 30 mins and since they bought it
#          for everyone they get 2x instead of 1.5x"). P is the normal pay (passive players' 75% included);
#          level XP, the robbery bounty and season scores come from P, not P'.
#   xp     robber-level XP from selling loot and car contracts is × b, the buyer's × (b + buyer-bonus).
#   rush   Heist Rush: heists cool down b times faster (a cooldown that runs out while it lasts is cooldown / b;
#          cooldowns already running when it starts are shortened the same way). Nobody gets more than anyone
#          else: no buyer bonus (like Heist Refresh, it's balanced for everyone).
# The buyer bonuses affect gameplay: they're listed in MONETIZATION.md, the disclosure for Minehut.
# One booster of each kind runs at a time; more of that kind queue behind it (a money and an XP booster can run
# together). The time only runs while someone is online (Minehut sleeps an empty server). Everyone sees them in
# the tab-list footer; the start and the end are announced to everyone.
# Saved (a paid booster survives restarts and sleep), per kind k with the prefix boosterKey(k) ("" for money,
# "<k>::" for the rest): {booster::<prefix>active} = "<name>|<uuid>|<b>", {booster::<prefix>left} = seconds
# left, {booster::<prefix>queue::<n>} = "<name>|<uuid>|<b>|<seconds>".
# Staff: /dbooster add|stop|clear|info. Players: /booster. Log: plugins\Skript\logs\boosters.log.

function boosterLog(text: text):
	log {_text} to "boosters"

function boosterIsKind(k: text) :: boolean:
	loop {-cfg::booster::kinds::*}:
		if loop-value is {_k}:
			return true
	return false

# The variables' prefix: the money booster keeps its first names ({booster::active}, ...).
function boosterKey(k: text) :: text:
	if {_k} is "money":
		return ""
	return "%{_k}%::"

# b while a booster of that kind runs, else 1.
function boosterMultiplierOf(k: text) :: number:
	set {_a} to {booster::%boosterKey({_k})%active}
	if {_a} is not set:
		return 1
	set {_parts::*} to {_a} split at "|"
	set {_b} to {_parts::3} parsed as number
	if {_b} is set:
		return {_b}
	return 1

function boosterMultiplier() :: number:
	return boosterMultiplierOf("money")

# The UUID of the running booster's buyer, or "".
function boosterBuyerOf(k: text) :: text:
	set {_a} to {booster::%boosterKey({_k})%active}
	if {_a} is not set:
		return ""
	set {_parts::*} to {_a} split at "|"
	return {_parts::2}

function boosterBuyer() :: text:
	return boosterBuyerOf("money")

# The multiplier for this player: b, plus the kind's buyer bonus for whoever bought it.
function boosterForKind(p: player, k: text) :: number:
	set {_b} to boosterMultiplierOf({_k})
	if {_b} <= 1:
		return 1
	if boosterBuyerOf({_k}) is "%uuid of {_p}%":
		set {_bonus} to {-cfg::booster::%{_k}%::buyer-bonus}
		if {_bonus} is set:
			return {_b} + {_bonus}
	return {_b}

# The money booster for a player's sale (bag.sk).
function boosterFor(p: player) :: number:
	return boosterForKind({_p}, "money")

# "1.5×" (no trailing zeros).
function boosterText(b: number) :: text:
	return "%{_b}%×"

# What a booster does, for messages: "1.5× money", "2× XP", "Heist Rush (2× faster)".
function boosterWhat(k: text, b: number) :: text:
	if {_k} is "rush":
		return "Heist Rush (%boosterText({_b})% faster)"
	return "%boosterText({_b})% %{-cfg::booster::%{_k}%::name}%"

# Starts the next queued booster of a kind if none of it runs.
function boosterNext(k: text):
	set {_key} to boosterKey({_k})
	{booster::%{_key}%active} is not set
	set {_keys::*} to indices of {booster::%{_key}%queue::*}
	{_keys::1} is set
	set {_q} to {booster::%{_key}%queue::%{_keys::1}%}
	delete {booster::%{_key}%queue::%{_keys::1}%}
	set {_parts::*} to {_q} split at "|"
	set {booster::%{_key}%active} to "%{_parts::1}%|%{_parts::2}%|%{_parts::3}%"
	set {booster::%{_key}%left} to {_parts::4} parsed as number
	set {_b} to {_parts::3} parsed as number
	set {_clock} to formatClock({booster::%{_key}%left})
	boosterLog("start %{_k}% %{_parts::1}% %{_parts::2}% b=%{_b}% seconds=%{booster::%{_key}%left}%")
	if {_k} is "rush":
		broadcastMsg("&6⚡ %{_parts::1}% started a &dHeist Rush&6: heists reopen %boosterText({_b})% faster for everyone! &e(%{_clock}%) &7Thank you!")
		heistRushStart({_b})
	else:
		broadcastMsg("&6⚡ %{_parts::1}% started a %boosterWhat({_k}, {_b})% booster for everyone! &e(%{_clock}%) &7Thank you!")
	loop all players:
		play sound "entity.player.levelup" with volume 0.7 and pitch 1.2 to loop-player
	boosterPlaceholder()

function boosterEnd(k: text, why: text):
	set {_key} to boosterKey({_k})
	{booster::%{_key}%active} is set
	set {_parts::*} to {booster::%{_key}%active} split at "|"
	boosterLog("end %{_k}% %{_parts::1}% %{_parts::2}% why=%{_why}% left=%{booster::%{_key}%left}%")
	delete {booster::%{_key}%active}
	delete {booster::%{_key}%left}
	if {_k} is "rush":
		broadcastMsg("&7The Heist Rush from &f%{_parts::1}% &7ended.")
	else:
		broadcastMsg("&7The %{-cfg::booster::%{_k}%::name}% booster from &f%{_parts::1}% &7ended.")
	boosterNext({_k})
	boosterPlaceholder()

# The footer line for everyone (placeholders.sk reads memory only): every booster running.
function boosterPlaceholder():
	loop {-cfg::booster::kinds::*}:
		set {_key} to boosterKey(loop-value)
		set {_a} to {booster::%{_key}%active}
		if {_a} is set:
			set {_parts::*} to {_a} split at "|"
			set {_b} to {_parts::3} parsed as number
			add "&6⚡ %boosterWhat(loop-value, {_b})% for everyone &7· &e%formatClock({booster::%{_key}%left})% &7· thanks &f%{_parts::1}%" to {_lines::*}
	if size of {_lines::*} is 0:
		delete {-ph::booster}
		stop
	set {-ph::booster} to join {_lines::*} with " &8| "

# Boosters saved under the first money names before kinds existed stay money boosters (same names).
# The time runs only while someone's online.
every second:
	set {_online} to false
	if size of all players > 0:
		set {_online} to true
	loop {-cfg::booster::kinds::*}:
		set {_k} to loop-value
		set {_key} to boosterKey({_k})
		if {booster::%{_key}%active} is not set:
			boosterNext({_k})
		else if {_online} is true:
			remove 1 from {booster::%{_key}%left}
			if {booster::%{_key}%left} <= 0:
				boosterEnd({_k}, "time")
	boosterPlaceholder()

on load:
	boosterPlaceholder()

command /booster:
	description: The boosters running now and the ones queued.
	aliases: /boosters
	executable by: players
	trigger:
		set {_any} to false
		loop {-cfg::booster::kinds::*}:
			set {_k} to loop-value
			set {_key} to boosterKey({_k})
			if {booster::%{_key}%active} is set:
				set {_any} to true
				set {_parts::*} to {booster::%{_key}%active} split at "|"
				set {_b} to {_parts::3} parsed as number
				if {_k} is "money":
					msg(player, "&6⚡ %boosterText({_b})% money for everyone &7· &e%formatClock({booster::%{_key}%left})% &7· thanks &f%{_parts::1}%")
				else:
					msg(player, "&6⚡ %boosterWhat({_k}, {_b})% for everyone &7· &e%formatClock({booster::%{_key}%left})% &7· thanks &f%{_parts::1}%")
				set {_mine} to boosterForKind(player, {_k})
				if {_mine} is not {_b}:
					send colored "&7 Yours: &e%boosterText({_mine})% &7(buyer)" to player
				set {_n} to size of {booster::%{_key}%queue::*}
				if {_n} > 0:
					send colored "&7 %{_n}% more queued" to player
		if {_any} is false:
			msg(player, "&7No booster right now. &f/store")

function dboosterReply(s: command sender, text: text):
	send "%{_text}%" to {_s}

# "" when the kind (or "money" when none is given) is known, else why not.
function dboosterKindArg(a: text) :: text:
	if {_a} is "":
		return "money"
	if boosterIsKind({_a}) is true:
		return {_a}
	return ""

# Only the owner and the console (Tebex) may grant a paid perk: its own permission, not staff's.
command /dbooster [<text>]:
	permission: donating.store
	permission message: &cOnly the owner and the store can do that.
	trigger:
		set {_a::*} to arg-1 split at " "
		set {_sub} to {_a::1}
		set {_usage} to "BOOSTER add: /dbooster add <player> <money|xp|rush> <multiplier> <minutes> [count]"
		if {_sub} is "add":
			# A refused paid delivery must leave a trace (Tebex counts it as delivered).
			boosterLog("add-request %arg-1% by=%sender%")
			set {_p} to {_a::2} parsed as offline player
			# The kind is optional (the first booster command had none: a money booster).
			set {_k} to "money"
			set {_i} to 3
			if {_a::3} is set:
				set {_n3} to {_a::3} parsed as number
				if {_n3} is not set:
					set {_k} to {_a::3}
					set {_i} to 4
			if boosterIsKind({_k}) is false:
				boosterLog("refused %arg-1% by=%sender% reason=kind")
				dboosterReply(sender, {_usage})
				stop
			set {_b} to {_a::%{_i}%} parsed as number
			set {_min} to {_a::%{_i} + 1%} parsed as integer
			set {_ci} to {_i} + 2
			if {_p} is not set:
				boosterLog("refused %arg-1% by=%sender% reason=usage")
				dboosterReply(sender, {_usage})
				stop
			if {_b} is not set:
				boosterLog("refused %arg-1% by=%sender% reason=usage")
				dboosterReply(sender, {_usage})
				stop
			if {_min} is not set:
				boosterLog("refused %arg-1% by=%sender% reason=usage")
				dboosterReply(sender, {_usage})
				stop
			# Checked as it's saved: two decimals (a 1.004 would pass "more than 1" and do nothing).
			set {_b} to round({_b} * 100) / 100
			set {_max} to {-cfg::booster::%{_k}%::max-multiplier}
			if {_b} <= 1:
				boosterLog("refused %arg-1% by=%sender% reason=multiplier")
				dboosterReply(sender, "BOOSTER add: the multiplier must be more than 1 (up to %{_max}%)")
				stop
			if {_b} > {_max}:
				boosterLog("refused %arg-1% by=%sender% reason=multiplier")
				dboosterReply(sender, "BOOSTER add: the multiplier must be more than 1 (up to %{_max}%)")
				stop
			set {_maxMin} to cfg("booster::max-minutes")
			if {_min} < 1:
				boosterLog("refused %arg-1% by=%sender% reason=minutes")
				dboosterReply(sender, "BOOSTER add: 1-%{_maxMin}% minutes")
				stop
			if {_min} > {_maxMin}:
				boosterLog("refused %arg-1% by=%sender% reason=minutes")
				dboosterReply(sender, "BOOSTER add: 1-%{_maxMin}% minutes")
				stop
			# An optional count (Tebex's {purchaseQuantity}: "$1 per 5 minutes" bought 6 times = 30 minutes):
			# minutes × count, queued in boosters of at most booster::max-minutes each.
			set {_count} to 1
			if {_a::%{_ci}%} is set:
				set {_count} to {_a::%{_ci}%} parsed as integer
				if {_count} is not set:
					boosterLog("refused %arg-1% by=%sender% reason=count")
					dboosterReply(sender, "BOOSTER add: the count must be a whole number (1-10000)")
					stop
				if {_count} < 1:
					boosterLog("refused %arg-1% by=%sender% reason=count")
					dboosterReply(sender, "BOOSTER add: the count must be a whole number (1-10000)")
					stop
				if {_count} > 10000:
					boosterLog("refused %arg-1% by=%sender% reason=count")
					dboosterReply(sender, "BOOSTER add: the count must be a whole number (1-10000)")
					stop
			set {_total} to {_min} * {_count}
			set {_chunks} to ceil({_total} / {_maxMin})
			set {_key} to boosterKey({_k})
			# Queue keys sort as text, so they all have the same length (100001, 100002, ...); one counter for all kinds.
			if {booster::next} is not set:
				set {booster::next} to 100000
			loop {_chunks} times:
				set {_this} to min({_maxMin}, {_total} - (loop-number - 1) * {_maxMin})
				add 1 to {booster::next}
				set {_n} to {booster::next}
				set {booster::%{_key}%queue::%{_n}%} to "%{_a::2}%|%uuid of {_p}%|%{_b}%|%{_this} * 60%"
			boosterLog("add %{_k}% %{_a::2}% %uuid of {_p}% b=%{_b}% minutes=%{_min}% count=%{_count}% total=%{_total}% by=%sender%")
			if {booster::%{_key}%active} is set:
				dboosterReply(sender, "BOOSTER queued: %{_k}% %{_a::2}% %{_b}%x %{_total}% min (%size of {booster::%{_key}%queue::*}% waiting)")
			else:
				boosterNext({_k})
				dboosterReply(sender, "BOOSTER started: %{_k}% %{_a::2}% %{_b}%x %{_total}% min")
			stop
		# stop, clear and info take a kind (none = the money booster, as before kinds existed).
		set {_ka} to ""
		if {_a::2} is set:
			set {_ka} to {_a::2}
		set {_k} to dboosterKindArg({_ka})
		if {_k} is "":
			dboosterReply(sender, "BOOSTER kinds: money, xp, rush")
			stop
		set {_key} to boosterKey({_k})
		if {_sub} is "stop":
			if {booster::%{_key}%active} is not set:
				dboosterReply(sender, "BOOSTER none running (%{_k}%)")
				stop
			boosterEnd({_k}, "staff:%sender%")
			dboosterReply(sender, "BOOSTER stopped (%{_k}%)")
			stop
		if {_sub} is "clear":
			# Each paid entry removed is logged (to refund or re-add from).
			loop {booster::%{_key}%queue::*}:
				boosterLog("cleared %{_k}% %loop-value% by=%sender%")
			delete {booster::%{_key}%queue::*}
			boosterLog("clear %{_k}% by=%sender%")
			dboosterReply(sender, "BOOSTER queue cleared (%{_k}%)")
			stop
		if {_sub} is "info":
			set {_act} to "none"
			if {booster::%{_key}%active} is set:
				set {_act} to {booster::%{_key}%active}
			set {_left} to 0
			if {booster::%{_key}%left} is set:
				set {_left} to {booster::%{_key}%left}
			dboosterReply(sender, "BOOSTER kind=%{_k}% active=%{_act}% left=%{_left}% queued=%size of {booster::%{_key}%queue::*}% multiplier=%boosterMultiplierOf({_k})%")
			stop
		dboosterReply(sender, "BOOSTER usage: /dbooster add <player> <money|xp|rush> <multiplier> <minutes> [count] | stop [kind] | clear [kind] | info [kind]")
